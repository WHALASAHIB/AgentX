# AgentX Website .gitignore

# Secrets — keep these out of git!
.env*
*.key
*_token.txt
.bridge_key
.cf_token
tunnel_token.txt

# Large binaries
cloudflared.exe
OpenSSH-Win64/

# Python
__pycache__/
*.pyc
*.pyo
*.pyc
.venv/
venv/

# Database
backend/db/*.db
backend/db/*.db-shm
backend/db/*.db-wal

# Temp
*.html
*.bak
/tmp/
temp/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
