# AgentX Website .gitignore

# Secrets — keep these out of git!
.env*
*.key
*_token.txt
.bridge_key
.cf_token
tunnel_token.txt

# Large binaries
cloudflared.exe
OpenSSH-Win64/

# Knowledge base — belongs in Hermess repo
rag_knowledge_base/

# Python
__pycache__/
*.pyc
*.pyo
*.pyc
.venv/
venv/

# Database — keep schema, ignore data
backend/db/*.db
backend/db/*.db-shm
backend/db/*.db-wal
backend/db/agentx_store.json

# Bot logs — runtime data, not source
bots/logs/

# Cloned third-party repos — not our source code
research_division/repos/
*.bak
/tmp/
temp/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
