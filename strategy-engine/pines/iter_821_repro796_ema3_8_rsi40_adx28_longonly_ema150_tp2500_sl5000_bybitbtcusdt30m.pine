//@version=6
strategy(title="REPRO-821 EMA3/8 RSI40 ManualADX28 LongOnly EMA150Filter BarrierExit TP2500 SL5000 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

// iter 821: CHAMPION RE-VALIDATION (scheduled repro) per the iter-820 result
// (result 01KZA3S8SE2J86BYVQNP1K78VQ -- scheduled repro produced PF 1.96 /
// Sharpe 2.03 / WR 76.2% / DD 1.58% / 21 trades / +$280.64, byte-identical to
// iter-816/817/818/819 (data window essentially unchanged); WITHIN the
// pre-registered tolerance (PF >= 1.5, trades >= 20, WR >= 60%): the edge
// PERSISTS; terminal answer RE-CONFIRMED for the 6th consecutive repro; store
// remains permanently locked at iter-796; 8/8 indicator families mapped,
// RSI/ADX/TP/SL barrier maps complete, fresh-symbol ETH/SOL/XRP and timeframe
// 1h transfers failed).
// ONE change: NONE in logic -- this is an EXACT reproduction of the locked
// champion stack (BYBIT:BTCUSDT.P 30m EMA3/8 crossover + RSI40 + ADX28 + EMA150
// long-only regime, TP2500/SL5000 manual tick barriers, flat-only, 1-bar min
// hold, NO breakeven) to confirm the edge persists as clickhouse data extends
// further past the current window. Decision rule: repro stays within tolerance
// (PF >= 1.5 and trades >= 20 and WR >= 60%) -> terminal answer iter-796
// RE-CONFIRMED, store remains permanently locked; drift beyond tolerance ->
// reopen exploration on the drifted axis.

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // iter 820: UNCHANGED at 3 (peak). sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // iter 820: UNCHANGED at 8 (peak). sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(40, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 820: RSI UNCHANGED at 40 (peak). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(28, "ADX Threshold", minval=10, maxval=50)   // iter 820: ADX UNCHANGED at 28 (peak). sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 820: regime EMA 150 (proven-best long-side). sweep: 100-200 step 50
take_profit_tick = input.int(2500, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 820: TP UNCHANGED at 2500 (PF peak, iter 792). sweep: 2000-4000 step 500
stop_loss_tick = input.int(5000, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 820: SL UNCHANGED at 5000 (iter-796 terminal peak config). sweep: 3000-6000 step 500

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 821: EXACT reproduction of the locked
// iter-796 champion -- EMA3/8 + RSI40 + ADX28 + EMA150 long-only regime +
// TP2500/SL5000 manual barriers, flat-only, 1-bar min hold, NO breakeven. All
// input values identical to iter 796/805/814/815/816/817/818/819/820; only the
// data window extends as clickhouse data grows.)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
