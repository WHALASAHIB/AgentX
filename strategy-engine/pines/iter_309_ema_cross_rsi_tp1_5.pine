//@version=5
strategy(title="EMA5/13 Crossover + RSI + 1:1.5 TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA fast period
emaFastLen = input.int(5, "EMA Fast Length", minval=2, maxval=50, group="EMA")  // sweep: 3-10 step 1
// EMA slow period
emaSlowLen = input.int(13, "EMA Slow Length", minval=5, maxval=100, group="EMA")  // sweep: 10-30 step 2
// RSI filter
useRSIFilter = input.bool(true, "Use RSI Filter", group="Filters")
rsiLen = input.int(14, "RSI Length", minval=7, maxval=21, group="Filters")  // sweep: 7-21 step 2
rsiLongThreshold = input.int(50, "RSI Long Threshold (> this)", minval=30, maxval=70, group="Filters")  // sweep: 40-60 step 5
rsiShortThreshold = input.int(50, "RSI Short Threshold (< this)", minval=30, maxval=70, group="Filters")  // sweep: 40-60 step 5
// TP/SL ratio
tpSlRatioLong = input.float(1.5, "TP/SL Ratio (Long)", minval=0.5, maxval=5.0, step=0.5, group="Risk")  // sweep: 0.5-4.0 step 0.5
tpSlRatioShort = input.float(1.5, "TP/SL Ratio (Short)", minval=0.5, maxval=5.0, step=0.5, group="Risk")  // sweep: 0.5-4.0 step 0.5
// SL as percentage of close
slPercent = input.float(0.3, "Stop Loss (% of price)", minval=0.05, maxval=2.0, step=0.05, group="Risk")  // sweep: 0.1-1.0 step 0.1

//--- calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)

//--- entry conditions
// Long: EMA fast crosses above EMA slow + RSI > threshold
longEntry = ta.crossover(emaFast, emaSlow)
if (useRSIFilter)
    longEntry := longEntry and (rsiVal > rsiLongThreshold)

// Short: EMA fast crosses below EMA slow + RSI < threshold
shortEntry = ta.crossunder(emaFast, emaSlow)
if (useRSIFilter)
    shortEntry := shortEntry and (rsiVal < rsiShortThreshold)

//--- entry management (no cascade-close: only enter, never strategy.close)
if (longEntry)
    strategy.entry("Long", strategy.long)

if (shortEntry)
    strategy.entry("Short", strategy.short)

//--- exit management via fixed SL/TP
// SL distance in ticks
slTicksLong = int(slPercent * close / syminfo.mintick / 100)
tpTicksLong = int(slTicksLong * tpSlRatioLong)
slTicksShort = int(slPercent * close / syminfo.mintick / 100)
tpTicksShort = int(slTicksShort * tpSlRatioShort)

// Place exits only when we have a position
if (strategy.position_size > 0)
    strategy.exit("Long Exit", "Long", loss=slTicksLong, profit=tpTicksLong)

if (strategy.position_size < 0)
    strategy.exit("Short Exit", "Short", loss=slTicksShort, profit=tpTicksShort)
