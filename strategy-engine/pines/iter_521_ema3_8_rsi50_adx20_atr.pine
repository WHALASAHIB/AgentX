//@version=6
strategy(title="EMA3/8 + RSI>50 + ADX>20 Long Only (iter521)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "EMA Fast Length", minval=1, maxval=50)           // sweep: 1-10 step 1
ema_slow_len = input.int(8, "EMA Slow Length", minval=2, maxval=50)           // sweep: 5-20 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=30)                     // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold", minval=30, maxval=70)          // sweep: 40-60 step 5
adx_len = input.int(14, "ADX Length", minval=5, maxval=30)                     // sweep: 7-21 step 2
adx_threshold = input.int(20, "ADX Threshold", minval=10, maxval=40)          // sweep: 15-25 step 2 (relaxed from 25 to 20)
atr_len = input.int(14, "ATR Length", minval=5, maxval=30)                     // sweep: 7-21 step 2
atr_mult = input.float(2.0, "ATR Multiplier for Trail", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-3.0 step 0.5

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX calculation (Wilder's method)
adx_len_actual = adx_len
up_change = ta.change(high)
down_change = -ta.change(low)
plus_dm = fixnan(up_change > down_change and up_change > 0 ? up_change : 0)
minus_dm = fixnan(down_change > up_change and down_change > 0 ? down_change : 0)
tr_val = ta.tr
atr_for_adx = ta.rma(tr_val, adx_len_actual)
plus_di = 100 * ta.rma(plus_dm, adx_len_actual) / atr_for_adx
minus_di = 100 * ta.rma(minus_dm, adx_len_actual) / atr_for_adx
dx_val = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.rma(dx_val, adx_len_actual)

atr_val = ta.atr(atr_len)

//--- crossover condition
ema_cross_above = ta.crossover(ema_fast, ema_slow)

//--- entry condition: EMA3 crosses above EMA8 AND RSI > 50 AND ADX > 20 (relaxed from 25)
long_condition = ema_cross_above and rsi_val > rsi_threshold and adx_val > adx_threshold

//--- plot indicators for visual reference
plot(ema_fast, "EMA Fast", color=color.blue, linewidth=2)
plot(ema_slow, "EMA Slow", color=color.red, linewidth=2)
hline(rsi_threshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed)
hline(adx_threshold, "ADX Threshold", color=color.gray, linestyle=hline.style_dashed)

//--- entry logic
if (long_condition)
    strategy.entry("Long", strategy.long)

//--- exit management: ATR trailing stop
trail_stop_level = 0.0
if (strategy.position_size > 0)
    trail_stop_level := close - (atr_val * atr_mult)
    // Ratchet up: only raise the trail, never lower
    trail_stop_level := math.max(trail_stop_level, strategy.position_avg_price * 0.97)  // hard floor at 3% below entry
    strategy.exit("Trail Exit", "Long", stop=trail_stop_level)

//--- plot trailing stop
plot(strategy.position_size > 0 ? trail_stop_level : na, "Trail Stop", color=color.purple, style=plot.style_linebr, linewidth=1)
