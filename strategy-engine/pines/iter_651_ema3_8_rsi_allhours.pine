//@version=6
strategy(title="Iter 651 - EMA3/8 RSI AllHours XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)          // sweep: 1-10 step 1
ema_slow_len = input.int(8, "Slow EMA Length", minval=2, maxval=50)           // sweep: 5-20 step 1
rsi_len      = input.int(14, "RSI Length", minval=2, maxval=50)               // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold (long above)", minval=20, maxval=80) // sweep: 40-60 step 5
tp_atr_mult  = input.float(1.0, "TP (ATR multiple)", minval=0.5, maxval=5.0) // sweep: 0.5-3.0 step 0.5
sl_atr_mult  = input.float(1.5, "SL (ATR multiple)", minval=0.5, maxval=5.0) // sweep: 0.5-3.0 step 0.5
atr_len      = input.int(14, "ATR Length", minval=5, maxval=50)               // sweep: 7-21 step 7
use_long     = input.bool(true, "Enable Long Trades")

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val  = ta.rsi(close, rsi_len)
atr_val  = ta.atr(atr_len)

//--- entry logic: EMA3/8 crossover + RSI(14)>50 filter, no session restriction (trade ALL hours)
long_condition = use_long and ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_threshold

if (long_condition)
    strategy.entry("Long", strategy.long)

//--- exit management (ATR-based TP/SL)
if (strategy.position_size > 0)
    tp_distance = math.floor(tp_atr_mult * atr_val / syminfo.mintick)
    sl_distance = math.floor(sl_atr_mult * atr_val / syminfo.mintick)
    strategy.exit("Long Exit", "Long", loss=sl_distance, profit=tp_distance)

//--- visual overlays
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=2)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=2)
hline(rsi_threshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed)
