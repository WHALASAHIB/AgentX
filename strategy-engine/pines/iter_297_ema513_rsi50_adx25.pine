//@version=5
strategy(title="EMA5/13 + RSI50 + ADX25 — XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// EMA parameters
emaFastLen = input.int(5, "EMA Fast Length", minval=1, maxval=50, step=1)       // sweep: 3-10 step 1
emaSlowLen = input.int(13, "EMA Slow Length", minval=5, maxval=50, step=1)      // sweep: 10-30 step 2

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30, step=1)               // sweep: 7-21 step 2
rsiThreshold = input.int(50, "RSI Threshold", minval=30, maxval=70, step=5)     // sweep: 40-60 step 5

// ADX parameters
adxLen = input.int(14, "ADX Length", minval=7, maxval=30, step=1)               // sweep: 7-21 step 2
adxThreshold = input.int(25, "ADX Min Threshold", minval=15, maxval=40, step=5) // sweep: 15-35 step 5

// TP/SL parameters
tpRatio = input.float(2.0, "Take Profit Ratio (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-4.0 step 0.5
slRatio = input.float(1.0, "Stop Loss Ratio (×ATR)", minval=0.5, maxval=5.0, step=0.5)    // sweep: 0.5-2.0 step 0.5
atrLen = input.int(14, "ATR Length", minval=5, maxval=30, step=1)                          // sweep: 7-21 step 2

//--- indicator calculations

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(high, low, close, adxLen)
atr = ta.atr(atrLen)

//--- entry logic

// Long conditions: EMA5 crosses above EMA13, RSI > 50, ADX > 25, +DI > -DI
longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiThreshold and adx > adxThreshold and diPlus > diMinus

// Short conditions: EMA5 crosses below EMA13, RSI < 50, ADX > 25, +DI < -DI
shortCondition = ta.crossunder(emaFast, emaSlow) and rsi < rsiThreshold and adx > adxThreshold and diPlus < diMinus

//--- exit management

// Calculate SL/TP distances in ticks using ATR
longSlTicks = int((slRatio * atr) / syminfo.mintick)
longTpTicks = int((tpRatio * atr) / syminfo.mintick)
shortSlTicks = int((slRatio * atr) / syminfo.mintick)
shortTpTicks = int((tpRatio * atr) / syminfo.mintick)

// Enter long
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=longSlTicks, profit=longTpTicks)

// Enter short
if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=shortSlTicks, profit=shortTpTicks)

//--- visual plots
plot(emaFast, "EMA Fast", color=color.blue, linewidth=1)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=1)
hline(adxThreshold, "ADX Threshold", color=color.gray, linestyle=hline.style_dashed)
