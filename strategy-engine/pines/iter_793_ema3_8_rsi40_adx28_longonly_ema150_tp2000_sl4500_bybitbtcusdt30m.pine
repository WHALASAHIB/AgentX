//@version=6
strategy(title="EMA3/8 RSI40 ManualADX28 LongOnly EMA150Filter BarrierExit TP2000 SL4500 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

// iter 793: TP BARRIER SWEEP CONTINUED in the improving direction per the iter-792 result
// (iter 792: TP 3000 -> 2500 BEAT the TP3000 peak on every gate on BYBIT:BTCUSDT.P 30m:
// 22 trades, PF 1.792 vs 1.66, Sharpe 1.96 vs 1.78, WR 77.3% vs 70.8%, DD 1.94% vs 2.23%,
// net +$268.17, result 01KZ5HVZ1MK94N7Z0PEABQDES9 -- new current-store peak; the tighter TP
// harvested more partial wins, avgBarsInTrade 7.14 vs 8.96).
// ONE change: take_profit_tick 2500 -> 2000 on BYBIT:BTCUSDT.P 30m (stop_loss_tick 4500 UNCHANGED;
// TP/SL ratio 0.556x -> 0.444x). Rationale: TP 3000->2500 improved PF/WR/Sharpe/DD, so the improving
// direction is TIGHTER TP -- TP2000 (~0.5x ATR) should push WR higher (77.3% -> ~80%+) with a further
// DD reduction; payoff per win drops further (realized 0.527x -> ~0.45x, breakeven WR ~69%), so this
// tests whether the WR gain outpaces the payoff loss.
// If TP2000 degrades below the iter-792 TP2500 peak (PF 1.79, net +$268.17), REVERT to TP2500 as the
// new terminal peak and test the complementary loose direction (TP 3500, SL 4500) to complete the TP
// map, or accept TP2500 as terminal.

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // iter 793: UNCHANGED at 3 (peak). sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // iter 793: UNCHANGED at 8 (peak). sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(40, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 793: RSI UNCHANGED at 40 (iter-769/770 peak). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(28, "ADX Threshold", minval=10, maxval=50)   // iter 793: ADX UNCHANGED at 28 (peak; ADX22 < ADX25 < ADX28 PEAK > ADX30 invalid). sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 793: regime EMA 150 (proven-best long-side). sweep: 100-200 step 50
take_profit_tick = input.int(2000, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 793: TP 2500 -> 2000 (SWEEP CONTINUED, ~0.5x ATR). sweep: 1500-3500 step 500
stop_loss_tick = input.int(4500, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 793: SL UNCHANGED at 4500 (~1x ATR). sweep: 3000-6000 step 500

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 793: TP barrier sweep CONTINUED 2500 -> 2000 on the confirmed
// BYBIT:BTCUSDT.P 30m peak -- EMA3/8 + RSI40 + ADX28 + EMA150 long-only regime + TP2000/SL4500
// manual barriers, flat-only, 1-bar min hold, NO breakeven. SL4500 UNCHANGED per the SL sweep
// mapping (SL4500 PEAK > SL3000/5000/1000); only the TP half of the barrier pair moves.)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
