//@version=5
strategy(title="EMA(5,13) + RSI(50) LONG-only H1 TP1.5", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFastLen = input.int(5, "EMA Fast Length", minval=1, maxval=50)       // sweep: 3-20 step 1
emaSlowLen = input.int(13, "EMA Slow Length", minval=1, maxval=100)       // sweep: 8-30 step 2

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)                 // sweep: 7-21 step 1
rsiThreshold = input.int(50, "RSI Threshold (long above)", minval=1, maxval=99)  // sweep: 40-60 step 5

// ATR-based stop/target — TP/SL ratio tightened from 2:1 to 1.5:1
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)                // sweep: 7-21 step 2
stopDist = input.float(1.0, "Stop Distance (ATR multiples)", minval=0.3, maxval=5.0, step=0.1)   // SL = 1.0x ATR
targetDist = input.float(1.5, "Target Distance (ATR multiples)", minval=0.3, maxval=10.0, step=0.1)  // TP = 1.5x ATR (1.5:1 ratio)

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- entry logic
// LONG only: EMA5 crosses above EMA13 AND RSI > 50
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThreshold

//--- exit management
// Use ATR-based fixed SL and TP with strategy.exit()
// Calculate stop and target distances in price units
slDistance = atrVal * stopDist
tpDistance = atrVal * targetDist

if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    // strategy.exit with loss/profit in ticks (syminfo.mintick)
    strategy.exit("XL", "Long", 
     loss=int(slDistance / syminfo.mintick), 
     profit=int(tpDistance / syminfo.mintick))

//--- visual
plot(emaFast, "EMA Fast", color=color.blue, linewidth=1)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=1)
hline(rsiThreshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed)
