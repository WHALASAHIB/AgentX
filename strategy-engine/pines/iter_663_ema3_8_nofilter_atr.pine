//@version=6
strategy(title="EMA3/8 Long-Only No Filters ATR TP15 SL10", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFast = input.int(3, "Fast EMA", minval=1, maxval=50)      // sweep: 2-10 step 1
emaSlow = input.int(8, "Slow EMA", minval=2, maxval=100)      // sweep: 5-30 step 5
tpMult  = input.float(1.5, "TP Multiplier (x ATR)", step=0.1)  // sweep: 1.0-3.0 step 0.5
slMult  = input.float(1.0, "SL Multiplier (x ATR)", step=0.1)  // sweep: 0.5-2.0 step 0.5
atrLen  = input.int(14, "ATR Length", minval=5, maxval=50)     // sweep: 10-30 step 5

//--- indicators
emaFastVal = ta.ema(close, emaFast)
emaSlowVal = ta.ema(close, emaSlow)
atrVal     = ta.atr(atrLen)

//--- entry logic: EMA3 crosses above EMA8 = long
longCondition = ta.crossover(emaFastVal, emaSlowVal)

//--- exit management: fixed ATR-based TP/SL
if (longCondition)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long_Exit", "Long", loss=atrVal * slMult / syminfo.mintick, profit=atrVal * tpMult / syminfo.mintick)

//--- plot EMAs for visual reference
plot(emaFastVal, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlowVal, "EMA Slow", color=color.red, linewidth=2)
