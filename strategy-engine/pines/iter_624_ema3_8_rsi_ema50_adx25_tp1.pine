//@version=6
strategy(title="EMA3/8 RSI50 EMA50 ADX25 TP1 BTCUSDT 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLen   = input.int(3, "Fast EMA Length", minval=1, maxval=50)          // sweep: 2-10 step 1
slowLen   = input.int(8, "Slow EMA Length", minval=1, maxval=50)          // sweep: 5-21 step 2
rsiLen    = input.int(14, "RSI Length", minval=2, maxval=50)              // sweep: 7-21 step 2
rsiMin    = input.int(50, "RSI Minimum (Long)", minval=20, maxval=80)     // sweep: 30-60 step 5
trendLen  = input.int(50, "Trend EMA Length", minval=20, maxval=200)      // sweep: 20-200 step 10
adxLen    = input.int(14, "ADX Length", minval=7, maxval=30)              // sweep: 7-21 step 2
adxThresh = input.int(25, "ADX Threshold", minval=10, maxval=40)          // sweep: 15-35 step 5
tpMult    = input.float(1.0, "Take Profit (×ATR)", step=0.25)             // sweep: 0.5-3.0 step 0.25
slMult    = input.float(1.0, "Stop Loss (×ATR)", step=0.25)               // sweep: 0.5-3.0 step 0.25
atrLen    = input.int(14, "ATR Length", minval=5, maxval=50)              // sweep: 7-21 step 2

//--- calculations
emaFast   = ta.ema(close, fastLen)
emaSlow   = ta.ema(close, slowLen)
emaTrend  = ta.ema(close, trendLen)
rsiVal    = ta.rsi(close, rsiLen)
atrVal    = ta.atr(atrLen)

//--- manual ADX calculation (ta.adx not supported by TV engine variant)
float up   = high - high[1]
float down = low[1] - low
trueRange   = math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
plusDM     = up > down and up > 0 ? up : 0
minusDM    = down > up and down > 0 ? down : 0
smoothedPD = ta.rma(plusDM, adxLen)
smoothedMD = ta.rma(minusDM, adxLen)
smoothedTR = ta.rma(trueRange, adxLen)
plusDI     = 100 * smoothedPD / (smoothedTR + 1e-10)
minusDI    = 100 * smoothedMD / (smoothedTR + 1e-10)
dx         = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI + 1e-10)
adxVal     = ta.rma(dx, adxLen)

//--- entry condition: EMA3/8 crossover + RSI>50 + price>EMA(50) + ADX>25 (trending market only)
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiMin and close > emaTrend and adxVal > adxThresh

//--- ATR-based TP/SL levels
longTP = close + atrVal * tpMult
longSL = close - atrVal * slMult

//--- entry (only when flat)
if longCondition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

//--- exit with ATR-based fixed TP/SL
if strategy.position_size > 0
    strategy.exit("XL", "Long", limit=longTP, stop=longSL)

//--- plots
plot(emaFast, "Fast EMA", color=color.blue, linewidth=1)
plot(emaSlow, "Slow EMA", color=color.red, linewidth=1)
plot(emaTrend, "Trend EMA", color=color.purple, linewidth=2)
plot(adxVal, "ADX", color=color.orange, linewidth=1, display=display.data_window)
hline(adxThresh, "ADX Threshold", color=color.gray, linestyle=hline.style_dashed, display=display.data_window)
