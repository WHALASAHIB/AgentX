//@version=5
strategy(title="BB Breakout H1 Nosma RSI40 Long-Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_len = input.int(20, "BB Length", minval=5, maxval=50)       // sweep: 10-30 step 5
bb_mult = input.float(2.0, "BB StdDev Mult", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)        // sweep: 10-20 step 2
rsi_threshold = input.int(40, "RSI Threshold", minval=20, maxval=60)  // sweep: 30-50 step 5
tp_mult = input.float(2.0, "TP Multiplier (x ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
sl_mult = input.float(1.0, "SL Multiplier (x ATR)", minval=0.3, maxval=3.0, step=0.3)  // sweep: 0.5-2.0 step 0.3
atr_len = input.int(14, "ATR Length", minval=7, maxval=30)        // sweep: 10-20 step 3

//--- indicator calculations
[basis, upper, lower] = ta.bb(close, bb_len, bb_mult)
rsi = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)

//--- entry logic
// SMA(20) trend filter removed to increase trade frequency in non-trending breakouts
// RSI threshold lowered from 50 to 40 for more entries
long_entry = close > upper and rsi > rsi_threshold

//--- exit management
if long_entry
    stop_loss = close - (atr_val * sl_mult)
    take_profit = close + (atr_val * tp_mult)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=close - stop_loss, profit=take_profit - close)

//--- plot
plot(basis, "BB Basis", color=color.blue)
plot(upper, "BB Upper", color=color.gray)
plot(lower, "BB Lower", color=color.gray)
hline(rsi_threshold, "RSI Threshold", color=color.green, linestyle=hline.style_dashed)
