//@version=5
strategy(title="EMA2/5 XAUUSD 30m DMI14 RSI50 LongOnly", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len  = input.int(2,   "Fast EMA Length",  minval=1, maxval=50)   // sweep: 1-10 step 1
ema_slow_len  = input.int(5,   "Slow EMA Length",  minval=1, maxval=50)   // sweep: 3-20 step 3
rsi_len       = input.int(14,  "RSI Length",       minval=2, maxval=50)   // sweep: 7-21 step 7
rsi_threshold = input.int(50,  "RSI Threshold",    minval=1, maxval=100)  // sweep: 40-60 step 5
dmi_len       = input.int(14,  "DMI/ADX Length",    minval=1, maxval=50)  // sweep: 7-21 step 7
dmi_threshold = input.int(14,  "ADX Trend Threshold",minval=1, maxval=50) // sweep: 10-30 step 5
tp_points     = input.int(67,  "Take Profit (pts)", minval=1, maxval=500) // sweep: 20-200 step 20
sl_points     = input.int(67,  "Stop Loss (pts)",    minval=1, maxval=500) // sweep: 20-200 step 20

//--- indicators
fast_ema = ta.ema(close, ema_fast_len)
slow_ema = ta.ema(close, ema_slow_len)
rsi_val  = ta.rsi(close, rsi_len)
[dplus, dminus, adx_val] = ta.dmi(high, low, close, dmi_len)

//--- entry logic: EMA crossover + RSI>50 + ADX>threshold
long_condition = ta.crossover(fast_ema, slow_ema) and rsi_val > rsi_threshold and adx_val > dmi_threshold

if long_condition
    strategy.entry("Long", strategy.long)

//--- exit management: fixed TP/SL
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=sl_points * syminfo.mintick, profit=tp_points * syminfo.mintick)
