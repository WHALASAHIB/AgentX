//@version=6
strategy(title="iter_535_ema3_8_reversesignalexit", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50, step=1)        // sweep: 1-10 step 1
slow_len = input.int(8, "Slow EMA Length", minval=1, maxval=50, step=2)         // sweep: 5-20 step 2
rsi_len  = input.int(14, "RSI Length", minval=2, maxval=50, step=1)             // sweep: 7-21 step 2
ema50_len = input.int(50, "EMA Trend Length", minval=20, maxval=200, step=5)    // sweep: 50-200 step 20

//--- calculations
ema_fast = ta.ema(close, fast_len)
ema_slow = ta.ema(close, slow_len)
ema_trend = ta.ema(close, ema50_len)
rsi_val = ta.rsi(close, rsi_len)

//--- entry logic: EMA3/8 crossover + RSI50 filter + EMA50 trend filter
long_condition  = ta.crossover(ema_fast, ema_slow) and rsi_val > 50 and close > ema_trend
short_condition = ta.crossunder(ema_fast, ema_slow) and rsi_val < 50 and close < ema_trend

//--- exit on REVERSE crossover (no fixed TP/SL, no strategy.exit cascade)
// Exit long when fast EMA crosses below slow EMA (opposite signal)
long_exit  = ta.crossunder(ema_fast, ema_slow)
short_exit = ta.crossover(ema_fast, ema_slow)

//--- execution
if (long_condition)
    strategy.entry("Long", strategy.long)

if (short_condition)
    strategy.entry("Short", strategy.short)

if (long_exit)
    strategy.close("Long")

if (short_exit)
    strategy.close("Short")
