//@version=5
strategy(title="EMA5/13 RSI50 ADX14 TimeFilter LongOnly", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFast = input.int(5, "EMA Fast Period", minval=1, maxval=50)        // sweep: 3-10 step 1
emaSlow = input.int(13, "EMA Slow Period", minval=1, maxval=50)        // sweep: 8-21 step 2

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)              // sweep: 10-21 step 2
rsiMin = input.int(50, "RSI Minimum (LONG-only)", minval=30, maxval=70) // sweep: 40-60 step 5

// ADX parameters
adxLen = input.int(14, "ADX Length", minval=5, maxval=30)              // sweep: 10-21 step 2
adxMin = input.int(14, "Min ADX (trend filter)", minval=5, maxval=50)  // sweep: 10-30 step 2

// TP/SL parameters
tpPoints = input.int(67, "Take Profit (points)", minval=10, maxval=500)  // sweep: 30-150 step 10
slPoints = input.int(67, "Stop Loss (points)", minval=10, maxval=500)    // sweep: 30-150 step 10

// Session filter
sessStart = input.int(8, "Session Start Hour (UTC)", minval=0, maxval=23)  // sweep: 6-12 step 1
sessEnd = input.int(16, "Session End Hour (UTC)", minval=0, maxval=23)      // sweep: 14-20 step 1

//--- indicator calculations
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLen)

// Manual ADX calculation using DMI (works on all Pine Script engines)
up = ta.change(high)
down = -ta.change(low)
plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atr = ta.sma(tr, adxLen)
plusDI = 100 * ta.sma(plusDM, adxLen) / atr
minusDI = 100 * ta.sma(minusDM, adxLen) / atr
dx = math.abs(plusDI - minusDI) / (plusDI + minusDI) * 100
adxVal = ta.sma(dx, adxLen)

//--- entry logic
// Time filter: trade only during specified UTC hours
currentHour = hour(time)
inSession = currentHour >= sessStart and currentHour < sessEnd

// Long entry: EMA5 crosses above EMA13 AND RSI > RSI min AND ADX > min threshold AND within session
longCondition = ta.crossover(emaF, emaS) and rsiVal > rsiMin and adxVal > adxMin and inSession

// Exit condition: EMA5 crosses below EMA13 (trailing exit)
exitCondition = ta.crossunder(emaF, emaS)

//--- entry management
if (longCondition)
    strategy.entry("Long", strategy.long)

//--- exit management
if (strategy.position_size > 0)
    // Fixed TP/SL exit
    strategy.exit("XL", "Long", loss=slPoints * syminfo.mintick, profit=tpPoints * syminfo.mintick)
    // Also exit on crossover signal
    if (exitCondition)
        strategy.close("Long")
