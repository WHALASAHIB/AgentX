//@version=5
strategy(title="EMA3/8 Crossover + RSI(50) + 1:1 TP/SL XAUUSD 1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
fastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50, tooltip="Fast EMA period for crossover signal")   // sweep: 2-10 step 1
slowLen = input.int(8, "Slow EMA Length", minval=2, maxval=100, tooltip="Slow EMA period for crossover signal") // sweep: 5-30 step 1

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50, tooltip="RSI period for trend filter")                 // sweep: 7-21 step 2
rsiLongThreshold = input.int(50, "RSI Long Threshold", minval=20, maxval=80, tooltip="RSI above = long allowed")  // sweep: 40-60 step 5
rsiShortThreshold = input.int(50, "RSI Short Threshold", minval=20, maxval=80, tooltip="RSI below = short allowed") // sweep: 40-60 step 5

// Risk management
slPercent = input.float(0.3, "Stop Loss %", minval=0.1, maxval=2.0, step=0.05, tooltip="Stop loss as % of entry price")   // sweep: 0.1-1.0 step 0.1
tpSlRatio = input.float(1.0, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.25, tooltip="Take profit multiple of stop loss") // sweep: 0.5-3.0 step 0.5

//--- indicator calculations
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)

//--- entry logic
// Crossover detection
bullishCross = ta.crossover(fastEma, slowEma)
bearishCross = ta.crossunder(fastEma, slowEma)

// RSI condition: long only if RSI > threshold, short only if RSI < threshold
rsiLongCondition = rsi > rsiLongThreshold
rsiShortCondition = rsi < rsiShortThreshold

// Entry signals
enterLong = bullishCross and rsiLongCondition
enterShort = bearishCross and rsiShortCondition

//--- TP/SL calculation in ticks
varip float lastLongEntry = na
varip float lastShortEntry = na

if (enterLong)
    lastLongEntry := close
    strategy.entry("Long", strategy.long)

if (enterShort)
    lastShortEntry := close
    strategy.entry("Short", strategy.short)

// Calculate stop loss and take profit ticks from entry
float slTicksLong = na
float tpTicksLong = na
float slTicksShort = na
float tpTicksShort = na

if (not na(lastLongEntry))
    slTicksLong := math.round((lastLongEntry * slPercent / 100.0) / syminfo.mintick)
    tpTicksLong := math.round(slTicksLong * tpSlRatio)
    strategy.exit("XL", "Long", loss=slTicksLong, profit=tpTicksLong)

if (not na(lastShortEntry))
    slTicksShort := math.round((lastShortEntry * slPercent / 100.0) / syminfo.mintick)
    tpTicksShort := math.round(slTicksShort * tpSlRatio)
    strategy.exit("XS", "Short", loss=slTicksShort, profit=tpTicksShort)

//--- visual signals
plot(fastEma, "Fast EMA", color=color.blue, linewidth=1)
plot(slowEma, "Slow EMA", color=color.red, linewidth=1)
hline(50, "RSI Mid", color=color.gray, linestyle=hline.style_dotted)
