//@version=6
strategy(title="EMA3/8 ATR Trail ADX25 Long Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)        // sweep: 2-8 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)        // sweep: 5-21 step 1
atrLen      = input.int(14, "ATR Length", minval=1, maxval=50)           // sweep: 7-21 step 2
atrMult     = input.float(2.0, "ATR Multiplier", minval=0.5, maxval=5.0) // sweep: 1.0-3.0 step 0.5
adxThresh   = input.int(25, "ADX Threshold", minval=1, maxval=60)        // sweep: 18-30 step 2

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)

//--- manual ADX calculation (ta.adx not available in this runtime)
// True Range
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
// Directional Movement
plusDM = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0
minusDM = low[1] - low > high - high[1] ? math.max(low[1] - low, 0) : 0
// Smoothed ATR and DMs using RMA (Wilder smoothing)
atrSmoothed = 0.0
plusSmooth = 0.0
minusSmooth = 0.0
atrSmoothed := nz(atrSmoothed[1] + (tr - nz(atrSmoothed[1])) / adxLen, tr)
plusSmooth := nz(plusSmooth[1] + (plusDM - nz(plusSmooth[1])) / adxLen, plusDM)
minusSmooth := nz(minusSmooth[1] + (minusDM - nz(minusSmooth[1])) / adxLen, minusDM)
// +DI and -DI
plusDI = 100 * plusSmooth / atrSmoothed
minusDI = 100 * minusSmooth / atrSmoothed
// DX and ADX
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adxCalc = 0.0
adxCalc := nz(adxCalc[1] + (dx - nz(adxCalc[1])) / adxLen, dx)

//--- entry logic: EMA3/8 crossover + ADX > threshold (trending market only)
longCondition = ta.crossover(emaFast, emaSlow) and adxCalc > adxThresh

//--- exit management: ATR trailing stop
trailStop = 0.0
if (strategy.position_size > 0)
    trailStop := math.max(trailStop[1], close - atrVal * atrMult)
    if (close < trailStop)
        strategy.close("Long", comment="TrailStop")
else
    trailStop := close - atrVal * atrMult

//--- entry
if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long, comment="EMA3_8_ADX")

//--- plots
plot(emaFast, "EMA Fast", color.blue)
plot(emaSlow, "EMA Slow", color.red)
hline(adxThresh, "ADX Threshold", color.gray, linestyle=hline.style_dashed)
