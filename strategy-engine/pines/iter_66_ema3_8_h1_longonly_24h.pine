//@version=5
strategy(title="EMA(3,8) H1 Long-Only 24h", overlay=true, initial_capital=10000, 
         default_qty_type=strategy.percent_of_equity, default_qty_value=100, 
         commission_type=strategy.commission.percent, commission_value=0.04, 
         process_orders_on_close=true)

// --- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)         // sweep: 1-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)         // sweep: 1-20 step 1
atrLen     = input.int(14, "ATR Length", minval=1, maxval=50)             // sweep: 5-30 step 5
slMult     = input.float(1.0, "Stop Loss ATR Multiplier", step=0.1)       // sweep: 0.5-3.0 step 0.5
tpRatio    = input.float(1.5, "Take Profit Ratio (SL * ratio)", step=0.1) // sweep: 1.0-4.0 step 0.5

// --- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)

// --- entry logic
longCondition = ta.crossover(emaFast, emaSlow)
exitCondition = ta.crossunder(emaFast, emaSlow)

// --- exit management
if (longCondition)
    slPrice = close - (atrVal * slMult)
    tpPrice = close + (atrVal * slMult * tpRatio)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=close - slPrice, profit=tpPrice - close)

if (exitCondition and strategy.position_size > 0)
    strategy.close("Long", comment="Crossunder Exit")
