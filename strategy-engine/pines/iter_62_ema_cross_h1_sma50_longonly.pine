//@version=5
strategy(title="EMA Crossover H1 SMA50 Filter LONG-Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(5, "EMA Fast Length", minval=2, maxval=30)       // sweep: 3-15 step 2
ema_slow_len = input.int(13, "EMA Slow Length", minval=5, maxval=50)      // sweep: 10-30 step 5
sma_trend_len = input.int(50, "SMA Trend Length", minval=20, maxval=200)  // sweep: 20-200 step 10
atr_len = input.int(14, "ATR Length", minval=7, maxval=30)                // sweep: 7-21 step 7
sl_mult = input.float(1.0, "SL Multiplier (ATR)", minval=0.5, maxval=3.0) // sweep: 0.5-3.0 step 0.5
tp_sl_ratio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0)    // sweep: 1.0-3.0 step 0.5

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
sma_trend = ta.sma(close, sma_trend_len)
atr_val = ta.atr(atr_len)
sl_pips = sl_mult * atr_val
tp_pips = sl_pips * tp_sl_ratio

//--- entry logic: LONG when EMA5 > EMA13 AND close > SMA(50) trend filter
long_condition = ta.crossover(ema_fast, ema_slow) and close > sma_trend

//--- exit logic: exit when EMA crosses under (trend reversal)
exit_long_condition = ta.crossunder(ema_fast, ema_slow)

//--- order management
if (long_condition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (exit_long_condition and strategy.position_size > 0)
    strategy.close("Long", comment="CrossUnder")

//--- fixed TP/SL for safety (multi-instrument safe using mintick)
if (strategy.position_size > 0 and strategy.position_size == strategy.position_size[1])
    // Update exit orders after entry bar
    strategy.exit("TP/SL", "Long", loss=sl_pips / syminfo.mintick, profit=tp_pips / syminfo.mintick)
