//@version=6
strategy(title="BB %B Only Mean Reversion XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands
bb_length = input.int(20, "BB Length", minval=5, maxval=50, step=1)        // sweep: 10-30 step 2
bb_mult   = input.float(2.0, "BB StdDev Multiplier", minval=1.0, maxval=4.0, step=0.1)  // sweep: 1.5-3.0 step 0.2

// %B entry thresholds — widened to increase trade count vs iter_553
oversold  = input.float(0.3, "%B Oversold (long entry)", minval=0.0, maxval=0.5, step=0.05)   // sweep: 0.1-0.5 step 0.05
overbought = input.float(0.7, "%B Overbought (short entry)", minval=0.5, maxval=1.0, step=0.05) // sweep: 0.5-0.9 step 0.05

//--- calculations
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
bb_pct = (close - bb_lower) / (bb_upper - bb_lower)  // %B — 0 at lower band, 1 at upper band

//--- entry logic
// Long: %B < oversold (price below lower band = undervalued)
long_condition = bb_pct < oversold

// Short: %B > overbought (price above upper band = overvalued)
short_condition = bb_pct > overbought

// Entry only when flat — no RSI filter (removed from iter_553)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

//--- exit management
// Fixed percentage-based SL/TP: 1% SL, 2% TP (same as iter_553)
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=close * 0.01 / syminfo.mintick, profit=close * 0.02 / syminfo.mintick)

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=close * 0.01 / syminfo.mintick, profit=close * 0.02 / syminfo.mintick)
