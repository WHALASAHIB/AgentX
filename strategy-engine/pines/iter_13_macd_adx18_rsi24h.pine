//@version=5
strategy(title="MACD+ADX18+RSI 24h XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
macdFast = input.int(12, "MACD Fast Length", minval=2, maxval=50)   // sweep: 8-16 step 2
macdSlow = input.int(26, "MACD Slow Length", minval=5, maxval=100)  // sweep: 20-30 step 2
macdSignal = input.int(9, "MACD Signal Smoothing", minval=2, maxval=30)  // sweep: 5-15 step 2

// ADX parameters
adxLen = input.int(14, "ADX Length", minval=5, maxval=50)     // sweep: 10-20 step 2
adxThresh = input.int(18, "ADX Threshold", minval=5, maxval=50)      // sweep: 10-25 step 3

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)     // sweep: 10-20 step 2
rsiLongMin = input.int(50, "RSI Min for Long", minval=30, maxval=70)  // sweep: 40-60 step 5
rsiShortMax = input.int(50, "RSI Max for Short", minval=30, maxval=70) // sweep: 40-60 step 5

// ATR-based TP/SL
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)     // sweep: 10-20 step 2
slMultiplier = input.float(1.0, "SL Multiplier (ATR)", minval=0.5, maxval=3.0, step=0.25)   // sweep: 0.5-2.0 step 0.25
tpRatio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.0-2.5 step 0.25

//--- indicator calculations
[macdLine, signalLine, _] = ta.macd(close, macdFast, macdSlow, macdSignal)
adxValue = ta.dmi(adxLen, adxLen)
rsiValue = ta.rsi(close, rsiLen)
atrValue = ta.atr(atrLen)

//--- entry logic
// Long: MACD crosses above signal line AND ADX > threshold AND RSI > min for long
longCondition = ta.crossover(macdLine, signalLine) and adxValue > adxThresh and rsiValue > rsiLongMin
// Short: MACD crosses below signal line AND ADX > threshold AND RSI < max for short
shortCondition = ta.crossunder(macdLine, signalLine) and adxValue > adxThresh and rsiValue < rsiShortMax

// Position management - no position reuse while in trade
if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (shortCondition and strategy.position_size == 0)
    strategy.entry("Short", strategy.short)

//--- exit management
// ATR-based stop loss and take profit levels
longStopLevel = close - (atrValue * slMultiplier)
longTargetLevel = close + (atrValue * slMultiplier * tpRatio)
shortStopLevel = close + (atrValue * slMultiplier)
shortTargetLevel = close - (atrValue * slMultiplier * tpRatio)

// Set exits for each trade direction
if (strategy.position_size > 0)
    strategy.exit("Long Exit", "Long", loss=int((close - longStopLevel) / syminfo.mintick), profit=int((longTargetLevel - close) / syminfo.mintick))

if (strategy.position_size < 0)
    strategy.exit("Short Exit", "Short", loss=int((shortStopLevel - close) / syminfo.mintick), profit=int((close - shortTargetLevel) / syminfo.mintick))
