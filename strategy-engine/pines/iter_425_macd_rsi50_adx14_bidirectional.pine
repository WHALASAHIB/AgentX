//@version=5
strategy(title="MACD RSI50 ADX14 Bidirectional XAUUSD 1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// MACD parameters
int fastLength = input.int(5, "MACD Fast Length", minval=1, maxval=50, group="MACD")       // sweep: 3-12 step 1
int slowLength = input.int(13, "MACD Slow Length", minval=1, maxval=50, group="MACD")       // sweep: 8-26 step 1
int signalLength = input.int(5, "MACD Signal Length", minval=1, maxval=30, group="MACD")    // sweep: 3-12 step 1

// RSI parameters
int rsiLength = input.int(14, "RSI Length", minval=5, maxval=30, group="RSI")               // sweep: 5-25 step 2
int rsiLongThreshold = input.int(50, "RSI Long Min (buy if RSI > this)", minval=30, maxval=70, group="RSI")  // sweep: 40-60 step 5
int rsiShortThreshold = input.int(50, "RSI Short Max (sell if RSI < this)", minval=30, maxval=70, group="RSI")  // sweep: 40-60 step 5

// ADX parameters
int adxLength = input.int(14, "ADX Length", minval=5, maxval=30, group="ADX")               // sweep: 10-25 step 2
int adxMin = input.int(14, "ADX Minimum Threshold", minval=5, maxval=40, group="ADX")       // sweep: 10-25 step 2

// TP/SL parameters
int tpPoints = input.int(100, "Take Profit (points)", minval=10, maxval=500, group="TP/SL")  // sweep: 50-200 step 10
int slPoints = input.int(150, "Stop Loss (points)", minval=10, maxval=500, group="TP/SL")    // sweep: 50-200 step 10

//--- indicator calculations

// MACD
[macdLine, signalLine, _] = ta.macd(close, fastLength, slowLength, signalLength)
bool macdBullish = ta.crossover(macdLine, signalLine)
bool macdBearish = ta.crossunder(macdLine, signalLine)

// RSI
float rsi = ta.rsi(close, rsiLength)

// ADX
float up = ta.change(high)
float down = -ta.change(low)
float tr = ta.tr
float plusDM = up > down and up > 0 ? up : 0
float minusDM = down > up and down > 0 ? down : 0
float atr = ta.sma(tr, adxLength)
float diPlus = 100 * ta.sma(plusDM, adxLength) / atr
float diMinus = 100 * ta.sma(minusDM, adxLength) / atr
float dx = 100 * math.abs(diPlus - diMinus) / (diPlus + diMinus)
float adx = ta.sma(dx, adxLength)

//--- entry logic

// Long entry: MACD bullish crossover + RSI > long threshold + ADX > minimum
bool longCondition = macdBullish and rsi > rsiLongThreshold and adx > adxMin

// Short entry: MACD bearish crossover + RSI < short threshold + ADX > minimum
bool shortCondition = macdBearish and rsi < rsiShortThreshold and adx > adxMin

//--- entry management

// Close opposite positions before entering new ones
if (longCondition)
    strategy.close("Short", comment="CloseShort")
    strategy.entry("Long", strategy.long, comment="MACD_Bull_RSI>50_ADX>14")

if (shortCondition)
    strategy.close("Long", comment="CloseLong")
    strategy.entry("Short", strategy.short, comment="MACD_Bear_RSI<50_ADX>14")

//--- exit management
// Fixed TP/SL exits using syminfo.mintick for price precision
float tpPrice = syminfo.mintick * tpPoints
float slPrice = syminfo.mintick * slPoints

if (strategy.position_size > 0)
    strategy.exit("LongExit", "Long", loss=slPrice, profit=tpPrice)

if (strategy.position_size < 0)
    strategy.exit("ShortExit", "Short", loss=slPrice, profit=tpPrice)
