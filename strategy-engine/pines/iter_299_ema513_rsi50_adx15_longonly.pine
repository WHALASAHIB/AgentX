//@version=5
strategy(title="iter_299 EMA5/13 RSI50 ADX15 Long Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFastLen = input.int(5, "EMA Fast Length", minval=1, maxval=50)
emaSlowLen = input.int(13, "EMA Slow Length", minval=1, maxval=100)

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)
rsiThreshold = input.int(50, "RSI Threshold (long above)", minval=20, maxval=80)

// ADX parameters
adxLen = input.int(14, "ADX Length", minval=2, maxval=50)
adxThreshold = input.int(15, "ADX Threshold (min trend)", minval=5, maxval=40)

// TP/SL parameters
tpRatio = input.float(2.0, "Take Profit (x ATR)", minval=0.5, maxval=5.0, step=0.5)
slRatio = input.float(1.0, "Stop Loss (x ATR)", minval=0.5, maxval=5.0, step=0.5)
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)

//--- manual ADX calculation (Wilder's method)
// True Range
hiLo = high - low
hiCl = math.abs(high - close[1])
loCl = math.abs(low - close[1])
trueRange = math.max(hiLo, math.max(hiCl, loCl))
atrVal = ta.rma(trueRange, atrLen)

// Directional Movements
upMove = high - high[1]
downMove = low[1] - low
plusDM = upMove > downMove and upMove > 0 ? upMove : 0
minusDM = downMove > upMove and downMove > 0 ? downMove : 0

// Smoothed DMs
sPlusDM = ta.rma(plusDM, adxLen)
sMinusDM = ta.rma(minusDM, adxLen)

// True Range for ADX (use rma)
trForADX = ta.rma(trueRange, adxLen)

// Directional Indicators
plusDI = 100 * sPlusDM / trForADX
minusDI = 100 * sMinusDM / trForADX

// DX and ADX
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
customADX = ta.rma(dx, adxLen)

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)

//--- entry logic
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThreshold and customADX > adxThreshold

if longCondition
    strategy.entry("Long", strategy.long)

//--- exit management
if strategy.position_size > 0
    entryPrice = strategy.position_avg_price
    slDist = slRatio * atrVal
    tpDist = tpRatio * atrVal
    strategy.exit("XL", "Long", loss=math.abs(slDist / syminfo.mintick), profit=math.abs(tpDist / syminfo.mintick))
