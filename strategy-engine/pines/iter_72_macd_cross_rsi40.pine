//@version=5
strategy(title="MACD Crossover + RSI(40) LONG-only XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(12, "MACD Fast Length")       // sweep: 8-16 step 2
slowLength = input.int(26, "MACD Slow Length")        // sweep: 20-30 step 2
signalLength = input.int(9, "MACD Signal Length")     // sweep: 7-12 step 1

// RSI filter
rsiThreshold = input.int(40, "RSI Threshold (>= this to enter)")  // sweep: 35-50 step 5
rsiLength = input.int(14, "RSI Length")                            // sweep: 10-20 step 2

// ATR-based stop management
atrLength = input.int(14, "ATR Length")                // sweep: 10-20 step 2
slMultiplier = input.float(1.5, "Stop Loss (ATR multiplier)") // sweep: 1.0-2.5 step 0.5
tpMultiplier = input.float(1.0, "Take Profit (ATR multiplier)") // sweep: 0.5-2.0 step 0.5

//--- indicators
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
rsi = ta.rsi(close, rsiLength)
atr = ta.atr(atrLength)

//--- entry logic: MACD line crosses ABOVE signal line AND RSI >= threshold
longCondition = ta.crossover(macdLine, signalLine) and (rsi >= rsiThreshold)

//--- exit logic: MACD line crosses BELOW signal line (bearish crossover)
exitCondition = ta.crossunder(macdLine, signalLine)

//--- position management
if (longCondition and strategy.position_size <= 0)
    stopPrice = close - (atr * slMultiplier)
    takeProfitPrice = close + (atr * tpMultiplier)
    strategy.entry("MACD_LONG", strategy.long)
    strategy.exit("MACD_X", "MACD_LONG", loss=math.round((atr * slMultiplier) / syminfo.mintick), profit=math.round((atr * tpMultiplier) / syminfo.mintick))

if (exitCondition and strategy.position_size > 0)
    strategy.close("MACD_LONG")
