//@version=5
strategy(title="EMA12_26 Cross + RSI50 LONG ONLY XAUUSD 30m", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
fastLen = input.int(12, "Fast EMA Length", minval=3, maxval=50)    // sweep: 5-20 step 2
slowLen = input.int(26, "Slow EMA Length", minval=5, maxval=100)   // sweep: 15-50 step 5

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)          // sweep: 7-21 step 2
rsiThresh = input.int(50, "RSI Long Threshold", minval=30, maxval=70) // sweep: 40-60 step 5

// TP/SL via ATR
atrLen = input.int(14, "ATR Length", minval=5, maxval=30)          // sweep: 10-20 step 2
slMultiplier = input.float(1.5, "SL Multiplier (xATR)", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-3.0 step 0.5
tpRatio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-3.0 step 0.5

//--- calculations
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

//--- entry conditions
buySignal = ta.crossover(fastEMA, slowEMA) and rsi > rsiThresh

//--- plot EMAs for visual reference
plot(fastEMA, "Fast EMA", color=color.blue, linewidth=1)
plot(slowEMA, "Slow EMA", color=color.red, linewidth=1)
hline(rsiThresh, "RSI Threshold", color=color.gray, linestyle=hline.style_dotted)

//--- entry logic
if (buySignal)
    strategy.entry("Long", strategy.long)

//--- exit management
if (strategy.position_size > 0)
    slDist = atr * slMultiplier
    tpDist = slDist * tpRatio
    // Convert to ticks for strategy.exit
    slTicks = int(slDist / syminfo.mintick)
    tpTicks = int(tpDist / syminfo.mintick)
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)


