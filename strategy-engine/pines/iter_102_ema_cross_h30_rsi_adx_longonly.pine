//@version=5
strategy(title="EMA Cross 5/13 + ADX(manual) + RSI Long Only — XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
emaFastLen = input.int(5, "Fast EMA Length", minval=1, maxval=50)       // sweep: 3-20 step 2
emaSlowLen = input.int(13, "Slow EMA Length", minval=5, maxval=100)      // sweep: 8-30 step 3

// ADX filter
adxLen = input.int(14, "ADX Length", minval=5, maxval=50)                // sweep: 10-20 step 2
adxThreshold = input.int(25, "ADX Minimum (trend threshold)", minval=10, maxval=50)  // sweep: 20-30 step 2

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)                // sweep: 10-20 step 2
rsiMin = input.int(50, "RSI Minimum (long only)", minval=30, maxval=70)  // sweep: 40-60 step 5

// TP/SL
tpSlRatio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
slPct = input.float(0.5, "SL % of entry price", minval=0.1, maxval=2.0, step=0.1)  // sweep: 0.3-1.0 step 0.1

// Trade session filter (London/NY overlap = 8-16 UTC)
sessionStart = input.int(8, "Session Start (UTC hour)", minval=0, maxval=23)
sessionEnd = input.int(16, "Session End (UTC hour)", minval=0, maxval=23)

//--- EMA calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

//--- RSI calculation
rsiValue = ta.rsi(close, rsiLen)

//--- Manual ADX calculation (ta.adx not supported)
trueRange = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
upMove = high - high[1]
downMove = low[1] - low
plusDM = upMove > downMove and upMove > 0 ? upMove : 0
minusDM = downMove > upMove and downMove > 0 ? downMove : 0
smoothedTR = ta.rma(trueRange, adxLen)
smoothedPlusDM = ta.rma(plusDM, adxLen)
smoothedMinusDM = ta.rma(minusDM, adxLen)
plusDI = 100 * smoothedPlusDM / smoothedTR
minusDI = 100 * smoothedMinusDM / smoothedTR
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adxValue = ta.rma(dx, adxLen)

//--- entry conditions (LONG ONLY)
inSession = (hour >= sessionStart and hour < sessionEnd)
trending = adxValue > adxThreshold
rsiOk = rsiValue > rsiMin  // RSI > 50 = bullish momentum for long entries

// Signal: EMA fast crosses ABOVE EMA slow (golden cross) with filters
longSignal = ta.crossover(emaFast, emaSlow) and inSession and trending and rsiOk

//--- entry management
if (longSignal)
    stopLossPrice = close * (1 - slPct / 100)
    takeProfitPrice = close * (1 + (slPct * tpSlRatio) / 100)
    strategy.entry("EL", strategy.long)
    strategy.exit("XL", "EL", loss=math.abs(close - stopLossPrice) / syminfo.mintick, profit=math.abs(takeProfitPrice - close) / syminfo.mintick)

//--- visual
plot(emaFast, "EMA Fast", color.blue, 1)
plot(emaSlow, "EMA Slow", color.red, 1)
hline(adxThreshold, "ADX Threshold", color.gray, hline.style_dashed)
plotshape(longSignal, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
