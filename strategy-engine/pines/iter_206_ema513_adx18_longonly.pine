//@version=5
strategy(title="EMA5_13_ADX18_LongOnly", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(5, "Fast EMA Length", minval=2, maxval=30)            // sweep: 3-10 step 1
emaSlowLen = input.int(13, "Slow EMA Length", minval=5, maxval=50)           // sweep: 8-26 step 2
adxLen = input.int(14, "ADX Length", minval=7, maxval=21)                    // sweep: 10-20 step 2
adxThreshold = input.int(18, "ADX Threshold (min)", minval=10, maxval=35)    // sweep: 14-25 step 2
tpRatio = input.float(2.0, "TP Ratio (x ATR)", minval=0.5, maxval=5.0)      // sweep: 1.0-3.0 step 0.5
slRatio = input.float(1.0, "SL Ratio (x ATR)", minval=0.3, maxval=3.0)      // sweep: 0.5-2.0 step 0.5
atrLen = input.int(14, "ATR Length", minval=7, maxval=28)                    // sweep: 10-20 step 2

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
atrVal = ta.atr(atrLen)

//--- entry logic
longEntry = false
// EMA bullish crossover AND market is trending (ADX above threshold)
if ta.crossover(emaFast, emaSlow) and adx > adxThreshold
    longEntry := true

//--- exit management
if longEntry
    strategy.entry("EL", strategy.long)
    strategy.exit("XL", "EL", loss=math.round(slRatio * atrVal / syminfo.mintick), profit=math.round(tpRatio * atrVal / syminfo.mintick))

//--- visual
plot(emaFast, "Fast EMA", color=color.blue, linewidth=1)
plot(emaSlow, "Slow EMA", color=color.red, linewidth=1)
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)
