//@version=5
strategy(title="EMA5/13 Cross RSI50 TP1:1.5", shorttitle="E5_13_R50_1.5", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len   = input.int(5, "Fast EMA", minval=2, maxval=50, tooltip="Fast EMA period")          // sweep: 3-10 step 1
ema_slow_len   = input.int(13, "Slow EMA", minval=5, maxval=50, tooltip="Slow EMA period")         // sweep: 10-30 step 2
rsi_len        = input.int(14, "RSI Period", minval=7, maxval=21, tooltip="RSI period")             // sweep: 7-21 step 2
rsi_threshold  = input.int(50, "RSI Threshold", minval=30, maxval=70, tooltip="RSI threshold")     // sweep: 40-60 step 5
tp_ratio       = input.float(1.0, "Take Profit (x ATR)", minval=0.5, maxval=5.0, step=0.5)         // sweep: 0.5-3.0 step 0.5
sl_ratio       = input.float(1.5, "Stop Loss (x ATR)", minval=0.5, maxval=5.0, step=0.5)           // sweep: 0.5-3.0 step 0.5
atr_len        = input.int(14, "ATR Period", minval=7, maxval=28, tooltip="ATR for volatility")     // sweep: 7-28 step 3

//--- indicator calculations
ema_fast     = ta.ema(close, ema_fast_len)
ema_slow     = ta.ema(close, ema_slow_len)
rsi_val      = ta.rsi(close, rsi_len)
atr_val      = ta.atr(atr_len)

//--- entry logic
long_condition  = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_threshold
short_condition = ta.crossunder(ema_fast, ema_slow) and rsi_val < rsi_threshold

//--- entry management
if long_condition
    strategy.entry("EL", strategy.long)

if short_condition
    strategy.entry("ES", strategy.short)

//--- exit management: fixed percentage stops based on ATR
// SL = sl_ratio * ATR, TP = tp_ratio * ATR (gives 1:1.5 TP/SL ratio)
long_sl_dist  = int(sl_ratio * atr_val / syminfo.mintick)
long_tp_dist  = int(tp_ratio * atr_val / syminfo.mintick)
short_sl_dist = int(sl_ratio * atr_val / syminfo.mintick)
short_tp_dist = int(tp_ratio * atr_val / syminfo.mintick)

if strategy.position_size > 0
    strategy.exit("XL", "EL", loss=long_sl_dist, profit=long_tp_dist)

if strategy.position_size < 0
    strategy.exit("XS", "ES", loss=short_sl_dist, profit=short_tp_dist)

//--- plot entries (on chart)
hline(rsi_threshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dotted)
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=1)
