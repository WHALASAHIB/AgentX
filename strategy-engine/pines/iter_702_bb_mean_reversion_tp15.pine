//@version=6
strategy(title="BB Mean Rev XAU30m TP1.5", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bbLength = input.int(20, "BB Length", minval=5, maxval=50)       // sweep: 10-30 step 5
bbStdDev = input.float(2.0, "BB StdDev", minval=1.0, maxval=4.0) // sweep: 1.5-3.0 step 0.5
tpTicks = input.int(500, "Take Profit (ticks)", minval=50)        // sweep: 300-600 step 100
slTicks = input.int(750, "Stop Loss (ticks)", minval=50)          // sweep: 500-1000 step 250
cooldownBars = input.int(3, "Cooldown bars", minval=1, maxval=10) // sweep: 1-5 step 1
useShort = input.bool(true, "Allow Shorts")

//--- Bollinger Bands
[bbMid, bbUpper, bbLower] = ta.bb(close, bbLength, bbStdDev)

//--- exit guard
var int barsSinceExit = 999
var bool inTrade = false

//--- track if we exited on this bar
barsSinceExit := barsSinceExit + 1
if (inTrade and strategy.position_size == 0)
    barsSinceExit := 0
    inTrade := false

//--- entry logic
bool longCondition = close <= bbLower and barsSinceExit >= cooldownBars and strategy.position_size == 0
bool shortCondition = close >= bbUpper and barsSinceExit >= cooldownBars and strategy.position_size == 0 and useShort

if (longCondition)
    strategy.entry("BBL", strategy.long)
    inTrade := true

if (shortCondition)
    strategy.entry("BBS", strategy.short)
    inTrade := true

//--- exit management via strategy.exit (TP/SL in ticks)
if (strategy.position_size > 0)
    strategy.exit("XL", "BBL", loss=slTicks, profit=tpTicks)

if (strategy.position_size < 0)
    strategy.exit("XS", "BBS", loss=slTicks, profit=tpTicks)

//--- trailing stop not used here
