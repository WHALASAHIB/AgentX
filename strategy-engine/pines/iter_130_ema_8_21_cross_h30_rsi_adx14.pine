//@version=5
// Strategy: EMA(8,21) Crossover + RSI(14)>50 + ADX(14)>14 LONG ONLY
// Instrument: XAUUSD 30m
// Hypothesis: Wider EMA spread (8,21 vs 5,13) should produce fewer but
// higher-quality crossover signals, improving PF and Sharpe.

//--- inputs
fast_len = input.int(8, "Fast EMA Length", minval=2, maxval=30, step=1, group="EMA")       // sweep: 5-12 step 1
slow_len = input.int(21, "Slow EMA Length", minval=10, maxval=50, step=1, group="EMA")     // sweep: 15-30 step 2
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30, step=1, group="RSI")            // sweep: 10-20 step 1
rsi_min = input.int(50, "RSI Minimum (long only if RSI > this)", minval=30, maxval=70, step=1, group="RSI") // sweep: 40-60 step 5
adx_len = input.int(14, "ADX Length", minval=5, maxval=30, step=1, group="ADX")            // sweep: 10-20 step 2
adx_min = input.int(14, "ADX Minimum (enter only if ADX > this)", minval=5, maxval=50, step=1, group="ADX") // sweep: 8-30 step 2
tp_sl_ratio = input.float(1.5, "TP/SL Ratio (profit = loss * ratio)", minval=0.5, maxval=5.0, step=0.1, group="Risk") // sweep: 1.0-3.0 step 0.5
sl_percent = input.float(0.5, "SL % of price", minval=0.1, maxval=2.0, step=0.05, group="Risk") // sweep: 0.3-1.0 step 0.1

//--- strategy definition
strategy(title="EMA(8,21) Cross + RSI(14)>50 + ADX(14)>14 LONG ONLY XAUUSD 30m", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- calculate indicators
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX calculation using ta.ema smoothing
up = ta.change(high)
down = -ta.change(low)
plus_dm = (up > down and up > 0 ? up : 0)
minus_dm = (down > up and down > 0 ? down : 0)
trur = ta.tr
atr_val = ta.ema(trur, adx_len)
plus_di = 100 * ta.ema(plus_dm, adx_len) / atr_val
minus_di = 100 * ta.ema(minus_dm, adx_len) / atr_val
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.ema(dx, adx_len)

//--- entry signals
bullish_cross = ta.crossover(fast_ema, slow_ema)

long_condition = bullish_cross and rsi_val > rsi_min and adx_val > adx_min

//--- entry logic
if long_condition
    strategy.entry("Long", strategy.long)

//--- exit management
if strategy.position_size > 0
    atr_stop = ta.atr(14)
    sl_ticks = math.floor(atr_stop / syminfo.mintick)
    tp_ticks = math.floor(sl_ticks * tp_sl_ratio)
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)

//--- visual cues
plot(fast_ema, "Fast EMA", color.blue, 1)
plot(slow_ema, "Slow EMA", color.red, 1)
hline(adx_min, "ADX Min", color.gray, hline.style_dashed)
