//@version=6
strategy(title="BB %B Long-Only XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands
bb_length = input.int(20, "BB Length", minval=5, maxval=50, step=1)        // sweep: 10-30 step 2
bb_mult   = input.float(2.0, "BB StdDev Multiplier", minval=1.0, maxval=4.0, step=0.1)  // sweep: 1.5-3.0 step 0.2

// %B entry threshold — long only
oversold  = input.float(0.3, "%B Oversold (long entry)", minval=0.0, maxval=0.5, step=0.05)   // sweep: 0.1-0.5 step 0.05

//--- calculations
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
bb_pct = (close - bb_lower) / (bb_upper - bb_lower)  // %B — 0 at lower band, 1 at upper band

//--- entry logic
// Long only: %B < oversold (price below lower band = undervalued)
// No short entries — long-only eliminates cascade-close pattern (iter_554 cascade ratio 1.57)
long_condition = bb_pct < oversold

// Entry only when flat
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

//--- exit management
// Fixed percentage-based SL/TP: 1% SL, 2% TP
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=close * 0.01 / syminfo.mintick, profit=close * 0.02 / syminfo.mintick)
