//@version=5
strategy(title="EMA3/8 Cross + RSI60 + ADX18 + 1.5TP/SL XAUUSD 1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)       // sweep: 1-10 step 1
ema_slow_len = input.int(8, "Slow EMA Length", minval=2, maxval=100)      // sweep: 5-30 step 1
rsi_len      = input.int(14, "RSI Length", minval=2, maxval=50)           // sweep: 7-21 step 2
rsi_long_th  = input.int(60, "RSI Long Threshold", minval=30, maxval=80)  // sweep: 50-70 step 5
rsi_short_th = input.int(50, "RSI Short Threshold", minval=20, maxval=70) // sweep: 30-50 step 5
adx_len      = input.int(14, "ADX Length", minval=5, maxval=30)           // sweep: 7-21 step 2
adx_th       = input.int(18, "ADX Threshold", minval=5, maxval=40)        // sweep: 15-30 step 3
tp_ratio     = input.float(1.5, "TP Ratio (×SL)", minval=0.5, maxval=5.0) // sweep: 1.0-3.0 step 0.5
sl_pct       = input.float(0.3, "SL %", minval=0.05, maxval=2.0)         // sweep: 0.1-1.0 step 0.1

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val  = ta.rsi(close, rsi_len)

//--- manual ADX calculation
up = high - high[1]
down = low[1] - low
plus_dm = up > down and up > 0 ? up : 0
minus_dm = down > up and down > 0 ? down : 0
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
smoothed_tr = ta.rma(tr, adx_len)
smoothed_plus_dm = ta.rma(plus_dm, adx_len)
smoothed_minus_dm = ta.rma(minus_dm, adx_len)
plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.rma(dx, adx_len)

//--- entry logic
long_condition  = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_long_th and adx_val > adx_th
short_condition = ta.crossunder(ema_fast, ema_slow) and rsi_val < rsi_short_th and adx_val > adx_th

//--- entry management
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

//--- exit management
sl_distance = close * sl_pct / 100
tp_distance = sl_distance * tp_ratio

if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=int(sl_distance / syminfo.mintick), profit=int(tp_distance / syminfo.mintick))

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=int(sl_distance / syminfo.mintick), profit=int(tp_distance / syminfo.mintick))

//--- plot EMA lines for visual reference
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=1)
