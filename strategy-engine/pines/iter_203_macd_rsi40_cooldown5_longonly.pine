//@version=5
strategy(title="MACD RSI40 Cooldown5 Long-Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLen = input.int(12, "MACD Fast Length", minval=5, maxval=30, group="MACD")      // sweep: 8-20 step 2
slowLen = input.int(26, "MACD Slow Length", minval=10, maxval=50, group="MACD")     // sweep: 18-34 step 4
signalLen = input.int(9, "MACD Signal Length", minval=3, maxval=20, group="MACD")   // sweep: 5-15 step 2

// RSI filter (moderate — screens out extreme oversold but not as restrictive as >50)
rsiThresh = input.int(40, "RSI Entry Threshold", minval=20, maxval=60, step=5)     // sweep: 30-50 step 5
rsiLen = input.int(14, "RSI Length", minval=7, maxval=21)                          // sweep: 7-21 step 7

// Cooldown to prevent whipsaw re-entry
coolBars = input.int(5, "Min Bars Between Trades", minval=2, maxval=20)           // sweep: 3-10 step 1

// TP/SL via ATR
atrLen = input.int(14, "ATR Length", minval=7, maxval=30)                          // sweep: 7-21 step 7
tpSlRatio = input.float(1.5, "TP/SL Ratio (ATR mult)", minval=0.5, maxval=4.0, step=0.5)  // sweep: 1.0-3.0 step 0.5

//--- indicators
[macdVal, sigVal, histVal] = ta.macd(close, fastLen, slowLen, signalLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- entry logic
// MACD histogram crossover above 0 = bullish momentum shift
macdCrossAbove = ta.crossover(histVal, 0)

// RSI filter: only enter when not deeply oversold
rsiOk = rsiVal > rsiThresh

// Track bars since last trade to enforce cooldown
var int barsSinceLast = 999
barsSinceLast := barsSinceLast + 1
if strategy.opentrades == 0 and strategy.closedtrades > 0
    barsSinceLast := 0
if strategy.opentrades > 0
    barsSinceLast := 0

coolDone = barsSinceLast >= coolBars

// No existing long position check
noPos = strategy.opentrades == 0

// Entry condition: MACD bullish crossover + RSI filter + cooldown
enterLong = macdCrossAbove and rsiOk and noPos and coolDone

if enterLong
    strategy.entry("L", strategy.long)

//--- exit management
// ATR-based TP/SL
slDist = atrVal * tpSlRatio
tpDist = atrVal * tpSlRatio * 1.0  // 1:1 TP/SL

if strategy.position_size > 0
    strategy.exit("X", "L", loss=int(slDist/syminfo.mintick), profit=int(tpDist/syminfo.mintick))

//--- visual signals
plotshape(enterLong, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)
