//@version=6
strategy(title="EMA3/8 RSI40 ManualADX28 LongOnly EMA150Filter ATRTrail BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

// iter 786: PIVOT to a DIFFERENT EXIT REGIME on the confirmed EMA3/8 stack per the iter-784/785
// plan (iter 785 re-confirmed the EMA3/8 ADX28 peak for the 4th time: 24 trades, PF 1.66,
// Sharpe 1.78, WR 70.8%, DD 2.23%, net +$273.58 -- all gates met; all four signal-family/entry
// dimensions conclusively mapped: Supertrend ENTRY-STARVED, MACD/BB/fast-EMA QUALITY-NEGATIVE):
// replace the fixed TP3000/SL4500 barrier exits with an ATR-based TRAILING STOP on
// BYBIT:BTCUSDT.P 30m -- ONE change: exit regime fixed barriers -> ATR trailing stop
// (initial stop ~1.5x ATR, trail ~1.0x ATR, long-only). Rationale: the all-time best
// iter_464_ema3_8_atr_trail.pine (PF 104.45 / Sharpe 22.28 / WR 92.4% on 264 trades) used
// EMA3/8 with an ATR trail -- the confirmed EMA3/8 signal family combined with an adaptive
// trailing exit is the one combination never tested on the current BTC 30m store. Risk:
// trailing stops cut winners early in chop but let winners run in trends; if ATR-trail
// quality degrades below the fixed-barrier peak, REVERT to the iter-785 EMA3/8 ADX28
// fixed-barrier peak (the confirmed family best) or try a new symbol/timeframe.

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // iter 786: UNCHANGED at 3 (confirmed peak). sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // iter 786: UNCHANGED at 8 (confirmed peak). sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(40, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 786: RSI UNCHANGED at 40 (proven peak). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(28, "ADX Threshold", minval=10, maxval=50)   // iter 786: ADX UNCHANGED at 28 (proven peak). sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 786: regime EMA 150 (proven long-side). sweep: 100-200 step 50
atr_len = input.int(14, "ATR Length", minval=1, maxval=100)        // iter 786: NEW exit-regime dimension. sweep: 7-21 step 2
initial_sl_mult = input.float(1.5, "Initial SL Multiplier (xATR)", minval=0.5, maxval=5.0, step=0.1)  // iter 786: initial stop 1.5x ATR. sweep: 1.0-2.5 step 0.25
trail_mult = input.float(1.0, "Trail Multiplier (xATR)", minval=0.5, maxval=5.0, step=0.1)  // iter 786: trail 1.0x ATR below highest close. sweep: 0.5-2.0 step 0.25

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)
atr_val = ta.atr(atr_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 786: PIVOT to ATR trailing exit on the confirmed
// EMA3/8 + RSI40 + ADX28 + EMA150 long-only regime stack -- the ONLY change is the exit
// regime: fixed TP3000/SL4500 barriers -> ATR trailing stop (initial 1.5x ATR, trail 1.0x
// ATR below highest close since entry). Filter stack UNCHANGED.)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- state tracking (ATR trailing stop)
var float entry_price = na
var float trail_stop = na
var float highest_close = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    entry_price := close
    highest_close := close
    trail_stop := close - initial_sl_mult * atr_val
    entry_bar := bar_index

//--- exit management (engine-compliant ATR trailing stop: ratchet trail series and call
// strategy.exit(from_entry=..., stop=trail) each bar -- mcprule: custom var-trail via
// strategy.close on low/high is FORBIDDEN; strategy.exit stop= is the sanctioned pattern,
// identical to the iter-464 all-time-best ATR trail. No TP order -> no OCO cascade risk.)
if strategy.position_size > 0
    if bar_index > entry_bar
        highest_close := math.max(highest_close, close)
        new_trail = highest_close - trail_mult * atr_val
        trail_stop := math.max(trail_stop, new_trail)
    strategy.exit("TrailExit", from_entry="Long", stop=trail_stop)
