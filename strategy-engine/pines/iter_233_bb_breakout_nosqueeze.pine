//@version=5
strategy(title="BB Breakout NoSqueeze XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_length = input.int(20, "BB Length", minval=5, maxval=100)          // sweep: 10-40 step 5
bb_mult   = input.float(2.0, "BB StdDev Mult", minval=0.5, maxval=5.0) // sweep: 1.5-3.0 step 0.5
rsi_len   = input.int(14, "RSI Length", minval=5, maxval=30)           // sweep: 7-21 step 7
rsi_th    = input.int(50, "RSI Threshold", minval=30, maxval=70)       // sweep: 40-60 step 10
atr_len   = input.int(14, "ATR Length", minval=5, maxval=30)           // sweep: 7-21 step 7
tp_sl_ratio = input.float(1.5, "TP/SL Ratio", minval=0.5, maxval=5.0)  // sweep: 1.0-3.0 step 0.5
sl_atr_mult = input.float(1.5, "SL ATR Multiplier", minval=0.5, maxval=5.0) // sweep: 0.5-3.0 step 0.5

//--- calculations
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)

//--- entry logic
long_condition  = close > bb_upper and rsi_val > rsi_th
short_condition = close < bb_lower and rsi_val < (100 - rsi_th)

if long_condition
    strategy.entry("BBLONG", strategy.long)

if short_condition
    strategy.entry("BBSHORT", strategy.short)

//--- exit management
sl_dist = sl_atr_mult * atr_val
tp_dist = sl_dist * tp_sl_ratio

if strategy.position_size > 0
    strategy.exit("BBLONG_EXIT", "BBLONG", loss=int(sl_dist / syminfo.mintick), profit=int(tp_dist / syminfo.mintick))

if strategy.position_size < 0
    strategy.exit("BBSHORT_EXIT", "BBSHORT", loss=int(sl_dist / syminfo.mintick), profit=int(tp_dist / syminfo.mintick))
