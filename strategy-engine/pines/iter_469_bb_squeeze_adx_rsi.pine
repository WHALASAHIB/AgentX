//@version=6
strategy(title="BB Squeeze ADX+RSI - BTCUSDT 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands
bb_length = input.int(20, "BB Length", minval=5, maxval=50, step=1)       // sweep: 10-30 step 5
bb_mult   = input.float(2.0, "BB Std Dev", minval=1.0, maxval=4.0, step=0.5) // sweep: 1.5-3.0 step 0.5
// ADX
adx_len   = input.int(14, "ADX Length", minval=5, maxval=30, step=1)      // sweep: 10-20 step 2
adx_thresh = input.int(25, "ADX Threshold", minval=15, maxval=35, step=5)  // sweep: 20-30 step 5
// RSI
rsi_len   = input.int(14, "RSI Length", minval=7, maxval=21, step=1)      // sweep: 7-21 step 7
rsi_long  = input.int(50, "RSI Long Min", minval=30, maxval=70, step=5)   // sweep: 40-60 step 5
rsi_short = input.int(50, "RSI Short Max", minval=30, maxval=70, step=5)  // sweep: 30-50 step 5
// ATR Trail
atr_len    = input.int(14, "ATR Length", minval=5, maxval=30, step=1)     // sweep: 10-20 step 5
atr_mult   = input.float(2.0, "ATR Trail Multiplier", minval=1.0, maxval=4.0, step=0.5) // sweep: 1.5-3.0 step 0.5
// BB Width Expansion
sma_len    = input.int(20, "BB Width SMA", minval=10, maxval=40, step=5)  // sweep: 10-30 step 5
min_width  = input.float(0.0, "Min BB Width", minval=0.0, maxval=0.001, step=0.0001)

//--- indicator calculations
// Bollinger Bands
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
bb_width   = (bb_upper - bb_lower) / bb_mid
bb_width_sma = ta.sma(bb_width, sma_len)
bb_expanding = bb_width > bb_width_sma

// ADX
[di_plus, di_minus, adx] = ta.dmi(high, low, close, adx_len)

// RSI
rsi = ta.rsi(close, rsi_len)

// ATR for trailing
atr = ta.atr(atr_len)

//--- entry logic
// Long entry: close > upper BB, BB expanding, RSI > 50, ADX > 25
long_condition = close > bb_upper and bb_expanding and rsi > rsi_long and adx > adx_thresh

// Short entry: close < lower BB, BB expanding, RSI < 50, ADX > 25
short_condition = close < bb_lower and bb_expanding and rsi < rsi_short and adx > adx_thresh

//--- ATR trailing stop management
// Use strategy.exit with ATR-based trailing stop via syminfo.mintick
// The loss parameter defines stop in ticks, profit in ticks
// For trailing stop we use a fixed ATR distance

//--- entry and exit
if long_condition
    strategy.entry("Long", strategy.long)

if short_condition
    strategy.entry("Short", strategy.short)

// Fixed ATR-based stop loss and 1:1 take profit using ticks
// For long: stop at entry - atr_mult*atr, take profit at entry + atr_mult*atr
// For short: stop at entry + atr_mult*atr, take profit at entry - atr_mult*atr
long_sl_ticks   = math.round(atr_mult * atr / syminfo.mintick)
long_tp_ticks   = math.round(atr_mult * atr / syminfo.mintick)
short_sl_ticks  = math.round(atr_mult * atr / syminfo.mintick)
short_tp_ticks  = math.round(atr_mult * atr / syminfo.mintick)

if strategy.position_size > 0
    strategy.exit("XL", "Long",  loss=long_sl_ticks, profit=long_tp_ticks)

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=short_sl_ticks, profit=short_tp_ticks)
