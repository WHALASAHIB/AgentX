//@version=6
strategy(title="Iter 611 — XAUUSD H1 EMA5 Price Above + ATR Trail", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_len = input.int(5, "EMA Length", minval=2, maxval=50, tooltip="Sweep: 3-20 step 2")
atr_mult = input.float(2.5, "ATR Multiplier", minval=0.5, maxval=5.0, step=0.5, tooltip="Sweep: 1.0-4.0 step 0.5")
atr_len = input.int(14, "ATR Length", minval=5, maxval=50, tooltip="Sweep: 7-21 step 7")

//--- indicators
ema_val = ta.ema(close, ema_len)
atr_val = ta.atr(atr_len)

//--- entry logic
long_condition = close > ema_val

if (long_condition) and (strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

//--- exit management — ATR trailing stop
if (strategy.position_size > 0)
    stop_price = close - (atr_val * atr_mult)
    strategy.exit("XL", "Long", stop=stop_price)
