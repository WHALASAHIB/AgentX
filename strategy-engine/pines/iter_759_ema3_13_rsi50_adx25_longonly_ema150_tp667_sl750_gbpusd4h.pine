//@version=6
strategy(title="EMA3/13 RSI50 ManualADX25 LongOnly EMA150Filter BarrierExit TP667 SL750 GBPUSD4h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 2-8 step 1
ema_slow_len = input.int(13, "Slow EMA", minval=1, maxval=50)       // iter 759: ema_slow 8->13 (ONLY CHANGE -- last unmapped GBPUSD entry dimension). Slowing the confirmation EMA widens the fast/slow gap (3/8 -> 3/13) -> crossovers require bigger swings -> fewer (30 -> ~20-24) but higher-quality entries; if WR holds ~60%+ at the 0.74x realized payoff, PF/Sharpe clear the bars. Risk: trade count may dip toward the 20-trade validity floor (ADX30 already showed entry starvation at 14 trades). sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(50, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 753: RSI>50 for long side (RSI50 peak; RSI45 disproven iter 758 WR 55.0% PF 0.90); sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(25, "ADX Threshold", minval=10, maxval=50)   // iter 753: ADX25 peak (ADX30 disproven iter 757 -- entry starvation, 14 trades); sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 753: regime EMA 150 (proven-best long-side from iter 745/747). sweep: 100-200 step 50
take_profit_tick = input.int(667, "Take Profit (ticks)", minval=100, maxval=20000, step=50)  // iter 753: TP667 peak of long-side TP map (TP1000 PF 0.851 < TP667 PF 0.859 > TP500 PF 0.810; GBPUSD TP map iter 749/750 peak). sweep: 500-1000 step 167
stop_loss_tick = input.int(750, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 753: SL750 peak of SL map (SL1000 PF 1.01 < SL750 PF 1.28 > SL500 PF 0.67). sweep: 500-1000 step 125

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 758: RSI 50->45 DISPROVEN -- trade relief 30->40 materialized but WR FELL 63.3->55.0% below the ~57.7% breakeven at 0.73x payoff, PF 1.28->0.90, net +$195->-$116; RSI50 gate was filtering exactly the right trades. GBPUSD 4h family map COMPLETE except the EMA pair itself (fast 3, slow 8 constant across iters 749-758). One change: ema_slow 8->13 -- iter-753 control otherwise intact (EMA3/8 + RSI50 + ADX25 + EMA150 + TP667/SL750 manual barrier exits, long-only, NO breakeven).)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
