//@version=6
strategy(title="EMA8/21 + RSI(50) + 1.5:1 TP/SL XAUUSD 30m", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true, pyramiding=0)

//--- inputs
ema_fast_len   = input.int(8, "Fast EMA", minval=3, maxval=20, step=1)       // sweep: 3-20 step 1
ema_slow_len   = input.int(21, "Slow EMA", minval=10, maxval=50, step=1)     // sweep: 10-50 step 5
rsi_len        = input.int(14, "RSI Length", minval=7, maxval=21, step=2)    // sweep: 7-21 step 2
rsi_threshold  = input.int(50, "RSI Threshold", minval=40, maxval=60, step=5) // sweep: 40-60 step 5
tp_ratio       = input.float(1.5, "TP:SL Ratio", minval=1.0, maxval=3.0, step=0.5) // sweep: 1.0-3.0 step 0.5
sl_atr_mult    = input.float(3.0, "SL: ATR Multiplier", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-5.0 step 0.5

//--- indicators
fast_ema = ta.ema(close, ema_fast_len)
slow_ema = ta.ema(close, ema_slow_len)
rsi      = ta.rsi(close, rsi_len)
atr_val  = ta.atr(14)

//--- entry signals
long_signal  = ta.crossover(fast_ema, slow_ema) and rsi > rsi_threshold
short_signal = ta.crossunder(fast_ema, slow_ema) and rsi < rsi_threshold

//--- position management flag (prevents re-entry while in position)
in_long  = strategy.position_size > 0
in_short = strategy.position_size < 0

//--- entries (pyramiding=0 prevents cascade-close; manual check for safety)
if (long_signal and not in_long and not in_short)
    sl_price = close - atr_val * sl_atr_mult
    tp_price = close + atr_val * sl_atr_mult * tp_ratio
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=sl_price, limit=tp_price)

if (short_signal and not in_long and not in_short)
    sl_price = close + atr_val * sl_atr_mult
    tp_price = close - atr_val * sl_atr_mult * tp_ratio
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=sl_price, limit=tp_price)

//--- plot EMAs for visual reference
plot(fast_ema, "Fast EMA", color=color.blue, linewidth=1)
plot(slow_ema, "Slow EMA", color=color.red, linewidth=1)
