//@version=5
strategy(title="EMA(3,8) + ADX > 25 LONG-only XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)       // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)       // sweep: 5-20 step 1
adxLen     = input.int(14, "ADX Length", minval=1, maxval=50)           // sweep: 10-20 step 2
adxThresh  = input.int(25, "ADX Threshold", minval=1, maxval=50)        // sweep: 20-30 step 5
useAdxFilter = input.bool(true, "Use ADX Trend Filter")                  // on/off

atrLen     = input.int(14, "ATR Length", minval=1, maxval=50)           // sweep: 10-20 step 2
atrMultSL  = input.float(1.0, "ATR SL Multiplier", minval=0.5, maxval=3.0, step=0.1)  // sweep: 0.5-2.0 step 0.25
tpRatio    = input.float(1.5, "TP/SL Ratio", minval=1.0, maxval=4.0, step=0.1)        // sweep: 1.0-3.0 step 0.5

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
atrVal = ta.atr(atrLen)

//--- entry logic — LONG only
longCondition = ta.crossover(emaFast, emaSlow)
trendOk = not useAdxFilter or (adx > adxThresh)

if longCondition and trendOk
    // ATR-based stop loss at atrMultSL * ATR below entry close
    stopPrice = close - (atrVal * atrMultSL)
    targetPrice = close + (atrVal * atrMultSL * tpRatio)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=math.round((close - stopPrice) / syminfo.mintick), profit=math.round((targetPrice - close) / syminfo.mintick))

//--- exit logic — crossunder closes position
shortCondition = ta.crossunder(emaFast, emaSlow)
if shortCondition
    strategy.close("Long", comment="Crossunder")
