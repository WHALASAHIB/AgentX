//@version=6
strategy(title="EMA8/21 Crossover XAUUSD 30m", overlay=true, initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         commission_type=strategy.commission.percent, commission_value=0.04,
         process_orders_on_close=true, pyramiding=0)

//--- inputs
ema_fast = input.int(8, "Fast EMA", minval=3, maxval=20, step=1)
ema_slow = input.int(21, "Slow EMA", minval=10, maxval=50, step=1)
tp_ratio = input.float(1.5, "TP:SL Ratio", minval=1.0, maxval=3.0, step=0.5)
sl_atr = input.float(1.5, "SL: ATR mult", minval=0.5, maxval=3.0, step=0.5)

//--- indicators
fast_ema = ta.ema(close, ema_fast)
slow_ema = ta.ema(close, ema_slow)
atr = ta.atr(14)

//--- entry conditions
long_signal = ta.crossover(fast_ema, slow_ema)
short_signal = ta.crossunder(fast_ema, slow_ema)

//--- entries (pyramiding=0 prevents cascade-close)
if (long_signal)
    sl_price = close - atr * sl_atr
    tp_price = close + atr * sl_atr * tp_ratio
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=sl_price, limit=tp_price)

if (short_signal)
    sl_price = close + atr * sl_atr
    tp_price = close - atr * sl_atr * tp_ratio
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", stop=sl_price, limit=tp_price)
