//@version=5
strategy(title="XAUUSD 30m EMA3/8 RSI DMI Long-Only (No Session Filter)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "EMA Fast Length", minval=1, maxval=50)       // sweep: 2-10 step 1
ema_slow_len = input.int(8, "EMA Slow Length", minval=1, maxval=50)       // sweep: 5-20 step 1
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)                // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Minimum (Long)", minval=1, maxval=99)  // sweep: 40-60 step 5
dmi_len = input.int(14, "DMI/ADX Length", minval=2, maxval=50)            // sweep: 10-30 step 2
adx_threshold = input.int(14, "ADX Minimum", minval=1, maxval=100)        // sweep: 10-30 step 2
tp_points = input.int(67, "Take Profit (points)", minval=1, maxval=500)   // sweep: 20-150 step 10
sl_points = input.int(67, "Stop Loss (points)", minval=1, maxval=500)     // sweep: 20-150 step 10

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
[di_plus, di_minus, adx_val] = ta.dmi(dmi_len, dmi_len)

// Primary crossover check
ema_cross_up = ta.crossover(ema_fast, ema_slow)
price_cross_up = ta.crossover(close, ema_slow)

//--- entry logic: long only — trading ALL hours (no session filter)
// Removing the 8-16 UTC session filter to increase trade count
long_condition = (ema_cross_up or price_cross_up) and rsi_val > rsi_threshold and adx_val > adx_threshold

//--- exit management
if (long_condition)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=sl_points * syminfo.mintick, profit=tp_points * syminfo.mintick)

//--- visual signals
plot(ema_fast, "EMA Fast", color=color.blue, linewidth=1)
plot(ema_slow, "EMA Slow", color=color.red, linewidth=1)
hline(rsi_threshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dotted)
