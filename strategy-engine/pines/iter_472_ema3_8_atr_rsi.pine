//@version=6
strategy(title="EMA3/8 ATR Trail + RSI Filter (iter 472)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast = input.int(3, "Fast EMA", minval=1, maxval=50)        // sweep: 2-10 step 1
ema_slow = input.int(8, "Slow EMA", minval=2, maxval=50)         // sweep: 5-20 step 1
atr_length = input.int(14, "ATR Length", minval=5, maxval=50)    // sweep: 7-21 step 2
atr_mult = input.float(2.0, "ATR Multiplier", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.5-3.0 step 0.2
rsi_length = input.int(14, "RSI Length", minval=5, maxval=30)    // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Entry Threshold (long >)", minval=20, maxval=80)  // sweep: 40-60 step 5
use_rsi_filter = input.bool(true, "Use RSI Filter")              // toggle RSI on/off

//--- indicator calculations
fast_ema = ta.ema(close, ema_fast)
slow_ema = ta.ema(close, ema_slow)
atr_val = ta.atr(atl_length)
rsi_val = ta.rsi(close, rsi_length)

//--- entry logic
long_condition = ta.crossover(fast_ema, slow_ema)
if use_rsi_filter
    // RSI filter: only enter long when RSI > threshold (ensures bullish momentum)
    long_condition := long_condition and (rsi_val > rsi_threshold)

//--- exit management
var float trail_stop = na
var int trade_bar_index = na

if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    trail_stop := close - (atr_val * atr_mult)
    trade_bar_index := bar_index

// Update trailing stop on each bar while in a long position
if strategy.position_size > 0
    // Trail the stop up if price moves higher, never lower
    new_stop = close - (atr_val * atr_mult)
    if new_stop > trail_stop
        trail_stop := new_stop
    strategy.exit("XL", "Long", stop=trail_stop)

// Reset when flat
if strategy.position_size == 0
    trail_stop := na
    trade_bar_index := na
