//@version=6
strategy(title="EMA3/8 BTC H1 RSI50 Trend TP=SL MinHold5", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods (sweep: fast 2-5 step 1, slow 6-15 step 2)
emaFast = input.int(3, "EMA Fast Period")
emaSlow = input.int(8, "EMA Slow Period")
// RSI (sweep: 10-25 step 5)
rsiLen = input.int(14, "RSI Length")
rsiLongThresh = input.int(50, "RSI Long Threshold (above)")
rsiShortThresh = input.int(50, "RSI Short Threshold (below)")
// EMA50 trend filter
emaTrendLen = input.int(50, "EMA Trend Length")
// ATR for TP/SL (sweep: 7-21 step 2)
atrLen = input.int(14, "ATR Length")
slMultiplier = input.float(1.5, "SL Multiplier (ATR)")   // sweep: 1.0-2.5 step 0.25
tpMultiplier = input.float(1.5, "TP Multiplier (ATR)")  // 1:1 ratio — tightened from 1.5:1 to try improving WR
// Minimum hold bars before exit by TP/SL
minHoldBars = input.int(5, "Minimum Hold Bars")          // sweep: 3-8 step 1

//--- indicators
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
emaTrend = ta.ema(close, emaTrendLen)

//--- entry conditions
longSignal = ta.crossover(emaF, emaS) and rsi > rsiLongThresh and close > emaTrend
shortSignal = ta.crossunder(emaF, emaS) and rsi < rsiShortThresh and close < emaTrend

//--- entry management
if longSignal
    strategy.entry("Long", strategy.long)

if shortSignal
    strategy.entry("Short", strategy.short)

//--- exit management: equal TP/SL at 1.5x ATR, with min hold check
if strategy.position_size > 0 and strategy.barssinceentry >= minHoldBars
    strategy.exit("XL", "Long", loss=int(slMultiplier * atr / syminfo.mintick), profit=int(tpMultiplier * atr / syminfo.mintick))

if strategy.position_size < 0 and strategy.barssinceentry >= minHoldBars
    strategy.exit("XS", "Short", loss=int(slMultiplier * atr / syminfo.mintick), profit=int(tpMultiplier * atr / syminfo.mintick))
