//@version=6
strategy(title="iter_643 — minimal_test", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04)

// Minimal: enter on every bar, no fancy options
longCondition = bar_index > 10
if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (strategy.position_size > 0 and bar_index % 5 == 0)
    strategy.close("Long")
