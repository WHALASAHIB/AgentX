//@version=5
strategy(title="EMA3/8 Long Only ADX14 RSI40", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)       // sweep: 1-10 step 1
ema_slow_len = input.int(8, "Slow EMA Length", minval=1, maxval=100)      // sweep: 5-20 step 1
adx_len = input.int(14, "ADX Length", minval=1, maxval=50)                // sweep: 10-20 step 1
adx_threshold = input.int(14, "ADX Threshold", minval=1, maxval=50)       // sweep: 10-25 step 1
rsi_len = input.int(14, "RSI Length", minval=1, maxval=50)                // sweep: 7-21 step 2
rsi_threshold = input.int(40, "RSI Entry Threshold (above)", minval=1, maxval=100) // sweep: 30-50 step 5
tp_ticks = input.int(125, "Take Profit (ticks)", minval=10, maxval=500)   // sweep: 50-200 step 25
sl_ticks = input.int(125, "Stop Loss (ticks)", minval=10, maxval=500)     // sweep: 50-200 step 25

//--- indicators
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
adx_val = ta.adx(high, low, close, adx_len)
rsi_val = ta.rsi(close, rsi_len)

//--- crossover / crossunder detection
cross_over = ta.crossover(ema_fast, ema_slow)
cross_under = ta.crossunder(ema_fast, ema_slow)

//--- entry logic
// Long entry: EMA3 crosses above EMA8 AND ADX > 14 (trending) AND RSI > 40 (not oversold)
long_entry = cross_over and adx_val > adx_threshold and rsi_val > rsi_threshold

// Exit long condition: EMA3 crosses below EMA8 (trend reversal) — handled by strategy.exit with TP/SL
// No separate close-on-reversal to avoid cascade-close

//--- execution
if long_entry
    strategy.entry("Long", strategy.long)

//--- exit management
// Each entry gets a TP/SL exit order; new signals are allowed to reverse the position
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)
