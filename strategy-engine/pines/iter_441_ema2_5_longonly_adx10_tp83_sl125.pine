//@version=5
strategy(title="EMA2/5 Crossover Long-Only ADX10 TP83/SL125", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Fast EMA period
fastLen = input.int(2, "Fast EMA Length", minval=1, maxval=50)  // sweep: 1-10 step 1
// Slow EMA period
slowLen = input.int(5, "Slow EMA Length", minval=1, maxval=50)  // sweep: 3-21 step 2
// ADX smoothing
adxLen = input.int(14, "ADX Length", minval=5, maxval=30)  // sweep: 5-30 step 1
// ADX threshold
adxThresh = input.int(10, "ADX Minimum Threshold", minval=1, maxval=50)  // sweep: 5-25 step 5
// Take profit in ticks
tpTicks = input.int(83, "Take Profit (ticks)", minval=10, maxval=500)  // sweep: 30-200 step 10
// Stop loss in ticks
slTicks = input.int(125, "Stop Loss (ticks)", minval=10, maxval=500)  // sweep: 50-300 step 10

//--- indicator calculations
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)

// ADX
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

// Crossover detection
bullishCross = ta.crossover(emaFast, emaSlow)

//--- entry logic
var float entryPrice = na
var int barsSinceEntry = 0

// Track bars since entry
if strategy.position_size != 0
    barsSinceEntry := barsSinceEntry + 1
else
    barsSinceEntry := 0

// Entry: bullish EMA crossover + ADX > threshold (trending), long only
if bullishCross and adx > adxThresh and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    entryPrice := close

//--- exit management
// Exit via fixed TP/SL in ticks using syminfo.mintick
if strategy.position_size > 0
    strategy.exit("TP/SL", "Long", loss=slTicks, profit=tpTicks)
