//@version=6
strategy(title="EMA3/8 Cross BTC 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=20)     // sweep: 2-5 step 1
ema_slow_len = input.int(8, "Slow EMA Length", minval=3, maxval=30)     // sweep: 6-12 step 2
tp_ticks = input.int(200, "Take Profit (ticks)", minval=50, maxval=500) // sweep: 100-300 step 50
sl_ticks = input.int(100, "Stop Loss (ticks)", minval=20, maxval=300)   // sweep: 50-200 step 25

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

//--- entry logic
long_condition = ta.crossover(ema_fast, ema_slow)

//--- exit management
if (long_condition)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=sl_ticks * syminfo.mintick, profit=tp_ticks * syminfo.mintick)

//--- plot
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=1)
