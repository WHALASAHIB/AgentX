//@version=5
strategy(title="iter_365_ema3_8_h1_rsi_timefilter_longonly", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen  = input.int(3,  "EMA Fast Length",  minval=1,  maxval=50)    // sweep: 2-10 step 1
emaSlowLen  = input.int(8,  "EMA Slow Length",  minval=5,  maxval=100)   // sweep: 5-21 step 1
rsiLen      = input.int(14, "RSI Length",       minval=2,  maxval=50)    // sweep: 7-21 step 1
rsiMin      = input.int(50, "RSI Min (long)",   minval=20, maxval=80)    // sweep: 30-60 step 5
tpPoints    = input.int(67,  "Take Profit (points)", minval=10, maxval=500, step=1)  // sweep: 30-200 step 10
slPoints    = input.int(100, "Stop Loss (points)",   minval=10, maxval=500, step=1)  // sweep: 30-200 step 10
useTimeFilter = input.bool(true, "Use Time Filter (8-16 UTC)")

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)

//--- entry logic
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiMin

//--- time filter (8-16 UTC = London/NY overlap)
inSession = not useTimeFilter or (hour >= 8 and hour < 16)

//--- exit management
if (longCondition and inSession and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=slPoints * syminfo.mintick, profit=tpPoints * syminfo.mintick)
