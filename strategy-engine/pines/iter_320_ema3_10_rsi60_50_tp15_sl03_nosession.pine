//@version=5
strategy(title="EMA3_10_RSI_Filter_NoSession_XAUUSD_H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
ema_fast = input.int(3, "Fast EMA", minval=2, maxval=50)            // sweep: 2-20 step 1
ema_slow = input.int(10, "Slow EMA", minval=5, maxval=100)           // sweep: 8-30 step 2

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)           // sweep: 5-25 step 5
rsi_long_threshold = input.int(60, "RSI Long Entry Threshold (above)", minval=30, maxval=80)  // sweep: 50-70 step 5
rsi_short_threshold = input.int(50, "RSI Short Entry Threshold (below)", minval=20, maxval=70) // sweep: 30-60 step 5

// TP/SL parameters
tp_ratio = input.float(1.5, "Take Profit Ratio (TP/SL)", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.0-3.0 step 0.5
sl_pct = input.float(0.3, "Stop Loss (%)", minval=0.1, maxval=2.0, step=0.05)               // sweep: 0.1-1.0 step 0.1

//--- indicator calculations
fast_ema = ta.ema(close, ema_fast)
slow_ema = ta.ema(close, ema_slow)
rsi_val = ta.rsi(close, rsi_len)

//--- entry logic
// Long: fast EMA crosses above slow EMA AND RSI > threshold
long_condition = ta.crossover(fast_ema, slow_ema) and rsi_val > rsi_long_threshold

// Short: fast EMA crosses below slow EMA AND RSI < threshold
short_condition = ta.crossunder(fast_ema, slow_ema) and rsi_val < rsi_short_threshold

//--- exit management
// Calculate SL distance in ticks based on entry price
sl_ticks = math.round((close * sl_pct / 100.0) / syminfo.mintick)
tp_ticks = math.round(sl_ticks * tp_ratio)

// Entry and exit
if long_condition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=sl_ticks, profit=tp_ticks)

if short_condition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=sl_ticks, profit=tp_ticks)

//--- plot EMAs for visual reference
plot(fast_ema, "Fast EMA", color=color.blue, linewidth=1)
plot(slow_ema, "Slow EMA", color=color.red, linewidth=1)
hline(rsi_long_threshold, "RSI Long Threshold", color=color.green, linestyle=hline.style_dashed)
hline(rsi_short_threshold, "RSI Short Threshold", color=color.maroon, linestyle=hline.style_dashed)
