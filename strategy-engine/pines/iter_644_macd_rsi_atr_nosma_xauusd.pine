//@version=6
strategy(title="iter_644 MACD RSI ATR XAUUSD H1 NoSMA", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLen = input.int(12, "MACD Fast Length", minval=2, maxval=50)         // sweep: 8-20 step 2
slowLen = input.int(26, "MACD Slow Length", minval=5, maxval=100)        // sweep: 18-34 step 2
sigLen  = input.int(9, "MACD Signal Length", minval=2, maxval=30)        // sweep: 5-15 step 2

// RSI filter
rsiLen  = input.int(14, "RSI Length", minval=2, maxval=50)              // sweep: 7-21 step 2
rsiMin  = input.int(50, "RSI Minimum (Long)", minval=20, maxval=80)     // sweep: 40-60 step 5

// ATR-based TP/SL
atrLen  = input.int(14, "ATR Length", minval=5, maxval=50)              // sweep: 10-20 step 2
tpMult  = input.float(2.0, "TP Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
slMult  = input.float(1.0, "SL Multiplier (×ATR)", minval=0.3, maxval=3.0, step=0.1)  // sweep: 0.5-2.0 step 0.25

//--- indicator calculations
[macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, sigLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- entry logic
longCondition = ta.crossover(macdLine, signalLine) and rsiVal > rsiMin

if longCondition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

//--- exit management
if strategy.position_size > 0
    entryPrice = strategy.position_avg_price
    stopPrice  = entryPrice - slMult * atrVal
    takeProfit = entryPrice + tpMult * atrVal
    strategy.exit("XL", "Long", stop=stopPrice, limit=takeProfit)

//--- plot (visual reference)
hline(0, "Zero Line", color=color.gray)
plot(macdLine, "MACD", color=color.blue)
plot(signalLine, "Signal", color=color.orange)
