//@version=5
strategy(title="EMA3/8 Cross + RSI + ADX XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// EMA parameters
ema_fast_len = input.int(3, "EMA Fast Length", minval=1, maxval=50)          // sweep: 2-10 step 1
ema_slow_len = input.int(8, "EMA Slow Length", minval=1, maxval=100)          // sweep: 5-20 step 1

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)                    // sweep: 7-21 step 2
rsi_long_min = input.int(50, "RSI Long Threshold (min)", minval=1, maxval=99) // sweep: 40-60 step 5
rsi_short_max = input.int(50, "RSI Short Threshold (max)", minval=1, maxval=99) // sweep: 40-60 step 5

// ADX parameters
adx_len_input = input.int(14, "ADX Length", minval=5, maxval=30)              // sweep: 10-20 step 2
adx_threshold = input.int(25, "ADX Threshold (min for trend)", minval=10, maxval=50) // sweep: 20-30 step 3

// TP/SL parameters
tp_ratio = input.float(1.5, "Take Profit Ratio (×SL)", minval=0.5, maxval=5.0) // sweep: 1.0-3.0 step 0.5
sl_pct = input.float(0.3, "Stop Loss %", minval=0.05, maxval=2.0)             // sweep: 0.15-0.5 step 0.05

//--- indicators

// EMAs
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

// RSI
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX calculation
// True Range
tr_val = ta.tr(true)
atr_val = ta.sma(tr_val, adx_len_input)

// Directional Movement
up = high - high[1]
down = low[1] - low

plus_dm = up > down and up > 0 ? up : 0
minus_dm = down > up and down > 0 ? down : 0

// Smoothed DM
s_plus_dm = ta.sma(plus_dm, adx_len_input)
s_minus_dm = ta.sma(minus_dm, adx_len_input)

// DMI
plus_di = 100 * nz(s_plus_dm / atr_val, 0)
minus_di = 100 * nz(s_minus_dm / atr_val, 0)

// ADX
di_sum = plus_di + minus_di
dx_val = di_sum > 0 ? 100 * math.abs(plus_di - minus_di) / di_sum : 0
adx_val = ta.sma(dx_val, adx_len_input)

//--- entry logic

cross_above = ta.crossover(ema_fast, ema_slow)
cross_below = ta.crossunder(ema_fast, ema_slow)

rsi_allows_long = rsi_val > rsi_long_min
rsi_allows_short = rsi_val < rsi_short_max

adx_trending = adx_val > adx_threshold

long_condition = cross_above and rsi_allows_long and adx_trending
short_condition = cross_below and rsi_allows_short and adx_trending

//--- entry management
if (long_condition)
    strategy.entry("Long", strategy.long)

if (short_condition)
    strategy.entry("Short", strategy.short)

//--- exit management
sl_ticks = int(sl_pct / 100 * close / syminfo.mintick)
tp_ticks = int(sl_ticks * tp_ratio)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", loss=sl_ticks, profit=tp_ticks)
