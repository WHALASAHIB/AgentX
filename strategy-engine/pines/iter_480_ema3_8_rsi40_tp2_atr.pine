//@version=6
strategy(title="iter_480_ema3_8_rsi40_tp2_atr", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50)       // sweep: 2-8 step 1
slowLen = input.int(8, "Slow EMA Length", minval=5, maxval=50)       // sweep: 5-21 step 1
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)            // sweep: 7-21 step 2
rsiThreshold = input.int(40, "RSI Threshold (long above)", minval=20, maxval=60) // sweep: 30-50 step 5
atrLen = input.int(14, "ATR Length", minval=5, maxval=30)            // sweep: 10-20 step 2
tpMultiplier = input.float(2.0, "TP = ATR ×", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
slMultiplier = input.float(1.0, "SL = ATR ×", minval=0.5, maxval=5.0, step=0.5)  // sweep: 0.5-2.0 step 0.5

//--- indicator calculations
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

//--- entry logic: EMA3/8 crossover + RSI(14) > 40 filter (long only)
longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiThreshold

//--- exit management: fixed TP/SL based on ATR, set at entry
if longCondition and strategy.position_size == 0
    stopLoss = close - (atr * slMultiplier)
    takeProfit = close + (atr * tpMultiplier)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=close - stopLoss, profit=takeProfit - close)
