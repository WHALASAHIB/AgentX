//@version=6
strategy(title="iter_581_ema2_5_rsi50", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//==============================================================================
//--- inputs
//==============================================================================

// EMA parameters
fastLen = input.int(2, "Fast EMA Length", minval=1, maxval=20)   // sweep: 1-10 step 1
slowLen = input.int(5, "Slow EMA Length", minval=2, maxval=50)   // sweep: 3-20 step 2

// RSI filter
rsiLen  = input.int(14, "RSI Length", minval=2, maxval=30)       // sweep: 7-21 step 2
rsiMin  = input.int(50, "RSI Minimum (Long)", minval=20, maxval=80) // sweep: 30-70 step 5

// TP/SL — fixed ratio, 1:1
tpRatio = input.float(1.0, "Take Profit (ratio of SL)", minval=0.5, maxval=5.0) // sweep: 0.5-3.0 step 0.5
slPct   = input.float(0.3, "Stop Loss (% of price)", minval=0.1, maxval=2.0)   // sweep: 0.1-1.0 step 0.1

//==============================================================================
//--- calculations
//==============================================================================

// EMAs
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)

// RSI
rsiVal = ta.rsi(close, rsiLen)

// Crossover logic
longEntry = ta.crossover(emaFast, emaSlow) and rsiVal > rsiMin

// Exit signal: crossunder
longExit  = ta.crossunder(emaFast, emaSlow)

//==============================================================================
//--- entry logic
//==============================================================================
if longEntry
    strategy.entry("Long", strategy.long)

//==============================================================================
//--- exit management — fixed-ratio TP/SL based on percentage of entry price
//==============================================================================
if strategy.position_size > 0
    entryPrice = strategy.position_avg_price
    slPrice = entryPrice * (1 - slPct / 100)
    tpPrice = entryPrice * (1 + slPct * tpRatio / 100)
    strategy.exit("XL", "Long", loss=slPrice, profit=tpPrice, comment="TP/SL")
