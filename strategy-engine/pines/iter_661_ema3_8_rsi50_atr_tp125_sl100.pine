//@version=6
strategy(title="iter_661_ema3_8_rsi50_atr_tp125_sl100", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
emaFastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50)      // sweep: 2-10 step 1
emaSlowLen = input.int(8, "Slow EMA Length", minval=1, maxval=50)      // sweep: 5-21 step 1

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)              // sweep: 7-21 step 1
rsiThreshold = input.int(50, "RSI Threshold (long > this)", minval=20, maxval=80) // sweep: 30-60 step 5

// ATR-based TP/SL
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)              // sweep: 7-21 step 1
tpMultiplier = input.float(1.25, "TP Multiplier (xATR)", minval=0.5, maxval=5.0, step=0.25) // sweep: 0.5-3.0 step 0.25
slMultiplier = input.float(1.0, "SL Multiplier (xATR)", minval=0.5, maxval=5.0, step=0.25)  // sweep: 0.5-3.0 step 0.25

// Position management
useLong = input.bool(true, "Enable Long Entries")                      // toggle

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- entry logic
// Long condition: EMA fast crosses above EMA slow AND RSI > threshold
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThreshold

// Exit condition: EMA fast crosses below EMA slow (trend reversal)
exitLongCondition = ta.crossunder(emaFast, emaSlow)

//--- entry/exit
if useLong and longCondition
    stopLossPts = slMultiplier * atrVal / syminfo.mintick
    takeProfitPts = tpMultiplier * atrVal / syminfo.mintick
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=math.round(stopLossPts), profit=math.round(takeProfitPts))
