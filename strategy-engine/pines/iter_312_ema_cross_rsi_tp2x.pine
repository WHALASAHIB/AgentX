//@version=5
strategy(title="EMA5/13 Cross + RSI(50) + 2:1 TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(5, "Fast EMA Length", minval=2, maxval=50)      // sweep: 3-10 step 1
emaSlowLen = input.int(13, "Slow EMA Length", minval=5, maxval=100)    // sweep: 10-26 step 2
rsiLen     = input.int(14, "RSI Length", minval=2, maxval=50)          // sweep: 7-21 step 2
rsiThresh  = input.int(50, "RSI Threshold", minval=20, maxval=80)      // sweep: 40-60 step 5
slPct      = input.float(0.3, "SL % of Close", minval=0.05, maxval=2.0, step=0.05)  // sweep: 0.1-1.0 step 0.1
tpRatio    = input.float(2.0, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.5)      // sweep: 1.0-3.0 step 0.5

//--- calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)

//--- crossover conditions
bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

//--- filter: RSI direction confirmation
rsiBull = rsiVal > rsiThresh
rsiBear = rsiVal < rsiThresh

//--- entry signals
enterLong  = bullCross and rsiBull
enterShort = bearCross and rsiBear

//--- exit management
slDist   = (close * slPct / 100.0) / syminfo.mintick
tpDist   = slDist * tpRatio

//--- entries
if enterLong
    strategy.entry("Long", strategy.long)
    strategy.exit("XLong", "Long", loss=slDist, profit=tpDist)

if enterShort
    strategy.entry("Short", strategy.short)
    strategy.exit("XShort", "Short", loss=slDist, profit=tpDist)
