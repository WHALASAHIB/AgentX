//@version=6
strategy(title="EMA3_8_ATR15_Trail — BTCUSDT 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)
ema_slow_len = input.int(8, "Slow EMA Length", minval=1, maxval=50)
atr_len      = input.int(14, "ATR Length", minval=5, maxval=50)
trail_mult   = input.float(1.5, "ATR Trail Multiplier", minval=0.5, maxval=5.0, step=0.1)
initial_sl_mult = input.float(1.5, "Initial SL (×ATR)", minval=0.5, maxval=5.0, step=0.1)

//--- core indicators
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
atr_val  = ta.atr(atr_len)

//--- entry logic
long_condition = ta.crossover(ema_fast, ema_slow)

//--- exit: ATR trailing stop
var float trail_stop = na
var int bar_entry = 0

if long_condition
    strategy.entry("Long", strategy.long)
    trail_stop := close - initial_sl_mult * atr_val
    bar_entry := bar_index

// Trail the stop
if strategy.position_size > 0
    new_stop = close - trail_mult * atr_val
    if new_stop > trail_stop
        trail_stop := new_stop
    strategy.exit("XL", "Long", stop=trail_stop)

//--- plot indicators
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=2)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=2)
plot(strategy.position_size > 0 ? trail_stop : na, "Trail Stop", color=color.green, style=plot.style_linebr)
