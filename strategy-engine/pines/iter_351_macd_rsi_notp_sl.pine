//@version=5
strategy(title="MACD+RSI XAUUSD H1 (Iter 351)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// MACD parameters
macdFast = input.int(12, "MACD Fast Length", minval=2, maxval=50)       // sweep: 8-20 step 2
macdSlow = input.int(26, "MACD Slow Length", minval=5, maxval=100)      // sweep: 20-40 step 5
macdSignal = input.int(9, "MACD Signal Length", minval=2, maxval=30)    // sweep: 5-15 step 2

// RSI filter
rsiLength = input.int(14, "RSI Length", minval=2, maxval=50)            // sweep: 7-21 step 2
rsiOversold = input.int(50, "RSI Long Threshold (above)", minval=20, maxval=80)  // sweep: 45-55 step 5
rsiOverbought = input.int(50, "RSI Short Threshold (below)", minval=20, maxval=80) // sweep: 45-55 step 5

// Risk management
slPct = input.float(0.3, "Stop Loss %", minval=0.1, maxval=5.0, step=0.1)        // sweep: 0.2-0.5 step 0.1
tpRatio = input.float(1.5, "TP : SL Ratio", minval=0.5, maxval=5.0, step=0.5)    // sweep: 1.0-3.0 step 0.5

//--- indicator calculations
[macdLine, signalLine, _hist] = ta.macd(close, macdFast, macdSlow, macdSignal)
rsi = ta.rsi(close, rsiLength)

//--- entry logic
longCondition = ta.crossover(macdLine, signalLine) and rsi > rsiOversold
shortCondition = ta.crossunder(macdLine, signalLine) and rsi < rsiOverbought

//--- exit management
// Calculate SL and TP distances in ticks
slTicks = (close * slPct / 100) / syminfo.mintick
tpTicks = slTicks * tpRatio

// Enter trades
if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

// Manage exits — set SL/TP on each position
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=slTicks, profit=tpTicks)
