//@version=5
strategy(title="MACD RSI Tight TP H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLength = input.int(8, "MACD Fast Length", minval=3, maxval=30)       // sweep: 5-12 step 1
slowLength = input.int(17, "MACD Slow Length", minval=8, maxval=40)      // sweep: 13-25 step 2
signalLength = input.int(7, "MACD Signal Length", minval=3, maxval=15)   // sweep: 5-11 step 1
rsiLength = input.int(14, "RSI Length", minval=7, maxval=21)             // sweep: 7-21 step 2
rsiThreshold = input.int(40, "RSI Lower Threshold", minval=20, maxval=60) // sweep: 30-50 step 5
atrLength = input.int(14, "ATR Length", minval=7, maxval=28)             // sweep: 7-21 step 2
tpFactor = input.float(1.5, "TP Factor (x ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
slFactor = input.float(1.0, "SL Factor (x ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 0.5-2.0 step 0.5

//--- calculations
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

//--- entry logic
// LONG: MACD line crosses above signal line AND RSI > threshold
longCondition = ta.crossover(macdLine, signalLine) and rsiValue > rsiThreshold

//--- exit management
// SL = slFactor * ATR below entry price
// TP = tpFactor * ATR above entry price (1.5:1 ratio)
slDistance = slFactor * atrValue
tpDistance = tpFactor * atrValue

if (longCondition)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=slDistance / syminfo.mintick, profit=tpDistance / syminfo.mintick)
