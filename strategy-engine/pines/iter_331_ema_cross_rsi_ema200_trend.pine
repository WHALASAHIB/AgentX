//@version=5
strategy(title="EMA3_8 Cross + RSI50 + EMA200 Trend Filter", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA fast period
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)         // sweep: 2-10 step 1
// EMA slow period
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)         // sweep: 5-21 step 2
// RSI period
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)                 // sweep: 7-21 step 2
// RSI long threshold
rsiLongThresh = input.int(50, "RSI Long Threshold", minval=1, maxval=100) // sweep: 40-60 step 5
// RSI short threshold
rsiShortThresh = input.int(50, "RSI Short Threshold", minval=1, maxval=100) // sweep: 40-60 step 5
// EMA200 period
ema200Len = input.int(200, "EMA Trend Filter Period", minval=50, maxval=300) // sweep: 100-300 step 25
// TP ratio (take profit as multiple of SL)
tpRatio = input.float(1.5, "TP Ratio (TP = SL * N)", minval=0.5, maxval=5.0, step=0.1) // sweep: 1.0-3.0 step 0.5
// SL percentage
slPercent = input.float(0.003, "Stop Loss (%)", minval=0.001, maxval=0.02, step=0.0005) // sweep: 0.001-0.01 step 0.001
// Trade session filter
tradeStart = input.int(8, "Trade Start Hour (UTC)", minval=0, maxval=23)  // sweep: 0-23 step 1
tradeEnd = input.int(16, "Trade End Hour (UTC)", minval=0, maxval=23)     // sweep: 0-23 step 1

//--- calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)
ema200 = ta.ema(close, ema200Len)

// Crossover / Crossunder signals
bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

// Trend filter — only long above EMA200, only short below EMA200
longTrendOk = close > ema200
shortTrendOk = close < ema200

// RSI filter
rsiLongOk = rsiVal > rsiLongThresh
rsiShortOk = rsiVal < rsiShortThresh

// Session filter
currentHour = hour(time)
sessionOk = currentHour >= tradeStart and currentHour < tradeEnd

//--- entry logic
// Long entry: EMA crossover above EMA200 + RSI > threshold + session ok
longCondition = bullCross and longTrendOk and rsiLongOk and sessionOk
// Short entry: EMA crossunder below EMA200 + RSI < threshold + session ok
shortCondition = bearCross and shortTrendOk and rsiShortOk and sessionOk

// No cascade close — only enter, not close on bar
if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

//--- exit management
// Compute SL/TP in ticks based on close price percentage
slTicks = (close * slPercent) / syminfo.mintick
tpTicks = slTicks * tpRatio

// Apply exits to all open positions
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=math.round(slTicks), profit=math.round(tpTicks))

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", loss=math.round(slTicks), profit=math.round(tpTicks))

//--- plots for visual reference
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)
plot(ema200, "EMA 200", color=color.purple, linewidth=1)
hline(rsiLongThresh, "RSI Long Thresh", color=color.green, linestyle=hline.style_dotted)
hline(rsiShortThresh, "RSI Short Thresh", color=color.red, linestyle=hline.style_dotted)
