//@version=5
strategy(title="EMA2/5 + RSI(50/50) + 1:1 TP/SL XAUUSD 1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(2, "Fast EMA Length", minval=1, maxval=50)     // sweep: 1-10 step 1
ema_slow_len = input.int(5, "Slow EMA Length", minval=1, maxval=50)     // sweep: 3-20 step 1
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)              // sweep: 7-21 step 2
rsi_ob = input.int(70, "RSI Overbought", minval=50, maxval=90)         // sweep: 60-80 step 5
rsi_os = input.int(30, "RSI Oversold", minval=10, maxval=50)           // sweep: 20-40 step 5

tp_ratio = input.float(1.0, "Take Profit (x SL)", minval=0.5, maxval=5.0)  // sweep: 0.5-3.0 step 0.5
sl_pct = input.float(0.3, "Stop Loss %", minval=0.1, maxval=2.0)          // sweep: 0.1-1.0 step 0.1

rsi_bull_threshold = input.int(50, "RSI Bullish Threshold (long if RSI > N)", minval=20, maxval=80)  // sweep: 30-60 step 5
rsi_bear_threshold = input.int(50, "RSI Bearish Threshold (short if RSI < N)", minval=20, maxval=80) // sweep: 30-60 step 5

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

//--- entry logic
long_condition = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_bull_threshold
short_condition = ta.crossunder(ema_fast, ema_slow) and rsi_val < rsi_bear_threshold

//--- entries
if long_condition
    strategy.entry("Long", strategy.long)

if short_condition
    strategy.entry("Short", strategy.short)

//--- exit management
sl_ticks = math.round(sl_pct / 100.0 * close / syminfo.mintick)
tp_ticks = math.round(sl_ticks * tp_ratio)

if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=sl_ticks, profit=tp_ticks)

//--- plot EMAs
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=1)
