//@version=5
strategy(title="MACD(8,17,7)+DMI-ADX(25) LONG-only XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(8, "MACD Fast Length", minval=2, maxval=50)     // sweep: 6-12 step 2
slowLength = input.int(17, "MACD Slow Length", minval=5, maxval=100)   // sweep: 12-26 step 5
signalLength = input.int(7, "MACD Signal Length", minval=2, maxval=30) // sweep: 5-15 step 2

// DMI-ADX parameters
diLength = input.int(14, "DI Length", minval=7, maxval=28)             // sweep: 7-21 step 7
adxThreshold = input.int(25, "ADX Threshold", minval=15, maxval=40)    // sweep: 20-30 step 5

// ATR exit parameters
atrLength = input.int(14, "ATR Length", minval=7, maxval=28)           // sweep: 7-21 step 7
slMultiplier = input.float(1.0, "SL Multiplier (ATR)", minval=0.5, maxval=3.0, step=0.25)  // sweep: 0.5-2.0 step 0.25
tpMultiplier = input.float(2.0, "TP Multiplier (ATR)", minval=0.5, maxval=5.0, step=0.25)  // sweep: 1.0-3.0 step 0.5

//--- indicator calculations
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
[diPlus, diMinus, adxValue] = ta.dmi(diLength, diLength)
atrValue = ta.atr(atrLength)

//--- entry logic
// LONG entry: MACD crossover AND ADX > threshold (trending market)
longCondition = ta.crossover(macdLine, signalLine) and adxValue > adxThreshold

if (longCondition)
    strategy.entry("MACD_LONG", strategy.long)

//--- exit management
// ATR-based fixed SL and TP on each bar where position is open
if (strategy.position_size > 0)
    stopLevel = close - (atrValue * slMultiplier)
    profitLevel = close + (atrValue * tpMultiplier)
    strategy.exit("MACD_EXIT", "MACD_LONG", loss=math.round((close - stopLevel) / syminfo.mintick), profit=math.round((profitLevel - close) / syminfo.mintick))
