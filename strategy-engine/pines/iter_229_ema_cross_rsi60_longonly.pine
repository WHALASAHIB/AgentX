//@version=5
strategy(title="EMA5/13 RSI60 Long-Only BTC 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=20, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA fast period
emaFast = input.int(5, "EMA Fast", minval=2, maxval=50)    // sweep: 3-10 step 1
// EMA slow period
emaSlow = input.int(13, "EMA Slow", minval=5, maxval=100)   // sweep: 10-20 step 1
// RSI period
rsiLen = input.int(14, "RSI Period", minval=5, maxval=30)   // sweep: 10-20 step 2
// RSI threshold (long entry)
rsiLongThresh = input.int(60, "RSI Long Threshold", minval=50, maxval=80)  // sweep: 55-70 step 5
// ATR period for stops
atrPeriod = input.int(14, "ATR Period", minval=7, maxval=30)  // sweep: 10-20 step 2
// TP multiplier (ATR multiples)
tpMultiplier = input.float(1.5, "TP Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
// SL multiplier (ATR multiples)
slMultiplier = input.float(1.0, "SL Multiplier (×ATR)", minval=0.3, maxval=3.0, step=0.1)  // sweep: 0.5-2.0 step 0.3
// Trailing stop activation (ATR multiples)
trailActivate = input.float(1.0, "Trailing Activation (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 0.5-2.0 step 0.5
// Trailing offset (ATR multiples)
trailOffset = input.float(0.5, "Trailing Offset (×ATR)", minval=0.1, maxval=3.0, step=0.1)  // sweep: 0.3-1.0 step 0.2
// Minimum bars to hold
minHoldBars = input.int(4, "Min Bars to Hold", minval=1, maxval=20)  // sweep: 2-8 step 2

//--- indicator calculations
ema_fast = ta.ema(close, emaFast)
ema_slow = ta.ema(close, emaSlow)
rsi_val = ta.rsi(close, rsiLen)
atr_val = ta.atr(atrPeriod)

//--- entry logic
// Long condition: EMA fast > EMA slow (bullish cross) AND RSI > threshold
long_cross = ta.crossover(ema_fast, ema_slow)
long_condition = long_cross and rsi_val > rsiLongThresh

// Track bar count since entry
var int bars_since_entry = 0
if (strategy.position_size == 0)
    bars_since_entry := 0
else
    bars_since_entry := bars_since_entry + 1

// Enter long only — no short entries
if (long_condition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

//--- exit management
if (strategy.position_size > 0)
    // Calculate TP and SL levels in ticks
    sl_ticks = math.round(atr_val * slMultiplier / syminfo.mintick)
    tp_ticks = math.round(atr_val * tpMultiplier / syminfo.mintick)
    
    // Set initial TP/SL on entry bar
    strategy.exit("Long Exit", "Long", loss=sl_ticks, profit=tp_ticks, 
     trail_price=close + trailActivate * atr_val, trail_offset=trailOffset * atr_val / syminfo.mintick)

//--- plot indicators for visual reference
plot(ema_fast, "EMA Fast", color=color.blue, linewidth=2)
plot(ema_slow, "EMA Slow", color=color.red, linewidth=2)
hline(50, "RSI Mid", color=color.gray)
plot(rsi_val, "RSI", color=color.purple, display=display.data_window)
