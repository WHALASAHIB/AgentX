//@version=5
strategy(title="MACD RSI ADX TP100 SL150 Long Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLen = input.int(5, "MACD Fast Length", minval=2, maxval=30, tooltip="MACD fast EMA length")   // sweep: 3-12 step 2
slowLen = input.int(13, "MACD Slow Length", minval=5, maxval=50, tooltip="MACD slow EMA length")   // sweep: 8-26 step 3
sigLen  = input.int(5, "MACD Signal Length", minval=2, maxval=20, tooltip="MACD signal line length") // sweep: 3-12 step 2

// RSI filter
rsiLen   = input.int(14, "RSI Length", minval=5, maxval=30)      // sweep: 7-21 step 2
rsiMin   = input.int(40, "RSI Minimum", minval=20, maxval=70)    // sweep: 30-55 step 5

// ADX filter
adxLen    = input.int(14, "ADX Length", minval=5, maxval=30)     // sweep: 10-25 step 3
adxMin    = input.int(14, "ADX Minimum", minval=5, maxval=50)    // sweep: 10-25 step 3

// TP/SL in points (syminfo.mintick units)
tpPoints  = input.int(100, "Take Profit (points)", minval=10, maxval=500, tooltip="Profit target in points (syminfo.mintick)")   // sweep: 50-200 step 25
slPoints  = input.int(150, "Stop Loss (points)", minval=10, maxval=500, tooltip="Stop loss in points (syminfo.mintick)")         // sweep: 75-250 step 25

//--- indicator calculations
// MACD
[macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, sigLen)
macdBullish = ta.crossover(macdLine, signalLine)

// RSI
rsiVal = ta.rsi(close, rsiLen)
rsiOk = rsiVal > rsiMin

// ADX (manual calculation)
trueRange = ta.tr
upMove = high - high[1]
downMove = low[1] - low
plusDM = na(upMove) ? na : (upMove > downMove and upMove > 0 ? upMove : 0)
minusDM = na(downMove) ? na : (downMove > upMove and downMove > 0 ? downMove : 0)
atr = ta.sma(trueRange, adxLen)
diPlus = 100 * ta.sma(plusDM, adxLen) / atr
diMinus = 100 * ta.sma(minusDM, adxLen) / atr
dx = 100 * math.abs(diPlus - diMinus) / (diPlus + diMinus)
adxVal = ta.sma(dx, adxLen)
adxOk = adxVal > adxMin

//--- entry logic — long only
enterLong = macdBullish and rsiOk and adxOk

if enterLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

//--- exit management via fixed TP/SL
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=slPoints, profit=tpPoints)
