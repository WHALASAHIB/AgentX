//@version=6
strategy(title="BTCUSDT 1h MACD RSI ADX TP_SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(12, "MACD Fast Length", minval=1)        // sweep: 8-16 step 2
slowLength = input.int(26, "MACD Slow Length", minval=1)        // sweep: 20-32 step 2
signalLength = input.int(9, "MACD Signal Length", minval=1)     // sweep: 7-12 step 1

// RSI filter
rsiLength = input.int(14, "RSI Length", minval=1)               // sweep: 10-20 step 2
rsiThreshold = input.int(50, "RSI Threshold (long above)", minval=1)  // sweep: 45-60 step 5

// ADX filter (manual calculation)
adxLength = input.int(14, "ADX Length", minval=1)               // sweep: 10-20 step 2
adxThreshold = input.int(25, "ADX Minimum Threshold", minval=1) // sweep: 20-30 step 5

// ATR-based TP/SL
atrLength = input.int(14, "ATR Length", minval=1)               // sweep: 10-20 step 2
slMultiplier = input.float(1.0, "SL Multiplier (x ATR)", minval=0.1, step=0.1)   // sweep: 0.5-2.0 step 0.25
tpMultiplier = input.float(1.5, "TP Multiplier (x ATR)", minval=0.1, step=0.1)   // sweep: 0.5-3.0 step 0.25

//--- indicator calculations
// MACD
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)

// RSI
rsiValue = ta.rsi(close, rsiLength)

// Manual ADX calculation
float truerange = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
float up = high - high[1]
float down = low[1] - low
float plusDM = up > down and up > 0 ? up : 0
float minusDM = down > up and down > 0 ? down : 0
atr = ta.rma(truerange, adxLength)
float plusDI = 100 * ta.rma(plusDM, adxLength) / atr
float minusDI = 100 * ta.rma(minusDM, adxLength) / atr
float dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
float adxValue = ta.rma(dx, adxLength)

// ATR for TP/SL
float atrVal = ta.atr(atrLength)

//--- entry logic
// MACD crossover condition
macdCrossover = ta.crossover(macdLine, signalLine)

// Filters: RSI > threshold AND ADX > threshold
rsiBull = rsiValue > rsiThreshold
trendStrong = adxValue > adxThreshold

// Entry condition
longCondition = macdCrossover and rsiBull and trendStrong

//--- entry execution
if (longCondition and strategy.position_size == 0)
    strategy.entry("MACD_LONG", strategy.long)

//--- exit management using price-based stop and limit
stopPrice = strategy.position_avg_price - slMultiplier * atrVal
limitPrice = strategy.position_avg_price + tpMultiplier * atrVal

if (strategy.position_size > 0)
    strategy.exit("MACD_EXIT", "MACD_LONG", stop=stopPrice, limit=limitPrice)
