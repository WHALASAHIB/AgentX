//@version=6
strategy(title="MACD(5,13,3) Long-Only XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs: MACD parameters
fastLength = input.int(5, "MACD Fast Length", minval=2, maxval=20, step=1)       // sweep: 2-20 step 1
slowLength = input.int(13, "MACD Slow Length", minval=5, maxval=30, step=1)      // sweep: 5-30 step 2
signalLength = input.int(3, "Signal Length", minval=2, maxval=10, step=1)        // sweep: 2-10 step 1

//--- inputs: TP/SL
tpPct = input.float(0.2, "Take Profit %", minval=0.05, maxval=1.0, step=0.05)   // sweep: 0.05-1.0 step 0.05
slPct = input.float(0.3, "Stop Loss %", minval=0.05, maxval=1.0, step=0.05)     // sweep: 0.05-1.0 step 0.05

//--- inputs: trade management
useEntryFilter = input.bool(false, "Use RSI Entry Filter")                       // default off for this iteration

//--- compute MACD
[macdLine, signalLine, _] = ta.macd(close, fastLength, slowLength, signalLength)

//--- entry logic (long-only MACD crossover)
longCondition = ta.crossover(macdLine, signalLine)

//--- RSI filter (optional, default OFF)
rsiValue = ta.rsi(close, 14)
rsiFilter = useEntryFilter ? (rsiValue > 50) : true

//--- entry
if longCondition and rsiFilter and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

//--- exit management: fixed percentage TP/SL on entry bar close
entryPrice = strategy.position_avg_price
if strategy.position_size > 0
    tpPrice = entryPrice * (1 + tpPct / 100)
    slPrice = entryPrice * (1 - slPct / 100)
    strategy.exit("Long Exit", "Long", limit=tpPrice, stop=slPrice)

//--- plot MACD for visual reference
hline(0, "Zero Line", color=color.gray)
plot(macdLine, "MACD", color=color.blue)
plot(signalLine, "Signal", color=color.orange)
