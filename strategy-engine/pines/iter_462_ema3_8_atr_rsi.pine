//@version=6
strategy(title="Iter 462 — EMA3/8 ATR Trail RSI Filter", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//──────────────────────────────────────────────
//--- INPUTS
//──────────────────────────────────────────────

// EMA parameters
emaFastLen      = input.int(3,   "EMA Fast Length",  group="EMA",     minval=1)     // sweep: 2-10 step 1
emaSlowLen      = input.int(8,   "EMA Slow Length",  group="EMA",     minval=2)     // sweep: 6-26 step 2

// ATR trailing stop parameters
atrLen          = input.int(14,  "ATR Length",        group="ATR Trail", minval=5)  // sweep: 7-21 step 2
trailMult       = input.float(2.0, "Trail Multiplier", group="ATR Trail", minval=0.5, step=0.5) // sweep: 1.0-4.0 step 0.5

// RSI filter
rsiLen          = input.int(14,  "RSI Length",        group="RSI Filter", minval=5) // sweep: 7-21 step 2
rsiLongThresh   = input.int(50,  "RSI Long Threshold", group="RSI Filter", minval=30, maxval=70) // sweep: 40-60 step 5
rsiShortThresh  = input.int(50,  "RSI Short Threshold", group="RSI Filter", minval=30, maxval=70) // sweep: 40-60 step 5

// Trade direction (Both = long + short)
tradeDirection  = input.string("Both", "Trade Direction")

//──────────────────────────────────────────────
//--- INDICATORS
//──────────────────────────────────────────────

emaFast         = ta.ema(close, emaFastLen)
emaSlow         = ta.ema(close, emaSlowLen)
atrValue        = ta.atr(atrLen)
rsiValue        = ta.rsi(close, rsiLen)

// Plot EMAs
plot(emaFast, "EMA Fast", color.blue)
plot(emaSlow, "EMA Slow", color.red)

//──────────────────────────────────────────────
//--- ENTRY LOGIC
//──────────────────────────────────────────────

// Crossover / crossunder conditions
emaCrossover    = ta.crossover(emaFast, emaSlow)
emaCrossunder   = ta.crossunder(emaFast, emaSlow)

// RSI filter conditions
rsiOkLong       = rsiValue > rsiLongThresh
rsiOkShort      = rsiValue < rsiShortThresh

// Composite entry signals
longSignal      = emaCrossover and rsiOkLong  and (tradeDirection == "Long Only" or tradeDirection == "Both")
shortSignal     = emaCrossunder and rsiOkShort and (tradeDirection == "Short Only" or tradeDirection == "Both")

//──────────────────────────────────────────────
//--- EXIT MANAGEMENT (ATR Trailing Stop)
//──────────────────────────────────────────────

// Calculate trailing stop distance in ticks
trailTicks      = math.round(trailMult * atrValue / syminfo.mintick)

// Entry and exit
if (longSignal and strategy.position_size <= 0)
    strategy.entry("EL", strategy.long)

if (shortSignal and strategy.position_size >= 0)
    strategy.entry("ES", strategy.short)

// ATR trailing stop exits — one for each direction
if (strategy.position_size > 0)
    strategy.exit("XL", "EL", trail_points=trailTicks, trail_offset=trailTicks)

if (strategy.position_size < 0)
    strategy.exit("XS", "ES", trail_points=trailTicks, trail_offset=trailTicks)
