//@version=5
strategy(title="EMA3/8 Cross RSI DMI 2:1 TP/SL XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)       // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)       // sweep: 5-21 step 1

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=7, maxval=21)               // sweep: 7-21 step 1
rsiLongThreshold = input.int(50, "RSI Long Threshold (above = long)", minval=30, maxval=70)  // sweep: 40-60 step 5
rsiShortThreshold = input.int(50, "RSI Short Threshold (below = short)", minval=30, maxval=70) // sweep: 40-60 step 5

// DMI/ADX filter
dmiLen = input.int(14, "DMI Length", minval=7, maxval=21)               // sweep: 7-21 step 1
adxThreshold = input.int(25, "ADX Threshold (enter only above)", minval=15, maxval=40) // sweep: 18-30 step 2

// TP/SL management
slPct = input.float(0.3, "Stop Loss %", step=0.05, minval=0.1, maxval=2.0)     // sweep: 0.15-1.0 step 0.05
tpRatio = input.float(2.0, "Take Profit Ratio (x SL)", step=0.5, minval=0.5, maxval=5.0) // sweep: 1.0-3.0 step 0.5

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(high, low, close, dmiLen)

//--- entry logic
// Long: EMA fast crosses above EMA slow, RSI > threshold, ADX > threshold
longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiLongThreshold and adx > adxThreshold

// Short: EMA fast crosses below EMA slow, RSI < threshold, ADX > threshold
shortCondition = ta.crossunder(emaFast, emaSlow) and rsi < rsiShortThreshold and adx > adxThreshold

// Calculate SL and TP in ticks
slTicks = int(slPct / 100 * close / syminfo.mintick)
tpTicks = int(tpRatio * slTicks)

//--- entry and exit management
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=slTicks, profit=tpTicks)

if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=slTicks, profit=tpTicks)

//--- plot EMAs for visual reference
plot(emaFast, "EMA Fast", color=color.blue, linewidth=1)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=1)
