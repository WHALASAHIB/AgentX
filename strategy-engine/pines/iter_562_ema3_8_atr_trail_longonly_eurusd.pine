//@version=6
strategy(title="iter_562_EMA3_8_LongOnly_ATR_Trail_EURUSD", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50, step=1)       // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=3, maxval=50, step=1)         // sweep: 5-21 step 2
atrLen = input.int(14, "ATR Length", minval=5, maxval=50, step=1)                 // sweep: 7-21 step 2
atrMult = input.float(3.0, "ATR Multiplier", minval=0.5, maxval=10.0, step=0.5)  // sweep: 1.5-5.0 step 0.5
useLongOnly = input.bool(true, "Long Only Mode", tooltip="If true, only long entries are allowed (eliminates cascade)")

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atr = ta.atr(atrLen)

//--- entry logic
// Bullish cross: fast EMA crosses above slow EMA
bullishCross = ta.crossover(emaFast, emaSlow)

// Entry conditions: only LONG entries
enterLong = bullishCross

//--- exit management via ATR trailing stop
// Track the highest high since entry for trailing stop
var float trailStop = na
var bool inLong = false

if enterLong and not inLong
    strategy.entry("Long", strategy.long)
    inLong := true
    trailStop := close - atr * atrMult

if inLong
    // Update trailing stop: raise to highest close - ATR*mult
    trailStop := math.max(trailStop, close - atr * atrMult)
    strategy.exit("TrailExit", "Long", stop=trailStop)
    
    // Exit if EMA crosses back down (bearish cross) or trend reverses
    if ta.crossunder(emaFast, emaSlow)
        strategy.close("Long")
        inLong := false
        trailStop := na

// Reset state on position close
if strategy.position_size == 0
    inLong := false
    trailStop := na

//--- visual indicators
plot(emaFast, "EMA Fast", color=color.blue, linewidth=1)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=1)
plot(atr, "ATR", color=color.purple, display=display.data_window)
