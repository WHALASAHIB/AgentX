//@version=5
strategy(title="Supertrend LONG-only H30 — ADX+RSI", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Supertend parameters
st_period = input.int(7, title="Supertrend Period", minval=3, maxval=20, step=1, tooltip="ATR period for Supertrend calculation. sweep: 5-14 step 2")
st_factor = input.float(3.0, title="Supertrend Multiplier", minval=1.0, maxval=5.0, step=0.5, tooltip="ATR multiplier for band width. sweep: 2-5 step 1")

// Trend filter
adx_len = input.int(14, title="ADX Length", minval=7, maxval=21, step=1, tooltip="ADX smoothing period. sweep: 10-20 step 2")
adx_threshold = input.int(20, title="ADX Threshold", minval=10, maxval=35, step=5, tooltip="Minimum ADX value required to trade. sweep: 15-30 step 5")

// RSI filter
rsi_len = input.int(14, title="RSI Length", minval=7, maxval=21, step=1, tooltip="RSI period. sweep: 10-20 step 2")
rsi_threshold = input.int(50, title="RSI Long Threshold", minval=30, maxval=60, step=5, tooltip="RSI must be above this for long entry. sweep: 40-60 step 5")

// TP/SL
atr_len = input.int(14, title="ATR Length", minval=7, maxval=21, step=1, tooltip="ATR period for stop/target calculation. sweep: 10-20 step 2")
sl_mult = input.float(1.5, title="Stop Loss (ATR multiplier)", minval=0.5, maxval=4.0, step=0.5, tooltip="SL distance as ATR multiple. sweep: 1.0-3.0 step 0.5")
tp_sl_ratio = input.float(2.0, title="TP:SL Ratio", minval=0.5, maxval=4.0, step=0.5, tooltip="Take profit to stop loss ratio. sweep: 1.0-3.0 step 0.5")

//--- indicator calculations
// Supertrend
[st_trend, st_line] = ta.supertrend(st_factor, st_period)
// st_trend = 1 for uptrend, -1 for downtrend

// Supertrend crossover detection
is_st_buy = st_trend == 1 and st_trend[1] == -1  // just flipped to uptrend

// ADX
[adx_val, plus_di, minus_di] = ta.dmi(high, low, close, adx_len)

// RSI
rsi_val = ta.rsi(close, rsi_len)

// ATR for stops
atr_val = ta.atr(atr_len)

//--- entry logic
long_condition = is_st_buy and adx_val > adx_threshold and rsi_val > rsi_threshold

//--- exit management
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    
    // Calculate SL and TP prices
    stop_price = close - sl_mult * atr_val
    profit_price = close + sl_mult * atr_val * tp_sl_ratio
    
    // Convert to ticks for strategy.exit
    sl_ticks = (close - stop_price) / syminfo.mintick
    tp_ticks = (profit_price - close) / syminfo.mintick
    
    strategy.exit("Long Exit", "Long", loss=math.round(sl_ticks), profit=math.round(tp_ticks))
