//@version=5
strategy(title="Supertrend Bare H30 Long-Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
st_period = input.int(7, "Supertrend Period", minval=3, maxval=21, step=1)        // sweep: 5-14 step 2
st_factor = input.float(3.0, "Supertrend Factor", minval=1.0, maxval=5.0, step=0.5) // sweep: 2-5 step 0.5
atr_period = input.int(14, "ATR Period", minval=7, maxval=21, step=1)              // sweep: 10-21 step 2
tp_sl_ratio = input.float(2.0, "TP:SL Ratio", minval=1.0, maxval=4.0, step=0.5)    // sweep: 1.5-3.0 step 0.5
sl_atr_mult = input.float(1.5, "SL ATR Multiplier", minval=0.5, maxval=3.0, step=0.5) // sweep: 1.0-2.5 step 0.5
use_trailing = input.bool(false, "Enable Trailing Stop")                            // future enhancement

//--- indicator calculations
[supertrend_dir, supertrend_line] = ta.supertrend(st_factor, st_period)
atr_val = ta.atr(atr_period)
is_uptrend = supertrend_dir == 1  // 1 = green/uptrend, -1 = red/downtrend

//--- entry logic — bare Supertrend signal, no additional filters
long_condition = is_uptrend and not (strategy.position_size > 0)

//--- exit management
sl_distance = sl_atr_mult * atr_val
tp_distance = sl_distance * tp_sl_ratio
// Convert to ticks for strategy.exit
sl_ticks = int(sl_distance / syminfo.mintick)
tp_ticks = int(tp_distance / syminfo.mintick)

if long_condition
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)
    // Flip: if trend turns down while in position, close
    if not is_uptrend
        strategy.close("Long", comment="TrendRev")
