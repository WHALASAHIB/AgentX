//@version=6
strategy(title="BTC EMA3/8 Long-Only ATR Trail 3x 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLen = input.int(3, "Fast EMA Length", minval=2, maxval=20, step=1)   // sweep: 2-10 step 1
slowLen = input.int(8, "Slow EMA Length", minval=5, maxval=30, step=1)   // sweep: 5-21 step 2
atrMult = input.float(3.0, "ATR Multiplier for Trail", minval=1.0, maxval=6.0, step=0.2)  // sweep: 1.0-5.0 step 0.5
atrLen = input.int(14, "ATR Length", minval=7, maxval=30, step=1)      // sweep: 7-21 step 2

//--- indicators
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
atrVal = ta.atr(atrLen)

//--- trailing stop (updates every bar while in position)
var float trailStop = na

if (strategy.position_size > 0)
    // Trail: highest close or entry minus ATR×mult — never lowers
    trailStop := math.max(trailStop, close - atrVal * atrMult)

//--- entry logic: crossover = long only (keeps cascade=1.0)
longCondition = ta.crossover(emaFast, emaSlow)

if (longCondition)
    trailStop := close - atrVal * atrMult
    strategy.entry("Long", strategy.long)

//--- trailing stop management
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", stop=trailStop)
