//@version=5
strategy(title="MACD RSI Long-Only XAUUSD 30m", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.04, process_orders_on_close=true)

//——————————————————————— inputs ———————————————————————

// MACD parameters
fast_len = input.int(12, "MACD Fast Length", minval=1)    // sweep: 8-20 step 2
slow_len = input.int(26, "MACD Slow Length", minval=1)    // sweep: 20-34 step 2
sig_len  = input.int(9, "MACD Signal Length", minval=1)   // sweep: 5-13 step 2

// RSI parameters
rsi_len  = input.int(14, "RSI Length", minval=1)          // sweep: 10-20 step 2
rsi_threshold = input.int(50, "RSI Threshold (long >)", minval=1) // sweep: 40-60 step 5

// ATR-based TP/SL
atr_len  = input.int(14, "ATR Length", minval=1)          // sweep: 10-20 step 2
sl_mult  = input.float(2.0, "Stop Loss ATR Multiple", minval=0.5)  // sweep: 1.0-3.0 step 0.5
tp_mult  = input.float(3.0, "Take Profit ATR Multiple", minval=0.5) // sweep: 1.5-4.0 step 0.5

// Cooldown (bars between entries)
cooldown_bars = input.int(10, "Min Bars Between Entries", minval=1) // sweep: 5-20 step 3

//——————————————————————— calculations ———————————————————————

// MACD
[macd_line, signal_line, hist] = ta.macd(close, fast_len, slow_len, sig_len)

// RSI
rsi_val = ta.rsi(close, rsi_len)

// ATR for dynamic SL/TP
atr_val = ta.atr(atr_len)

//——————————————————————— entry logic ———————————————————————

// Long entry: MACD histogram crosses above 0 (MACD line crosses above signal line)
// AND RSI > threshold AND cooldown elapsed
macd_bullish_cross = ta.crossover(macd_line, signal_line)

// Cooldown: track bars since last entry
var int bars_since_entry = 999
if strategy.position_size > 0
    bars_since_entry := 0
else
    bars_since_entry := bars_since_entry + 1

cooldown_ok = bars_since_entry >= cooldown_bars

// Final long condition
long_condition = macd_bullish_cross and rsi_val > rsi_threshold and cooldown_ok

// Entry: go long on condition
if long_condition
    strategy.entry("Long", strategy.long)

//——————————————————————— exit management ———————————————————————

// Set ATR-based stop loss and take profit on entry
if strategy.position_size > 0 and strategy.position_size[1] == 0
    sl_price = close - (atr_val * sl_mult)
    tp_price = close + (atr_val * tp_mult)
    strategy.exit("XL", "Long", loss=sl_price, profit=tp_price, 
         comment="TP/SL")
