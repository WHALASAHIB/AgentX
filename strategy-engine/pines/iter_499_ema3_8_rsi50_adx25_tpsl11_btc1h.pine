//@version=6
strategy(title="iter_499_ema3_8_rsi50_adx25_tpsl11_btc1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)       // sweep: 2-10 step 1
slow_len = input.int(8, "Slow EMA Length", minval=1, maxval=50)       // sweep: 5-21 step 2

// RSI filter
rsi_len   = input.int(14, "RSI Length", minval=2, maxval=50)          // sweep: 7-21 step 1
rsi_threshold = input.int(50, "RSI Threshold (long >)", minval=20, maxval=80) // sweep: 30-60 step 5

// ADX filter
adx_len       = input.int(14, "ADX Length", minval=5, maxval=30)      // sweep: 7-21 step 2
adx_threshold = input.int(25, "ADX Threshold (trend >)", minval=10, maxval=40) // sweep: 15-30 step 3

// ATR-based TP/SL
atr_len       = input.int(14, "ATR Length", minval=5, maxval=30)      // sweep: 7-21 step 2
sl_atr_mult   = input.float(2.0, "SL ATR Multiplier", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-4.0 step 0.5
tp_atr_mult   = input.float(2.0, "TP ATR Multiplier", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-4.0 step 0.5

//--- calculations
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val  = ta.rsi(close, rsi_len)
[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)
atr_val  = ta.atr(atr_len)

//--- entry logic
long_condition = false
if (fast_ema > slow_ema) and (rsi_val > rsi_threshold) and (adx_val > adx_threshold)
    long_condition := true

//--- exit management
if (long_condition) and (strategy.position_size == 0)
    stop_loss   = close - (atr_val * sl_atr_mult)
    take_profit = close + (atr_val * tp_atr_mult)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=close - stop_loss, profit=take_profit - close)

//--- plot
plot(fast_ema, "Fast EMA", color=color.blue, linewidth=1)
plot(slow_ema, "Slow EMA", color=color.red, linewidth=1)
hline(rsi_threshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dotted)
