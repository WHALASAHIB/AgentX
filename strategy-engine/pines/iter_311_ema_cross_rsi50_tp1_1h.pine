//@version=5
strategy(title="XAUUSD 1h EMA5/13 + RSI50 + 1:1 TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(5, "EMA Fast Length", minval=1, maxval=50)     // sweep: 3-20 step 2
emaSlowLen = input.int(13, "EMA Slow Length", minval=1, maxval=100)    // sweep: 8-30 step 3
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)              // sweep: 7-21 step 7
rsiThreshold = input.int(50, "RSI Threshold (long above, short below)", minval=20, maxval=80)  // sweep: 40-60 step 5
tpSlRatio = input.float(1.0, "TP:SL Ratio (1:X)", minval=0.5, maxval=5.0, step=0.1)  // sweep: 0.5-2.0 step 0.25
slPercent = input.float(0.3, "SL as % of Close", minval=0.05, maxval=2.0, step=0.05)  // sweep: 0.1-1.0 step 0.1

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)

//--- entry logic
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThreshold
shortCondition = ta.crossunder(emaFast, emaSlow) and rsiVal < rsiThreshold

if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

//--- exit management
slPrice = close * (slPercent / 100.0)
tpPrice = slPrice * tpSlRatio

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=syminfo.mintick * math.floor(slPrice / syminfo.mintick), profit=syminfo.mintick * math.floor(tpPrice / syminfo.mintick))

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", loss=syminfo.mintick * math.floor(slPrice / syminfo.mintick), profit=syminfo.mintick * math.floor(tpPrice / syminfo.mintick))
