//@version=6
strategy(title="XAUUSD 30m EMA3/8 RSI50 ATR TP2SL1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MA parameters
fast_len = input.int(3, "Fast EMA", minval=1, maxval=50, step=1)      // sweep: 2-10 step 1
slow_len = input.int(8, "Slow EMA", minval=2, maxval=100, step=1)     // sweep: 5-21 step 1

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=5, maxval=28, step=1)    // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold (long >)", minval=30, maxval=70, step=5) // sweep: 30-70 step 5

// ATR parameters
atr_len = input.int(14, "ATR Length", minval=5, maxval=28, step=1)    // sweep: 7-21 step 2
tp_atr_mult = input.float(2.0, "TP (x ATR)", minval=0.5, maxval=5.0, step=0.25)  // sweep: 1.0-3.0 step 0.5
sl_atr_mult = input.float(1.0, "SL (x ATR)", minval=0.5, maxval=3.0, step=0.25)  // sweep: 0.5-2.0 step 0.25

//--- calculate indicators
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)

//--- entry logic: long only
long_condition = ta.crossover(fast_ema, slow_ema) and rsi_val > rsi_threshold

//--- exit management
if (long_condition) and strategy.position_size <= 0
    stop_price = close - (atr_val * sl_atr_mult)
    limit_price = close + (atr_val * tp_atr_mult)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", limit=limit_price, stop=stop_price)
