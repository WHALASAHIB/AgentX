//@version=5
strategy(title="BB Squeeze H1 Long Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_length = input.int(20, "BB Length", minval=10, maxval=50, step=2)  // sweep: 10-50 step 2
bb_mult   = input.float(2.0, "BB Mult", minval=1.0, maxval=3.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
sma_len   = input.int(5, "SMA Trend Length", minval=3, maxval=20, step=1)  // sweep: 3-20 step 2
rsi_len   = input.int(14, "RSI Length", minval=7, maxval=21, step=2)  // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold", minval=40, maxval=60, step=5)  // sweep: 40-60 step 5
squeeze_threshold = input.float(0.1, "Squeeze Threshold (bandwidth %)", minval=0.05, maxval=0.3, step=0.05)  // sweep: 0.05-0.3 step 0.05
tp_points = input.int(150, "Take Profit (points)", minval=50, maxval=300, step=25)  // sweep: 50-300 step 25
sl_points = input.int(100, "Stop Loss (points)", minval=50, maxval=200, step=25)  // sweep: 50-200 step 25

//--- BB calculation
basis = ta.sma(close, bb_length)
dev = ta.stdev(close, bb_length) * bb_mult
upper = basis + dev
lower = basis - dev
bandwidth = (upper - lower) / basis * 100  // bandwidth as % of basis

//--- SMA trend
sma_trend = ta.sma(close, sma_len)

//--- RSI
rsi_val = ta.rsi(close, rsi_len)

//--- Squeeze detection: bandwidth was contracting (now expanding after being low)
// BB %B for position within bands
pct_b = (close - lower) / (upper - lower)

//--- Entry logic
squeeze_releasing = bandwidth > bandwidth[1] and bandwidth[1] <= squeeze_threshold
// Bullish breakout: price above SMA(5), RSI > threshold, squeeze releasing, price above basis
long_condition = squeeze_releasing and close > sma_trend and rsi_val > rsi_threshold and close > basis and pct_b > 0.5

//--- Exit management
if (long_condition)
    strategy.entry("BBLong", strategy.long)
    strategy.exit("BBExit", "BBLong", loss=sl_points * syminfo.mintick, profit=tp_points * syminfo.mintick)
