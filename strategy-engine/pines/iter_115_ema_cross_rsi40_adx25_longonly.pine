//@version=5
strategy(title="EMA(5,13) Cross + RSI(40) + ADX(25) LONG ONLY XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fast_len = input.int(5, "Fast EMA Length", minval=1, maxval=50)        // sweep: 3-13 step 2
slow_len = input.int(13, "Slow EMA Length", minval=1, maxval=50)       // sweep: 8-26 step 3

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)             // sweep: 7-21 step 7
rsi_min = input.int(40, "RSI Minimum (long only above)", minval=1, maxval=100)  // sweep: 30-55 step 5

// ADX parameters (manual implementation since ta.adx is not supported)
adx_len = input.int(14, "ADX Length", minval=2, maxval=50)             // sweep: 7-21 step 7
adx_threshold = input.int(25, "ADX Minimum (trend strength)", minval=1, maxval=50)  // sweep: 15-35 step 5

// TP/SL parameters
tp_ratio = input.float(1.0, "Take Profit (×SL ratio)", minval=0.1, maxval=10, step=0.1)   // sweep: 0.5-3.0 step 0.5
sl_ratio = input.float(1.5, "Stop Loss (×ATR)", minval=0.1, maxval=10, step=0.1)          // sweep: 1.0-3.0 step 0.5

//--- indicator calculations
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX calculation (ta.adx not available on this platform)
up_change = high - high[1]
down_change = low[1] - low
plus_dm = 0.0
minus_dm = 0.0
if up_change > down_change and up_change > 0
    plus_dm := up_change
else
    plus_dm := 0.0
if down_change > up_change and down_change > 0
    minus_dm := down_change
else
    minus_dm := 0.0

tr_val = ta.tr(true)
smoothed_tr = ta.rma(tr_val, adx_len)
smoothed_plus_dm = ta.rma(plus_dm, adx_len)
smoothed_minus_dm = ta.rma(minus_dm, adx_len)

plus_di = 100.0 * smoothed_plus_dm / (smoothed_tr != 0 ? smoothed_tr : 1)
minus_di = 100.0 * smoothed_minus_dm / (smoothed_tr != 0 ? smoothed_tr : 1)

dx = 100.0 * math.abs(plus_di - minus_di) / ((plus_di + minus_di) != 0 ? (plus_di + minus_di) : 1)
adx_val = ta.rma(dx, adx_len)

// ATR for stops
atr_val = ta.atr(14)

//--- entry logic
// Long condition: EMA5 > EMA13 crossover, RSI > 40, ADX > 25 (strong trend)
long_condition = ta.crossover(fast_ema, slow_ema) and rsi_val > rsi_min and adx_val > adx_threshold

//--- entry
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

//--- exit management
if strategy.position_size > 0
    sl_distance_ticks = math.round(atr_val * sl_ratio / syminfo.mintick)
    tp_distance_ticks = math.round(atr_val * tp_ratio / syminfo.mintick)
    strategy.exit("XL", "Long", loss=sl_distance_ticks, profit=tp_distance_ticks)
