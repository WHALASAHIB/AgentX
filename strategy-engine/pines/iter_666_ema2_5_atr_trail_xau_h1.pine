//@version=6
strategy(title="EMA2/5 ATR Trail XAU H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLen  = input.int(2, "Fast EMA Length", minval=1, maxval=50)     // sweep: 1-5 step 1
slowLen  = input.int(5, "Slow EMA Length", minval=2, maxval=50)     // sweep: 3-10 step 1
atrMult  = input.float(2.0, "ATR Trail Multiplier", step=0.5)       // sweep: 1.0-4.0 step 0.5
atrLen   = input.int(14, "ATR Length", minval=5, maxval=50)         // sweep: 10-20 step 2

//--- indicator calculations
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
atrVal  = ta.atr(atrLen)

//--- ATR trailing stop (long-only)
var float trailStop = na
var bool inLong = false

// Crossover = long entry
if ta.crossover(emaFast, emaSlow)
    strategy.entry("Long", strategy.long)
    trailStop := close - atrVal * atrMult
    inLong := true

// Update trailing stop for active long
if inLong and strategy.position_size > 0
    newStop = close - atrVal * atrMult
    if newStop > trailStop
        trailStop := newStop

// Exit when price closes below trail
if inLong and strategy.position_size > 0 and close < trailStop
    strategy.close("Long")
    inLong := false

// Also trail on each bar for active positions
if strategy.position_size > 0
    strategy.exit("Trail Exit", "Long", stop=trailStop)

//--- plots
plot(emaFast, "Fast EMA", color.blue)
plot(emaSlow, "Slow EMA", color.red)
plot(trailStop, "Trail Stop", color.green, style=plot.style_linebr)
