//@version=5
strategy(title="EMA3/10 Cross + RSI60/50 + Session Filter", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)      // sweep: 3-10 step 1
emaSlowLen = input.int(10, "EMA Slow Length", minval=5, maxval=50)      // sweep: 8-21 step 1

// RSI thresholds
rsiLen = input.int(14, "RSI Length", minval=7, maxval=21)               // sweep: 7-21 step 1
rsiLongMin = input.int(60, "RSI Long Minimum", minval=30, maxval=80)    // sweep: 50-70 step 5
rsiShortMax = input.int(50, "RSI Short Maximum", minval=20, maxval=70)  // sweep: 30-50 step 5

// TP/SL
stopLossPct = input.float(0.3, "Stop Loss %", minval=0.1, maxval=2.0)   // sweep: 0.1-1.0 step 0.1
tpSlRatio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0)     // sweep: 0.5-3.0 step 0.5

// Session filter
sessionStart = input.int(8, "Session Start Hour (UTC)", minval=0, maxval=23)   // sweep: 0-12 step 2
sessionEnd = input.int(20, "Session End Hour (UTC)", minval=0, maxval=23)      // sweep: 12-23 step 2

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)

//--- entry logic
// Long: EMA3 crosses above EMA10 AND RSI > RSI long minimum AND within session hours
longCondition = ta.crossover(emaFast, emaSlow) and (rsiVal > rsiLongMin) and (hour >= sessionStart and hour < sessionEnd)

// Short: EMA3 crosses below EMA10 AND RSI < RSI short maximum AND within session hours
shortCondition = ta.crossunder(emaFast, emaSlow) and (rsiVal < rsiShortMax) and (hour >= sessionStart and hour < sessionEnd)

// Calculate SL and TP distances in ticks
slTicks = (close * stopLossPct / 100.0) / syminfo.mintick
tpTicks = slTicks * tpSlRatio

//--- entry management
if (longCondition)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=math.round(slTicks), profit=math.round(tpTicks))

if (shortCondition)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=math.round(slTicks), profit=math.round(tpTicks))
