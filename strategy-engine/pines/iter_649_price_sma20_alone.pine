//@version=6
strategy(title="iter_649 — price>SMA20 alone", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04)

len = 20
sma20 = ta.sma(close, len)

longEntry = ta.crossover(close, sma20)

if (longEntry and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", limit=close * 1.02, stop=close * 0.98)
