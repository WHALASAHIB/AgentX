//@version=5
strategy(title="EMA5_13_RSI50_H1_1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(5, "EMA Fast Length", minval=1, maxval=50)       // sweep: 3-10 step 1
ema_slow_len = input.int(13, "EMA Slow Length", minval=5, maxval=100)      // sweep: 10-30 step 2
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)                 // sweep: 10-20 step 2
rsi_threshold = input.int(50, "RSI Threshold (long> / short<)", minval=20, maxval=80)  // sweep: 40-60 step 5
tp_sl_ratio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0)     // sweep: 1.0-3.0 step 0.5
sl_percent = input.float(0.3, "Stop Loss (% of close)", minval=0.05, maxval=2.0)  // sweep: 0.1-1.0 step 0.1

//--- indicators
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

//--- entry logic
// Long: EMA fast crosses above EMA slow AND RSI > threshold
long_condition = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_threshold
// Short: EMA fast crosses below EMA slow AND RSI < threshold
short_condition = ta.crossunder(ema_fast, ema_slow) and rsi_val < rsi_threshold

//--- entry management
if (long_condition)
    strategy.entry("Long", strategy.long)

if (short_condition)
    strategy.entry("Short", strategy.short)

//--- exit management
// Calculate SL and TP distances in ticks
sl_ticks = math.round(close * sl_percent / 100 / syminfo.mintick)
tp_ticks = math.round(sl_ticks * tp_sl_ratio)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", loss=sl_ticks, profit=tp_ticks)
