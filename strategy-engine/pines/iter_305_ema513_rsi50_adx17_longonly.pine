//@version=5
strategy(title="EMA5/13 + RSI50 + ADX17 Long-only 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(5, "Fast EMA Length", minval=1, maxval=50)    // sweep: 3-13 step 2
ema_slow_len = input.int(13, "Slow EMA Length", minval=5, maxval=50)   // sweep: 10-26 step 3
rsi_len = input.int(14, "RSI Length", minval=5, maxval=21)             // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold (long above)", minval=30, maxval=70) // sweep: 40-60 step 5
adx_len = input.int(14, "ADX Length", minval=7, maxval=21)             // sweep: 7-21 step 2
adx_threshold = input.int(17, "ADX Threshold (enter above)", minval=10, maxval=30) // sweep: 14-25 step 1
tp_ratio = input.float(1.5, "TP Ratio (1 = 1xSL)", minval=0.5, maxval=5.0)  // sweep: 0.5-3.0 step 0.5
sl_atr_mult = input.float(1.5, "SL as ATR multiple", minval=0.5, maxval=5.0) // sweep: 1.0-3.0 step 0.5
use_session_filter = input.bool(true, "Session Filter (8-16 UTC)")      // sweep: true/false

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
[di_plus, di_minus, adx_val] = ta.dmi(high, low, close, adx_len)
atr_val = ta.atr(14)

//--- session filter
in_session = not use_session_filter or (hour >= 8 and hour < 16)

//--- entry logic
long_condition = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_threshold and adx_val > adx_threshold and in_session

//--- exit management
sl_distance = sl_atr_mult * atr_val
tp_distance = sl_distance * tp_ratio

if (long_condition)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=long(sl_distance / syminfo.mintick), profit=long(tp_distance / syminfo.mintick))

//--- visual indicators
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=1)
hline(rsi_threshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dotted)
