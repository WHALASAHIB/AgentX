//@version=5
strategy(title="BB Trend-Follow ADX Filter - XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands
bb_length = input.int(20, "BB Length", minval=5, maxval=50, step=1)         // sweep: 10-30 step 5
bb_mult   = input.float(2.0, "BB StdDev Mult", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5

// RSI filter
rsi_len   = input.int(14, "RSI Length", minval=7, maxval=21, step=1)         // sweep: 7-21 step 7
rsi_bull  = input.int(50, "RSI Bullish Threshold (long)", minval=30, maxval=70, step=5)  // sweep: 40-60 step 10
rsi_bear  = input.int(50, "RSI Bearish Threshold (short)", minval=30, maxval=70, step=5)  // sweep: 40-60 step 10

// ADX parameters (manual DMI calculation)
adx_len   = input.int(14, "ADX Length", minval=7, maxval=21, step=1)         // sweep: 7-21 step 7
adx_thresh = input.int(25, "ADX Threshold (trend)", minval=15, maxval=35, step=5)  // sweep: 15-30 step 5

// TP/SL
tp_atr_mult = input.float(2.0, "Take Profit (ATR mult)", minval=0.5, maxval=4.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
sl_atr_mult = input.float(1.0, "Stop Loss (ATR mult)", minval=0.5, maxval=3.0, step=0.5)    // sweep: 0.5-2.0 step 0.5
atr_len     = input.int(14, "ATR Length", minval=7, maxval=21, step=1)       // sweep: 7-21 step 7

//--- indicator calculations
// Bollinger Bands
[bb_middle, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)

// RSI
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX via DMI (compatible with Trader Dev's Pine runtime)
up = ta.change(high)
down = -ta.change(low)
plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atr_sma = ta.sma(tr, adx_len)
plusDI = 100 * ta.sma(plusDM, adx_len) / atr_sma
minusDI = 100 * ta.sma(minusDM, adx_len) / atr_sma
dx = math.abs(plusDI - minusDI) / (plusDI + minusDI) * 100
adx_val = ta.sma(dx, adx_len)

// ATR for TP/SL sizing
atr_val = ta.sma(tr, atr_len)

//--- entry logic
// Determine price relative to BB middle band
price_above_middle = close > bb_middle
price_below_middle = close < bb_middle

// Trending market filter (THIS ITERATION'S CHANGE)
trending = adx_val > adx_thresh

// Long: price above BB middle band, RSI above bullish threshold, trending market
if (price_above_middle and rsi_val > rsi_bull and trending)
    strategy.entry("BBL", strategy.long)

// Short: price below BB middle band, RSI below bearish threshold, trending market
if (price_below_middle and rsi_val < rsi_bear and trending)
    strategy.entry("BBS", strategy.short)

//--- exit management
// Calculate TP/SL in ticks based on ATR
long_tp_ticks  = int(tp_atr_mult * atr_val / syminfo.mintick)
long_sl_ticks  = int(sl_atr_mult * atr_val / syminfo.mintick)
short_tp_ticks = int(tp_atr_mult * atr_val / syminfo.mintick)
short_sl_ticks = int(sl_atr_mult * atr_val / syminfo.mintick)

if (strategy.position_size > 0)
    strategy.exit("BBL_EXIT", "BBL", loss=long_sl_ticks, profit=long_tp_ticks)

if (strategy.position_size < 0)
    strategy.exit("BBS_EXIT", "BBS", loss=short_sl_ticks, profit=short_tp_ticks)
