//@version=5
strategy(title="EMA5_13_RSI50_ADX15_SL015", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
emaFastLen = input.int(5, "EMA Fast Length", minval=1, maxval=50)       // sweep: 3-10 step 1
emaSlowLen = input.int(13, "EMA Slow Length", minval=1, maxval=50)       // sweep: 8-26 step 1

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=1, maxval=50)                // sweep: 7-21 step 1
rsiThreshold = input.int(50, "RSI Threshold (long >, short <)", minval=1, maxval=100) // sweep: 40-60 step 5

// ADX trend filter
adxLen = input.int(14, "ADX Length", minval=1, maxval=50)                // sweep: 7-21 step 1
adxThreshold = input.int(15, "ADX Threshold (enter only if ADX >)", minval=1, maxval=50) // sweep: 10-25 step 1

// TP/SL management
slPercent = input.float(0.15, "SL % of Close (per trade)", minval=0.05, maxval=1.0, step=0.05)  // sweep: 0.1-0.5 step 0.05
tpSlRatio = input.float(2.0, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5

// Trade session filter
tradeStartHour = input.int(8, "Trade Session Start (UTC)", minval=0, maxval=23)   // London opens 8 UTC
tradeEndHour = input.int(16, "Trade Session End (UTC)", minval=0, maxval=23)      // US session 16 UTC

//--- calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

rsi = ta.rsi(close, rsiLen)

[adxVal, diPlus, diMinus] = ta.dmi(high, low, close, adxLen)

// Session check — trade during London/NY overlap
isTradeSession = (hour >= tradeStartHour) and (hour < tradeEndHour)

//--- entry logic
longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiThreshold and adxVal > adxThreshold and isTradeSession
shortCondition = ta.crossunder(emaFast, emaSlow) and rsi < rsiThreshold and adxVal > adxThreshold and isTradeSession

// Entry
if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

//--- exit management
// Calculate SL/TP levels in ticks based on close price percentage
slTicks = (close * slPercent / 100) / syminfo.mintick
tpTicks = slTicks * tpSlRatio

// Close-based stops for long positions
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)

// Close-based stops for short positions
if (strategy.position_size < 0)
    strategy.exit("XS", "Short", loss=slTicks, profit=tpTicks)

//--- visual
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)
