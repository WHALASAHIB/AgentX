//@version=6
strategy(title="BB %B Mean Reversion w/ RSI Oversold/Overbought", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_length     = input.int(20, "BB Length", minval=5, maxval=50, step=1)        // sweep: 10-30 step 5
bb_mult       = input.float(2.0, "BB StdDev Mult", minval=1.0, maxval=3.0, step=0.5)  // sweep: 1.5-3.0 step 0.5
atr_length    = input.int(14, "ATR Length", minval=5, maxval=30, step=1)        // sweep: 10-20 step 2
sl_atr_mult   = input.float(1.0, "SL Multiplier (ATR)", minval=0.5, maxval=3.0, step=0.5)  // sweep: 0.5-2.0 step 0.5
tp_atr_mult   = input.float(3.0, "TP Multiplier (ATR)", minval=1.0, maxval=5.0, step=0.5)  // sweep: 2.0-4.0 step 0.5
rsi_length    = input.int(14, "RSI Length", minval=7, maxval=21, step=1)        // sweep: 7-21 step 7
rsi_oversold  = input.int(30, "RSI Oversold (long entry)", minval=20, maxval=40, step=5)  // sweep: 20-40 step 5
rsi_overbought = input.int(70, "RSI Overbought (short entry)", minval=60, maxval=80, step=5)  // sweep: 60-80 step 5

//--- indicators
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
atr_val     = ta.atr(atr_length)
rsi_val     = ta.rsi(close, rsi_length)

//--- entry logic
// Standard Bollinger Bands mean reversion:
// Long when price touches lower band AND RSI is oversold (<30)
// Short when price touches upper band AND RSI is overbought (>70)
long_cond  = (close <= bb_lower) and (rsi_val < rsi_oversold)
short_cond = (close >= bb_upper) and (rsi_val > rsi_overbought)

//--- exit management (use syminfo.mintick directly)
sl_pips_long  = atr_val * sl_atr_mult / syminfo.mintick
tp_pips_long  = atr_val * tp_atr_mult / syminfo.mintick
sl_pips_short = sl_pips_long
tp_pips_short = tp_pips_long

//--- entries
if long_cond
    strategy.entry("Long", strategy.long)

if short_cond
    strategy.entry("Short", strategy.short)

//--- exits (fixed TP/SL via ATR)
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=sl_pips_long, profit=tp_pips_long)

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=sl_pips_short, profit=tp_pips_short)
