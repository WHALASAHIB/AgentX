//@version=5
strategy(title="MACD(12,26,9)+RSI(40) H1 LONG-only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
macd_fast = input.int(12, "MACD Fast Length", minval=5, maxval=30)      // sweep: 8-16 step 2
macd_slow = input.int(26, "MACD Slow Length", minval=15, maxval=40)     // sweep: 20-30 step 2
macd_signal = input.int(9, "MACD Signal Length", minval=5, maxval=20)   // sweep: 7-12 step 1

// RSI filter
rsi_len = input.int(14, "RSI Length", minval=7, maxval=28)              // sweep: 7-21 step 7
rsi_thresh = input.int(40, "RSI Threshold (long above)", minval=20, maxval=60) // sweep: 30-50 step 5

// ATR for stop loss
atr_len = input.int(14, "ATR Length", minval=7, maxval=28)              // sweep: 7-21 step 7
sl_mult = input.float(1.5, "Stop Loss (ATR multiple)", minval=0.5, maxval=3.0, step=0.25) // sweep: 1.0-2.0 step 0.25

//--- indicator calculations
[macd_line, signal_line, hist_line] = ta.macd(close, macd_fast, macd_slow, macd_signal)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)

//--- entry logic: MACD crosses above signal line AND RSI > threshold
long_entry = ta.crossover(macd_line, signal_line) and rsi_val > rsi_thresh

//--- exit logic: MACD crosses below signal line (bearish crossover)
long_exit = ta.crossunder(macd_line, signal_line)

//--- 24h trading (no session restriction)
in_session = true

//--- position management
if (long_entry and in_session and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=int(atr_val * sl_mult / syminfo.mintick))

// Exit on MACD bearish crossover
if (long_exit and strategy.position_size > 0)
    strategy.close("Long", comment="Exit_MACD_Crossunder")

//--- visual indicators
hline(0, "MACD Zero", color=color.gray, linestyle=hline.style_dotted)
plot(macd_line, "MACD", color=color.blue, linewidth=2)
plot(signal_line, "Signal", color=color.orange, linewidth=1)
hline(rsi_thresh, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed, display=display.none)
