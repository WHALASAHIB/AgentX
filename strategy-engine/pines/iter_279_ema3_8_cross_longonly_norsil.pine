//@version=5
strategy(title="iter_279 EMA3/8 Cross Long-Only NoRSI", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen   = input.int(3,   "Fast EMA Length",    minval=1, maxval=50, step=1)    // sweep: 1-10 step 1
emaSlowLen   = input.int(8,   "Slow EMA Length",    minval=2, maxval=50, step=1)    // sweep: 5-20 step 1
tpAtrMult    = input.float(2.0, "TP (ATR multiple)", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-4 step 0.5
slAtrMult    = input.float(1.5, "SL (ATR multiple)", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-3 step 0.5
atrLen       = input.int(14,  "ATR Length",          minval=5, maxval=50, step=1)   // sweep: 5-21 step 2

//--- indicator calculations
emaFast       = ta.ema(close, emaFastLen)
emaSlow       = ta.ema(close, emaSlowLen)
atrVal        = ta.atr(atrLen)
isUpTrend     = emaFast > emaSlow  // EMA3 > EMA8 = bullish
crossAbove    = ta.crossover(emaFast, emaSlow)  // buy signal
crossBelow    = ta.crossunder(emaFast, emaSlow) // sell signal (not used — long only)

//--- entry logic — EMA3 crossing above EMA8, long-only, 24h
if (crossAbove)
    strategy.entry("Long", strategy.long, comment="EMA3x8↑")

//--- exit management — fixed ATR-based TP/SL
if (strategy.position_size > 0)
    strategy.exit("XL", "Long",
         loss   = int(slAtrMult * atrVal / syminfo.mintick),
         profit = int(tpAtrMult * atrVal / syminfo.mintick),
         comment = "TP/SL")
