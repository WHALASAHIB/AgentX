//@version=5
strategy(title="EMA8/21 + RSI50 + 1:1.5 TP/SL Long-Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFastLen = input.int(8, "Fast EMA Length", minval=2, maxval=50, step=1, group="EMA Settings")   // sweep: 3-12 step 1
emaSlowLen = input.int(21, "Slow EMA Length", minval=5, maxval=50, step=1, group="EMA Settings")   // sweep: 13-30 step 1

// RSI filter
rsiLen     = input.int(14, "RSI Length", minval=7, maxval=21, step=1, group="RSI Filter")          // sweep: 7-21 step 2
rsiThresh  = input.int(50, "RSI Threshold (long above)", minval=30, maxval=70, step=5, group="RSI Filter") // sweep: 40-65 step 5

// TP/SL point values for XAUUSD
tpPoints   = input.int(67, "Take Profit (points)", minval=10, maxval=300, step=10, group="TP/SL")  // sweep: 20-200 step 20
slPoints   = input.int(100, "Stop Loss (points)", minval=10, maxval=300, step=10, group="TP/SL")   // sweep: 30-200 step 20

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)

//--- entry logic: EMA8/21 crossover + RSI > threshold — long only
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThresh

//--- exit management: fixed TP/SL points
if (longCondition)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=slPoints * syminfo.mintick, profit=tpPoints * syminfo.mintick)

//--- plot EMAs for visual reference
plot(emaFast, "Fast EMA", color=color.blue, linewidth=1)
plot(emaSlow, "Slow EMA", color=color.red, linewidth=1)
hline(rsiThresh, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed)
