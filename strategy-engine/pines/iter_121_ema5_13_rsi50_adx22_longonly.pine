//@version=5
strategy(title="EMA5_13_RSI50_ADX22_LONG_ONLY", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(5, "EMA Fast Length", minval=2, maxval=50)   // sweep: 3-10 step 1
ema_slow_len = input.int(13, "EMA Slow Length", minval=5, maxval=100) // sweep: 8-30 step 2
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)            // sweep: 7-21 step 2
rsi_min = input.int(50, "RSI Minimum (Long)", minval=20, maxval=70)   // sweep: 30-60 step 5
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)            // sweep: 10-25 step 3
adx_threshold = input.int(22, "ADX Threshold", minval=10, maxval=50)  // sweep: 15-30 step 2
tp_sl_ratio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.0-3.0 step 0.25
sl_pct = input.float(0.3, "SL %", minval=0.05, maxval=2.0, step=0.05)  // sweep: 0.1-1.0 step 0.1

//--- calculate EMAs and RSI
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

//--- manual ADX calculation using DMI components
// True Range
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
// Directional Movement
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0
// Smoothed ATR and DM
atr_val = ta.rma(tr, adx_len)
plus_di = 100 * ta.rma(plus_dm, adx_len) / atr_val
minus_di = 100 * ta.rma(minus_dm, adx_len) / atr_val
// DX and ADX
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.rma(dx, adx_len)

//--- crossover detection
ema_cross_over = ta.crossover(ema_fast, ema_slow)
ema_cross_under = ta.crossunder(ema_fast, ema_slow)

//--- entry logic — LONG ONLY
long_condition = ema_cross_over and rsi_val > rsi_min and adx_val > adx_threshold

if long_condition
    strategy.entry("Long", strategy.long)

//--- exit management
sl_ticks = math.round((close * sl_pct / 100) / syminfo.mintick)
tp_ticks = math.round(sl_ticks * tp_sl_ratio)

if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)

//--- plots
plot(ema_fast, "EMA Fast", color=color.blue, linewidth=2)
plot(ema_slow, "EMA Slow", color=color.red, linewidth=2)
hline(rsi_min, "RSI Min", color=color.gray, linestyle=hline.style_dashed)
