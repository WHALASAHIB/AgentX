//@version=5
strategy(title="EMA5/13 Crossover No-Filter Long-Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFast = input.int(5, "Fast EMA", minval=2, maxval=20, step=1)            // sweep: 3-10 step 1
emaSlow = input.int(13, "Slow EMA", minval=8, maxval=40, step=2)           // sweep: 10-20 step 2

// TP/SL via ATR
atrLen = input.int(14, "ATR Length", minval=7, maxval=30)                  // sweep: 7-21 step 7
tpMult = input.float(2.0, "TP/SL Ratio", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-3.0 step 0.5
slMult = input.float(1.0, "SL Multiplier (ATR)", minval=0.5, maxval=3.0)  // sweep: 0.5-2.0 step 0.5

//--- indicators
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
atrVal = ta.atr(atrLen)

//--- entry logic
// No filters — just EMA crossover
emaBullCross = ta.crossover(emaF, emaS)
noPos = strategy.opentrades == 0

enterLong = emaBullCross and noPos

if enterLong
    strategy.entry("L", strategy.long)

//--- exit management
slDist = atrVal * slMult
tpDist = atrVal * tpMult

if strategy.position_size > 0
    strategy.exit("X", "L", loss=int(slDist/syminfo.mintick), profit=int(tpDist/syminfo.mintick))

//--- visual
plot(emaF, "Fast EMA", color=color.green, linewidth=2)
plot(emaS, "Slow EMA", color=color.red, linewidth=2)
plotshape(enterLong, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
