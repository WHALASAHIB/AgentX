//@version=5
strategy(
  title="EMA3/8 Cross + RSI50 Long Only (XAUUSD 1h)",
  overlay=true,
  initial_capital=10000,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=100,
  commission_type=strategy.commission.percent,
  commission_value=0.04,
  process_orders_on_close=true
)

//--- inputs
emaFastLen  = input.int(3,   "Fast EMA Length",  minval=1, maxval=50)     // sweep: 2-10 step 1
emaSlowLen  = input.int(8,   "Slow EMA Length",  minval=2, maxval=50)     // sweep: 5-21 step 2
rsiLen      = input.int(14,  "RSI Length",       minval=2, maxval=50)     // sweep: 7-21 step 2
rsiMin      = input.int(50,  "RSI Minimum (Long)", minval=1, maxval=100)  // sweep: 30-70 step 5
tpPoints    = input.int(150, "Take Profit (ticks)", minval=10, maxval=500) // sweep: 50-300 step 25
slPoints    = input.int(100, "Stop Loss (ticks)",   minval=10, maxval=500) // sweep: 50-300 step 25

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi     = ta.rsi(close, rsiLen)

//--- entry logic
bullishCross = ta.crossover(emaFast, emaSlow)

// Entry condition: EMA fast crosses above slow + RSI above minimum threshold
longCondition = bullishCross and rsi > rsiMin

// Exit: when EMA fast crosses below slow (trend reversal)
bearishCross = ta.crossunder(emaFast, emaSlow)

//--- position management
if (longCondition)
    strategy.entry("Long", strategy.long)

// Exit on inverse crossover or TP/SL
if (bearishCross)
    strategy.close("Long")

// Fixed TP/SL via strategy.exit (applied after entry)
if (strategy.position_size > 0)
    strategy.exit("TP/SL", "Long", loss=slPoints, profit=tpPoints)
