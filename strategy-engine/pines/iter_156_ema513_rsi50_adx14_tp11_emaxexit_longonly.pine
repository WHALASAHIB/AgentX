//@version=5
strategy(title="EMA(5,13) + RSI(50) + ADX(14>14) + TP/SL 1:1 (1xATR) + EMA XUnder Exit — LONG ONLY XAUUSD 30m", 
         overlay=true, 
         initial_capital=10000, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=100, 
         commission_type=strategy.commission.percent, 
         commission_value=0.04, 
         process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFast = input.int(5, "Fast EMA Length")          // sweep: 3-10 step 1
emaSlow = input.int(13, "Slow EMA Length")         // sweep: 10-21 step 2

// RSI filter
rsiLen = input.int(14, "RSI Length")                // sweep: 10-21 step 2
rsiMin = input.int(50, "RSI Minimum (long if >)")   // sweep: 40-60 step 5

// ADX filter
adxLen = input.int(14, "ADX Length")                // sweep: 10-21 step 2
adxMin = input.int(14, "Min ADX (trend filter)")    // sweep: 10-25 step 5

// TP/SL parameters (1:1 ratio via ATR)
atrLen = input.int(14, "ATR Length")                // sweep: 10-21 step 2
slATRMult = input.float(1.0, "SL ATR Multiplier")   // sweep: 0.5-2.0 step 0.5
tpATRMult = input.float(1.0, "TP ATR Multiplier")   // sweep: 0.5-2.0 step 0.5

//--- indicator calculations
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLen)

// Manual ADX calculation (ta.adx not supported by Trader Dev engine)
up = ta.change(high)
down = -ta.change(low)
plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atr = ta.sma(tr, atrLen)
plusDI = 100 * ta.sma(plusDM, adxLen) / atr
minusDI = 100 * ta.sma(minusDM, adxLen) / atr
dx = math.abs(plusDI - minusDI) / (plusDI + minusDI) * 100
adxVal = ta.sma(dx, adxLen)

//--- ATR for TP/SL distance
atrVal = ta.sma(tr, atrLen)

//--- entry logic
// LONG entry: EMA5 crosses above EMA13 AND RSI > RSI min AND ADX > min threshold
longCondition = ta.crossover(emaF, emaS) and rsiVal > rsiMin and adxVal > adxMin

// Exit condition: EMA5 crosses below EMA13 (trend reversal exit)
exitCondition = ta.crossunder(emaF, emaS)

//--- entry management
if (longCondition)
    // Calculate SL and TP distances based on ATR
    slDist = slATRMult * atrVal
    tpDist = tpATRMult * atrVal
    
    // Convert to ticks
    slTicks = math.round(slDist / syminfo.mintick)
    tpTicks = math.round(tpDist / syminfo.mintick)
    
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)

//--- close-based exit on trend reversal (to recycle capital)
if (exitCondition and strategy.position_size > 0)
    strategy.close("Long", comment="EMA_XUnder_Exit")
