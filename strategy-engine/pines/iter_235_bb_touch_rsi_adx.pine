//@version=5
strategy(title="BB Touch + RSI + ADX Filter", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_length = input.int(20, "BB Length", group="Bollinger Bands")  // sweep: 14-30 step 2
bb_mult = input.float(2.0, "BB StdDev", group="Bollinger Bands")  // sweep: 1.5-3.0 step 0.25
rsi_length = input.int(14, "RSI Length", group="RSI")  // sweep: 10-20 step 2
rsi_long_threshold = input.int(50, "RSI Long Threshold (> this)", group="RSI")  // sweep: 40-60 step 5
rsi_short_threshold = input.int(50, "RSI Short Threshold (< this)", group="RSI")  // sweep: 40-60 step 5
adx_length = input.int(14, "ADX Length", group="ADX")  // sweep: 10-20 step 2
adx_threshold = input.int(25, "ADX Threshold (enter only if > this)", group="ADX")  // sweep: 20-30 step 2
atr_length = input.int(14, "ATR Length", group="TP/SL")  // sweep: 10-20 step 2
tp_sl_ratio = input.float(1.5, "TP:SL Ratio", step=0.1, group="TP/SL")  // sweep: 1.0-2.5 step 0.25

//--- Bollinger Bands
basis = ta.sma(close, bb_length)
dev = ta.stdev(close, bb_length) * bb_mult
upper_bb = basis + dev
lower_bb = basis - dev

//--- RSI
rsi = ta.rsi(close, rsi_length)

//--- ADX (true strength)
[di_plus, di_minus, adx] = ta.dmi(adx_length, adx_length)

//--- ATR for dynamic TP/SL
atr = ta.atr(atr_length)

//--- entry logic
long_condition = close > upper_bb and rsi > rsi_long_threshold and adx > adx_threshold
short_condition = close < lower_bb and rsi < rsi_short_threshold and adx > adx_threshold

//--- entry management
var in_long = false
var in_short = false

if long_condition and not in_long and not in_short
    strategy.entry("Long", strategy.long)
    in_long := true
    in_short := false

if short_condition and not in_short and not in_long
    strategy.entry("Short", strategy.short)
    in_short := true
    in_long := false

//--- exit management
// Use ATR-based TP/SL with configurable ratio
sl_distance = atr * 1.0  // 1 ATR stop loss
tp_distance = atr * tp_sl_ratio  // ratio * ATR take profit

if strategy.position_size > 0  // long position open
    strategy.exit("Long Exit", "Long", loss=syminfo.mintick * math.floor(sl_distance / syminfo.mintick), profit=syminfo.mintick * math.floor(tp_distance / syminfo.mintick))
    in_long := false

if strategy.position_size < 0  // short position open
    strategy.exit("Short Exit", "Short", loss=syminfo.mintick * math.floor(sl_distance / syminfo.mintick), profit=syminfo.mintick * math.floor(tp_distance / syminfo.mintick))
    in_short := false

//--- plot bands for visual reference
plot(basis, "BB Middle", color=color.blue)
plot(upper_bb, "BB Upper", color=color.green)
plot(lower_bb, "BB Lower", color=color.red)
