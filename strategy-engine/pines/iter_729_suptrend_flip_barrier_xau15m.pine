//@version=6
strategy(title="Supertrend Flip Barrier Exit XAU 15m f2.5", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     process_orders_on_close=true,
     pyramiding=1)

//--- inputs
st_factor = input.float(2.5, "Supertrend ATR Factor", minval=1.0, maxval=10.0, step=0.5)   // sweep: 1.0-5.0 step 0.5 (iter 729: 2.0 -> 2.5 midpoint)
st_period = input.int(7, "Supertrend ATR Period", minval=3, maxval=21, step=1)             // sweep: 3-21 step 2
tp_ticks  = input.int(500, "Take Profit (ticks)", minval=100, maxval=2000, step=50)        // sweep: 100-2000 step 100
sl_ticks  = input.int(500, "Stop Loss (ticks)", minval=100, maxval=2000, step=50)          // sweep: 100-2000 step 100

//--- Supertrend flip detection
[st_line, st_dir] = ta.supertrend(st_factor, st_period)
// st_dir: 1 = up (bullish), -1 = down (bearish)

// Only enter on direction CHANGE (flip), not every bar
flip_up   = ta.crossover(st_dir, 0)
flip_down = ta.crossunder(st_dir, 0)

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var float short_tp = na
var float short_sl = na
var int entry_bar = -1

//--- entry logic
if flip_up and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    long_tp := close + tp_ticks * syminfo.mintick
    long_sl := close - sl_ticks * syminfo.mintick
    entry_bar := bar_index

if flip_down and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
    short_tp := close - tp_ticks * syminfo.mintick
    short_sl := close + sl_ticks * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long")
    if low <= long_sl
        strategy.close("Long")

if strategy.position_size < 0 and bar_index > entry_bar
    if low <= short_tp
        strategy.close("Short")
    if high >= short_sl
        strategy.close("Short")
