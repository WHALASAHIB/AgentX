//@version=5
strategy(title="EMA3/8 Crossover Long-Only XAUUSD 30m", overlay=true, initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         commission_type=strategy.commission.percent, commission_value=0.04,
         process_orders_on_close=true)

//--- inputs
// EMA periods
ema_fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)       // sweep: 2-10 step 1
ema_slow_len = input.int(8, "Slow EMA Length", minval=5, maxval=100)      // sweep: 5-26 step 1

// TP/SL in points (1:1.5 ratio = TP 67, SL 100)
tp_points = input.int(67, "Take Profit (points)", minval=10, maxval=500)   // sweep: 20-200 step 10
sl_points = input.int(100, "Stop Loss (points)", minval=10, maxval=500)    // sweep: 20-200 step 10

// Session filter toggle
use_session_filter = input.bool(false, "Use Session Filter (8-16 UTC)")    // enable to restrict trade hours

//--- indicators
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

//--- entry logic
// Bullish crossover: fast EMA crosses above slow EMA
bullish_cross = ta.crossover(ema_fast, ema_slow)

// Session check (optional)
in_session = not use_session_filter or (hour >= 8 and hour < 16)

// Long entry condition
long_entry = bullish_cross and in_session

// Exit condition: trend reversal (fast crosses below slow)
bearish_cross = ta.crossunder(ema_fast, ema_slow)

//--- entry management
if long_entry
    strategy.entry("Long", strategy.long)

//--- exit management
if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", loss=sl_points * syminfo.mintick, profit=tp_points * syminfo.mintick)

//--- visual indicators
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=2)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=2)
plotshape(long_entry, "Buy Signal", style=shape.triangleup, location=location.belowbar, size=size.small, color=color.green)
