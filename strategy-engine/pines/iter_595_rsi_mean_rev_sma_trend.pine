//@version=6
strategy(title="RSI Mean Rev + SMA Trend 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
rsiLength = input.int(14, "RSI Length", minval=2, maxval=50, step=1)                  // sweep: 7-21 step 2
oversoldThreshold = input.int(40, "Oversold (long trigger)", minval=20, maxval=50, step=5)   // sweep: 25-50 step 5
overboughtThreshold = input.int(60, "Overbought (short trigger)", minval=50, maxval=80, step=5) // sweep: 50-80 step 5
trendSmaLen = input.int(50, "Trend SMA Length", minval=20, maxval=100, step=10)        // sweep: 30-80 step 10
tpPercent = input.float(0.3, "Take Profit %", minval=0.1, maxval=2.0, step=0.1)        // sweep: 0.2-1.0 step 0.1
slPercent = input.float(0.3, "Stop Loss %", minval=0.1, maxval=2.0, step=0.1)          // sweep: 0.2-1.0 step 0.1

//--- indicators
rsi = ta.rsi(close, rsiLength)
smaTrend = ta.sma(close, trendSmaLen)

//--- RSI crossover detection with SMA trend filter
// Long: RSI exits oversold AND price above SMA (uptrend)
// Short: RSI exits overbought AND price below SMA (downtrend)
longSignal = ta.crossover(rsi, oversoldThreshold) and close > smaTrend
shortSignal = ta.crossunder(rsi, overboughtThreshold) and close < smaTrend

//--- TP/SL calculation (fixed percentage)
tpPriceLong  = close * (1 + tpPercent / 100)
slPriceLong  = close * (1 - slPercent / 100)
tpPriceShort = close * (1 - tpPercent / 100)
slPriceShort = close * (1 + slPercent / 100)

//--- entry/exit logic with position check (prevents cascade)
if (longSignal and strategy.position_size <= 0)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", limit=tpPriceLong, stop=slPriceLong)

if (shortSignal and strategy.position_size >= 0)
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", limit=tpPriceShort, stop=slPriceShort)

//--- plots
hline(oversoldThreshold, "Oversold", color=color.green, linestyle=hline.style_dotted)
hline(overboughtThreshold, "Overbought", color=color.red, linestyle=hline.style_dotted)
plot(rsi, "RSI", color=color.purple)
hline(50, "Midline", color=color.gray, linestyle=hline.style_dotted)
