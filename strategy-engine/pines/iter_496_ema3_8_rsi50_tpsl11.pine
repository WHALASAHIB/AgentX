//@version=6
strategy(title="Iter 496 — EMA3/8 crossover + RSI(14)>50 + TP/SL 1:1 at 2×ATR", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFast = input.int(3, "EMA Fast Length", minval=1, maxval=50)       // sweep: 2-10 step 1
emaSlow = input.int(8, "EMA Slow Length", minval=1, maxval=100)      // sweep: 5-21 step 1
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)            // sweep: 7-21 step 1
rsiThresh = input.int(50, "RSI Long Threshold", minval=1, maxval=100)  // sweep: 40-60 step 5
atrLen = input.int(14, "ATR Length", minval=1, maxval=50)            // sweep: 7-21 step 1
atrMultSL = input.float(2.0, "ATR Multiplier SL", step=0.5, minval=0.5, maxval=10.0)  // sweep: 1.0-5.0 step 0.5
atrMultTP = input.float(2.0, "ATR Multiplier TP", step=0.5, minval=0.5, maxval=10.0)  // sweep: 1.0-5.0 step 0.5

//--- indicators
emaFastVal = ta.ema(close, emaFast)
emaSlowVal = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- entry logic: EMA3/8 crossover + RSI(14) > 50
longCondition = ta.crossover(emaFastVal, emaSlowVal) and rsiVal > rsiThresh

//--- exit management: fixed TP/SL at ATR multiples
if (longCondition)
    strategy.entry("Long", strategy.long)
    slTicks = math.floor(atrVal * atrMultSL / syminfo.mintick)
    tpTicks = math.floor(atrVal * atrMultTP / syminfo.mintick)
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)
