//@version=6
strategy(title="MACD Long-Only XAUUSD 1:1.5 TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(12, "MACD Fast Length", minval=5, maxval=30, step=1)   // sweep: 8-20 step 2
slowLength = input.int(26, "MACD Slow Length", minval=15, maxval=50, step=2)   // sweep: 20-40 step 4
signalLength = input.int(9, "MACD Signal Length", minval=5, maxval=20, step=1) // sweep: 7-14 step 1

// TP/SL parameters — tightened to 1:1.5 ratio (WR < 40% fix)
tpRatio = input.float(1.0, "Take Profit (ATR multiple)", minval=0.5, maxval=4.0, step=0.1)    // sweep: 0.5-2.0 step 0.25
slRatio = input.float(1.5, "Stop Loss (ATR multiple)", minval=0.5, maxval=4.0, step=0.1)     // sweep: 0.5-2.0 step 0.25

// ATR for stop placement
atrLength = input.int(14, "ATR Length", minval=7, maxval=30, step=1)  // sweep: 10-20 step 2

//--- indicator calculations
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
atrValue = ta.atr(atrLength)

//--- MACD direction (candle to candle)
macdAboveSignal = macdLine > signalLine
// Bullish: MACD above signal (crossed up or already above)
isLongSignal = macdAboveSignal

//--- entry logic — long-only to fix cascade ratio
if (isLongSignal and strategy.position_size == 0)
    stopLoss = close - (atrValue * slRatio)
    takeProfit = close + (atrValue * tpRatio)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=close - stopLoss, profit=takeProfit - close)

//--- exit management — MACD reversal close
if (not isLongSignal and strategy.position_size > 0)
    strategy.close("Long")
