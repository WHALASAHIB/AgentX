//@version=6
strategy(title="BB RSI ATR XAU30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_length = input.int(20, "BB Length", minval=5, maxval=50)
bb_mult = input.float(2.0, "BB StdDev", minval=1.0, maxval=4.0)
rsi_length = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_long_thresh = input.int(50, "RSI Long <", minval=30, maxval=60)
rsi_short_thresh = input.int(50, "RSI Short >", minval=40, maxval=70)
atr_length = input.int(14, "ATR Length", minval=7, maxval=30)
tp_mult = input.float(0.8, "TP (ATR mult)", minval=0.3, maxval=2.0)
sl_mult = input.float(1.5, "SL (ATR mult)", minval=0.5, maxval=3.0)
cooldown = input.int(5, "Cooldown bars", minval=2, maxval=15)

//--- entry logic
[bb_center, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
rsi_val = ta.rsi(close, rsi_length)
atr_val = ta.atr(atr_length)
mintick = syminfo.mintick

// Track state
var int bars_since_exit = 999
var float entry_price = 0.0
var int entry_bar = 0
var float tp_price = 0.0
var float sl_price = 0.0
var int exit_bar = -999

// State machine
if na(strategy.position_size) or strategy.position_size == 0
    // No position
    bars_since_exit := bars_since_exit + 1
    entry_bar := 0

if strategy.position_size != 0
    // In position - freeze TP/SL on first bar
    if entry_bar == 0
        entry_price := close
        entry_bar := bar_index
        if strategy.position_size > 0
            tp_price := entry_price + (tp_mult * atr_val)
            sl_price := entry_price - (sl_mult * atr_val)
        else
            tp_price := entry_price - (tp_mult * atr_val)
            sl_price := entry_price + (sl_mult * atr_val)

// Entry conditions
long_cond = close <= bb_lower and rsi_val < rsi_long_thresh
short_cond = close >= bb_upper and rsi_val > rsi_short_thresh
can_enter = bars_since_exit >= cooldown or exit_bar == -999

if can_enter and long_cond and strategy.position_size == 0
    strategy.entry("BBLONG", strategy.long)

if can_enter and short_cond and strategy.position_size == 0
    strategy.entry("BBSHORT", strategy.short)

// Exit management
if strategy.position_size != 0 and entry_bar > 0
    if strategy.position_size > 0
        strategy.exit("LONGX", "BBLONG", loss=math.round((entry_price - sl_price) / mintick), profit=math.round((tp_price - entry_price) / mintick))
    if strategy.position_size < 0
        strategy.exit("SHORTX", "BBSHORT", loss=math.round((sl_price - entry_price) / mintick), profit=math.round((entry_price - tp_price) / mintick))
