//@version=6
strategy(title="XAUUSD 30m Short-Only SMA20 ADX20 RSI ATR", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
smaLen = input.int(20, "SMA Length", minval=5, maxval=100)       // sweep: 10-50 step 5
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)         // sweep: 7-21 step 2
rsiThreshold = input.int(50, "RSI Max (short when RSI < this)", minval=20, maxval=80)  // sweep: 30-60 step 5
adxLen = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 2
adxThreshold = input.int(20, "ADX Min", minval=10, maxval=40)     // sweep: 14-25 step 2 -- lowered from 25 to 20 to get more entries
smaTrendLen = input.int(50, "Trend SMA Length", minval=20, maxval=200) // sweep: 30-100 step 10
atrLen = input.int(14, "ATR Length", minval=7, maxval=30)         // sweep: 7-21 step 2
tpMultiplier = input.float(4.0, "TP (x ATR)", minval=1.0, maxval=10.0, step=0.5) // sweep: 2.0-6.0 step 0.5
slMultiplier = input.float(2.0, "SL (x ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5

//--- indicators
sma = ta.sma(close, smaLen)
smaTrend = ta.sma(close, smaTrendLen)
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
atr = ta.atr(atrLen)

//--- entry logic (SHORT ONLY)
// Entry condition: Close crosses below SMA(20) in downtrend (close < SMA(50)) with RSI < 50 and ADX > 20
shortEntry = ta.crossunder(close, sma) and close < smaTrend and rsi < rsiThreshold and adx > adxThreshold and adx < 100

//--- exit management
shortSL = strategy.position_avg_price + (slMultiplier * atr)
shortTP = strategy.position_avg_price - (tpMultiplier * atr)

if (shortEntry)
    strategy.entry("Short", strategy.short)

if (strategy.position_size < 0)
    strategy.exit("Short Exit", "Short", stop=shortSL, limit=shortTP)
