//@version=5
strategy(title="XAUUSD H1 EMA3/8 + RSI(50) + EMA50 Trend + 1:1.5 TP/SL",
         overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         commission_type=strategy.commission.percent,
         commission_value=0.04,
         process_orders_on_close=true)

//--- inputs
// EMA fast period
fastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50)
// sweep: 1-10 step 1

// EMA slow period
slowLen = input.int(8, "Slow EMA Length", minval=2, maxval=50)
// sweep: 5-20 step 1

// EMA trend filter period (shorter than EMA200 to increase trade count)
trendLen = input.int(50, "Trend EMA Length", minval=20, maxval=200)
// sweep: 20-200 step 10

// RSI period
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)
// sweep: 5-20 step 1

// RSI oversold threshold (long entry: RSI above this)
rsiLongThresh = input.int(50, "RSI Long Threshold", minval=20, maxval=80)
// sweep: 30-70 step 5

// RSI overbought threshold (short entry: RSI below this)
rsiShortThresh = input.int(50, "RSI Short Threshold", minval=20, maxval=80)
// sweep: 30-70 step 5

// Stop loss percentage (of price)
slPercent = input.float(0.3, "Stop Loss %", minval=0.1, maxval=5.0, step=0.1)
// sweep: 0.1-2.0 step 0.1

// Take profit ratio (TP = SL * tpRatio)
tpRatio = input.float(1.5, "TP/SL Ratio", minval=0.5, maxval=5.0, step=0.1)
// sweep: 0.5-3.0 step 0.2

// Trade session filter (UTC)
useSessionFilter = input.bool(true, "Use Session Filter (8-16 UTC)")
// sweep: true/false

//--- calculate indicators
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)
trendMA = ta.ema(close, trendLen)
rsi = ta.rsi(close, rsiLen)

//--- crossover conditions
longEntry = ta.crossover(fastMA, slowMA)
shortEntry = ta.crossunder(fastMA, slowMA)

//--- RSI filters
rsiLongOk = rsi > rsiLongThresh
rsiShortOk = rsi < rsiShortThresh

//--- Trend filter: long only above trend EMA, short only below trend EMA
aboveTrend = close > trendMA
belowTrend = close < trendMA

//--- Session filter (8-16 UTC = London/NY overlap)
sessionOk = not useSessionFilter or (hour >= 8 and hour < 16)

//--- Entry logic
enterLong = longEntry and rsiLongOk and aboveTrend and sessionOk
enterShort = shortEntry and rsiShortOk and belowTrend and sessionOk

//--- Calculate SL and TP distances in ticks
slTicks = int(slPercent / 100.0 * close / syminfo.mintick)
tpTicks = int(slTicks * tpRatio)

//--- Entry
if enterLong
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=slTicks, profit=tpTicks)

if enterShort
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=slTicks, profit=tpTicks)

//--- Plot indicators for visual reference
plot(fastMA, "Fast EMA", color=color.blue, linewidth=1)
plot(slowMA, "Slow EMA", color=color.red, linewidth=1)
plot(trendMA, "Trend EMA", color=color.purple, linewidth=2)
hline(rsiLongThresh, "RSI Long Thresh", color=color.green, linestyle=hline.style_dashed)
hline(rsiShortThresh, "RSI Short Thresh", color=color.red, linestyle=hline.style_dashed)
