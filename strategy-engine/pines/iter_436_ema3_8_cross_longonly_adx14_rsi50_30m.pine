//@version=5
strategy(title="EMA3/8 Long-Only ADX14 RSI50 XAUUSD 30m", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50)       // sweep: 2-10 step 1
slowLen = input.int(8, "Slow EMA Length", minval=1, maxval=50)       // sweep: 5-21 step 1
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)            // sweep: 7-21 step 1
rsiLongMin = input.int(50, "RSI Long Min (RSI > this for long)", minval=20, maxval=80) // sweep: 40-60 step 5
adxLen = input.int(14, "ADX Length", minval=5, maxval=50)            // sweep: 7-21 step 1
adxThreshold = input.int(14, "ADX Min (trend strength)", minval=5, maxval=50) // sweep: 10-25 step 5
tpTicks = input.int(125, "Take Profit (ticks)", minval=1, maxval=500) // sweep: 50-200 step 25
slTicks = input.int(125, "Stop Loss (ticks)", minval=1, maxval=500)   // sweep: 50-200 step 25

//--- indicators
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)
rsiVal = ta.rsi(close, rsiLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

//--- entry logic: LONG ONLY
bullishCross = ta.crossover(fastMA, slowMA)

// Long entry: EMA fast crosses above slow + RSI > minimum + ADX > threshold + no existing position
longCondition = bullishCross and rsiVal > rsiLongMin and adxVal > adxThreshold

//--- position management: entry only when flat, exit via TP/SL
if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=slTicks * syminfo.mintick,
                  profit=tpTicks * syminfo.mintick)

//--- visual
plot(fastMA, "Fast EMA", color=color.blue, linewidth=1)
plot(slowMA, "Slow EMA", color=color.red, linewidth=1)
hline(rsiLongMin, "RSI Min", color=color.gray, linestyle=hline.style_dashed)
