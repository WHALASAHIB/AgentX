//@version=5
strategy(title="iter_245_EMA_RSI_ATR_LongOnly_NoADX", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLen = input.int(5, "Fast EMA Length", minval=2, maxval=50, step=1)   // sweep: 3-10 step 1
slowLen = input.int(13, "Slow EMA Length", minval=5, maxval=100, step=2)  // sweep: 10-30 step 2
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30, step=1)         // sweep: 7-21 step 2
rsiThreshold = input.int(50, "RSI Threshold (long only above)", minval=30, maxval=70, step=5) // sweep: 40-60 step 5
atrLen = input.int(14, "ATR Length", minval=7, maxval=30, step=1)         // sweep: 7-21 step 2
tpRatio = input.float(1.0, "Take Profit (ATR multiple)", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-3.0 step 0.5
slRatio = input.float(1.5, "Stop Loss (ATR multiple)", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-3.0 step 0.5
tradeSession = input.string("0800-1600", "Trade Session (UTC)", group="Session Settings")

//--- indicator calculations
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- entry logic
// Long only: EMA5/13 crossover + RSI above threshold
// ADX filter removed to increase trade count (iter 244 had only 13 trades with ADX>25)
inSession = time(timeframe.period, tradeSession)
longCondition = ta.crossover(fastMA, slowMA) and rsiVal > rsiThreshold and inSession

if (longCondition)
    strategy.entry("Long", strategy.long)

//--- exit management (ATR-based TP/SL 1:1.5)
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=int(atrVal * slRatio / syminfo.mintick), profit=int(atrVal * tpRatio / syminfo.mintick))

//--- plots
plot(fastMA, "Fast EMA", color=color.blue, linewidth=1)
plot(slowMA, "Slow EMA", color=color.red, linewidth=1)
