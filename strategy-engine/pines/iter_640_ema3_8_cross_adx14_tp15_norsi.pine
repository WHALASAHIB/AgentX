//@version=6
strategy(title="iter_640 — BTCUSDT 30m EMA3/8 cross ADX14 TP15 (no RSI)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//====================================================================
// --- inputs
//====================================================================

// EMA periods
fastLen = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 1-10 step 1
slowLen = input.int(8, "Slow EMA", minval=1, maxval=100)       // sweep: 5-21 step 1

// ADX
adxLen  = input.int(14, "ADX Length", minval=2, maxval=50)     // sweep: 10-25 step 3
adxMin  = input.int(14, "ADX Minimum", minval=1, maxval=100)   // sweep: 14-25 step 3

// TP/SL — based on ATR
atrLen   = input.int(14, "ATR Length", minval=2, maxval=50)    // sweep: 7-21 step 7
tpMult   = input.float(1.5, "TP Multiplier (×ATR)", minval=0.1, maxval=10.0, step=0.1)  // sweep: 0.5-3.0 step 0.25
slMult   = input.float(1.0, "SL Multiplier (×ATR)", minval=0.1, maxval=10.0, step=0.1)  // sweep: 0.5-2.0 step 0.25

//====================================================================
// --- calculations
//====================================================================

// EMAs
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)

// Manual ADX calculation
hiLo = high - low
hiCl = math.abs(high - close[1])
loCl = math.abs(low - close[1])
tr = math.max(hiLo, hiCl, loCl)
atr = ta.rma(tr, atrLen)

dmPlus  = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0
dmMinus = low[1] - low > high - high[1] ? math.max(low[1] - low, 0) : 0

sDMplus  = ta.rma(dmPlus, adxLen)
sDMminus = ta.rma(dmMinus, adxLen)

diPlus  = 100 * sDMplus / atr
diMinus = 100 * sDMminus / atr

dx  = 100 * math.abs(diPlus - diMinus) / (diPlus + diMinus)
adx = ta.rma(dx, adxLen)

//--- entry signals — NO RSI filter (removed to increase trade count)
bullishCross = ta.crossover(fastEMA, slowEMA)
trending = adx > adxMin

// Long entry condition — just EMA3/8 crossover + ADX trend filter
longEntry = bullishCross and trending

//--- exit management
tpPrice = strategy.position_avg_price + (tpMult * atr * syminfo.mintick)
slPrice = strategy.position_avg_price - (slMult * atr * syminfo.mintick)

//====================================================================
// --- entry logic
//====================================================================
if (longEntry and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

//====================================================================
// --- exit management
//====================================================================
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", limit=tpPrice, stop=slPrice)
