//@version=5
strategy(title="iter_250_EMA_RSI_ADX_ATR_1_5", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(5, title="EMA Fast Length", minval=2, maxval=50, step=1)           // sweep: 2-20 step 1
ema_slow_len = input.int(13, title="EMA Slow Length", minval=5, maxval=100, step=1)          // sweep: 8-50 step 2
rsi_len = input.int(14, title="RSI Length", minval=5, maxval=30, step=1)                     // sweep: 7-21 step 2
rsi_threshold = input.int(50, title="RSI Threshold (long >, short <)", minval=30, maxval=70, step=5) // sweep: 40-60 step 5
adx_len = input.int(14, title="ADX Length", minval=7, maxval=30, step=1)                     // sweep: 10-28 step 2
adx_threshold = input.int(25, title="ADX Threshold (enter only if above)", minval=10, maxval=50, step=5) // sweep: 15-35 step 5
atr_len = input.int(14, title="ATR Length", minval=5, maxval=30, step=1)                     // sweep: 10-20 step 2
tp_atr_mult = input.float(1.0, title="TP (ATR multiplier)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 0.5-3.0 step 0.5
sl_atr_mult = input.float(1.5, title="SL (ATR multiplier)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 0.5-3.0 step 0.5

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
[di_plus, di_minus, adx_val] = ta.dmi(high, low, close, adx_len)
atr_val = ta.atr(atr_len)

//--- entry conditions
long_condition = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_threshold and adx_val > adx_threshold
short_condition = ta.crossunder(ema_fast, ema_slow) and rsi_val < (100 - rsi_threshold) and adx_val > adx_threshold

//--- entry logic
if (long_condition)
    strategy.entry("Long", strategy.long)

if (short_condition)
    strategy.entry("Short", strategy.short)

//--- exit management — ATR-based TP/SL
long_tp_level = close + (atr_val * tp_atr_mult)
long_sl_level = close - (atr_val * sl_atr_mult)
short_tp_level = close - (atr_val * tp_atr_mult)
short_sl_level = close + (atr_val * sl_atr_mult)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", limit=long_tp_level, stop=long_sl_level)

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", limit=short_tp_level, stop=short_sl_level)
