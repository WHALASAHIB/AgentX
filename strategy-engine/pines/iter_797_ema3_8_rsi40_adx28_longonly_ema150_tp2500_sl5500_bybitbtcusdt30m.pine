//@version=6
strategy(title="EMA3/8 RSI40 ManualADX28 LongOnly EMA150Filter BarrierExit TP2500 SL5500 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

// iter 797: SL BARRIER SWEEP CONTINUED -- LOOSE side per the iter-796 result
// (SL 5000 IMPROVED the TP2500 peak on every gate: 22 trades, PF 2.063 vs 1.79,
// Sharpe 2.21 vs 1.96, WR 77.3% equal, DD 1.55% vs 1.94%, net +$313.74 vs +$268.17,
// result 01KZ5N9ZKQBSW9AHAM59GTH4CG -- loosening the stop gave winners more room:
// avgBarsInTrade 7.14 -> 7.32, gross loss $338.65 -> $295.15, breakeven-WR margin
// widened 11.8pp -> 15.1pp; SL map so far at TP2500: SL4000 == SL4500 neutral <
// SL5000 PEAK; the improving direction is LOOSER SL, so the map is NOT complete).
// ONE change: stop_loss_tick 5000 -> 5500 on BYBIT:BTCUSDT.P 30m (take_profit_tick
// 2500 UNCHANGED; TP/SL ratio 0.5x -> 0.455x). Rationale: continue the loose-side
// sweep one step -- SL5500 (~1.22x ATR) gives winners even more room; if SL5500
// degrades below the TP2500/SL5000 peak (PF 2.06, net +$313.74), the SL map is
// complete (SL4000 == SL4500 < SL5000 PEAK > SL5500) and TP2500/SL5000 is the
// confirmed terminal current-store optimum -- next pivot is a new symbol/timeframe
// or indicator family per the exploration ledger (XAUUSD/GBPUSD/EURUSD/ETHUSDT
// 30m/1h/4h all previously mapped quality-negative on this stack).

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // iter 797: UNCHANGED at 3 (peak). sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // iter 797: UNCHANGED at 8 (peak). sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(40, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 797: RSI UNCHANGED at 40 (iter-769/770 peak). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(28, "ADX Threshold", minval=10, maxval=50)   // iter 797: ADX UNCHANGED at 28 (peak; ADX22 < ADX25 < ADX28 PEAK > ADX30 invalid). sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 797: regime EMA 150 (proven-best long-side). sweep: 100-200 step 50
take_profit_tick = input.int(2500, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 797: TP UNCHANGED at 2500 (PF peak, iter 792). sweep: 2000-4000 step 500
stop_loss_tick = input.int(5500, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 797: SL 5000 -> 5500 (SWEEP loose side, ~1.22x ATR). sweep: 3000-6500 step 500

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 797: SL barrier sweep loose side 5000 -> 5500 on
// the confirmed BYBIT:BTCUSDT.P 30m peak -- EMA3/8 + RSI40 + ADX28 + EMA150 long-only
// regime + TP2500/SL5500 manual barriers, flat-only, 1-bar min hold, NO breakeven.
// TP2500 UNCHANGED per the TP sweep mapping (TP map COMPLETE: TP2500 PF 1.79 PEAK,
// TP3500 net +$309.12 best net/Sharpe 1.98); only the SL half of the barrier pair moves.)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
