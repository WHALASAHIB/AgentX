//@version=5
strategy(title="EMA3_8_RSI60_40_ADX14_XAUUSD_H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)       // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)       // sweep: 5-21 step 2

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)               // sweep: 7-21 step 2
rsiLongThreshold = input.int(60, "RSI Long Threshold", minval=50, maxval=80)  // sweep: 50-70 step 5
rsiShortThreshold = input.int(40, "RSI Short Threshold", minval=20, maxval=50) // sweep: 20-50 step 5

// ADX parameters
adxLen = input.int(14, "ADX Length", minval=5, maxval=30)               // sweep: 10-25 step 3
adxThreshold = input.int(14, "ADX Threshold", minval=8, maxval=40)      // sweep: 10-25 step 2

// TP/SL parameters
slPercent = input.float(0.3, "Stop Loss %", minval=0.1, maxval=2.0, step=0.05)   // sweep: 0.1-1.0 step 0.1
tpRatio = input.float(1.5, "TP/SL Ratio", minval=0.5, maxval=5.0, step=0.1)      // sweep: 1.0-3.0 step 0.5

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

rsiVal = ta.rsi(close, rsiLen)

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

//--- entry logic
// Long conditions: EMA fast > EMA slow, RSI > long threshold, ADX > threshold
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiLongThreshold and adxVal > adxThreshold

// Short conditions: EMA fast < EMA slow, RSI < short threshold, ADX > threshold
shortCondition = ta.crossunder(emaFast, emaSlow) and rsiVal < rsiShortThreshold and adxVal > adxThreshold

//--- exit management
// Calculate SL and TP distances in price units
slDistance = close * (slPercent / 100.0)
tpDistance = slDistance * tpRatio

// Convert to ticks for strategy.exit
slTicks = int(slDistance / syminfo.mintick)
tpTicks = int(tpDistance / syminfo.mintick)

// Entry with explicit direction
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)

if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", loss=slTicks, profit=tpTicks)

//--- plot indicators for visual reference
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)
hline(rsiLongThreshold, "RSI Long Threshold", color=color.green, linestyle=hline.style_dotted)
hline(rsiShortThreshold, "RSI Short Threshold", color=color.red, linestyle=hline.style_dotted)
plot(rsiVal, "RSI", color=color.purple, display=display.none)
plot(adxVal, "ADX", color=color.orange, display=display.none)
hline(adxThreshold, "ADX Threshold", color=color.gray, linestyle=hline.style_dotted, display=display.none)
