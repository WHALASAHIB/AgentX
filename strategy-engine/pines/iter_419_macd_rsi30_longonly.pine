//@version=5
strategy(title="MACD_RSI30_LongOnly_XAUUSD_H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(5, "MACD Fast Length", minval=2, maxval=50)       // sweep: 2-20 step 1
slowLength = input.int(13, "MACD Slow Length", minval=5, maxval=50)      // sweep: 5-26 step 1
signalLength = input.int(5, "MACD Signal Smoothing", minval=2, maxval=20) // sweep: 2-9 step 1

// RSI filter
rsiLength = input.int(14, "RSI Length", minval=7, maxval=21)             // sweep: 7-21 step 1
rsiMin = input.int(30, "RSI Minimum for Long", minval=20, maxval=60)     // sweep: 20-60 step 5

// TP/SL
slPoints = input.int(100, "Stop Loss (points)", minval=20, maxval=500)    // sweep: 50-300 step 25
tpPoints = input.int(150, "Take Profit (points)", minval=30, maxval=750)  // sweep: 75-450 step 25

//--- indicator calculations
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
rsiValue = ta.rsi(close, rsiLength)

//--- entry logic
// MACD bullish crossover: MACD line crosses above signal line
macdBullish = ta.crossover(macdLine, signalLine)

// Long entry condition: MACD bullish crossover AND RSI above minimum threshold
longCondition = macdBullish and rsiValue > rsiMin

// Execute long entry when condition is met and we're flat
if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

//--- exit management
// Set TP/SL on the last entry bar (only once per position)
if (strategy.position_size > 0 and strategy.position_size == strategy.position_size[1])
    // No action — exit already set
    na
else if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=slPoints, profit=tpPoints)

//--- visual cues
plot(macdLine, "MACD", color.blue, 1)
plot(signalLine, "Signal", color.orange, 1)
hline(0, "Zero", color.gray, hline.style_dotted)
