//@version=5
strategy(title="EMA513 Cross RSI ADX22 Trail - Iter 136", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04)

//--- inputs
// EMA parameters
ema_fast_len = input.int(5, "EMA Fast Length", minval=1, maxval=50)     // sweep: 3-20 step 1
ema_slow_len = input.int(13, "EMA Slow Length", minval=1, maxval=50)    // sweep: 8-30 step 1

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)              // sweep: 7-21 step 1
rsi_threshold = input.int(50, "RSI Long Threshold", minval=1, maxval=99) // sweep: 40-60 step 5

// ADX parameters
adx_len = input.int(14, "ADX Length", minval=2, maxval=50)              // sweep: 7-28 step 1
adx_threshold = input.int(22, "ADX Threshold (trending only)", minval=1, maxval=99) // sweep: 14-30 step 2

// Trailing stop parameters — replaces fixed TP/SL
atr_len = input.int(14, "ATR Length for Trail Offset", minval=2, maxval=50)   // sweep: 7-21 step 1
trail_mult = input.float(1.0, "Trail Offset (×ATR)", minval=0.3, maxval=5.0, step=0.1) // sweep: 0.5-3.0 step 0.25

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX calculation (avoids ta.dmi() engine issues)
up = ta.change(high)
down = -ta.change(low)
plus_dm = up > down and up > 0 ? up : 0
minus_dm = down > up and down > 0 ? down : 0
tr_val = ta.tr(true)
atr_adx = ta.rma(tr_val, adx_len)
plus_di = 100 * ta.rma(plus_dm, adx_len) / atr_adx
minus_di = 100 * ta.rma(minus_dm, adx_len) / atr_adx
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.rma(dx, adx_len)

atr_val = ta.atr(atr_len)

//--- entry logic
long_condition = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_threshold and adx_val > adx_threshold

if long_condition
    strategy.entry("Long", strategy.long)

//--- exit management — ATR-based trailing stop (replaces fixed TP/SL)
// trail_offset = ATR in ticks, trailing stop activates immediately from entry
trail_offset_ticks = int(atr_val / syminfo.mintick * trail_mult)
strategy.exit("Trail Exit", "Long", trail_offset = trail_offset_ticks)
