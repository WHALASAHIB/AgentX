//@version=6
strategy(title="XAUUSD H1 — EMA3/8 Long-Only No RSI Filter", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
emaFast = input.int(3, "EMA Fast", minval=1, maxval=50)      // sweep: 2-10 step 1
emaSlow = input.int(8, "EMA Slow", minval=1, maxval=50)      // sweep: 5-21 step 1

// Fixed tick TP/SL
tpTicks = input.int(150, "Take Profit (ticks)", minval=10, maxval=500)   // sweep: 50-300 step 10
slTicks = input.int(100, "Stop Loss (ticks)", minval=10, maxval=500)    // sweep: 50-200 step 10

//--- indicator calculations
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)

//--- entry logic: EMA3/8 crossover long-only
longCondition = ta.crossover(emaF, emaS)
shortCondition = false  // long-only strategy

//--- entry
if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

//--- exit management: fixed tick TP/SL
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", limit=close + tpTicks * syminfo.mintick, stop=close - slTicks * syminfo.mintick)
