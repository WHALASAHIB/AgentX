//@version=5
// Strategy: EMA(5,10) Crossover + RSI(14)>50 + Manual ADX(14)>25 + Price>EMA50 + TP/SL 1:1.5 + MinHold=4
// Iteration 190 — Manual ADX computation (ta.adx not supported by engine)
// LONG ONLY — XAUUSD 30m

strategy(title="Iter 190 — EMA Cross + RSI + Manual ADX25", overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         commission_type=strategy.commission.percent,
         commission_value=0.04,
         process_orders_on_close=true)

//--- inputs
fast_len = input.int(5, "Fast EMA Length", minval=1, maxval=50)         // sweep: 3-10 step 1
slow_len = input.int(10, "Slow EMA Length", minval=1, maxval=50)         // sweep: 8-30 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)               // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold (min)", minval=1, maxval=100) // sweep: 40-70 step 5
adx_len = input.int(14, "ADX Length (manual)", minval=5, maxval=30)      // sweep: 10-20 step 2
adx_threshold = input.int(25, "ADX Threshold (min)", minval=10, maxval=50) // sweep: 20-30 step 5
ema50_len = input.int(50, "Trend EMA Length", minval=20, maxval=200)     // sweep: 30-200 step 10

tp_ratio = input.float(1.0, "Take Profit (×ATR)", minval=0.5, maxval=5.0)  // sweep: 0.5-3.0 step 0.5
sl_ratio = input.float(1.5, "Stop Loss (×ATR)", minval=0.5, maxval=5.0)    // sweep: 0.5-3.0 step 0.5
min_hold_bars = input.int(4, "Min Hold Bars", minval=1, maxval=20)       // sweep: 2-10 step 2

//--- indicators
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)
trend_ema = ta.ema(close, ema50_len)

//--- Manual ADX computation (since ta.adx() is not supported by Trader Dev engine)
// Step 1: True Range
tr_val = ta.tr(true)

// Step 2: Directional Movement
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

// Step 3: Smooth using RMA (Wilder's Moving Average)
smoothed_tr = ta.rma(tr_val, adx_len)
smoothed_plus_dm = ta.rma(plus_dm, adx_len)
smoothed_minus_dm = ta.rma(minus_dm, adx_len)

// Step 4: Directional Indicators (DI)
plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr

// Step 5: Directional Index (DX)
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

// Step 6: ADX = RMA of DX
adx_val = ta.rma(dx, adx_len)

//--- bar counting for min_hold
var int bars_since_entry = 0
bars_since_entry := bars_since_entry + 1

//--- entry logic (LONG ONLY)
long_condition = ta.crossover(fast_ema, slow_ema)
     and rsi_val > rsi_threshold
     and adx_val > adx_threshold
     and close > trend_ema

// Exit on EMA crossunder (only after min_hold)
exit_condition = ta.crossunder(fast_ema, slow_ema) and bars_since_entry >= min_hold_bars

//--- entry management
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    bars_since_entry := 0

//--- exit management
if exit_condition and strategy.position_size > 0
    strategy.close("Long")

// Exit via fixed TP/SL based on ATR
if strategy.position_size > 0
    atr_val = ta.atr(14)
    sl_price = strategy.position_avg_price - (sl_ratio * atr_val)
    tp_price = strategy.position_avg_price + (tp_ratio * atr_val)
    strategy.exit("TP/SL", "Long", loss=sl_price, profit=tp_price)
