//@version=6
strategy(title="Donchian RSI ADX14 30m", overlay=true, initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         commission_type=strategy.commission.percent, commission_value=0.04,
         process_orders_on_close=true)

//--- inputs
dc_len = input.int(20, "Donchian Length", minval=10, maxval=50, step=5)    // sweep: 10-50 step 5
rsi_len = input.int(14, "RSI Length", minval=7, maxval=21, step=1)           // sweep: 7-21 step 2
rsi_ob = input.int(70, "RSI Overbought", minval=60, maxval=80, step=5)      // sweep: 60-80 step 5
rsi_os = input.int(30, "RSI Oversold", minval=20, maxval=40, step=5)        // sweep: 20-40 step 5
adx_len = input.int(14, "ADX Length", minval=7, maxval=28, step=1)          // sweep: 7-28 step 1
adx_threshold = input.float(14.0, "ADX Threshold", minval=5, maxval=30, step=1) // sweep: 5-30 step 1
rsi_filter = input.bool(true, "RSI Filter On")
adx_filter = input.bool(true, "ADX Filter On")
atr_mult = input.float(2.0, "ATR Multiplier for Stops", minval=1.0, maxval=4.0, step=0.5) // sweep: 1-4 step 0.5
tp_ratio = input.float(1.5, "TP Ratio (Risk:Reward)", minval=1.0, maxval=3.0, step=0.5)   // sweep: 1-3 step 0.5

//--- indicators
donchian_top = ta.highest(high, dc_len)
donchian_bot = ta.lowest(low, dc_len)
donchian_mid = (donchian_top + donchian_bot) / 2
rsi_val = ta.rsi(close, rsi_len)
adx_val = ta.dmi(di_len=adx_len)[0]  // ta.dmi returns [adx, plus_di, minus_di]
plus_di = ta.dmi(di_len=adx_len)[1]
minus_di = ta.dmi(di_len=adx_len)[2]
atr_val = ta.atr(14)

//--- entry logic
long_condition = false
short_condition = false

// Breakout long: close > Donchian top
if (close > donchian_top)
    if (adx_filter == false or adx_val >= adx_threshold)
        if (rsi_filter == false or rsi_val > 50)
            long_condition := true

// Breakout short: close < Donchian bottom
if (close < donchian_bot)
    if (adx_filter == false or adx_val >= adx_threshold)
        if (rsi_filter == false or rsi_val < 50)
            short_condition := true

//--- exit management (ATR-based TP/SL)
sl_ticks = math.round(atr_val * atr_mult / syminfo.mintick)
tp_ticks = math.round(sl_ticks * tp_ratio)

//--- entries (pyramiding=0 means no overlapping positions)
if (long_condition)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)

if (short_condition)
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", loss=sl_ticks, profit=tp_ticks)
