//@version=6
strategy(title="iter_505_macd_rsi_tpsl — BTCUSDT 1h MACD+RSI+Fixed TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(12, "MACD Fast Length", minval=1)        // sweep: 8-16 step 2
slowLength = input.int(26, "MACD Slow Length", minval=1)        // sweep: 20-30 step 2
signalLength = input.int(9, "MACD Signal Length", minval=1)     // sweep: 7-12 step 1

// RSI filter
rsiLength = input.int(14, "RSI Length", minval=1)               // sweep: 10-20 step 2
rsiThreshold = input.int(50, "RSI Entry Threshold", minval=1)   // sweep: 40-60 step 5

// ATR for TP/SL
atrLength = input.int(14, "ATR Length", minval=1)               // sweep: 10-20 step 2
slMultiplier = input.float(1.0, "SL Multiplier (x ATR)", minval=0.1, step=0.1)   // sweep: 0.5-2.0 step 0.25
tpMultiplier = input.float(1.5, "TP Multiplier (x ATR)", minval=0.1, step=0.1)   // sweep: 1.0-3.0 step 0.5

//--- indicator calculations
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

//--- entry logic: MACD crosses above signal line AND RSI > threshold (long only)
macdCrossAbove = ta.crossover(macdLine, signalLine)
longCondition = macdCrossAbove and rsiValue > rsiThreshold

//--- exit management: fixed TP/SL based on ATR
slDistance = atrValue * slMultiplier
tpDistance = atrValue * tpMultiplier

//--- execution
if (longCondition)
    strategy.entry("Long", strategy.long)

// Apply fixed TP/SL to any open long position
if (strategy.position_size > 0)
    strategy.exit("TP/SL", "Long", loss=slDistance / syminfo.mintick, profit=tpDistance / syminfo.mintick)

//--- plot indicators for visual reference
plot(macdLine, color=color.blue, title="MACD Line")
plot(signalLine, color=color.orange, title="Signal Line")
hline(0, "Zero Line", color=color.gray)
