//@version=5
strategy(title="EMA513_RSI55_ADX15_TP2_emaexit_XAUUSD_30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// EMA parameters
ema_fast_len = input.int(5, "EMA Fast Length", minval=1, maxval=50)  // sweep: 3-10 step 1
ema_slow_len = input.int(13, "EMA Slow Length", minval=1, maxval=100) // sweep: 8-21 step 1

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)           // sweep: 7-21 step 1
rsi_threshold = input.int(55, "RSI Entry Threshold (long if > this)", minval=1, maxval=100)  // sweep: 50-70 step 5

// ADX parameters
adx_len = input.int(14, "ADX Length", minval=2, maxval=50)           // sweep: 7-21 step 1
adx_threshold = input.int(15, "ADX Minimum Threshold", minval=1, maxval=100)  // sweep: 10-30 step 5

// ATR-based TP/SL parameters
atr_len = input.int(14, "ATR Length", minval=2, maxval=50)           // sweep: 7-21 step 1
sl_atr_mult = input.float(1.0, "SL ATR Multiplier", minval=0.1, maxval=5.0, step=0.1)  // sweep: 0.5-3.0 step 0.25
tp_atr_mult = input.float(2.0, "TP ATR Multiplier", minval=0.1, maxval=5.0, step=0.1)  // sweep: 1.0-3.0 step 0.25  // CHANGED from 1.5 to 2.0 for 2:1 TP/SL ratio

//--- indicator calculations

// EMAs
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

// RSI
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX calculation (engine may not support ta.adx)
// DMI calculation: +DI and -DI from high/low/close
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
atr_smooth = ta.sma(tr, adx_len)

up = high - high[1]
down = low[1] - low

plus_dm = up > down and up > 0 ? up : 0
minus_dm = down > up and down > 0 ? down : 0

plus_di = 100 * ta.sma(plus_dm, adx_len) / atr_smooth
minus_di = 100 * ta.sma(minus_dm, adx_len) / atr_smooth

dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.sma(dx, adx_len)

// ATR for TP/SL
atr_val = ta.atr(atr_len)

// EMA crossover conditions
ema_cross_up = ta.crossover(ema_fast, ema_slow)
ema_cross_down = ta.crossunder(ema_fast, ema_slow)

//--- entry logic — LONG ONLY

long_entry = ema_cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold

//--- exit management

// Calculate TP and SL levels based on ATR
sl_distance = sl_atr_mult * atr_val
tp_distance = tp_atr_mult * atr_val

// Convert distances to ticks
sl_ticks = math.round(sl_distance / syminfo.mintick)
tp_ticks = math.round(tp_distance / syminfo.mintick)

// Enter long
if long_entry
    strategy.entry("Long", strategy.long)

// Exit with fixed TP/SL (risk boundary) — now 2:1 ratio (2xATR TP / 1xATR SL)
if strategy.position_size > 0
    strategy.exit("TP/SL", "Long", loss=sl_ticks, profit=tp_ticks)

// Also exit on EMA crossunder (recycle capital for new entries when trend reverses)
if ema_cross_down and strategy.position_size > 0
    strategy.close("Long", comment="ema_xunder_exit")
