//@version=6
strategy(title="EMA3/8 Crossover + ATR Trail 1.5x (BTC 30m)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50, group="EMA Settings")  // sweep: 2-10 step 1
slow_len = input.int(8, "Slow EMA Length", minval=1, maxval=50, group="EMA Settings")   // sweep: 5-21 step 1
atr_len  = input.int(14, "ATR Length", minval=5, maxval=50, group="ATR Trail")          // sweep: 7-21 step 2
atr_mult = input.float(1.5, "ATR Trail Multiplier", step=0.1, minval=0.5, maxval=5.0, group="ATR Trail")  // sweep: 1.0-4.0 step 0.5
use_ts   = input.bool(true, "Use Trailing Stop", group="Exit Management")

//--- indicator calculations
ema_fast = ta.ema(close, fast_len)
ema_slow = ta.ema(close, slow_len)
atr_val  = ta.atr(atr_len)

//--- entry logic
long_condition = ta.crossover(ema_fast, ema_slow)
short_condition = ta.crossunder(ema_fast, ema_slow)

if (long_condition)
    strategy.entry("Long", strategy.long)

if (short_condition)
    strategy.entry("Short", strategy.short)

//--- exit management — trailing ATR stop
if (use_ts and strategy.position_size != 0)
    trail_price = strategy.position_avg_price + (strategy.position_size > 0 ? -atr_val * atr_mult : atr_val * atr_mult)
    strategy.exit("Trail", "Long", stop=trail_price, qty_percent=100, comment="TrailExit")
