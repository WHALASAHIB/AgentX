//@version=5
strategy(title="EMA(5,10) Crossover LONG ONLY XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
fast_len = input.int(5, "Fast EMA Length", minval=2, maxval=50, group="EMA Settings")  // sweep: 2-20 step 1
slow_len = input.int(10, "Slow EMA Length", minval=5, maxval=100, group="EMA Settings") // sweep: 8-30 step 2

// RSI filter
rsi_len   = input.int(14, "RSI Length", minval=7, maxval=28, group="RSI Filter")       // sweep: 7-28 step 7
rsi_thresh = input.int(55, "RSI Long Threshold", minval=40, maxval=80, group="RSI Filter") // sweep: 40-80 step 10

// ADX filter
adx_len      = input.int(14, "ADX Length", minval=7, maxval=28, group="ADX Filter")        // sweep: 7-28 step 7
adx_thresh   = input.int(14, "ADX Minimum", minval=5, maxval=40, group="ADX Filter")       // sweep: 5-40 step 5

// ATR for SL/TP
atr_len      = input.int(14, "ATR Length", minval=5, maxval=28, group="Risk Management")   // sweep: 5-28 step 5
tp_sl_ratio  = input.float(2.0, "TP:SL Ratio", minval=1.0, maxval=5.0, step=0.5, group="Risk Management") // sweep: 1.0-4.0 step 0.5
atr_mult_sl  = input.float(1.0, "ATR Multiple for SL", minval=0.5, maxval=5.0, step=0.5, group="Risk Management") // sweep: 0.5-3.0 step 0.5
min_hold     = input.int(5, "Minimum Hold Bars", minval=1, maxval=20, group="Exit Settings") // sweep: 1-20 step 1

//--- manual ADX calculation (ta.adx not supported in Trader Dev engine)
// True Range
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
atr_val = ta.rma(tr, atr_len)

// Directional Movement
up_move = high - high[1]
down_move = low[1] - low
plus_dm = 0.0
minus_dm = 0.0
if (up_move > down_move and up_move > 0)
    plus_dm := up_move
else
    plus_dm := 0.0
if (down_move > up_move and down_move > 0)
    minus_dm := down_move
else
    minus_dm := 0.0

// Smoothed DM
plus_di = 100 * ta.rma(plus_dm, adx_len) / atr_val
minus_di = 100 * ta.rma(minus_dm, adx_len) / atr_val

// DX and ADX
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.rma(dx, adx_len)

//--- calculations
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)

//--- entry logic
long_condition = ta.crossover(fast_ema, slow_ema) and rsi_val > rsi_thresh and adx_val > adx_thresh

//--- exit management
// Track bars since entry
var int bars_since_entry = 0
if (strategy.position_size > 0)
    bars_since_entry := bars_since_entry + 1
else
    bars_since_entry := 0

// Determine SL and TP prices on entry
var float long_sl_price = na
var float long_tp_price = na

if (long_condition and strategy.position_size == 0)
    long_sl_price := close - (atr_val * atr_mult_sl)
    long_tp_price := close + (atr_val * atr_mult_sl * tp_sl_ratio)

// EMA crossunder exit (only after min_hold bars)
ema_crossunder_exit = ta.crossunder(fast_ema, slow_ema) and bars_since_entry >= min_hold

//--- execute entry
if (long_condition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

//--- execute exit
if (strategy.position_size > 0)
    // Fixed SL/TP exit
    strategy.exit("XL", "Long", loss=long_sl_price, profit=long_tp_price)
    // EMA crossunder exit (after min hold period)
    if (ema_crossunder_exit)
        strategy.close("Long", comment="XUnderExit")
