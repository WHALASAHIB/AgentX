//@version=6
strategy(title="Supertrend3/7 RSI30 ManualADX22 EMA100Filter BarrierExit TP3000 SL4500 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

// iter 778: CONTINUE the Supertrend(3,7) family on BYBIT:BTCUSDT.P 30m per the iter-776/777 plan.
// iter 777: EMA regime 150->100 SATURATED -- on the SAME 4610-bar window vs the iter-776 control,
// the trade set is IDENTICAL (5 trades, 4W/1L, WR 80%, PF 2.08, net +$70.35): EMA100 admitted ZERO
// new flip entries because every qualifying flip_up already had close > EMA100 at entry; the binding
// constraint is the flip event + ADX>22 + RSI>40 combination, NOT the regime gate. The ADX lever was
// already exhausted (iter 776: 28->22 gained +1 trade only). Per the iter-776 plan, the next (and
// FINAL) relaxation lever is RSI threshold 40->30 -- ONE change this iteration. Rationale: RSI>40
// rejects flip_up events when RSI sits in the 30-40 zone; RSI30 admits those earlier/lower-momentum
// flips, targeting trade count >20. Risk: RSI30 admits weak-momentum whipsaw flips (quality could
// drop from the WR 80%/PF 2.08 held so far) -- but with only 5 trades the sample is statistically
// meaningless anyway. Precedent: iter 770 RSI 40->30 on the EMA family was SATURATED (identical
// trade set, filter not binding below 40). If RSI30 is also identical here, ALL relaxation levers
// are exhausted: abandon the supertrend family pivot (conclusively entry-starved, not quality-starved)
// and REVERT to the iter-774 EMA3/8 ADX28 peak (24 trades, PF 1.66, WR 70.8%, net +$273.58).

//--- inputs
st_factor = input.float(3.0, "Supertrend ATR Factor", minval=1.0, maxval=10.0, step=0.5)   // sweep: 1.0-5.0 step 0.5 (iter 778: factor 3.0 per iter-714 precedent)
st_period = input.int(7, "Supertrend ATR Period", minval=3, maxval=21, step=1)             // sweep: 3-21 step 2 (iter 778: period 7 per iter-714 precedent)
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(30, "RSI Threshold (long above / short below)", minval=20, maxval=80)  // iter 778: RSI 40->30 (ONE change; FINAL relaxation lever -- iter-777 plan). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(22, "ADX Threshold", minval=10, maxval=50)   // iter 778: ADX UNCHANGED at 22 (iter-776; 28->22 gained +1 trade only, lever exhausted). sweep: 15-35 step 5
ema_regime_len = input.int(100, "Regime EMA Length", minval=50, maxval=300)   // iter 778: regime EMA UNCHANGED at 100 (iter-777; 150->100 SATURATED, identical trade set). sweep: 100-200 step 50
take_profit_tick = input.int(3000, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 778: TP UNCHANGED at 3000 (iter-765 peak, ~0.75x ATR). sweep: 2000-4000 step 500
stop_loss_tick = input.int(4500, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 778: SL UNCHANGED at 4500 (iter-765 peak, ~1x ATR). sweep: 3000-6000 step 500

//--- indicator calculations
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- Supertrend (built-in; returns [line, direction], direction: 1 = up, -1 = down)
[st_line, st_dir] = ta.supertrend(st_factor, st_period)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- flip-change detection (only enter on direction CHANGE, not every bar)
flip_up = ta.crossover(st_dir, 0)
flip_down = ta.crossunder(st_dir, 0)

//--- entry conditions (both directions; filter stack UNCHANGED from iter-777 except RSI 40->30)
long_condition = flip_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime
short_condition = flip_down and rsi_val < rsi_threshold and adx_val > adx_threshold and close < ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var float short_tp = na
var float short_sl = na
var int entry_bar = -1

//--- entry logic (flat only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    short_tp := close - take_profit_tick * syminfo.mintick
    short_sl := close + stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")

if strategy.position_size < 0 and bar_index > entry_bar
    if low <= short_tp
        strategy.close("Short", comment="TP")
    if high >= short_sl
        strategy.close("Short", comment="SL")
