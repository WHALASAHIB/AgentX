//@version=5
strategy(title="MACD(8,17,7)+RSI(50)+ADX(20) LONG-only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fast_len    = input.int(8,   "MACD Fast Length",   minval=2, maxval=30, step=1)   // sweep: 5-14 step 1
slow_len    = input.int(17,  "MACD Slow Length",   minval=10, maxval=50, step=1)  // sweep: 12-26 step 2
signal_len  = input.int(7,   "MACD Signal Length", minval=3, maxval=15, step=1)   // sweep: 5-12 step 1

// RSI parameters
rsi_len     = input.int(14,  "RSI Length",  minval=5, maxval=30, step=1)           // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold (long above)", minval=30, maxval=70, step=5) // sweep: 40-60 step 5

// ADX parameters
adx_len     = input.int(14,  "ADX Length",         minval=7, maxval=30, step=1)   // sweep: 10-20 step 2
adx_threshold = input.int(20, "ADX Threshold (enter above)", minval=10, maxval=40, step=5) // sweep: 15-25 step 5

// ATR-based TP/SL parameters
atr_len     = input.int(14,  "ATR Length",         minval=7, maxval=30, step=1)   // sweep: 10-20 step 2
sl_atr_mult = input.float(1.0, "SL Multiplier (x ATR)",  minval=0.5, maxval=3.0, step=0.25) // sweep: 0.5-2.0 step 0.25
tp_atr_mult = input.float(1.5, "TP Multiplier (x ATR)",  minval=0.5, maxval=5.0, step=0.25) // sweep: 1.0-3.0 step 0.25

// Trade session filter
trade_hour_start = input.int(0, "Trade Session Start (UTC hour)", minval=0, maxval=23, step=1)  // sweep: 0-8 step 2
trade_hour_end   = input.int(23, "Trade Session End (UTC hour)",   minval=0, maxval=23, step=1)  // sweep: 16-23 step 1

//--- indicator calculations
[macd_line, signal_line, macd_hist] = ta.macd(close, fast_len, slow_len, signal_len)
rsi_val = ta.rsi(close, rsi_len)
[di_plus, di_minus, adx_val] = ta.dmi(high, low, close, adx_len)
atr_val = ta.atr(atr_len)

//--- entry logic
in_session = (hour >= trade_hour_start and hour <= trade_hour_end)

// LONG entry condition: MACD crossover + RSI > threshold + ADX > threshold
long_entry = ta.crossover(macd_line, signal_line) and rsi_val > rsi_threshold and adx_val > adx_threshold and in_session

// Emergency exit condition: MACD crossunder
long_exit = ta.crossunder(macd_line, signal_line)

//--- position management
if (long_entry and strategy.position_size == 0)
    stop_loss   = close - (atr_val * sl_atr_mult)
    take_profit = close + (atr_val * tp_atr_mult)
    strategy.entry("MACD-LONG", strategy.long)
    strategy.exit("MACD-EXIT", "MACD-LONG", loss=close - stop_loss, profit=take_profit - close)

// Emergency exit on MACD crossunder
if (long_exit and strategy.position_size > 0)
    strategy.close("MACD-LONG", comment="MACD-XU")
