//@version=5
strategy(title="EMA5/13 RSI40 ADX25 LongOnly XAUUSD 1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFast = input.int(5, "EMA Fast Period")        // sweep: 3-10 step 1
emaSlow = input.int(13, "EMA Slow Period")       // sweep: 10-21 step 2

// RSI parameters
rsiLen   = input.int(14, "RSI Length")           // sweep: 10-21 step 2
rsiThresh = input.int(40, "RSI Minimum (LONG-only)") // sweep: 40-60 step 5

// ADX parameters
adxLen = input.int(14, "ADX Length")             // sweep: 10-21 step 2
adxMin = input.int(25, "Min ADX (trend filter)") // sweep: 20-30 step 5

// TP/SL
tpPoints = input.int(150, "Take Profit (points)") // sweep: 50-300 step 25
slPoints = input.int(100, "Stop Loss (points)")   // sweep: 50-300 step 25

//--- indicator calculations
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLen)

// Manual ADX calculation using DMI (ta.adx not available on Trader Dev)
up = ta.change(high)
down = -ta.change(low)
plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atr = ta.sma(tr, adxLen)
plusDI = 100 * ta.sma(plusDM, adxLen) / atr
minusDI = 100 * ta.sma(minusDM, adxLen) / atr
dx = math.abs(plusDI - minusDI) / (plusDI + minusDI) * 100
adxVal = ta.sma(dx, adxLen)

//--- entry logic
// LONG entry: EMA fast crosses above EMA slow AND RSI > threshold AND ADX > min (trending market)
longCondition = ta.crossover(emaF, emaS) and rsiVal > rsiThresh and adxVal > adxMin

// Exit condition: EMA fast crosses below EMA slow
exitCondition = ta.crossunder(emaF, emaS)

//--- entry management
if (longCondition)
    strategy.entry("Long", strategy.long)

//--- exit management
if (strategy.position_size > 0)
    // Fixed TP/SL exit
    strategy.exit("XL", "Long", loss=slPoints * syminfo.mintick, profit=tpPoints * syminfo.mintick)
    // Also exit on crossover signal
    if (exitCondition)
        strategy.close("Long")
