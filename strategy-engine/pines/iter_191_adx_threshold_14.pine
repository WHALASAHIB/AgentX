//@version=5
strategy(title="EMA5_10_RSI50_ADX14_EMA50_LONG_ONLY_ATR_TP_SL_1x1.5", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fast_len = input.int(5, "Fast EMA Length", minval=2, maxval=50)       // sweep: 3-10 step 1
slow_len = input.int(10, "Slow EMA Length", minval=5, maxval=100)     // sweep: 8-30 step 2

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)            // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold (above = long only)", minval=30, maxval=70)  // sweep: 40-60 step 5

// ADX parameters (manual calculation)
adx_len = input.int(14, "ADX Length", minval=5, maxval=30)            // sweep: 7-25 step 2
adx_threshold = input.int(14, "ADX Threshold (min trend strength)", minval=5, maxval=40)  // sweep: 10-25 step 2 — lowered from 25 to 14 to allow more entries

// EMA50 trend filter
ema50_len = input.int(50, "EMA Trend Filter Length", minval=20, maxval=200)  // sweep: 20-100 step 10

// Trade management
min_hold_bars = input.int(4, "Minimum Hold Bars", minval=1, maxval=20)  // sweep: 2-10 step 1
tp_sl_ratio = input.float(1.5, "TP:SL Ratio (TP = ratio × SL)", minval=0.5, maxval=5.0, step=0.1)  // sweep: 0.5-3.0 step 0.25
atr_mult_sl = input.float(1.0, "ATR Multiplier for SL", minval=0.5, maxval=5.0, step=0.5)  // sweep: 0.5-3.0 step 0.5

//--- indicator calculation
// EMAs
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
ema50 = ta.ema(close, ema50_len)

// RSI
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX(14) calculation
// True Range
tr_val = ta.tr(true)
// Directional Movement
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0
// Smoothed values
atr_smooth = ta.rma(tr_val, adx_len)
plus_di_raw = 100 * ta.rma(plus_dm, adx_len) / atr_smooth
minus_di_raw = 100 * ta.rma(minus_dm, adx_len) / atr_smooth
// DX and ADX
dx = 100 * math.abs(plus_di_raw - minus_di_raw) / (plus_di_raw + minus_di_raw)
adx_val = ta.rma(dx, adx_len)

// ATR for position sizing
atr_val = ta.atr(14)

// Crossover / crossunder detection
ema_cross_over = ta.crossover(fast_ema, slow_ema)
ema_cross_under = ta.crossunder(fast_ema, slow_ema)

//--- entry logic
// Long conditions: EMA crossover above slow EMA, RSI > threshold, ADX > threshold, price above EMA50
long_condition = ema_cross_over and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema50

// Track entry bar index to enforce minimum hold
var int entry_bar = na
var float entry_price = na
var float sl_price = na
var float tp_price = na

// Calculate ATR-based SL and TP distances
sl_distance = atr_val * atr_mult_sl
tp_distance = sl_distance * tp_sl_ratio

// Entry: when conditions are met and no position is open
if long_condition and strategy.position_size == 0
    entry_bar := bar_index
    entry_price := close
    sl_price := close - sl_distance  // Long SL below entry
    tp_price := close + tp_distance  // Long TP above entry
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=sl_distance / syminfo.mintick, profit=tp_distance / syminfo.mintick)

//--- exit management (EMA crossunder exit after minimum hold)
if strategy.position_size > 0 and bar_index >= entry_bar + min_hold_bars
    if ema_cross_under
        strategy.close("Long", comment="EMA_XU")

//--- plot indicators for visual reference
plot(fast_ema, "Fast EMA", color=color.blue, linewidth=1)
plot(slow_ema, "Slow EMA", color=color.red, linewidth=1)
plot(ema50, "EMA50", color=color.purple, linewidth=1)

// ADX and RSI background coloring for debugging
hline(adx_threshold, "ADX Threshold", color=color.gray, linestyle=hline.style_dashed)
plot(adx_val, "ADX", color=color.orange, display=display.none)
plot(rsi_val, "RSI", color=color.green, display=display.none)
