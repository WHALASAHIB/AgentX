//@version=5
strategy(title="EMA3/8 Cross + RSI + ADX Filter", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA fast period
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)          // sweep: 2-10 step 1
// EMA slow period
emaSlowLen = input.int(8, "EMA Slow Length", minval=5, maxval=100)          // sweep: 5-30 step 2
// RSI period
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)                   // sweep: 7-21 step 2
// RSI oversold threshold (long only above this)
rsiOversold = input.int(50, "RSI Oversold Threshold", minval=30, maxval=70) // sweep: 30-60 step 5
// RSI overbought threshold (short only below this)
rsiOverbought = input.int(50, "RSI Overbought Threshold", minval=30, maxval=70) // sweep: 30-60 step 5
// ADX period
adxLen = input.int(14, "ADX Length", minval=7, maxval=30)                   // sweep: 7-21 step 2
// ADX threshold (enter only if trending)
adxThreshold = input.int(25, "ADX Threshold", minval=15, maxval=40)         // sweep: 20-35 step 3
// Stop Loss % of close
slPct = input.float(0.3, "Stop Loss %", step=0.05)                          // sweep: 0.1-0.5 step 0.05
// Take Profit ratio vs SL (1:1 = 1.0, 1:1.5 = 1.5, etc.)
tpRatio = input.float(1.0, "TP/SL Ratio", step=0.1, minval=0.5, maxval=5.0) // sweep: 0.5-3.0 step 0.2

//--- calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
[adxVal, _, _] = ta.dmi(adxLen, adxLen)

//--- entry signals
// Long: EMA fast crosses above slow, RSI > oversold threshold, ADX > threshold
longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiOversold and adxVal > adxThreshold
// Short: EMA fast crosses below slow, RSI < overbought threshold, ADX > threshold
shortCondition = ta.crossunder(emaFast, emaSlow) and rsi < rsiOverbought and adxVal > adxThreshold

//--- entry management
if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

//--- exit management with fixed percentage-based stops
// Calculate SL and TP distances in ticks
slTicks = (slPct / 100.0) * close / syminfo.mintick
tpTicks = slTicks * tpRatio

// Exit existing positions
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=math.round(slTicks), profit=math.round(tpTicks))

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", loss=math.round(slTicks), profit=math.round(tpTicks))

//--- visual indicators
plot(emaFast, "EMA Fast", color.blue, 1)
plot(emaSlow, "EMA Slow", color.red, 1)
hline(50, "RSI Mid", color.gray, hline.style_dashed)
