//@version=5
strategy(title="EMA3/8 Cross + RSI(50/50) 2:1 TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
emaFast = input.int(3, "EMA Fast Period", minval=1, maxval=50)       // sweep: 2-10 step 1
emaSlow = input.int(8, "EMA Slow Period", minval=2, maxval=50)        // sweep: 5-20 step 1

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)             // sweep: 7-21 step 2
rsiOverbought = input.int(70, "RSI Overbought", minval=50, maxval=90) // sweep: 60-80 step 5
rsiOversold   = input.int(30, "RSI Oversold", minval=10, maxval=50)   // sweep: 20-40 step 5

// TP/SL parameters
tpRatio = input.float(2.0, "TP Ratio (x SL)", minval=0.5, maxval=5.0, step=0.1) // sweep: 1.0-3.0 step 0.5
slPct   = input.float(0.3, "SL % of Price", minval=0.1, maxval=2.0, step=0.1)   // sweep: 0.1-1.0 step 0.1

// Trade settings
useRsiFilter = input.bool(true, "Use RSI Filter (50/50)")             // sweep: true/false

//--- indicator calculations
emaFastVal = ta.ema(close, emaFast)
emaSlowVal = ta.ema(close, emaSlow)
rsiVal     = ta.rsi(close, rsiLen)

//--- crossover detection
crossAbove = ta.crossover(emaFastVal, emaSlowVal)  // fast EMA crosses above slow EMA → long signal
crossBelow = ta.crossunder(emaFastVal, emaSlowVal) // fast EMA crosses below slow EMA → short signal

//--- entry logic
enterLong  = crossAbove and (not useRsiFilter or rsiVal > 50)
enterShort = crossBelow and (not useRsiFilter or rsiVal < 50)

//--- entry execution
if enterLong
    strategy.entry("Long", strategy.long)

if enterShort
    strategy.entry("Short", strategy.short)

//--- exit management
// Calculate SL distance and TP distance in ticks
slTicks = int(slPct * close / syminfo.mintick)
tpTicks = int(slTicks * tpRatio)

// Apply exits to any open position
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=slTicks, profit=tpTicks)
