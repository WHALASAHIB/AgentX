//@version=5
strategy(
  title="EMA Cross + RSI(40) + ADX(25) TP1.5:SL1 LONG ONLY XAUUSD 30m",
  overlay=true,
  initial_capital=10000,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=100,
  commission_type=strategy.commission.percent,
  commission_value=0.04,
  process_orders_on_close=true
)

//--- inputs

// EMA fast period
emaFastLen = input.int(5, "EMA Fast Length", minval=2, maxval=50)
// sweep: 3-10 step 1

// EMA slow period
emaSlowLen = input.int(13, "EMA Slow Length", minval=5, maxval=100)
// sweep: 8-26 step 2

// RSI period and threshold
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)
// sweep: 7-21 step 1
rsiMin = input.int(40, "RSI Minimum (Long Only)", minval=20, maxval=70)
// sweep: 30-55 step 5

// ADX period and threshold
adxLen = input.int(14, "ADX Length", minval=5, maxval=30)
// sweep: 10-20 step 2
adxMin = input.int(25, "ADX Minimum (Trending)", minval=10, maxval=50)
// sweep: 20-35 step 5

// ATR for stops
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)
// sweep: 10-20 step 2

// TP and SL multipliers (1.5:1 ratio)
tpMult = input.float(1.5, "Take Profit (×ATR)", minval=0.5, maxval=5.0, step=0.1)
// sweep: 1.0-3.0 step 0.1
slMult = input.float(1.0, "Stop Loss (×ATR)", minval=0.5, maxval=5.0, step=0.1)
// sweep: 0.5-2.0 step 0.1

//--- indicator calculations

// EMAs
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// RSI
rsi = ta.rsi(close, rsiLen)

// ADX
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

// ATR
atr = ta.atr(atrLen)

//--- entry logic

// Entry condition: EMA fast crosses above EMA slow + RSI > minimum + ADX > minimum
longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiMin and adx > adxMin
// Re-entry condition: EMA fast stays above EMA slow + price > emaFast (pullback bounce) + RSI > minimum + ADX > minimum
// (allows multiple entries in a strong uptrend but not on every bar)
reEntryCondition = emaFast > emaSlow and close > emaFast and rsi > rsiMin and adx > adxMin

// Exit condition: EMA fast crosses below EMA slow (trend reversal)
exitLong = ta.crossunder(emaFast, emaSlow)

//--- entry management

// Long entries when conditions met (LONG ONLY strategy)
if longCondition
    strategy.entry("EL", strategy.long, comment="EMA_X_LONG")

// Alternative: additional entries on pullback re-confirmation
// Only re-enter if we don't already have a position AND trend is confirmed
if reEntryCondition and strategy.position_size <= 0
    strategy.entry("EL_Re", strategy.long, comment="EMA_RE_LONG")

//--- exit management

// Exit: set TP/SL via strategy.exit on each order
// Use ATR-based TP/SL with 1.5:1 ratio
if strategy.position_size > 0
    strategy.exit("XL", "EL", loss=int(slMult * atr / syminfo.mintick), profit=int(tpMult * atr / syminfo.mintick))
    strategy.exit("XL_Re", "EL_Re", loss=int(slMult * atr / syminfo.mintick), profit=int(tpMult * atr / syminfo.mintick))

// Trend reversal exit (cascade guard — close only on opposite signal)
if exitLong and strategy.position_size > 0
    strategy.close("EL", comment="TREND_REV_EXIT")
    strategy.close("EL_Re", comment="TREND_REV_EXIT")
