//@version=5
strategy(title="MACD RSI50 LONG-only XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(12, "MACD Fast Length", minval=1)     // sweep: 8-16 step 2
slowLength = input.int(26, "MACD Slow Length", minval=1)     // sweep: 20-30 step 2
signalLength = input.int(9, "MACD Signal Length", minval=1)  // sweep: 7-12 step 1

// RSI filter
rsiLength = input.int(14, "RSI Length", minval=1)            // sweep: 10-20 step 2
rsiThreshold = input.int(50, "RSI Entry Threshold", minval=1)// sweep: 40-60 step 5

// ATR-based stop management
atrLength = input.int(14, "ATR Length", minval=1)            // sweep: 10-20 step 2
slMultiplier = input.float(1.5, "ATR SL Multiplier", step=0.5)// sweep: 1.0-3.0 step 0.5
useAtrStop = input.bool(true, "Use ATR-based Stop")          // sweep: true/false

//--- calculate indicators
// MACD
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
macdBullish = ta.crossover(macdLine, signalLine)

// RSI
rsiValue = ta.rsi(close, rsiLength)
rsiAboveThreshold = rsiValue > rsiThreshold

// ATR
atrValue = ta.atr(atrLength)

//--- entry logic
longCondition = macdBullish and rsiAboveThreshold

//--- exit management
var float entryPrice = na
var float slPrice = na
var int barSinceEntry = na

if longCondition and strategy.position_size == 0
    // Entry: MACD bullish crossover AND RSI above threshold
    strategy.entry("Long", strategy.long)
    entryPrice := close
    slPrice := close - (atrValue * slMultiplier)
    barSinceEntry := bar_index
    
    // Exit with ATR-based stop
    strategy.exit("Long Exit", "Long", stop=slPrice)

// Exit on MACD bearish crossover (signal exit)
if macdLine < signalLine and strategy.position_size > 0 and ta.crossover(signalLine, macdLine)
    strategy.close("Long", comment="MACD Crossunder Exit")

//--- visual cues
plot(macdLine, "MACD Line", color.blue, 1)
plot(signalLine, "Signal Line", color.orange, 1)
hline(0, "Zero Line", color.gray, hline.style_dashed)
plot(rsiValue, "RSI", color.purple, 1)
hline(rsiThreshold, "RSI Threshold", color.red, hline.style_dashed)
