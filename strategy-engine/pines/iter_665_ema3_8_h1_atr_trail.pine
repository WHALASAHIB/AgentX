//@version=6
strategy(title="XAUUSD H1 EMA3/8 ATR Trail", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)        // sweep: 1-20 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=100)        // sweep: 5-30 step 1
atrLen = input.int(14, "ATR Length", minval=1, maxval=50)                 // sweep: 7-21 step 2
atrMult = input.float(3.0, "ATR Trail Multiplier", minval=0.5, maxval=10.0, step=0.5)  // sweep: 1.5-5.0 step 0.5
useTrailOffset = input.bool(true, "Use Trail Offset (vs trailing stop)")  // if true, trail offset calc; else trailing stop

//--- indicator calcs
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atr = ta.atr(atrLen)

//--- crossover detection
bullishCross = ta.crossover(emaFast, emaSlow)
bearishCross = ta.crossunder(emaFast, emaSlow)

//--- entry logic — long only
if (bullishCross)
    strategy.entry("LONG", strategy.long)

//--- exit management: ATR-based trailing stop
// entry_price tracks last entry
var float entryPrice = na
if (strategy.position_size > 0 and na(entryPrice))
    entryPrice := close
if (strategy.position_size == 0)
    entryPrice := na

// trailing stop level = highest high since entry - atrMult * atr
var float trailStop = na
if (strategy.position_size > 0)
    float newTrail = high - (atrMult * atr)
    if (na(trailStop) or newTrail > trailStop)
        trailStop := newTrail
    strategy.exit("TRAIL", "LONG", stop=trailStop)
else
    trailStop := na

//--- visual aids
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)
plot(strategy.position_size > 0 ? trailStop : na, "Trail Stop", color=color.green, style=plot.style_linebr)
