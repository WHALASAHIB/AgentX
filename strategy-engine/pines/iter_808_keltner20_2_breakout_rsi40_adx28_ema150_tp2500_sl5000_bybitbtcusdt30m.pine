//@version=6
strategy(title="Keltner20x2 Breakout RSI40 ManualADX28 EMA150LongOnly BarrierExit TP2500 SL5000 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

// iter 808: KELTNER CHANNEL FAMILY -- first test on the REFERENCE symbol
// (BYBIT:BTCUSDT.P 30m, engine tv_jul26_mc7). Store locked at iter-796 champion
// (EMA3/8 + RSI40 + ADX28 + EMA150 long-only + TP2500/SL5000 manual barriers,
// PF 2.06 / Sharpe 2.21 / WR 77.3% / 22 trades / +$313.74); fresh-symbol pivots
// STOPPED after 3 consecutive failures (ETH 30m PF 0.76-0.96, SOL 30m zero trades,
// XRP 30m zero trades, 1h transfer PF 0.604).
// ONE change: new indicator family -- Keltner Channel (20, 2.0) BREAKOUT long-only:
// long when close crosses ABOVE the upper Keltner band, with the proven filter stack
// retained (RSI40 + ADX28 + EMA150 long-only regime), TP2500/SL5000 manual tick
// barriers, flat-only, 1-bar min hold, NO breakeven. Entry via crossover (not
// persistent close > band) to fire once per breakout leg.
// Decision rule: PF >= 1.5 and trades >= 20 -> candidate store peak (sweep TP/SL
// from there); PF 1.3-1.5 -> incremental; below PF 1.3 -> Keltner family closed on
// fixed barriers, then conclude the fixed-tick exploration (all families mapped,
// store locked at iter-796).

//--- inputs
kc_ema_len = input.int(20, "KC EMA Length", minval=5, maxval=50, step=1)        // sweep: 10-30 step 5
kc_atr_mult = input.float(2.0, "KC ATR Multiplier", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)                       // sweep: 7-21 step 7
rsi_threshold = input.int(40, "RSI Threshold (long above)", minval=20, maxval=80)  // proven peak 40. sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)                       // sweep: 7-21 step 7
adx_threshold = input.int(28, "ADX Threshold", minval=10, maxval=50)             // proven peak 28. sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)      // proven best long-side 150. sweep: 100-200 step 50
take_profit_tick = input.int(2500, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // proven peak 2500. sweep: 2000-4000 step 500
stop_loss_tick = input.int(5000, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // proven peak 5000. sweep: 3000-6000 step 500

//--- indicator calculations
kc_ema = ta.ema(close, kc_ema_len)
kc_atr = ta.atr(kc_ema_len)
kc_upper = kc_ema + kc_atr_mult * kc_atr
kc_lower = kc_ema - kc_atr_mult * kc_atr
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- entry logic (Keltner breakout, long-only, flat-only, filters retained)
cross_up = ta.crossover(close, kc_upper)

// Long entry: close crosses above upper Keltner band AND RSI > 40 AND ADX > 28
// AND close above EMA150 long-only regime.
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
