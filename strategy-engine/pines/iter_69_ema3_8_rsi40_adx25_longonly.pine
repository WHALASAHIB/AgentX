//@version=5
strategy(title="iter_69_EMA3_8_RSI40_ADX25_LONGONLY_XAUUSD_H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA fast period
emaFast = input.int(3, "EMA Fast", minval=1, maxval=50)     // sweep: 2-10 step 1
// EMA slow period
emaSlow = input.int(8, "EMA Slow", minval=2, maxval=100)     // sweep: 5-20 step 1
// RSI period
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)    // sweep: 7-21 step 2
// RSI threshold
rsiThresh = input.int(40, "RSI Threshold", minval=1, maxval=99) // sweep: 30-60 step 5
// ADX period
adxLen = input.int(14, "ADX Length", minval=2, maxval=50)    // sweep: 7-21 step 2
// ADX threshold
adxThresh = input.int(25, "ADX Threshold", minval=1, maxval=99) // sweep: 20-35 step 5
// ATR period for stops
atrPeriod = input.int(14, "ATR Period", minval=2, maxval=50) // sweep: 7-21 step 2
// Stop loss as ATR multiplier
slMultiplier = input.float(1.5, "SL ATR Multiplier", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-3.0 step 0.5
// Take profit as ATR multiplier
tpMultiplier = input.float(1.0, "TP ATR Multiplier", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-3.0 step 0.5

//--- indicator calculations
emaFastVal = ta.ema(close, emaFast)
emaSlowVal = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
atrVal = ta.atr(atrPeriod)

//--- entry logic
// Entry conditions: EMA crossover AND RSI > threshold AND ADX > threshold (trend filter)
longEntry = ta.crossover(emaFastVal, emaSlowVal) and rsiVal > rsiThresh and adxVal > adxThresh

// Exit condition: EMA crossunder (trend reversal)
longExit = ta.crossunder(emaFastVal, emaSlowVal)

//--- position management
// Entry: LONG only on crossover + RSI confirmation + ADX trending filter
if longEntry and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

// Exit on EMA crossunder (trend reversal)
if longExit and strategy.position_size > 0
    strategy.close("Long")

// Emergency stop-loss and take-profit using ATR-based levels
// Place when position is opened (handled via strategy.exit on next bar)
if strategy.position_size > 0 and strategy.position_size[1] == 0
    stopLevel = close - atrVal * slMultiplier
    profitLevel = close + atrVal * tpMultiplier
    strategy.exit("XL", "Long", loss=abs((close - stopLevel) / syminfo.mintick), profit=abs((profitLevel - close) / syminfo.mintick))
