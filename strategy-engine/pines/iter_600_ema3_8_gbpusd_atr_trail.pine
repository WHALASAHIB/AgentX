//@version=6
strategy(title="iter_600_EMA3_8_GBPUSD_ATR_Trail", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

// ============================================================
// --- inputs
// ============================================================

// EMAs
emaFastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50)       // sweep: 2-10 step 1
emaSlowLen = input.int(8, "Slow EMA Length", minval=1, maxval=50)        // sweep: 5-21 step 2

// ATR trailing stop
atrLen  = input.int(14, "ATR Length", minval=5, maxval=50)               // sweep: 7-21 step 2
atrMult = input.float(3.0, "ATR Multiplier", minval=0.5, maxval=10.0, step=0.5) // sweep: 1.5-5.0 step 0.5

// ============================================================
// --- calculations
// ============================================================

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)

// Long-only ratchet trail: highest close - ATR*mult, never lower
var float trailStop = na

// Crossover detection
bool crossoverLong  = ta.crossover(emaFast, emaSlow)
bool crossunderLong = ta.crossunder(emaFast, emaSlow)

// ============================================================
// --- entry logic (long-only)
// ============================================================

// Enter long on EMA3 cross above EMA8
if crossoverLong
    strategy.entry("EL", strategy.long)
    trailStop := close - atrVal * atrMult

// ============================================================
// --- exit management (ATR trailing stop via strategy.exit)
// ============================================================

if strategy.position_size > 0
    // Ratchet trail up — never lower
    trailStop := math.max(trailStop, close - atrVal * atrMult)
    // Set trailing stop via strategy.exit — updated each bar
    strategy.exit("XL", "EL", stop=trailStop)

    // Also exit if fast EMA crosses below slow EMA (trend reversal)
    if crossunderLong
        strategy.exit("EXL", "EL", stop=close)  // immediate exit
