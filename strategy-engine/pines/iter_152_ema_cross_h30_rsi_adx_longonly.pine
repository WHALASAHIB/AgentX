//@version=5
// Strategy: EMA(5,13) Crossover + RSI(14) > 50 + ADX(14) > 14 + TP/SL 1.5:1
// Direction: LONG ONLY
// Symbol: XAUUSD, Timeframe: 30m
// Reverting RSI threshold from 55 (iter 151) back to 50 to restore trade count
// ADX calculated manually (ta.adx not supported by Trader Dev engine)

strategy(
    title="EMA5_13_RSI50_ADX14_LONGONLY",
    overlay=true,
    initial_capital=10000,
    default_qty_type=strategy.percent_of_equity,
    default_qty_value=100,
    commission_type=strategy.commission.percent,
    commission_value=0.04,
    process_orders_on_close=true
)

// --- inputs ---

// EMA parameters
ema_fast_len = input.int(5, title="Fast EMA Length", minval=1, maxval=50)  // sweep: 3-10 step 1
ema_slow_len = input.int(13, title="Slow EMA Length", minval=1, maxval=50)  // sweep: 8-21 step 2

// RSI parameters
rsi_len = input.int(14, title="RSI Length", minval=2, maxval=50)  // sweep: 7-21 step 2
rsi_threshold = input.int(50, title="RSI Entry Threshold (min)", minval=1, maxval=100)  // sweep: 40-60 step 5

// ADX parameters
adx_len = input.int(14, title="ADX Length", minval=2, maxval=50)  // sweep: 7-21 step 2
adx_threshold = input.float(14, title="ADX Minimum Threshold", minval=1, maxval=50)  // sweep: 8-25 step 2

// TP/SL parameters
tp_sl_ratio = input.float(1.5, title="TP:SL Ratio", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.0-3.0 step 0.5
atr_mult_sl = input.float(1.0, title="ATR Multiplier for SL", minval=0.5, maxval=5.0, step=0.1)  // sweep: 0.5-2.0 step 0.5
atr_len = input.int(14, title="ATR Length", minval=5, maxval=50)  // sweep: 10-20 step 2

// --- manual ADX(14) calculation ---
// True Range
hi_lo = high - low
hi_cl = math.abs(high - close[1])
lo_cl = math.abs(low - close[1])
tr = math.max(hi_lo, math.max(hi_cl, lo_cl))

// Directional movement
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

// Smoothed TR and DM
smoothed_tr = ta.ema(tr, adx_len)
smoothed_plus_dm = ta.ema(plus_dm, adx_len)
smoothed_minus_dm = ta.ema(minus_dm, adx_len)

// Directional indicators
plus_di = smoothed_plus_dm / smoothed_tr * 100
minus_di = smoothed_minus_dm / smoothed_tr * 100

// DX and ADX
dx = math.abs(plus_di - minus_di) / (plus_di + minus_di) * 100
adx_val = ta.ema(dx, adx_len)

// --- indicator calculations ---

// EMAs
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

// RSI
rsi_val = ta.rsi(close, rsi_len)

// ATR for dynamic stops
atr_val = ta.atr(atr_len)

// Entry conditions
ema_cross_over = ta.crossover(ema_fast, ema_slow)
rsi_ok = rsi_val > rsi_threshold
adx_ok = adx_val > adx_threshold

long_entry = ema_cross_over and rsi_ok and adx_ok

// Exit conditions (close-based)
ema_cross_under = ta.crossunder(ema_fast, ema_slow)
rsi_exit = rsi_val < rsi_threshold - 10
adx_exit = adx_val < adx_threshold - 5

long_exit = ema_cross_under or rsi_exit or adx_exit

// --- entry logic ---

if long_entry and strategy.position_size == 0
    stop_loss = atr_mult_sl * atr_val
    take_profit = stop_loss * tp_sl_ratio
    
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=stop_loss / syminfo.mintick, profit=take_profit / syminfo.mintick)

// --- exit management (close-based) ---

if long_exit and strategy.position_size > 0
    strategy.close("Long", comment="Exit")

// --- visual plots ---

plot(ema_fast, title="Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow, title="Slow EMA", color=color.red, linewidth=1)

hline(rsi_threshold, title="RSI Threshold", color=color.gray, linestyle=hline.style_dashed)
hline(adx_threshold, title="ADX Threshold", color=color.purple, linestyle=hline.style_dashed)

// Background highlight for active positions
bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : na, title="Active Position")
