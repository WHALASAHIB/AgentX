//@version=5
strategy(title="MACD 8/17/9 Both Sides - XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(8, title="MACD Fast Length", minval=2, maxval=50)  // sweep: 5-14 step 2
slowLength = input.int(17, title="MACD Slow Length", minval=5, maxval=50)  // sweep: 12-26 step 3
signalLength = input.int(9, title="MACD Signal Length", minval=3, maxval=20)  // sweep: 5-14 step 2

// Trade direction
useLong = input.bool(true, title="Enable Long Entries")
useShort = input.bool(true, title="Enable Short Entries")

// ATR stop/target parameters
atrLength = input.int(14, title="ATR Length", minval=5, maxval=30)  // sweep: 10-20 step 2
atrStopMult = input.float(1.5, title="ATR Stop Loss Multiplier", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.0-3.0 step 0.5
atrTpMult = input.float(2.0, title="ATR Take Profit Multiplier", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.0-4.0 step 0.5

// Minimum hold bars
minHoldBars = input.int(0, title="Min Bars to Hold", minval=0, maxval=20)  // sweep: 0-10 step 2

//--- indicator calculations
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
atr = ta.atr(atrLength)

// Determine entries per bar
var int barsSinceEntry = 999
var bool inPosition = false

//--- entry logic: MACD crossover
// Long: MACD line crosses above signal line
longCondition = ta.crossover(macdLine, signalLine)
// Short: MACD line crosses below signal line
shortCondition = ta.crossunder(macdLine, signalLine)

//--- exit management
if (longCondition and useLong and not inPosition)
    strategy.entry("MACD_Long", strategy.long)
    inPosition := true
    barsSinceEntry := 0

if (shortCondition and useShort and not inPosition)
    strategy.entry("MACD_Short", strategy.short)
    inPosition := true
    barsSinceEntry := 0

// Track bars since entry
if (inPosition)
    barsSinceEntry := barsSinceEntry + 1

// Set stop loss and take profit for long positions
if (strategy.position_size > 0 and barsSinceEntry >= minHoldBars)
    stopLevel = close - atr * atrStopMult
    profitLevel = close + atr * atrTpMult
    strategy.exit("Long_Exit", "MACD_Long", loss=math.round((close - stopLevel) / syminfo.mintick), profit=math.round((profitLevel - close) / syminfo.mintick))

// Set stop loss and take profit for short positions
if (strategy.position_size < 0 and barsSinceEntry >= minHoldBars)
    stopLevel = close + atr * atrStopMult
    profitLevel = close - atr * atrTpMult
    strategy.exit("Short_Exit", "MACD_Short", loss=math.round((stopLevel - close) / syminfo.mintick), profit=math.round((close - profitLevel) / syminfo.mintick))

// Reset when flat
if (strategy.position_size == 0)
    inPosition := false
    barsSinceEntry := 999
