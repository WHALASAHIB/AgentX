//@version=6
strategy(title="EMA3/8 H1 No RSI ATR TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50, step=1)        // sweep: 2-10 step 1
slowLen = input.int(8, "Slow EMA Length", minval=1, maxval=50, step=1)        // sweep: 5-21 step 2
atrLen  = input.int(14, "ATR Length", minval=5, maxval=50, step=1)            // sweep: 10-21 step 2
tpMult  = input.float(1.0, "TP Multiplier (xATR)", minval=0.5, maxval=5.0, step=0.1)  // sweep: 0.5-3.0 step 0.5
slMult  = input.float(1.5, "SL Multiplier (xATR)", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.0-3.0 step 0.5

//--- indicators
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
atrVal  = ta.atr(atrLen)

//--- entry logic
longCondition = ta.crossover(fastEma, slowEma)

if longCondition
    strategy.entry("Long", strategy.long)

//--- exit management
// Use ATR-based trailing stop/take-profit in points
if strategy.position_size > 0
    entryPrice = strategy.position_avg_price
    slPips = math.round(slMult * atrVal / syminfo.mintick)
    tpPips = math.round(tpMult * atrVal / syminfo.mintick)
    strategy.exit("XL", "Long", loss=slPips, profit=tpPips)

//--- plot EMAs for visual reference
plot(fastEma, "Fast EMA", color=color.blue, linewidth=1)
plot(slowEma, "Slow EMA", color=color.red, linewidth=1)
