//@version=6
strategy(
  title="PSAR + EMA Trend Filter + Fixed Tick 1.5:1 TP/SL — XAUUSD H1",
  overlay=true,
  initial_capital=10000,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=100,
  commission_type=strategy.commission.percent,
  commission_value=0.04,
  process_orders_on_close=true
)

//=== INPUTS ===

// PSAR settings
psarStart     = input.float(0.02, "PSAR Step", step=0.005, minval=0.005, maxval=0.1)     // sweep: 0.01-0.05 step 0.01
psarIncrement = input.float(0.02, "PSAR Increment", step=0.01, minval=0.01, maxval=0.1)   // sweep: 0.02-0.05 step 0.01
psarMax       = input.float(0.2, "PSAR Maximum", step=0.05, minval=0.1, maxval=0.5)       // sweep: 0.1-0.5 step 0.1

// Trend filter — EMA alignment (replaces ADX which is unsupported in this engine)
emaFast       = input.int(20, "Fast EMA", minval=10, maxval=50)                           // sweep: 10-50 step 10
emaSlow       = input.int(50, "Slow EMA", minval=30, maxval=100)                          // sweep: 30-100 step 10

// Fixed TP/SL in ticks (ensures exact 1.5:1 ratio — no ATR drift)
slTicks       = input.int(100, "SL Ticks", minval=30, maxval=300)                          // sweep: 50-200 step 25
tpTicks       = input.int(150, "TP Ticks", minval=45, maxval=450)                          // sweep: 75-300 step 25

//=== INDICATORS ===

// PSAR returns a single value (the PSAR level). Direction: PSAR below close = uptrend (1), above = downtrend (-1)
psarVal = ta.sar(psarStart, psarIncrement, psarMax)
psarDir = close > psarVal ? 1 : -1

// EMA trend filter: fast EMA above slow EMA = bullish trending market
emaFastVal = ta.ema(close, emaFast)
emaSlowVal = ta.ema(close, emaSlow)
trendUp = emaFastVal > emaSlowVal

//=== ENTRY LOGIC ===

// Long-only: PSAR bullish AND EMA trend confirms uptrend
longCondition = psarDir == 1 and trendUp

// Enter long when conditions are met
if longCondition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

//=== EXIT MANAGEMENT ===

// Fixed tick-based stop loss and take profit
// Uses syminfo.mintick to convert ticks to price distance
// This guarantees exact 1.5:1 TP:SL ratio regardless of ATR fluctuations
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=slTicks * syminfo.mintick, profit=tpTicks * syminfo.mintick)
