//@version=6
strategy(title="iter_646 — EMA2/5 cross ADX14", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04)

fastLen = 2
slowLen = 5
adxLen = 14
adxMin = 14
atrLen = 14
tpMult = 1.5
slMult = 1.0

fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
atr = ta.atr(atrLen)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

bullishCross = ta.crossover(fastEMA, slowEMA)
trending = adx > adxMin

longEntry = bullishCross and trending

tpPrice = strategy.position_avg_price + (tpMult * atr * syminfo.mintick)
slPrice = strategy.position_avg_price - (slMult * atr * syminfo.mintick)

if (longEntry and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", limit=tpPrice, stop=slPrice)
