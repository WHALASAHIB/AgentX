//@version=5
strategy(title="MACD(8,17,7) H1 LONG-only noRSI", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLen = input.int(8, "MACD Fast Length", minval=2, maxval=50, tooltip="Fast EMA length for MACD calculation")
// sweep: 5-12 step 1
slowLen = input.int(17, "MACD Slow Length", minval=5, maxval=100, tooltip="Slow EMA length for MACD calculation")
// sweep: 12-26 step 2
signalLen = input.int(7, "MACD Signal Length", minval=2, maxval=20, tooltip="Signal line smoothing length")
// sweep: 5-12 step 1

// ATR-based TP/SL
atrLen = input.int(14, "ATR Length", minval=7, maxval=30, tooltip="Period for ATR calculation")
// sweep: 7-21 step 2
slMultiplier = input.float(1.0, "SL Multiplier (x ATR)", minval=0.3, maxval=3.0, step=0.1, tooltip="Stop loss as multiple of ATR")
// sweep: 0.5-2.0 step 0.3
tpMultiplier = input.float(1.5, "TP Multiplier (x ATR)", minval=0.3, maxval=5.0, step=0.1, tooltip="Take profit as multiple of ATR")
// sweep: 1.0-3.0 step 0.5

// Trading hours (24h by default — set UTC)
tradeStart = input.int(0, "Trading Start Hour (UTC)", minval=0, maxval=23, tooltip="Hour (UTC) to start allowing trades")
// sweep: 0-8 step 2
tradeEnd = input.int(23, "Trading End Hour (UTC)", minval=0, maxval=23, tooltip="Hour (UTC) to stop allowing trades")
// sweep: 16-23 step 2

//--- MACD calculation
[macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, signalLen)
macdHist = macdLine - signalLine

//--- ATR calculation
atrValue = ta.atr(atrLen)

//--- Entry logic
// LONG entry: MACD line crosses above signal line
longCondition = ta.crossover(macdLine, signalLine)

// Time filter (UTC)
inTradingHours = (hour(time) >= tradeStart and hour(time) <= tradeEnd)

// Entry condition
enterLong = longCondition and inTradingHours

//--- Exit management
// Use strategy.exit with ATR-based TP and SL
// SL distance in ticks
slTicks = int(atrValue * slMultiplier / syminfo.mintick)
tpTicks = int(atrValue * tpMultiplier / syminfo.mintick)

//--- Order execution
if (enterLong and strategy.position_size == 0)
    strategy.entry("MACD_Long", strategy.long)

if (strategy.position_size > 0)
    strategy.exit("MACD_Exit", "MACD_Long", loss=slTicks, profit=tpTicks)

//--- Plotting
plot(macdLine, "MACD Line", color=color.blue, linewidth=1)
plot(signalLine, "Signal Line", color=color.orange, linewidth=1)
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dotted)

// Plot Buy signals
plotshape(enterLong and strategy.position_size == 0, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
