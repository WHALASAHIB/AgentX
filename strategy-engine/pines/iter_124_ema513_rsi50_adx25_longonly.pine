//@version=5
// Strategy: EMA(5,13) crossover + RSI(14)>50 + ADX(14)>25 LONG ONLY
// Target: XAUUSD 30m
// This iteration: Raise ADX minimum from 14 to 25 (Wilder strong trend default)
// Rationale: iter 123 had Sharpe 0.12 with ADX(14) — too many range-bound entries.
// ADX(25) historically produced Sharpe 0.66-0.95 with 31 trades (iter 112).

strategy(title="EMA(5,13) RSI50 ADX25 LongOnly XAUUSD 30m", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- inputs

// EMA parameters
ema_fast_len = input.int(5, "Fast EMA Length", minval=1, maxval=50, group="EMA")
ema_slow_len = input.int(13, "Slow EMA Length", minval=1, maxval=100, group="EMA")  // sweep: 8-21 step 3

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=1, maxval=50, group="RSI")              // sweep: 7-21 step 7
rsi_min = input.int(50, "RSI Minimum (Long Only)", minval=1, maxval=100, group="RSI") // sweep: 30-70 step 10

// ADX parameters
adx_len = input.int(14, "ADX Length", minval=1, maxval=50, group="ADX")               // sweep: 10-30 step 5
adx_min = input.int(25, "ADX Minimum Threshold", minval=1, maxval=100, group="ADX")   // sweep: 14-40 step 5

// TP/SL parameters
tp_ratio = input.float(1.5, "Take Profit (x ATR)", minval=0.1, maxval=10.0, step=0.1, group="TP/SL")  // sweep: 1.0-3.0 step 0.5
sl_ratio = input.float(1.0, "Stop Loss (x ATR)", minval=0.1, maxval=10.0, step=0.1, group="TP/SL")    // sweep: 0.5-2.0 step 0.5
atr_len = input.int(14, "ATR Length", minval=1, maxval=100, group="TP/SL")

//--- indicator calculations

// EMAs
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

// RSI
rsi_val = ta.rsi(close, rsi_len)

// ADX — directional movement indicator (Wilder's original)
// Using ta.dmi() which returns +DI, -DI, and ADX series
[di_plus, di_minus, adx] = ta.dmi(adx_len, adx_len)

// ATR for dynamic TP/SL distances
atr_val = ta.atr(atr_len)

//--- entry logic
// LONG: EMA fast crosses above EMA slow + RSI > 50 + ADX > 25 (strong trend)
long_condition = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_min and adx > adx_min

// EXIT conditions — tracked via strategy.exit with predetermined TP/SL
// No re-entry logic to avoid cascade-close pattern (cascade ratio must be 1.0)

if (long_condition)
    // Place entry at market on close
    strategy.entry("Long", strategy.long)

    // Set exit with ATR-based TP and SL distances
    // TP = entry_price + tp_ratio * atr
    // SL = entry_price - sl_ratio * atr
    // Convert to ticks for strategy.exit
    tp_distance_ticks = math.round(tp_ratio * atr_val / syminfo.mintick)
    sl_distance_ticks = math.round(sl_ratio * atr_val / syminfo.mintick)

    strategy.exit("Long Exit", "Long",
         loss=sl_distance_ticks,
         profit=tp_distance_ticks)

//--- visual plot
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=1)

// Plot ADX in a separate pane for visual reference — commented out to avoid pane overlap
// plot(adx, "ADX", color=color.purple)
// hline(adx_min, "ADX Threshold", color=color.gray, linestyle=hline.style_dashed)
