//@version=5
strategy(title="EMA513_RSI50_ADX14_LONGONLY", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(5, "Fast EMA Length", minval=1, maxval=50)        // sweep: 3-10 step 1
ema_slow_len = input.int(13, "Slow EMA Length", minval=1, maxval=100)      // sweep: 10-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)                 // sweep: 7-21 step 2
rsi_min = input.int(50, "RSI Minimum (Long Only)", minval=20, maxval=80)   // sweep: 40-60 step 5
adx_len = input.int(14, "ADX Length", minval=2, maxval=50)                 // sweep: 7-21 step 2
adx_threshold = input.int(14, "ADX Minimum Threshold", minval=1, maxval=50) // sweep: 8-25 step 2
tp_sl_ratio = input.float(1.5, "Take Profit / Stop Loss Ratio", minval=0.5, maxval=5.0)  // sweep: 1.0-2.5 step 0.25
sl_atr_mult = input.float(1.0, "SL ATR Multiplier", minval=0.5, maxval=5.0)              // sweep: 0.75-2.0 step 0.25
atr_len = input.int(14, "ATR Length", minval=5, maxval=50)                               // sweep: 7-21 step 2
use_session = input.bool(true, "Session Filter (8-16 UTC)")                              // sweep: true/false

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX calculation using EMA for smoothing (Trader Dev Pine engine compatibility)
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0
smoothed_tr = ta.ema(tr, adx_len)
smoothed_plus_dm = ta.ema(plus_dm, adx_len)
smoothed_minus_dm = ta.ema(minus_dm, adx_len)
plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.ema(dx, adx_len)

atr_val = ta.atr(atr_len)

//--- session filter (London/NY overlap: 8-16 UTC)
in_session = not use_session or (hour >= 8 and hour < 16)

//--- entry logic
ema_cross_over = ta.crossover(ema_fast, ema_slow)
ema_cross_under = ta.crossunder(ema_fast, ema_slow)

// LONG ONLY: Enter when EMA fast crosses above slow, RSI > threshold, ADX > threshold, in session
long_condition = ema_cross_over and rsi_val > rsi_min and adx_val > adx_threshold and in_session

//--- exit management
sl_distance = sl_atr_mult * atr_val
tp_distance = tp_sl_ratio * sl_distance
sl_ticks = math.round(sl_distance / syminfo.mintick)
tp_ticks = math.round(tp_distance / syminfo.mintick)

// Entry: LONG ONLY
if long_condition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=sl_ticks, profit=tp_ticks)

// Exit on bearish cross if in position (trend reversal)
if ema_cross_under and strategy.position_size > 0
    strategy.close("Long")

//--- visual signals
plot(ema_fast, "EMA Fast", color.blue)
plot(ema_slow, "EMA Slow", color.red)
hline(adx_threshold, "ADX Threshold", color.gray, hline.style_dashed)
plotchar(long_condition, "Long Signal", "▲", location.belowbar, color.green, size=size.small)
