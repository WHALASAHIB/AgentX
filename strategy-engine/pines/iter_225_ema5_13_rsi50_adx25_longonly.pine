//@version=5
strategy(title="EMA5_13_RSI50_ADX25_LongOnly — Iter 225", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=20, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fastLen = input.int(5, "Fast EMA Length", minval=1, maxval=50)         // sweep: 3-10 step 1
slowLen = input.int(13, "Slow EMA Length", minval=1, maxval=100)       // sweep: 8-30 step 2

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)              // sweep: 7-21 step 2
rsiThreshold = input.int(50, "RSI Min (long)", minval=1, maxval=100)   // sweep: 40-60 step 5

// ADX parameters
adxLen = input.int(14, "ADX Length", minval=2, maxval=50)              // sweep: 7-21 step 2
adxThreshold = input.int(25, "ADX Min (trend filter)", minval=10, maxval=50) // sweep: 20-30 step 2

// ATR-based TP/SL parameters
atrLen = input.int(14, "ATR Length", minval=2, maxval=50)              // sweep: 7-21 step 2
slMultiplier = input.float(1.0, "SL Multiplier (×ATR)", minval=0.1, maxval=5.0, step=0.1)  // sweep: 0.5-2.0 step 0.2
tpRatio = input.float(1.5, "TP:SL Ratio (e.g. 1.5 = 1.5×SL)", minval=0.5, maxval=5.0, step=0.1) // sweep: 1.0-3.0 step 0.5

// Trailing stop parameters
trailActivate = input.float(1.0, "Trailing Activate (×ATR)", minval=0.1, maxval=5.0, step=0.1) // sweep: 0.5-2.0 step 0.3
trailOffset = input.float(0.5, "Trailing Offset (×ATR)", minval=0.1, maxval=5.0, step=0.1)   // sweep: 0.3-1.5 step 0.2

// Minimum bars hold
minHoldBars = input.int(4, "Minimum Bars Hold", minval=1, maxval=50)   // sweep: 2-10 step 1

//--- indicator calculations
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(high, low, close, adxLen)
atr = ta.atr(atrLen)

//--- entry logic
// Long condition: EMA5 > EMA13 (bullish crossover/alignment), RSI > 50, ADX > 25 (trending)
longCondition = fastMA > slowMA and rsi > rsiThreshold and adx > adxThreshold

// Track bars since last entry to enforce min hold
var int barsSinceEntry = 999
if (strategy.position_size != strategy.position_size[1])
    barsSinceEntry := 0
else
    barsSinceEntry := barsSinceEntry + 1

// Entry
if (longCondition and strategy.position_size == 0 and barsSinceEntry >= minHoldBars)
    strategy.entry("LONG", strategy.long)

//--- exit management
if (strategy.position_size > 0)
    slPrice = close - (atr * slMultiplier)
    tpPrice = close + (atr * slMultiplier * tpRatio)
    strategy.exit("EXIT_LONG", "LONG", loss=(close - slPrice) / syminfo.mintick, profit=(tpPrice - close) / syminfo.mintick, trail_price=close + atr * trailActivate, trail_offset=(atr * trailOffset) / syminfo.mintick)
