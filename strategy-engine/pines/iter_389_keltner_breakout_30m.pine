//@version=5
strategy(title="Keltner Channels Breakout XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Keltner Channels parameters
kc_ema_len = input.int(20, "KC EMA Length", minval=5, maxval=50, step=1)        // sweep: 10-30 step 5
kc_atr_mult = input.float(2.0, "KC ATR Multiplier", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5

// Entry filters
rsi_len = input.int(14, "RSI Length", minval=7, maxval=21, step=1)               // sweep: 10-20 step 2
rsi_threshold = input.int(50, "RSI Minimum (long)", minval=30, maxval=60, step=5) // sweep: 40-55 step 5

// Risk management
atr_len = input.int(14, "ATR Length for TP/SL", minval=7, maxval=21, step=1)     // sweep: 10-20 step 2
tp_atr_mult = input.float(2.0, "Take Profit (ATR multiples)", minval=0.5, maxval=4.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
sl_atr_mult = input.float(1.0, "Stop Loss (ATR multiples)", minval=0.5, maxval=3.0, step=0.5)    // sweep: 0.5-2.0 step 0.5

//--- calculations
// Keltner Channels
kc_ema = ta.ema(close, kc_ema_len)
kc_atr = ta.atr(kc_ema_len)
kc_upper = kc_ema + kc_atr_mult * kc_atr
kc_lower = kc_ema - kc_atr_mult * kc_atr

// Momentum
rsi_val = ta.rsi(close, rsi_len)

// ATR for TP/SL distance
atr_val = ta.atr(atr_len)

//--- entry logic
// Long condition: close above upper Keltner band + RSI above threshold
long_entry = close > kc_upper and rsi_val > rsi_threshold

// Entry on first bar where condition is true (prevent re-entry)
enter_long = long_entry and (na(long_entry[1]) or not long_entry[1])

//--- exit management
// Calculate TP and SL levels in ticks
sl_ticks = (sl_atr_mult * atr_val) / syminfo.mintick
tp_ticks = (tp_atr_mult * atr_val) / syminfo.mintick

//--- strategy execution
if enter_long
    strategy.entry("KeltnerLong", strategy.long)
    strategy.exit("KeltnerExit", "KeltnerLong", loss=sl_ticks, profit=tp_ticks, comment="TP/SL")

//--- visual plots
plot(kc_ema, "KC EMA Basis", color=color.blue, linewidth=1)
plot(kc_upper, "KC Upper", color=color.green, linewidth=1)
plot(kc_lower, "KC Lower", color=color.red, linewidth=1)
