//@version=5
strategy(title="iter_288 Bollinger Mean Reversion XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_length = input.int(20, "BB Length", minval=5, maxval=50)        // sweep: 10-30 step 5
bb_mult = input.float(2.0, "BB StdDev", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5
rsi_length = input.int(14, "RSI Length", minval=5, maxval=30)       // sweep: 7-21 step 7
rsi_oversold = input.int(30, "RSI Oversold Threshold", minval=15, maxval=40)  // sweep: 20-35 step 5
rsi_overbought = input.int(70, "RSI Overbought Threshold", minval=60, maxval=85) // sweep: 65-80 step 5
atr_length = input.int(14, "ATR Length", minval=7, maxval=30)       // sweep: 10-21 step 5
sl_atr_mult = input.float(1.5, "SL ATR Multiplier", minval=0.5, maxval=3.0, step=0.5) // sweep: 1.0-2.5 step 0.5
tp_atr_mult = input.float(1.0, "TP ATR Multiplier", minval=0.5, maxval=3.0, step=0.5) // sweep: 0.5-2.0 step 0.5

//--- indicator calculations
bb_basis = ta.sma(close, bb_length)
bb_dev = ta.stdev(close, bb_length) * bb_mult
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
rsi_val = ta.rsi(close, rsi_length)
atr_val = ta.atr(atr_length)

//--- entry signals
long_condition = close <= bb_lower and rsi_val < rsi_oversold
short_condition = close >= bb_upper and rsi_val > rsi_overbought

//--- entry logic
if long_condition
    strategy.entry("Long", strategy.long)

if short_condition
    strategy.entry("Short", strategy.short)

//--- exit management
// Exit long at middle band TP or SL
if strategy.position_size > 0
    strategy.exit("XL", "Long", 
     limit=bb_basis, 
     stop=close - (atr_val * sl_atr_mult))

// Exit short at middle band TP or SL
if strategy.position_size < 0
    strategy.exit("XS", "Short", 
     limit=bb_basis, 
     stop=close + (atr_val * sl_atr_mult))

//--- plot (for visual reference)
plot(bb_basis, "BB Middle", color=color.blue)
plot(bb_upper, "BB Upper", color=color.blue, linewidth=1)
plot(bb_lower, "BB Lower", color=color.blue, linewidth=1)
fill(plot(bb_upper), plot(bb_lower), color=color.new(color.blue, 95))
