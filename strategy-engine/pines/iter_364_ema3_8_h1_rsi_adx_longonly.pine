//@version=5
strategy(title="EMA3_8_H1_RSI_ADX_LongOnly", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)       // sweep: 1-10 step 1
ema_slow_len = input.int(8, "Slow EMA Length", minval=1, maxval=50)       // sweep: 5-20 step 1
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)                // sweep: 7-21 step 1
rsi_threshold = input.int(50, "RSI Threshold (Long >)", minval=20, maxval=80)  // sweep: 40-60 step 5
adx_len = input.int(14, "ADX Length", minval=5, maxval=50)               // sweep: 10-20 step 2
adx_threshold = input.int(18, "ADX Threshold (> = trending)", minval=5, maxval=50)  // sweep: 15-30 step 3
tp_points = input.int(100, "Take Profit (points)", minval=10, maxval=500) // sweep: 50-200 step 10
sl_points = input.int(67, "Stop Loss (points)", minval=10, maxval=500)   // sweep: 30-150 step 5
trade_start_hour = input.int(8, "Trade Start Hour (UTC)", minval=0, maxval=23)   // sweep: 0-23 step 1
trade_end_hour = input.int(16, "Trade End Hour (UTC)", minval=0, maxval=23)     // sweep: 0-23 step 1

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
[di_plus, di_minus, adx_val] = ta.dmi(high, low, close, adx_len)

//--- entry logic
long_condition = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_threshold and adx_val > adx_threshold

//--- time filter
in_trading_hours = hour(time) >= trade_start_hour and hour(time) < trade_end_hour

//--- entry execution
if long_condition and in_trading_hours and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

//--- exit management (TP/SL only — no crossunder close)
if strategy.position_size > 0
    strategy.exit("TP/SL", "Long", loss=sl_points, profit=tp_points)
