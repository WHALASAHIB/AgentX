//@version=5
strategy(title="EMA Crossover + RSI (TP 1:1.5)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fastLen = input.int(12, "Fast EMA", minval=2, maxval=100)  // sweep: 5-20 step 2
slowLen = input.int(26, "Slow EMA", minval=5, maxval=200)  // sweep: 15-40 step 3

// RSI filter parameters
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)  // sweep: 7-21 step 2
rsiOverbought = input.int(70, "RSI Overbought", minval=60, maxval=90, step=1)  // sweep: 65-80 step 5
rsiOversold = input.int(30, "RSI Oversold", minval=10, maxval=40, step=1)  // sweep: 20-35 step 5

// Risk management — tight TP:SL ratio to improve win rate
slPct = input.float(0.5, "Stop Loss %", minval=0.1, maxval=5.0, step=0.1)  // sweep: 0.3-2.0 step 0.2
tpRatio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-2.5 step 0.5 — tightened from 2:1 to 1:1.5

//--- indicators
// EMAs for trend direction
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)

// RSI for momentum filter
rsiValue = ta.rsi(close, rsiLen)

//--- entry logic
// Core EMA crossover signals
emaLongSignal = ta.crossover(fastMA, slowMA)
emaShortSignal = ta.crossunder(fastMA, slowMA)

// RSI filter: long only when RSI > 50 (bullish momentum), short only when RSI < 50 (bearish momentum)
rsiLongFilter = rsiValue > 50
rsiShortFilter = rsiValue < 50

// Combined entry conditions
longCondition = emaLongSignal and rsiLongFilter
shortCondition = emaShortSignal and rsiShortFilter

// Enter long when EMA12 crosses above EMA26 AND RSI > 50 (bullish momentum)
if longCondition
    strategy.entry("Long", strategy.long)

// Enter short when EMA12 crosses below EMA26 AND RSI < 50 (bearish momentum)
if shortCondition
    strategy.entry("Short", strategy.short)

//--- exit management
// Fixed TP/SL exits based on close percentage — tighter 1:1.5 ratio to increase win rate
longSL = close * slPct / 100 / syminfo.mintick
longTP = close * slPct * tpRatio / 100 / syminfo.mintick
shortSL = close * slPct / 100 / syminfo.mintick
shortTP = close * slPct * tpRatio / 100 / syminfo.mintick

strategy.exit("Long Exit", "Long", loss=longSL, profit=longTP)
strategy.exit("Short Exit", "Short", loss=shortSL, profit=shortTP)
