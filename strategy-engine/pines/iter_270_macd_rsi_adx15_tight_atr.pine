//@version=5
strategy(title="MACD RSI ADX15 Tight ATR — XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs: MACD parameters
fast_len = input.int(8, "MACD Fast Length", minval=2, maxval=50)       // sweep: 5-20 step 3
slow_len = input.int(17, "MACD Slow Length", minval=5, maxval=100)     // sweep: 10-30 step 5
sig_len  = input.int(9, "MACD Signal Length", minval=2, maxval=30)     // sweep: 5-15 step 3

//--- inputs: RSI filter
rsi_len  = input.int(14, "RSI Length", minval=5, maxval=30)            // sweep: 7-21 step 7
rsi_bull = input.int(50, "RSI Bullish Threshold (long)", minval=30, maxval=70)   // sweep: 40-60 step 10
rsi_bear = input.int(50, "RSI Bearish Threshold (short)", minval=30, maxval=70)  // sweep: 40-60 step 10

//--- inputs: DMI/ADX filter (manual ADX calc)
adx_len  = input.int(14, "ADX Length", minval=7, maxval=30)            // sweep: 7-21 step 7
adx_threshold = input.float(15, "ADX Threshold", minval=5, maxval=40, step=2.5) // sweep: 5-25 step 5

//--- inputs: ATR-based TP/SL
atr_len  = input.int(14, "ATR Length", minval=7, maxval=30)            // sweep: 7-21 step 7
sl_mult  = input.float(1.5, "SL Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
tp_mult  = input.float(1.0, "TP Multiplier (×ATR)", minval=0.3, maxval=5.0, step=0.25) // sweep: 0.5-2.0 step 0.5

//--- inputs: session filter
session_start = input.int(8, "Session Start (UTC)", minval=0, maxval=23)   // sweep: 6-12 step 2
session_end   = input.int(16, "Session End (UTC)", minval=0, maxval=23)    // sweep: 12-20 step 2

//--- inputs: trade direction
allow_long  = input.bool(true, "Allow Long Trades")
allow_short = input.bool(true, "Allow Short Trades")

//--- indicators
[macd_line, signal_line, hist] = ta.macd(close, fast_len, slow_len, sig_len)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)

//--- manual ADX calculation from DMI components
[di_plus, di_minus, adx_val] = ta.dmi(high, low, close, adx_len)

//--- session check
in_session = (hour >= session_start) and (hour < session_end)

//--- entry logic: MACD crossover with RSI + ADX filters
long_condition  = ta.crossover(macd_line, signal_line) and rsi_val > rsi_bull and adx_val > adx_threshold and in_session
short_condition = ta.crossunder(macd_line, signal_line) and rsi_val < rsi_bear and adx_val > adx_threshold and in_session

//--- entry
if long_condition and allow_long
    strategy.entry("Long", strategy.long)

if short_condition and allow_short
    strategy.entry("Short", strategy.short)

//--- exit management: ATR-based fixed TP/SL
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=int(atr_val * sl_mult / syminfo.mintick), profit=int(atr_val * tp_mult / syminfo.mintick))

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=int(atr_val * sl_mult / syminfo.mintick), profit=int(atr_val * tp_mult / syminfo.mintick))
