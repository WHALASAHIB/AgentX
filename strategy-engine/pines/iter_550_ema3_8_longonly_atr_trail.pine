//@version=6
strategy(title="Iter 550 — BTCUSDT 30m Long-Only EMA3/8 + RSI50 + ATR Trail", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen  = input.int(3,   "EMA Fast Length",  minval=1,  maxval=50)   // sweep: 2-10 step 1
emaSlowLen  = input.int(8,   "EMA Slow Length",  minval=2,  maxval=50)   // sweep: 5-21 step 2
rsiLen      = input.int(14,  "RSI Length",       minval=2,  maxval=50)   // sweep: 7-21 step 2
rsiMinLong  = input.int(50,  "RSI Minimum (Long)", minval=20, maxval=80) // sweep: 40-60 step 5
atrLen      = input.int(14,  "ATR Length",       minval=7,  maxval=30)   // sweep: 7-21 step 2
atrMult     = input.float(1.5, "ATR Trail Multiplier", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-3.0 step 0.5

//--- indicators
emaFast     = ta.ema(close, emaFastLen)
emaSlow     = ta.ema(close, emaSlowLen)
rsiVal      = ta.rsi(close, rsiLen)
atrVal      = ta.atr(atrLen)
atrTrail    = atrVal * atrMult

//--- entry logic (LONG ONLY)
longEntry   = ta.crossover(emaFast, emaSlow) and rsiVal > rsiMinLong

//--- trailing stop calculation
var float longStopPrice = na
if longEntry
    longStopPrice := close - atrTrail
    strategy.entry("Long", strategy.long)

// Update trailing stop on each bar while in a long position
if strategy.position_size > 0
    // Trail up only — never move stop down
    newStop = close - atrTrail
    if na(longStopPrice) or newStop > longStopPrice
        longStopPrice := newStop

// Exit when price hits the trailing stop
if strategy.position_size > 0 and not na(longStopPrice)
    strategy.exit("TrailExit", "Long", stop=longStopPrice)

//--- visual cues
plot(emaFast, "EMA Fast", color.blue, 1)
plot(emaSlow, "EMA Slow", color.red, 1)
hline(rsiMinLong, "RSI Min", color.green, hline.style_dashed)
