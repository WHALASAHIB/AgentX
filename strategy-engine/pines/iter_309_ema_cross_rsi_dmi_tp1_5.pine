//@version=5
strategy(title="EMA5/13 + RSI + ADX(DMI) + 1:1.5 TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(5, "EMA Fast Length", minval=2, maxval=50, group="EMA")
emaSlowLen = input.int(13, "EMA Slow Length", minval=5, maxval=100, group="EMA")
useRSIFilter = input.bool(true, "Use RSI Filter", group="Filters")
rsiLen = input.int(14, "RSI Length", minval=7, maxval=21, group="Filters")
rsiLongThreshold = input.int(50, "RSI Long Threshold (> this)", minval=30, maxval=70, group="Filters")
rsiShortThreshold = input.int(50, "RSI Short Threshold (< this)", minval=30, maxval=70, group="Filters")
useADXFilter = input.bool(true, "Use ADX Filter", group="Filters")
adxLen = input.int(14, "ADX/DMI Length", minval=7, maxval=21, group="Filters")
adxThreshold = input.int(16, "ADX Threshold", minval=10, maxval=25, group="Filters")
tpSlRatioLong = input.float(1.5, "TP/SL Ratio (Long)", minval=0.5, maxval=5.0, step=0.5, group="Risk")
tpSlRatioShort = input.float(1.5, "TP/SL Ratio (Short)", minval=0.5, maxval=5.0, step=0.5, group="Risk")
slPercent = input.float(0.3, "Stop Loss (% of price)", minval=0.05, maxval=2.0, step=0.05, group="Risk")

//--- calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)
// Use ta.dmi() which returns [diPlus, diMinus, adx] — avoids ta.adx() not being a function
[dip, dim, adxVal] = ta.dmi(high, low, close, adxLen)

//--- entry conditions
longEntry = ta.crossover(emaFast, emaSlow)
if (useRSIFilter)
    longEntry := longEntry and (rsiVal > rsiLongThreshold)
if (useADXFilter)
    longEntry := longEntry and (adxVal > adxThreshold)

shortEntry = ta.crossunder(emaFast, emaSlow)
if (useRSIFilter)
    shortEntry := shortEntry and (rsiVal < rsiShortThreshold)
if (useADXFilter)
    shortEntry := shortEntry and (adxVal > adxThreshold)

//--- entry management (no cascade-close)
if (longEntry)
    strategy.entry("Long", strategy.long)

if (shortEntry)
    strategy.entry("Short", strategy.short)

//--- exit management via fixed SL/TP
slTicksLong = int(slPercent * close / syminfo.mintick / 100)
tpTicksLong = int(slTicksLong * tpSlRatioLong)
slTicksShort = int(slPercent * close / syminfo.mintick / 100)
tpTicksShort = int(slTicksShort * tpSlRatioShort)

if (strategy.position_size > 0)
    strategy.exit("Long Exit", "Long", loss=slTicksLong, profit=tpTicksLong)

if (strategy.position_size < 0)
    strategy.exit("Short Exit", "Short", loss=slTicksShort, profit=tpTicksShort)
