//@version=5
strategy(title="MACD RSI TP1.5 NoADX XAU30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLen = input.int(8, "MACD Fast Length", minval=2, maxval=30)      // sweep: 5-12 step 1
slowLen = input.int(17, "MACD Slow Length", minval=5, maxval=50)     // sweep: 13-26 step 1
sigLen  = input.int(9, "MACD Signal Length", minval=2, maxval=20)    // sweep: 5-14 step 1

// RSI parameters
rsiLen   = input.int(14, "RSI Length", minval=5, maxval=30)          // sweep: 7-21 step 1
rsiUpper = input.int(50, "RSI Long Threshold (above)", minval=30, maxval=70)  // sweep: 40-60 step 5
rsiLower = input.int(50, "RSI Short Threshold (below)", minval=30, maxval=70) // sweep: 40-60 step 5

// ATR-based TP/SL
atrLen = input.int(14, "ATR Length", minval=5, maxval=30)  // sweep: 10-21 step 1
tpMult = input.float(1.0, "TP Multiplier (×ATR)", step=0.1)  // sweep: 0.5-2.0 step 0.1
slMult = input.float(1.5, "SL Multiplier (×ATR)", step=0.1)  // sweep: 0.5-3.0 step 0.1

// Session filter
sessionStart = input.int(8, "Session Start Hour (UTC)", minval=0, maxval=23)   // sweep: 6-12 step 1
sessionEnd   = input.int(16, "Session End Hour (UTC)", minval=0, maxval=23)    // sweep: 14-20 step 1

//--- calculations
[macdLine, signalLine, histLine] = ta.macd(close, fastLen, slowLen, sigLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

//--- market regime
isInSession = hour(time) >= sessionStart and hour(time) < sessionEnd

//--- entry logic
// MACD crossover = bullish signal (fast line crosses above signal line)
macdBuy = ta.crossover(macdLine, signalLine)
// MACD crossunder = bearish signal (fast line crosses below signal line)
macdSell = ta.crossunder(macdLine, signalLine)

// RSI filter: only enter if RSI confirms the direction
rsiBullish = rsi > rsiUpper    // above threshold = bullish
rsiBearish = rsi < rsiLower    // below threshold = bearish

// Combined entry conditions (no ADX filter — tested and produced 0 trades on Polygon data)
longCondition  = macdBuy and rsiBullish and isInSession
shortCondition = macdSell and rsiBearish and isInSession

//--- position management
var float entryPrice = na
var int   barEntry   = 0

if (longCondition and strategy.position_size <= 0)
    strategy.entry("Long", strategy.long)
    entryPrice := close
    barEntry := bar_index

if (shortCondition and strategy.position_size >= 0)
    strategy.entry("Short", strategy.short)
    entryPrice := close
    barEntry := bar_index

//--- exit management
// ATR-based stop loss and take profit using syminfo.mintick for precision
if (strategy.position_size > 0)
    stopPrice  = entryPrice - slMult * atr
    profitPrice = entryPrice + tpMult * atr
    strategy.exit("XL", "Long", stop=stopPrice, limit=profitPrice)

if (strategy.position_size < 0)
    stopPrice   = entryPrice + slMult * atr
    profitPrice = entryPrice - tpMult * atr
    strategy.exit("XS", "Short", stop=stopPrice, limit=profitPrice)
