//@version=6
strategy(title="EMA3/8 ATR Trail BTCUSDT 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
ema_fast = input.int(3, "Fast EMA Length", minval=1, maxval=50)      // sweep: 1-10 step 1
ema_slow = input.int(8, "Slow EMA Length", minval=1, maxval=50)      // sweep: 5-20 step 1
// ATR trailing stop
atr_length = input.int(14, "ATR Length", minval=5, maxval=50)        // sweep: 7-21 step 2
atr_mult = input.float(2.0, "ATR Multiplier", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.0-3.0 step 0.2
// Position sizing
risk_percent = input.float(100.0, "Equity Per Trade %", minval=10, maxval=100, step=10)  // sweep: 50-100 step 25

//--- indicator calculations
ema_f = ta.ema(close, ema_fast)
ema_s = ta.ema(close, ema_slow)
atr_val = ta.atr(atr_length)

//--- entry logic (long only)
long_signal = ta.crossover(ema_f, ema_s)

//--- exit management: ATR trailing stop
var float trail_stop = na
var bool in_position = false

if long_signal and not in_position
    strategy.entry("Long", strategy.long)
    trail_stop := close - (atr_val * atr_mult)
    in_position := true

// Update trailing stop on each bar when in position (only upward)
if in_position
    new_stop = close - (atr_val * atr_mult)
    if new_stop > trail_stop
        trail_stop := new_stop
    strategy.exit("XL", "Long", stop=trail_stop)

// Reset on exit
if strategy.position_size == 0 and in_position
    in_position := false
    trail_stop := na

//--- visual
plot(ema_f, "Fast EMA", color=color.blue, linewidth=2)
plot(ema_s, "Slow EMA", color=color.red, linewidth=2)
