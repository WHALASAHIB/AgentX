//@version=5
strategy(title="EMA3/8 RSI50 ADX25 TP1SL1.5 (iter 285)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
emaFast = input.int(3, "EMA Fast", minval=1, maxval=50, step=1)        // sweep: 2-10 step 1
emaSlow = input.int(8, "EMA Slow", minval=1, maxval=50, step=1)         // sweep: 5-21 step 2

// RSI(14) filter — long only if RSI > threshold
rsiLength = input.int(14, "RSI Length", minval=2, maxval=50, step=1)    // sweep: 7-21 step 2
rsiThreshold = input.int(50, "RSI Threshold (long min)", minval=20, maxval=80, step=5)  // sweep: 30-70 step 5

// ADX(14) trend filter — only trade if ADX > threshold
adxLength = input.int(14, "ADX Length", minval=5, maxval=30, step=1)    // sweep: 7-21 step 2
adxThreshold = input.int(25, "ADX Threshold (min)", minval=10, maxval=50, step=2)  // sweep: 14-30 step 2

// TP/SL as multiples of ATR
atrLength = input.int(14, "ATR Length", minval=5, maxval=50, step=1)   // sweep: 10-20 step 2
tpMultiplier = input.float(1.0, "TP (ATR multiples)", minval=0.5, maxval=5.0, step=0.25)  // sweep: 0.5-2.5 step 0.25
slMultiplier = input.float(1.5, "SL (ATR multiples)", minval=0.5, maxval=5.0, step=0.25)  // sweep: 0.5-2.5 step 0.25

//--- indicator calculations
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLength)
[adxVal, plusDi, minusDi] = ta.dmi(adxLength, adxLength)
atrVal = ta.atr(atrLength)

//--- entry condition: long only
// Bullish EMA crossover: fast crosses above slow
bullishCrossover = ta.crossover(emaF, emaS)

// RSI filter: long only if RSI above threshold
rsiOkLong = rsiVal > rsiThreshold

// ADX filter: only trade in trending markets
trendingOk = adxVal > adxThreshold

// Entry signal: all conditions met
enterLong = bullishCrossover and rsiOkLong and trendingOk

//--- entry
if enterLong
    strategy.entry("Long", strategy.long)

//--- exit management: fixed ATR-based TP/SL
if strategy.position_size > 0
    stopLevel = close - slMultiplier * atrVal
    profitLevel = close + tpMultiplier * atrVal
    strategy.exit("Long Exit", "Long", loss=stopLevel, profit=profitLevel)
