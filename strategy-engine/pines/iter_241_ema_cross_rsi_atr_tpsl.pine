//@version=5
strategy(title="EMA5/13 + RSI(14)>50 + ATR TP/SL 1.5:1 XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast = input.int(5, "Fast EMA Length", minval=2, maxval=50, step=1)    // sweep: 2-20 step 1
ema_slow = input.int(13, "Slow EMA Length", minval=5, maxval=100, step=1)   // sweep: 8-30 step 1
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30, step=1)          // sweep: 5-30 step 5
rsi_threshold = input.int(50, "RSI Threshold (above = long)", minval=30, maxval=70, step=5) // sweep: 40-60 step 5
atr_len = input.int(14, "ATR Length", minval=5, maxval=50, step=1)          // sweep: 5-30 step 5
sl_atr_mult = input.float(1.0, "SL ATR Multiplier", minval=0.5, maxval=3.0, step=0.25) // sweep: 0.5-2.5 step 0.25
tp_atr_mult = input.float(1.5, "TP ATR Multiplier", minval=0.5, maxval=5.0, step=0.25) // sweep: 0.5-3.0 step 0.25

//--- indicators
ema_fast_val = ta.ema(close, ema_fast)
ema_slow_val = ta.ema(close, ema_slow)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)

//--- entry logic
cross_above = ta.crossover(ema_fast_val, ema_slow_val)
cross_below = ta.crossunder(ema_fast_val, ema_slow_val)

// Long-only: EMA5 crosses above EMA13 AND RSI(14) > 50
long_condition = cross_above and rsi_val > rsi_threshold

//--- exit management (pure ATR-based TP/SL, NO crossunder exit)
// Entry
if (long_condition)
    strategy.entry("Long", strategy.long)

// Exit with ATR-based TP/SL only
// SL at 1.0x ATR below entry, TP at 1.5x ATR above entry
strategy.exit("TP/SL", "Long", loss=int(atr_val * sl_atr_mult / syminfo.mintick), profit=int(atr_val * tp_atr_mult / syminfo.mintick))

//--- plot EMA lines for visual reference
plot(ema_fast_val, "Fast EMA", color=color.blue, linewidth=2)
plot(ema_slow_val, "Slow EMA", color=color.red, linewidth=2)
