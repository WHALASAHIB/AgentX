//@version=6
strategy(title="iter_584_macd_rsi_filter", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLen = input.int(12, "MACD Fast Length", minval=5, maxval=30)   // sweep: 8-20 step 2
slowLen = input.int(26, "MACD Slow Length", minval=15, maxval=50)  // sweep: 20-40 step 5
sigLen  = input.int(9, "MACD Signal Length", minval=5, maxval=15)   // sweep: 7-12 step 1

// RSI filter
rsiLen  = input.int(14, "RSI Length", minval=5, maxval=25)          // sweep: 10-20 step 2
rsiBull = input.int(50, "RSI Bull Threshold", minval=40, maxval=60)  // sweep: 45-55 step 5
rsiBear = input.int(50, "RSI Bear Threshold", minval=40, maxval=60)  // sweep: 40-50 step 5

// TP/SL in ticks
stopTicks  = input.int(30, "Stop Loss (ticks x10)", minval=10, maxval=200)  // sweep: 15-100 step 10
tpTicks    = input.int(30, "Take Profit (ticks x10)", minval=10, maxval=200) // sweep: 15-100 step 10

//--- indicators
[macdLine, signalLine, _hist] = ta.macd(close, fastLen, slowLen, sigLen)
rsiVal = ta.rsi(close, rsiLen)

macdCrossAbove = ta.crossover(macdLine, signalLine)
macdCrossBelow = ta.crossunder(macdLine, signalLine)

//--- entry logic
longCondition  = macdCrossAbove and rsiVal > rsiBull
shortCondition = macdCrossBelow and rsiVal < rsiBear

if longCondition
    strategy.entry("L", strategy.long)

if shortCondition
    strategy.entry("S", strategy.short)

//--- exit management
if strategy.position_size > 0
    strategy.exit("X_L", "L", loss=stopTicks, profit=tpTicks)

if strategy.position_size < 0
    strategy.exit("X_S", "S", loss=stopTicks, profit=tpTicks)
