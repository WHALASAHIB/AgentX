//@version=6
strategy(title="EURUSD 30m — EMA2/5 ATR Trail Long-Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
emaFastLen = input.int(2, "EMA Fast Length", minval=1, maxval=20)      // sweep: 1-10 step 1
emaSlowLen = input.int(5, "EMA Slow Length", minval=2, maxval=30)      // sweep: 3-10 step 1

// ATR trail
atrLen     = input.int(14, "ATR Length", minval=5, maxval=50)          // sweep: 7-21 step 2
atrMult    = input.float(3.0, "ATR Trail Multiplier", minval=0.5, maxval=10.0, step=0.5) // sweep: 1.5-5 step 0.5

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)

//--- ATR trailing stop (long-only)
var float trailStop = 0.0
bool newLongSignal = ta.crossover(emaFast, emaSlow)

if newLongSignal
    trailStop := close - atrVal * atrMult

// Update trail only when price moves higher (ratchet up)
if strategy.position_size > 0
    float newStop = close - atrVal * atrMult
    if newStop > trailStop
        trailStop := newStop

//--- entry logic (long-only)
if newLongSignal and strategy.position_size == 0
    strategy.entry("EL", strategy.long)

//--- exit via trailing stop
if strategy.position_size > 0
    strategy.exit("XL", "EL", stop=trailStop)

//--- visual
plot(emaFast, "EMA Fast", color=color.blue, linewidth=1)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=1)
plot(trailStop, "Trail Stop", color=color.purple, linewidth=1, style=plot.style_linebr)
