//@version=5
strategy(title="EMA3_8_Cross_RSI_ADX18_LongOnly_XAU30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)       // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)       // sweep: 5-21 step 1
rsiLen     = input.int(14, "RSI Length", minval=2, maxval=50)           // sweep: 7-21 step 1
rsiThresh  = input.int(50, "RSI Long Threshold", minval=1, maxval=100)  // sweep: 30-70 step 5
adxLen     = input.int(14, "ADX Length", minval=2, maxval=50)           // sweep: 7-21 step 1
adxThresh  = input.int(18, "ADX Threshold", minval=1, maxval=50)        // sweep: 14-30 step 2
tpPoints   = input.int(80, "Take Profit (points)", minval=1, maxval=500) // sweep: 40-200 step 20
slPoints   = input.int(100, "Stop Loss (points)", minval=1, maxval=500) // sweep: 50-200 step 10

//--- indicator calculations
emaFast    = ta.ema(close, emaFastLen)
emaSlow    = ta.ema(close, emaSlowLen)
rsiVal     = ta.rsi(close, rsiLen)

//--- Manual ADX calculation (DMI-based, ta.adx is not supported on all engines)
up         = ta.change(high)
down       = -ta.change(low)
plusDM     = na(up) ? na : (up > down and up > 0 ? up : 0)
minusDM    = na(down) ? na : (down > up and down > 0 ? down : 0)
tr         = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atr        = ta.sma(tr, adxLen)
plusDI     = 100 * ta.sma(plusDM, adxLen) / atr
minusDI    = 100 * ta.sma(minusDM, adxLen) / atr
dx         = math.abs(plusDI - minusDI) / (plusDI + minusDI) * 100
adxVal     = ta.sma(dx, adxLen)

//--- crossover detection
emaCrossOver  = ta.crossover(emaFast, emaSlow)
emaCrossUnder = ta.crossunder(emaFast, emaSlow)

//--- entry conditions (long only)
longCondition = emaCrossOver and rsiVal > rsiThresh and adxVal > adxThresh

//--- exit conditions
exitCondition = emaCrossUnder

//--- entry logic
if (longCondition)
    strategy.entry("Long", strategy.long)

//--- exit management via TP/SL
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=slPoints * syminfo.mintick, profit=tpPoints * syminfo.mintick)
    if (exitCondition)
        strategy.close("Long")
