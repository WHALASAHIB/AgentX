//@version=5
// ---
// Strategy: EMA8/21 crossover + RSI(14)>50 + ADX(14)>10 + ATR TP/SL
// Symbol: XAUUSD, Timeframe: 30m
// Iteration: 393
// This iteration changes: ADX threshold reduced from 18 to 10 to allow entries in weakly trending markets
// ---

strategy(title="iter_393_ema821_rsi50_adx10_longonly", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
ema_fast_len = input.int(8, "EMA Fast Length", minval=2, maxval=50)  // sweep: 5-15 step 1
ema_slow_len = input.int(21, "EMA Slow Length", minval=5, maxval=100) // sweep: 15-30 step 2

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=7, maxval=21)          // sweep: 7-21 step 1
rsi_threshold = input.int(50, "RSI Long Threshold", minval=30, maxval=70) // sweep: 40-60 step 5

// ADX parameters
adx_len = input.int(14, "ADX Length", minval=7, maxval=21)          // sweep: 7-21 step 1
adx_threshold = input.int(10, "ADX Min Threshold", minval=5, maxval=40) // sweep: 5-20 step 2

// ATR-based TP/SL parameters
atr_len = input.int(14, "ATR Length", minval=7, maxval=21)          // sweep: 7-21 step 2
tp_atr_mult = input.float(2.0, "TP ATR Multiplier", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-4.0 step 0.5
sl_atr_mult = input.float(1.0, "SL ATR Multiplier", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-2.0 step 0.5

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
[adx_val, plus_di, minus_di] = ta.dmi(high, low, close, adx_len)
atr_val = ta.atr(atr_len)

//--- entry logic
// Long condition: EMA fast crosses above EMA slow + RSI > threshold + ADX > threshold
long_condition = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_threshold and adx_val > adx_threshold

// Enter long
if long_condition
    strategy.entry("Long", strategy.long)

//--- exit management
// Calculate TP and SL levels in price terms based on ATR
// TP = entry_price + (ATR * tp_atr_mult)
// SL = entry_price - (ATR * sl_atr_mult)
// Use strategy.exit() with loss/profit in ticks
if strategy.position_size > 0
    sl_ticks = int(atr_val * sl_atr_mult / syminfo.mintick)
    tp_ticks = int(atr_val * tp_atr_mult / syminfo.mintick)
    strategy.exit("Exit Long", "Long", loss=sl_ticks, profit=tp_ticks)
