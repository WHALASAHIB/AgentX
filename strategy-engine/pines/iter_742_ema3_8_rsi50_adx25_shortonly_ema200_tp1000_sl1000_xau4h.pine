//@version=6
strategy(title="EMA3/8 RSI50 ManualADX25 ShortOnly EMA200Filter BarrierExit TP1000 SL1000 XAU4h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(50, "RSI Threshold (short below)", minval=20, maxval=80)  // sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(25, "ADX Threshold", minval=10, maxval=50)   // iter 742: ADX UNCHANGED at 25 (iter 741: ADX 15->25 did NOT move WR, stuck ~27% -- entry signal is the bottleneck, not ADX strictness); sweep: 15-35 step 5
ema_regime_len = input.int(200, "Regime EMA Length", minval=50, maxval=300)   // iter 742: ONE CHANGE -- ADD EMA200 trend-regime filter. Iter 740/741 evidence: 4h WR stuck at ~27% asymptote across ALL barrier/ADX settings (TP5000->1500->1000, ADX15->25); ~73% of shorts are counter-trend (fading rallies in uptrends). EMA200 regime filter removes counter-trend shorts, targeting WR 35-45%. At 1.43x payoff (iter 741 avg win 54.56/avg loss 38.13), breakeven WR ~41%; 45% WR -> PF ~1.3+. sweep: 100-200 step 50
take_profit_tick = input.int(1000, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 742: TP UNCHANGED at 1000; sweep: 500-1500 step 250
stop_loss_tick = input.int(1000, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 742: SL UNCHANGED at 1000; sweep: 500-2500 step 250

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_below = ta.crossunder(ema_fast, ema_slow)

//--- entry conditions (SHORT-ONLY preserved: iter 732 longs -0.69 PF vs shorts +2.48 PF; EMA200 regime filter added iter 742)
short_condition = cross_below and rsi_val < (100 - rsi_threshold) and adx_val > adx_threshold and close < ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float short_tp = na
var float short_sl = na
var int entry_bar = -1

//--- entry logic (flat only, short side only)
if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    short_tp := close - take_profit_tick * syminfo.mintick
    short_sl := close + stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size < 0 and bar_index > entry_bar
    if low <= short_tp
        strategy.close("Short", comment="TP")
    if high >= short_sl
        strategy.close("Short", comment="SL")
