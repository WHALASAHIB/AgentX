//@version=5
strategy(title="EMA8/21 + RSI50 + TP1:SL1.5 Long-Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(8, "EMA Fast Length", minval=2, maxval=50, step=1)  // sweep: 5-15 step 2
emaSlowLen = input.int(21, "EMA Slow Length", minval=10, maxval=100, step=1)  // sweep: 15-50 step 5
rsiLen = input.int(14, "RSI Length", minval=7, maxval=28, step=1)  // sweep: 10-20 step 2
rsiThreshold = input.int(50, "RSI Threshold (long above)", minval=30, maxval=70, step=5)  // sweep: 40-60 step 5
atrLen = input.int(14, "ATR Length", minval=7, maxval=28, step=1)  // sweep: 10-20 step 2
tpMultiplier = input.float(1.0, "TP Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 0.5-2.0 step 0.5
slMultiplier = input.float(1.5, "SL Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5

//--- calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

//--- trend condition: fast EMA above slow = uptrend
trendUp = emaFast > emaSlow

//--- entry signals
// Long: EMA8 crosses above EMA21 (golden cross) AND RSI > threshold
longEntry = ta.crossover(emaFast, emaSlow) and rsi > rsiThreshold

//--- exit signals (no close-based cascade)
// Profit target and stop loss are set in strategy.exit()
longCondition = longEntry and trendUp

//--- entry management
if longCondition
    strategy.entry("Long", strategy.long)

//--- exit management — each bar set exit with ATR-based TP/SL
if strategy.position_size > 0
    strategy.exit("XL", "Long", 
     loss=int(slMultiplier * atr / syminfo.mintick), 
     profit=int(tpMultiplier * atr / syminfo.mintick))
