//@version=6
strategy(title="BB %B Mean Reversion LONG-ONLY — BTCUSDT 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands parameters
bbLength = input.int(20, "BB Length", minval=10, maxval=50, step=2)                // sweep: 10-40 step 5
bbStdDev = input.float(2.0, "BB StdDev", minval=1.0, maxval=3.0, step=0.25)         // sweep: 1.5-3.0 step 0.25

// %B thresholds
oversoldThreshold = input.float(0.2, "%B Oversold (long entry)", minval=0.0, maxval=0.5, step=0.05)   // sweep: 0.0-0.4 step 0.1
overboughtThreshold = input.float(0.8, "%B Overbought (TP target)", minval=0.5, maxval=1.0, step=0.05) // sweep: 0.6-1.0 step 0.1

// RSI parameters
rsiLength = input.int(14, "RSI Length", minval=5, maxval=30, step=1)                // sweep: 7-21 step 7
rsiMin = input.int(40, "RSI Min (avoid free-fall)", minval=30, maxval=55, step=5)    // sweep: 30-55 step 5

// ATR stop parameters
atrLength = input.int(14, "ATR Length", minval=7, maxval=30, step=1)                // sweep: 7-21 step 7
slMultiplier = input.float(2.0, "SL Multiplier (xATR)", minval=1.0, maxval=4.0, step=0.5)    // sweep: 1.0-3.0 step 0.5
tpMultiplier = input.float(2.0, "TP Multiplier (xATR)", minval=1.0, maxval=5.0, step=0.5)     // sweep: 1.5-4.0 step 0.5

//--- Bollinger Bands
basis = ta.sma(close, bbLength)
dev = ta.stdev(close, bbLength) * bbStdDev
upperBand = basis + dev
lowerBand = basis - dev

// %B indicator (where price sits within the bands)
pctB = (close - lowerBand) / (upperBand - lowerBand)

//--- RSI
rsiVal = ta.rsi(close, rsiLength)

//--- ATR
atrVal = ta.atr(atrLength)

//--- Entry conditions (LONG ONLY — mean reversion)
// %B < oversold threshold = price near lower band (oversold)
// RSI > min threshold = not in free-fall, momentum stabilizing
longEntryCondition = pctB < oversoldThreshold and rsiVal > rsiMin

//--- Entry
if longEntryCondition
    strategy.entry("Long", strategy.long)

//--- Exit management
tpPts = tpMultiplier * atrVal / syminfo.mintick
slPts = slMultiplier * atrVal / syminfo.mintick

if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", loss=slPts, profit=tpPts)
