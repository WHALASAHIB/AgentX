//@version=6
strategy(title="EMA3/8 RSI40 ManualADX28 LongOnly EMA150Filter BarrierExit TP2500 SL4500 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

// iter 792: TP/SL BARRIER SWEEP on the confirmed BTC 30m PEAK per the iter-791 contingency
// (iter 791 proved the EMA3/8+RSI40+ADX28+EMA150+TP3000/SL4500 stack is BTC-SPECIFIC: identical
// stack on BYBIT:ETHUSDT.P 30m produced 21 trades, PF 0.96, Sharpe -0.10, WR 57.1%, net -$80.98,
// result 01KZ5H0GVB3XMK1Q26ZDTCT400 -- valid sample, quality-negative; ETH tick=0.01 makes the same
// nominal tick barriers ~1/10 the dollar distance of BTC's, avgBarsInTrade 35.1 vs 8.96, DD 7.55%
// vs 2.23%).
// ONE change: take_profit_tick 3000 -> 2500 on BYBIT:BTCUSDT.P 30m (stop_loss_tick 4500 UNCHANGED;
// TP/SL ratio 0.667x -> 0.556x). Rationale: TP is the under-tested half of the barrier pair on the
// peak config (TP3000 fixed since iter 765; SL sweeps already mapped: SL4500 PEAK > SL3000/5000/1000,
// and ATR-trail exits proven quality-negative at iter 786); a tighter TP 2500 should harvest more
// partial wins in BTC 30m pullbacks (WR up from 70.8%) at the cost of lower payoff per win.
// If TP2500 degrades below the iter-789/790 peak (PF 1.66, net +$273.58), REVERT and test the
// complementary sweep (TP 3500, SL 4500) or accept the peak as terminal.

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // iter 792: UNCHANGED at 3 (peak). sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // iter 792: UNCHANGED at 8 (peak). sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(40, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 792: RSI UNCHANGED at 40 (iter-769/770 peak). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(28, "ADX Threshold", minval=10, maxval=50)   // iter 792: ADX UNCHANGED at 28 (peak; ADX22 < ADX25 < ADX28 PEAK > ADX30 invalid). sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 792: regime EMA 150 (proven-best long-side). sweep: 100-200 step 50
take_profit_tick = input.int(2500, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 792: TP 3000 -> 2500 (SWEEP, ~0.625x ATR). sweep: 2000-4000 step 500
stop_loss_tick = input.int(4500, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 792: SL UNCHANGED at 4500 (~1x ATR). sweep: 3000-6000 step 500

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 792: TP barrier sweep 3000 -> 2500 on the confirmed
// BYBIT:BTCUSDT.P 30m peak -- EMA3/8 + RSI40 + ADX28 + EMA150 long-only regime + TP2500/SL4500
// manual barriers, flat-only, 1-bar min hold, NO breakeven. SL4500 UNCHANGED per the SL sweep
// mapping (SL4500 PEAK > SL3000/5000/1000); only the TP half of the barrier pair moves.)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
