//@version=6
strategy(title="XAUUSD 30m EMA2/5 ATR Trail", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

// --- inputs
emaFastLen = input.int(2, title="EMA Fast Length", minval=1, maxval=10)    // sweep: 2-5 step 1
emaSlowLen = input.int(5, title="EMA Slow Length", minval=3, maxval=20)    // sweep: 5-13 step 2
atrPeriod = input.int(14, title="ATR Period", minval=7, maxval=21)         // sweep: 7-21 step 7
atrMultiplier = input.float(2.0, title="ATR Trail Multiplier", minval=0.5, maxval=4.0, step=0.5) // sweep: 1.0-3.0 step 0.5
useLongOnly = input.bool(true, title="Long Only Mode")                     // sweep: true/false

// --- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atr = ta.atr(atrPeriod)

// --- entry logic: EMA crossover (long only)
crossUp = ta.crossover(emaFast, emaSlow)
crossDn = ta.crossunder(emaFast, emaSlow)

// --- ATR trailing stop (long side)
var float longStop = na
if (strategy.position_size > 0)
    longStop := math.max(longStop, close - atr * atrMultiplier)
    // trail never tightens below entry-level logic: only trail up
    longStop := math.max(longStop, strategy.position_avg_price - atr * atrMultiplier * 0.5)
else
    longStop := na

// --- entry
if (useLongOnly and crossUp and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

// --- exit: ATR trailing stop
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", stop=longStop)

// --- short side (if bidirectional)
if (not useLongOnly and crossDn and strategy.position_size == 0)
    strategy.entry("Short", strategy.short)

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", stop=close + atr * atrMultiplier)
