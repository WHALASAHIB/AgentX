//@version=5
strategy(title="EMA5_13_RSI50_LONG_H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(5, "EMA Fast Length", minval=2, maxval=50)    // sweep: 3-10 step 1
ema_slow_len = input.int(13, "EMA Slow Length", minval=5, maxval=100)  // sweep: 10-30 step 2
rsi_len      = input.int(14, "RSI Length", minval=5, maxval=30)        // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold (above=long)", minval=30, maxval=70) // sweep: 40-60 step 5
ats_mult     = input.float(1.5, "ATR Multiplier for SL", minval=0.5, maxval=4.0, step=0.25) // sweep: 1.0-3.0 step 0.5
tp_ratio     = input.float(2.0, "TP/SL Ratio", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-3.0 step 0.5

//--- indicators
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val  = ta.rsi(close, rsi_len)
atr_val  = ta.atr(14)

//--- entry logic
long_condition = ta.crossover(ema_fast, ema_slow) and rsi_val > rsi_threshold

if long_condition
    sl_price = close - atr_val * ats_mult
    tp_price = close + (close - sl_price) * tp_ratio
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=int((close - sl_price) / syminfo.mintick), profit=int((tp_price - close) / syminfo.mintick))

//--- exit on crossunder (early exit if trend reverses)
if ta.crossunder(ema_fast, ema_slow) and strategy.position_size > 0
    strategy.close("Long", comment="CrossUnder")

//--- plot indicators for visual reference
plot(ema_fast, "EMA Fast", color=color.blue, linewidth=2)
plot(ema_slow, "EMA Slow", color=color.red, linewidth=2)
hline(rsi_threshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed)
