//@version=5
strategy(title="EMA5/13 Crossover RSI Long-Only XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// EMA parameters
emaFastLen = input.int(5, "EMA Fast Length", minval=2, maxval=50)       // sweep: 3-20 step 2
emaSlowLen = input.int(13, "EMA Slow Length", minval=5, maxval=100)      // sweep: 10-30 step 3

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=7, maxval=28)               // sweep: 7-21 step 7
rsiThreshold = input.int(50, "RSI Min Threshold (long)", minval=20, maxval=80) // sweep: 30-60 step 5

// ATR stop management
atrLen = input.int(14, "ATR Length", minval=7, maxval=28)               // sweep: 7-28 step 7
atrMultSL = input.float(1.5, "ATR Multiplier (SL)", step=0.5)           // sweep: 1.0-3.0 step 0.5
tpSlRatio = input.float(1.0, "TP/SL Ratio", step=0.5)                   // sweep: 0.5-2.0 step 0.5

// Trading hours filter
tradeStartHour = input.int(8, "Trade Start Hour (UTC)", minval=0, maxval=23)
tradeEndHour = input.int(16, "Trade End Hour (UTC)", minval=0, maxval=23)

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- signals
isLong = ta.crossover(emaFast, emaSlow)
isShort = ta.crossunder(emaFast, emaSlow)

// Current bar conditions
rsiOkLong = rsiVal > rsiThreshold
inTradingHours = (hour(time) >= tradeStartHour and hour(time) < tradeEndHour)

//--- entry logic
longCondition = isLong and rsiOkLong and inTradingHours and strategy.position_size == 0

if longCondition
    stopLossPips = atrVal * atrMultSL
    takeProfitPips = stopLossPips * tpSlRatio
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=math.round(stopLossPips / syminfo.mintick), profit=math.round(takeProfitPips / syminfo.mintick))

//--- exit on EMA crossunder (manual close if still in trade after crossover resets)
if strategy.position_size > 0 and isShort
    strategy.close("Long", comment="EMA_Crossunder_Exit")

//--- plot
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)
hline(50, "RSI 50 Ref", color=color.gray, linestyle=hline.style_dashed)
