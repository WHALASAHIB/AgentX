//@version=6
strategy(title="EMA3/8 ATR Trail EURUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

// --- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)       // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=2, maxval=50)       // sweep: 5-20 step 1
atrLen     = input.int(14, "ATR Length", minval=5, maxval=30)           // sweep: 5-25 step 5
atrMult    = input.float(3.0, "ATR Trail Multiplier", minval=0.5, maxval=10.0, step=0.5) // sweep: 1.0-5.0 step 0.5

// --- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)

// --- entry logic
longCondition  = ta.crossover(emaFast, emaSlow)
shortCondition = ta.crossunder(emaFast, emaSlow)

if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

// --- exit management: ATR trailing stop
longStop  = close - atrVal * atrMult
shortStop = close + atrVal * atrMult

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", stop=longStop)

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", stop=shortStop)
