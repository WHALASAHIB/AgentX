//@version=5
// Strategy: EMA(5,13) Crossover + RSI(14) > 55 + ADX(14) > 14 + TP/SL 2:1 + EMA Crossunder Exit
// Symbol: XAUUSD, Timeframe: 30m
// Long Only
// This iteration changes: ADX threshold reduced from 18 to 14 (iter 169)

strategy(title="EMA5_13_RSI55_ADX14_TP2_EMAExit_LONG XAUUSD 30m",
         overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         commission_type=strategy.commission.percent,
         commission_value=0.04,
         process_orders_on_close=true)

//--- inputs

// EMA parameters
emaFastLen = input.int(5, "EMA Fast Length", minval=1, maxval=50)  // sweep: 3-10 step 1
emaSlowLen = input.int(13, "EMA Slow Length", minval=1, maxval=100) // sweep: 8-21 step 1

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=1, maxval=50)           // sweep: 7-21 step 1
rsiThreshold = input.int(55, "RSI Entry Threshold (Long)", minval=1, maxval=100) // sweep: 30-70 step 5

// ADX parameters
adxLen = input.int(14, "ADX Length", minval=1, maxval=50)           // sweep: 7-21 step 1
adxThreshold = input.int(14, "ADX Minimum Threshold", minval=1, maxval=100) // sweep: 10-30 step 2

// TP/SL parameters
tpSlRatio = input.float(2.0, "TP/SL Ratio", minval=0.1, maxval=10.0, step=0.5) // sweep: 1.0-3.0 step 0.5
atrMultiplierSL = input.float(1.0, "ATR Multiplier for SL", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-2.0 step 0.5

//--- indicator calculations

// EMAs
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// RSI
rsi = ta.rsi(close, rsiLen)

// Manual ADX(14) calculation
adxPeriod = adxLen
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up = high - high[1]
down = low[1] - low
plusDM = up > down and up > 0 ? up : 0
minusDM = down > up and down > 0 ? down : 0
atr = ta.rma(tr, adxPeriod)
diPlus = 100 * ta.rma(plusDM, adxPeriod) / (atr == 0 ? 0.0001 : atr)
diMinus = 100 * ta.rma(minusDM, adxPeriod) / (atr == 0 ? 0.0001 : atr)
dx = 100 * math.abs(diPlus - diMinus) / ((diPlus + diMinus) == 0 ? 0.0001 : (diPlus + diMinus))
adxManual = ta.rma(dx, adxPeriod)

// ATR for TP/SL distance
slAtr = input.int(14, "ATR Length for SL", minval=1, maxval=100)   // sweep: 7-21 step 1
atrValue = ta.atr(slAtr)

//--- entry logic

// Entry conditions: EMA crossover + RSI > threshold + ADX > threshold (now ADX>14)
emaCrossOver = ta.crossover(emaFast, emaSlow)
rsiCondition = rsi > rsiThreshold
adxCondition = adxManual > adxThreshold

longEntry = emaCrossOver and rsiCondition and adxCondition

// Exit conditions: EMA crossunder (signal-based exit), or TP/SL
emaCrossUnder = ta.crossunder(emaFast, emaSlow)

//--- entry management

if (longEntry)
    // Calculate SL and TP prices
    slPrice = close - (atrValue * atrMultiplierSL)
    tpPrice = close + (atrValue * atrMultiplierSL * tpSlRatio)
    
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long",
         loss=math.round((close - slPrice) / syminfo.mintick),
         profit=math.round((tpPrice - close) / syminfo.mintick))

// Signal-based exit: EMA crossunder closes the position
if (emaCrossUnder)
    strategy.close("Long", comment="ema_xunder_exit")
