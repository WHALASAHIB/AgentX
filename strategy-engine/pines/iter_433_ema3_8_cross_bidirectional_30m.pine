//@version=5
strategy(title="EMA3/8 Crossover Bidirectional XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)       // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)       // sweep: 5-21 step 1
rsiLen     = input.int(14, "RSI Length", minval=2, maxval=50)           // sweep: 7-21 step 2
rsiLongMin = input.int(50, "RSI Minimum for Long", minval=1, maxval=100)  // sweep: 40-60 step 5
rsiShortMax = input.int(50, "RSI Maximum for Short", minval=1, maxval=100) // sweep: 40-60 step 5
adxLen     = input.int(14, "ADX Length", minval=2, maxval=50)           // sweep: 10-25 step 3
adxMin     = input.int(20, "ADX Minimum (Trend Strength)", minval=1, maxval=50) // sweep: 14-25 step 2
tpPoints   = input.int(125, "Take Profit (points)", minval=10, maxval=500)   // sweep: 75-200 step 25
slPoints   = input.int(125, "Stop Loss (points)", minval=10, maxval=500)     // sweep: 75-200 step 25

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)

//--- Manual ADX calculation (Wilder's smoothing)
float trVal = ta.tr(true)
float upMove = high - high[1]
float dnMove = low[1] - low
float plusDM = na(upMove) ? 0 : (upMove > dnMove and upMove > 0 ? upMove : 0)
float minusDM = na(dnMove) ? 0 : (dnMove > upMove and dnMove > 0 ? dnMove : 0)

float smTR = ta.rma(trVal, adxLen)
float smPDM = ta.rma(plusDM, adxLen)
float smMDM = ta.rma(minusDM, adxLen)

float pDI = smTR != 0 ? 100 * smPDM / smTR : 0
float mDI = smTR != 0 ? 100 * smMDM / smTR : 0

float dxVal = (pDI + mDI) != 0 ? 100 * math.abs(pDI - mDI) / (pDI + mDI) : 0
float adxVal = ta.rma(dxVal, adxLen)

//--- crossover / crossunder detection
bool crossUp  = ta.crossover(emaFast, emaSlow)
bool crossDn  = ta.crossunder(emaFast, emaSlow)

//--- entry logic
// Long entry: EMA3 crosses above EMA8, RSI > rsiLongMin, ADX > adxMin
if crossUp and rsiVal > rsiLongMin and adxVal > adxMin
    strategy.entry("Long", strategy.long)

// Short entry: EMA3 crosses below EMA8, RSI < rsiShortMax, ADX > adxMin
if crossDn and rsiVal < rsiShortMax and adxVal > adxMin
    strategy.entry("Short", strategy.short)

//--- exit management via fixed TP/SL
if strategy.position_size > 0
    strategy.exit("XL", "Long",  loss=slPoints, profit=tpPoints)

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=slPoints, profit=tpPoints)
