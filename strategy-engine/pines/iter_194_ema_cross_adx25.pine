//@version=5
strategy(title="EMA Crossover XAUUSD 30m — RSI+ADX25+EMAfilter + TP/SL 1:1.5 (iter 194)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fast_len = input.int(5, "Fast EMA Length", minval=2, maxval=30)       // sweep: 3-15 step 2
slow_len = input.int(10, "Slow EMA Length", minval=5, maxval=50)      // sweep: 8-30 step 2
ema50_len = input.int(50, "EMA50 Trend Filter", minval=20, maxval=200)// sweep: 20-200 step 10
rsi_len = input.int(14, "RSI Length", minval=7, maxval=21)            // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold", minval=30, maxval=70)  // sweep: 30-70 step 5
adx_len = input.int(14, "ADX Length", minval=7, maxval=28)            // sweep: 7-28 step 2
adx_threshold = input.int(25, "ADX Threshold", minval=5, maxval=40)   // sweep: 5-40 step 3  ← CHANGED from 14 to 25
min_hold_bars = input.int(4, "Min Hold Bars", minval=1, maxval=10)    // sweep: 1-10 step 1
tp_atr_mult = input.float(1.5, "TP (ATR multiplier)", minval=0.5, maxval=5.0, step=0.1)  // sweep: 0.5-4.0 step 0.3
sl_atr_mult = input.float(1.0, "SL (ATR multiplier)", minval=0.3, maxval=3.0, step=0.1)   // sweep: 0.5-3.0 step 0.3
atr_len = input.int(14, "ATR Length", minval=7, maxval=28)            // sweep: 7-28 step 3

//--- indicator calculations
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
ema50 = ta.ema(close, ema50_len)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)

//--- Manual ADX calculation (Wilder's smoothed)
up_move = high - high[1]
down_move = low[1] - low
plus_dm = (up_move > down_move and up_move > 0) ? up_move : 0
minus_dm = (down_move > up_move and down_move > 0) ? down_move : 0
tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
atr_wilder = ta.rma(tr_val, adx_len)
plus_di = 100 * ta.rma(plus_dm, adx_len) / atr_wilder
minus_di = 100 * ta.rma(minus_dm, adx_len) / atr_wilder
dx_val = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.rma(dx_val, adx_len)

//--- entry conditions
bullish_crossover = ta.crossover(fast_ema, slow_ema)
above_ema50 = close > ema50
rsi_ok = rsi_val > rsi_threshold
adx_ok = adx_val > adx_threshold   // ← Now requires ADX > 25 (strong trending)

//--- entry logic (ALL conditions must be true)
if bullish_crossover and above_ema50 and rsi_ok and adx_ok
    strategy.entry("Long", strategy.long)

//--- exit management
// Track bars since entry
var int entry_bar = na
var float entry_price = na
if strategy.position_size > 0 and na(entry_bar)
    entry_bar := bar_index
    entry_price := close

// Calculate TP/SL levels based on ATR
tp_price = na
sl_price = na
if not na(entry_price)
    tp_price := entry_price + (atr_val * tp_atr_mult)
    sl_price := entry_price - (atr_val * sl_atr_mult)

// Exit with TP/SL
if strategy.position_size > 0 and not na(tp_price) and not na(sl_price)
    strategy.exit("Long Exit", "Long", limit=tp_price, stop=sl_price)

// Min hold: exit if EMA crossunder happens after min_hold_bars
bars_held = bar_index - (na(entry_bar) ? bar_index : entry_bar)
bearish_crossunder = ta.crossunder(fast_ema, slow_ema)
if strategy.position_size > 0 and bearish_crossunder and bars_held >= min_hold_bars
    strategy.close("Long")

// Reset tracking on flat
if strategy.position_size == 0
    entry_bar := na
    entry_price := na
