//@version=5
strategy(
  title="EMA3/8 + RSI(50) + ADX>15 + 1.5:1 TP/SL (iter 341)",
  overlay=true,
  initial_capital=10000,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=100,
  commission_type=strategy.commission.percent,
  commission_value=0.04,
  process_orders_on_close=true
)

//--- inputs
ema_fast_len  = input.int(3,  "Fast EMA Length",  group="EMA", minval=1, maxval=50)  // sweep: 1-10 step 1
ema_slow_len  = input.int(8,  "Slow EMA Length",  group="EMA", minval=5, maxval=50)  // sweep: 5-30 step 2
rsi_len       = input.int(14, "RSI Length",       group="RSI", minval=5, maxval=30)  // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Long Threshold", group="RSI", minval=30, maxval=70) // sweep: 40-60 step 5
adx_len       = input.int(14, "ADX Length",       group="ADX", minval=7, maxval=30)  // sweep: 7-21 step 2
adx_threshold = input.int(15, "ADX Threshold",    group="ADX", minval=10, maxval=40) // sweep: 10-30 step 5
sl_pct        = input.float(0.3, "Stop Loss %",   group="TP/SL", minval=0.1, maxval=2.0, step=0.1)    // sweep: 0.1-1.0 step 0.1
tp_ratio      = input.float(1.5, "TP:SL Ratio",   group="TP/SL", minval=0.5, maxval=5.0, step=0.5)    // sweep: 0.5-3.0 step 0.5

//--- indicators
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val  = ta.rsi(close, rsi_len)

//--- manual ADX calculation (using Wilder's method)
// True Range
tr_val = ta.tr(true)
// +DM and -DM
up = high - high[1]
down = low[1] - low
pos_dm = up > down and up > 0 ? up : 0
neg_dm = down > up and down > 0 ? down : 0
// Smoothed with RMA (Wilder smoothing)
smoothed_tr = ta.rma(tr_val, adx_len)
smoothed_pos_dm = ta.rma(pos_dm, adx_len)
smoothed_neg_dm = ta.rma(neg_dm, adx_len)
// +DI and -DI
pos_di = 100 * smoothed_pos_dm / smoothed_tr
neg_di = 100 * smoothed_neg_dm / smoothed_tr
// DX and ADX
dx_val = 100 * math.abs(pos_di - neg_di) / (pos_di + neg_di)
adx_val = ta.rma(dx_val, adx_len)

//--- state tracking
var bool in_position = false
var float entry_price = 0.0
var int  bars_since_entry = 0

//--- entry logic: long only
long_condition = false
if not in_position
    // EMA crossover condition
    if ta.crossover(ema_fast, ema_slow)
        // RSI filter: long only if RSI above threshold
        if rsi_val > rsi_threshold
            // ADX filter: trending market only
            if adx_val > adx_threshold
                long_condition := true

if long_condition
    strategy.entry("Long", strategy.long)
    entry_price := close
    in_position := true
    bars_since_entry := 0

//--- exit management
if in_position
    bars_since_entry := bars_since_entry + 1
    // Calculate SL and TP in price terms
    sl_distance = close * (sl_pct / 100.0)
    tp_distance = sl_distance * tp_ratio
    
    sl_price = close - sl_distance   // stop loss below entry
    tp_price = close + tp_distance   // take profit above entry
    
    strategy.exit("Long Exit", "Long",
         loss=int(sl_distance / syminfo.mintick),
         profit=int(tp_distance / syminfo.mintick))

//--- reset on exit
if strategy.position_size == 0 and in_position
    in_position := false
    entry_price := 0.0
    bars_since_entry := 0
