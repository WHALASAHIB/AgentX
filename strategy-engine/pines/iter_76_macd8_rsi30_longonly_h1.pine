//@version=5
strategy(title="MACD(8,17,7)+RSI(30) LONG-only H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(8, "MACD Fast Length", minval=5, maxval=20, step=1)   // sweep: 5-20 step 1
slowLength = input.int(17, "MACD Slow Length", minval=10, maxval=30, step=1) // sweep: 10-30 step 1
signalLength = input.int(7, "MACD Signal Length", minval=3, maxval=15, step=1) // sweep: 3-15 step 1

// RSI parameters
rsiLength = input.int(14, "RSI Length", minval=7, maxval=21, step=1)         // sweep: 7-21 step 2
rsiThreshold = input.int(30, "RSI Threshold", minval=20, maxval=50, step=5)  // sweep: 20-50 step 5

// ATR-based TP/SL parameters
atrLength = input.int(14, "ATR Length", minval=7, maxval=21, step=1)        // sweep: 7-21 step 2
slMultiplier = input.float(1.0, "SL ATR Multiplier", minval=0.5, maxval=3.0, step=0.25)  // sweep: 0.5-3.0 step 0.25
tpMultiplier = input.float(1.5, "TP ATR Multiplier", minval=0.5, maxval=5.0, step=0.25)  // sweep: 0.5-5.0 step 0.25

//--- indicator calculations
[macdLine, signalLine, _] = ta.macd(close, fastLength, slowLength, signalLength)
rsi = ta.rsi(close, rsiLength)
atr = ta.atr(atrLength)

//--- entry logic
// LONG entry: MACD line crosses above Signal line AND RSI > threshold
longCondition = ta.crossover(macdLine, signalLine) and rsi > rsiThreshold

//--- exit management
var float entryPrice = na
var int tradeBarIndex = na

if (longCondition and strategy.position_size == 0)
    strategy.entry("LONG", strategy.long)
    entryPrice := close
    tradeBarIndex := bar_index

// Set fixed TP/SL based on ATR from entry bar
if (strategy.position_size > 0 and strategy.position_size[1] == 0)
    // New entry this bar — set exit orders
    stopPrice = entryPrice - (atr * slMultiplier)
    takeProfitPrice = entryPrice + (atr * tpMultiplier)
    strategy.exit("EXIT_LONG", "LONG", loss=close - stopPrice, profit=takeProfitPrice - close)

//--- visual signals
plotshape(longCondition, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
hline(rsiThreshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed)
