//@version=6
strategy(title="EMA3/8 ATR Trail 1.5x", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// EMA parameters
fastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50)
slowLen = input.int(8, "Slow EMA Length", minval=1, maxval=50)

// ATR trailing stop parameters
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)
trailMult = input.float(1.5, "ATR Trail Multiplier", step=0.1, minval=0.5, maxval=5.0)

//--- indicator calculations
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
atrVal = ta.atr(atrLen)

//--- entry logic
longCondition = ta.crossover(fastEma, slowEma)
shortCondition = ta.crossunder(fastEma, slowEma)

//--- ATR trailing stop levels for entry decisions
longStop = close - atrVal * trailMult
shortStop = close + atrVal * trailMult

//--- entry
if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

//--- exit management via ATR trailing stop
if (strategy.position_size > 0)
    // Long position: exit if price closes below ATR trail
    strategy.exit("XL", "Long", stop=longStop)

if (strategy.position_size < 0)
    // Short position: exit if price closes above ATR trail
    strategy.exit("XS", "Short", stop=shortStop)
