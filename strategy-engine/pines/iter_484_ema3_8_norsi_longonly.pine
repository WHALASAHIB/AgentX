//@version=6
strategy(title="BTC 30m — EMA3/8 Crossover No RSI", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods — sweep: 3-8 step 1
fastLen = input.int(3, "Fast EMA", minval=1, maxval=20)
slowLen = input.int(8, "Slow EMA", minval=5, maxval=50)

// ATR-based TP/SL — sweep: 1.0-2.5 step 0.25
atrPeriod = input.int(14, "ATR Period", minval=5, maxval=50)
tpMultiplier = input.float(1.5, "TP (×ATR)", minval=0.5, maxval=5.0, step=0.1)
slMultiplier = input.float(1.0, "SL (×ATR)", minval=0.5, maxval=5.0, step=0.1)

//--- indicators
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)
atrVal = ta.atr(atrPeriod)

//--- entry logic
longCondition = ta.crossover(fastMA, slowMA)
shortCondition = ta.crossunder(fastMA, slowMA)

// Plot EMAs
plot(fastMA, "Fast EMA", color=color.blue, linewidth=2)
plot(slowMA, "Slow EMA", color=color.red, linewidth=2)

//--- exit management
if (longCondition)
    stopLoss = close - (atrVal * slMultiplier)
    takeProfit = close + (atrVal * tpMultiplier)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=math.round((close - stopLoss) / syminfo.mintick), profit=math.round((takeProfit - close) / syminfo.mintick))

if (shortCondition)
    stopLoss = close + (atrVal * slMultiplier)
    takeProfit = close - (atrVal * tpMultiplier)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=math.round((stopLoss - close) / syminfo.mintick), profit=math.round((close - takeProfit) / syminfo.mintick))

// ATR bands plotted for visual reference
upperBand = close + (atrVal * tpMultiplier)
lowerBand = close - (atrVal * slMultiplier)
plot(upperBand, "Upper ATR Band", color=color.green, style=plot.style_circles)
plot(lowerBand, "Lower ATR Band", color=color.red, style=plot.style_circles)
