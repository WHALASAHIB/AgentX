//@version=6
strategy(title="EMA3/8 RSI50 ManualADX25 LongOnly EMA150Filter BarrierExit TP667 SL500 GBPUSD4h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(50, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 754: RSI>50 for long side; sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(25, "ADX Threshold", minval=10, maxval=50)   // iter 754: ADX UNCHANGED at 25; sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 754: regime EMA 150 (proven-best long-side from iter 745/747). sweep: 100-200 step 50
take_profit_tick = input.int(667, "Take Profit (ticks)", minval=100, maxval=20000, step=50)  // iter 754: TP UNCHANGED at 667 (peak of long-side TP map: TP1000 PF 0.851 < TP667 PF 0.859 > TP500 PF 0.810; GBPUSD TP map iter 749 peak). sweep: 500-1000 step 167
stop_loss_tick = input.int(500, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 754: SL 750->500 (ONLY CHANGE -- CONTINUE the confirmed SL gradient from iter 753: SL1000 PF 1.01 < SL750 PF 1.28, avg loss -$87.10->-$63.09 (-28%), WR held 63.3% vs ~57.4% breakeven, net +$9.13->+$195.16). SL 500: avg loss est. -$45-50, barrier 667/500 = 1.33x -> payoff ratio >1 -> breakeven WR ~50% or below, WR ~63% far above -> est. gross PF ~1.7-2.0 if WR holds ~60%. Risk: over-tight SL stops out trades on normal pullback noise before TP works (WR may fall faster than breakeven) -- that is the experiment. sweep: 400-1000 step 100

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 754: CONTINUE the confirmed SL gradient from iter 753 -- SL 1000->750 CONFIRMED: avg loss -$87.10->-$63.09 (-28%), WR held 63.3% vs ~57.4% breakeven at 0.74x realized payoff, PF 1.01->1.28, net +$9.13->+$195.16 (best GBPUSD run), DD 2.95->2.19%, cascade 1.0 perfect. The loss side is the confirmed structural lever and it still runs 1.35x avg win ($63.09 vs $46.80). SL 500 shrinks avg loss further (est. to ~-$45-50, barrier crosses 1.0x -> payoff ratio >1 -> breakeven WR drops to ~50% or below), leaving WR ~63% far above breakeven -- est. gross PF ~1.7-2.0 if WR holds ~60%+. Risk: over-tight SL stops out trades on normal pullback noise before TP works (WR may fall faster than breakeven) -- that is the experiment. One change: stop_loss_tick 750->500 on GBPUSD 4h (iter-753 config otherwise intact: EMA3/8 + RSI50 + ADX25 + EMA150 + TP667 + manual barrier exits, long-only, NO breakeven).)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
