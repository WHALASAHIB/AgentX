//@version=5
strategy(title="EMA5/13 Cross + RSI(50) + 1:1.5 TP/SL XAUUSD 1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFastLen = input.int(5, title="EMA Fast Length", minval=1, maxval=50, step=1)   // sweep: 3-10 step 1
emaSlowLen = input.int(13, title="EMA Slow Length", minval=1, maxval=50, step=1)  // sweep: 10-21 step 1

// RSI filter
rsiLen = input.int(14, title="RSI Length", minval=1, maxval=50, step=1)            // sweep: 7-21 step 2
rsiThreshold = input.int(50, title="RSI Threshold", minval=1, maxval=100, step=5)  // sweep: 40-60 step 5

// Risk management
slPct = input.float(0.3, title="Stop Loss %", minval=0.05, maxval=2.0, step=0.05)  // sweep: 0.1-1.0 step 0.1
tpRatio = input.float(1.5, title="TP/SL Ratio", minval=0.5, maxval=3.0, step=0.5)  // sweep: 0.5-3.0 step 0.5

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)

//--- entry logic
longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiThreshold
shortCondition = ta.crossunder(emaFast, emaSlow) and rsi < rsiThreshold

//--- exit management
if (longCondition)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=close * slPct / syminfo.mintick, profit=close * slPct * tpRatio / syminfo.mintick)

if (shortCondition)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=close * slPct / syminfo.mintick, profit=close * slPct * tpRatio / syminfo.mintick)
