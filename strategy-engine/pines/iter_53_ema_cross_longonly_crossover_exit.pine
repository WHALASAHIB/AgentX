//@version=5
strategy(title="EMA Crossover Long-Only — Crossover Exit (iter 53)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(5, "EMA Fast Length", minval=2, maxval=50)       // sweep: 3-10 step 1
emaSlowLen = input.int(13, "EMA Slow Length", minval=5, maxval=100)     // sweep: 10-30 step 2
atrLen = input.int(14, "ATR Length", minval=5, maxval=50)               // sweep: 10-21 step 1
slPct = input.float(0.5, "SL % of Entry Price", minval=0.1, maxval=3.0) // sweep: 0.3-2.0 step 0.1

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal = ta.atr(atrLen)

//--- entry logic
longCondition = ta.crossover(emaFast, emaSlow)
exitCondition = ta.crossunder(emaFast, emaSlow)

if (longCondition)
    entryPrice = close
    slDistance = entryPrice * slPct / 100.0
    slPrice = entryPrice - slDistance
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=slPrice)

if (exitCondition and strategy.position_size > 0)
    strategy.close("Long", comment="CrossoverExit")

//--- visual aids
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)
