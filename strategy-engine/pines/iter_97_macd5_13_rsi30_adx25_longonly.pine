//@version=5
strategy(title="MACD(5,13,5) RSI(30) ADX(14)>25 Long-Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength   = input.int(5,  "MACD Fast Length",  minval=2, maxval=50, step=1)   // sweep: 2-20 step 1
slowLength   = input.int(13, "MACD Slow Length",  minval=5, maxval=50, step=1)   // sweep: 10-30 step 2
signalLength = input.int(5,  "MACD Signal Length", minval=2, maxval=20, step=1)  // sweep: 3-12 step 1

// RSI filter
rsiLength    = input.int(14, "RSI Length",         minval=5, maxval=30, step=1)  // sweep: 7-21 step 2
rsiMin       = input.int(30, "RSI Minimum (Long)", minval=20, maxval=60, step=2) // sweep: 25-50 step 5

// ADX trend filter (NEW — to filter out chop)
adxLength    = input.int(14, "ADX Length",         minval=7, maxval=30, step=1)  // sweep: 10-21 step 2
adxMin       = input.int(25, "ADX Minimum (Trend)", minval=15, maxval=40, step=5) // sweep: 20-30 step 5

// TP/SL
tpRatio      = input.float(2.0, "Take Profit (1:Risk)", minval=0.5, maxval=5.0, step=0.1)  // sweep: 1.0-3.0 step 0.5
slATRMult    = input.float(1.5, "SL ATR Multiple",      minval=0.5, maxval=4.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
atrLength    = input.int(14,   "ATR Length",            minval=5, maxval=30, step=1)

//--- calculations
[macdLine, signalLine, _] = ta.macd(close, fastLength, slowLength, signalLength)
rsiVal = ta.rsi(close, rsiLength)
atrVal = ta.atr(atrLength)

// Manual ADX calculation using DMI
up = ta.change(high)
down = -ta.change(low)
plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
smoothTR = ta.sma(tr, adxLength)
smoothPlusDM = ta.sma(plusDM, adxLength)
smoothMinusDM = ta.sma(minusDM, adxLength)
plusDI = 100 * smoothPlusDM / smoothTR
minusDI = 100 * smoothMinusDM / smoothTR
dx = math.abs(plusDI - minusDI) / (plusDI + minusDI) * 100
adxVal = ta.sma(dx, adxLength)

//--- entry logic
// LONG entry: MACD line > signal line AND MACD above zero AND RSI >= min AND ADX > min (trending market only)
longCondition = macdLine > signalLine and macdLine > 0 and rsiVal >= rsiMin and adxVal > adxMin

//--- exit management
slTicks = int(atrVal * slATRMult / syminfo.mintick)
tpTicks = int(slTicks * tpRatio)

if longCondition and strategy.position_size == 0
    strategy.entry("LONG", strategy.long)

if strategy.position_size > 0
    strategy.exit("LONG_EXIT", "LONG", loss=slTicks, profit=tpTicks)
