//@version=5
strategy(title="EMA3/8 Long-Only ADX14 NoRSI 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
ema_fast_len = input.int(3, "EMA Fast Length", minval=1, maxval=50)        // sweep: 2-10 step 1
ema_slow_len = input.int(8, "EMA Slow Length", minval=1, maxval=50)         // sweep: 5-21 step 1

// ADX parameters
adx_len = input.int(14, "ADX Length", minval=5, maxval=30)                  // sweep: 10-25 step 1
adx_threshold = input.float(14, "ADX Minimum", minval=1, maxval=50)         // sweep: 12-18 step 1

// TP/SL in points
tp_points = input.int(125, "Take Profit (points)", minval=10, maxval=500)   // sweep: 50-250 step 25
sl_points = input.int(125, "Stop Loss (points)", minval=10, maxval=500)     // sweep: 50-250 step 25

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

[di_plus, di_minus, adx] = ta.dmi(adx_len, adx_len)

//--- entry logic
long_condition = false
long_condition := ta.crossover(ema_fast, ema_slow) and adx > adx_threshold

//--- exit management
if (long_condition)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=sl_points, profit=tp_points)

//--- visual plot for analysis
plot(ema_fast, "EMA Fast", color=color.blue, linewidth=1)
plot(ema_slow, "EMA Slow", color=color.red, linewidth=1)
hline(adx_threshold, "ADX Threshold", color=color.gray, linestyle=hline.style_dashed)
