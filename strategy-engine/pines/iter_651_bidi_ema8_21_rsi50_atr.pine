//@version=6
strategy(title="iter_651 — bidi EMA8/21 ATR TP/SL RSI50", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04)

//====================================================================
// --- inputs
//====================================================================

fastLen = input.int(8, "Fast EMA", minval=2, maxval=50)       // sweep: 5-13 step 2
slowLen = input.int(21, "Slow EMA", minval=5, maxval=100)     // sweep: 13-34 step 3
rsiLen  = input.int(14, "RSI Length", minval=2, maxval=50)    // sweep: 10-20 step 2
adxLen  = input.int(14, "ADX Length", minval=2, maxval=50)    // sweep: 10-25 step 3
atrLen  = input.int(14, "ATR Length", minval=2, maxval=50)    // sweep: 7-21 step 7
tpMult  = input.float(1.5, "TP Multiplier", minval=0.1, maxval=5.0, step=0.1)  // sweep: 1.0-3.0 step 0.5
slMult  = input.float(1.0, "SL Multiplier", minval=0.1, maxval=5.0, step=0.1)  // sweep: 0.5-2.0 step 0.5

//====================================================================
// --- calculations
//====================================================================

fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
adx = ta.adx(high, low, close, adxLen)

bullCross = ta.crossover(fastEMA, slowEMA)
bearCross = ta.crossunder(fastEMA, slowEMA)

// RSI filter: long only if RSI>50, short only if RSI<50
rsiLongOK = rsi > 50
rsiShortOK = rsi < 50

longEntry = bullCross and rsiLongOK
shortEntry = bearCross and rsiShortOK

//--- exit management
tpPriceLong = strategy.position_avg_price + (tpMult * atr * syminfo.mintick)
slPriceLong = strategy.position_avg_price - (slMult * atr * syminfo.mintick)
tpPriceShort = strategy.position_avg_price - (tpMult * atr * syminfo.mintick)
slPriceShort = strategy.position_avg_price + (slMult * atr * syminfo.mintick)

//====================================================================
// --- entry logic (reversal — close existing, open opposite)
//====================================================================
if (longEntry)
    strategy.entry("Long", strategy.long)

if (shortEntry)
    strategy.entry("Short", strategy.short)

//====================================================================
// --- exit management (TP/SL)
//====================================================================
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", limit=tpPriceLong, stop=slPriceLong)

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", limit=tpPriceShort, stop=slPriceShort)
