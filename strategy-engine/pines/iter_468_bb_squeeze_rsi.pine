//@version=6
strategy(title="BB Squeeze Breakout RSI Filter — BTCUSDT 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bbLength = input.int(20, "BB Length", minval=5, maxval=50)       // sweep: 10-30 step 5
bbStdDev = input.float(2.0, "BB StdDev", minval=0.5, maxval=4.0)  // sweep: 1.5-3.0 step 0.5
rsiLength = input.int(14, "RSI Length", minval=5, maxval=30)      // sweep: 10-20 step 2
rsiLongThresh = input.int(50, "RSI Long Threshold", minval=30, maxval=70)   // sweep: 40-60 step 5
rsiShortThresh = input.int(50, "RSI Short Threshold", minval=30, maxval=70)  // sweep: 40-60 step 5
atrLength = input.int(14, "ATR Length", minval=5, maxval=30)      // sweep: 10-20 step 2
atrMult = input.float(2.0, "ATR Trail Multiplier", minval=0.5, maxval=5.0)  // sweep: 1.5-3.0 step 0.5
bbWidthSmaLength = input.int(20, "BB Width SMA Length", minval=5, maxval=50) // sweep: 10-30 step 5

//--- indicator calculations
basis = ta.sma(close, bbLength)
dev = ta.stdev(close, bbLength) * bbStdDev
upperBB = basis + dev
lowerBB = basis - dev
bbWidth = upperBB - lowerBB
bbWidthSma = ta.sma(bbWidth, bbWidthSmaLength)
bbExpanding = bbWidth > bbWidthSma

rsi = ta.rsi(close, rsiLength)
atr = ta.atr(atrLength)

//--- entry logic
longCondition = close > upperBB and bbExpanding and rsi > rsiLongThresh
shortCondition = close < lowerBB and bbExpanding and rsi < rsiShortThresh

if (longCondition)
    strategy.entry("L", strategy.long)

if (shortCondition)
    strategy.entry("S", strategy.short)

//--- exit management via ATR trailing stop
strategy.exit("XL", "L", stop=close - atr * atrMult, trail_offset=close - atr * atrMult)
strategy.exit("XS", "S", stop=close + atr * atrMult, trail_offset=close + atr * atrMult)
