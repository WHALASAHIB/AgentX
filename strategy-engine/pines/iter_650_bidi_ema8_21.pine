//@version=6
strategy(title="iter_650 — bidirectional EMA8/21 cross", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04)

// Bidirectional EMA crossover — enter long when fast crosses above slow, short when fast crosses below
fastLen = 8
slowLen = 21
atrLen = 14

fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
atr = ta.atr(atrLen)

bullCross = ta.crossover(fastEMA, slowEMA)
bearCross = ta.crossunder(fastEMA, slowEMA)

tpMult = 1.5
slMult = 1.0

tpPriceLong = strategy.position_avg_price + (tpMult * atr * syminfo.mintick)
slPriceLong = strategy.position_avg_price - (slMult * atr * syminfo.mintick)
tpPriceShort = strategy.position_avg_price - (tpMult * atr * syminfo.mintick)
slPriceShort = strategy.position_avg_price + (slMult * atr * syminfo.mintick)

if (bullCross and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (bearCross and strategy.position_size == 0)
    strategy.entry("Short", strategy.short)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", limit=tpPriceLong, stop=slPriceLong)

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", limit=tpPriceShort, stop=slPriceShort)
