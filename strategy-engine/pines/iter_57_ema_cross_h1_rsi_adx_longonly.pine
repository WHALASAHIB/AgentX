//@version=5
strategy(title="EMA5_13_RSI_ADX_H1_LONG_ONLY", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// EMA parameters
emaFastLen   = input.int(5,   "EMA Fast Length",   minval=1, maxval=50, group="EMA")   // sweep: 3-10 step 1
emaSlowLen   = input.int(13,  "EMA Slow Length",   minval=5, maxval=50, group="EMA")   // sweep: 10-20 step 2

// RSI parameters
rsiLen       = input.int(14,  "RSI Length",        minval=5, maxval=30, group="RSI")   // sweep: 7-21 step 2
rsiThreshold = input.int(50,  "RSI Long Threshold (> this)", minval=30, maxval=70, group="RSI") // sweep: 40-60 step 5

// ADX parameters
adxLen       = input.int(14,  "ADX Length",        minval=5, maxval=30, group="ADX")   // sweep: 10-20 step 2
adxThreshold = input.int(25,  "ADX Min (trending)", minval=15, maxval=40, group="ADX") // sweep: 20-30 step 2

// Trade management
tpRatio      = input.float(2.0, "Take Profit (×ATR)", minval=1.0, maxval=5.0, step=0.5, group="Trade Mgmt") // sweep: 1.0-3.0 step 0.5
slATRMult    = input.float(1.0, "Stop Loss (×ATR)",  minval=0.5, maxval=3.0, step=0.5, group="Trade Mgmt") // sweep: 0.5-2.0 step 0.5
atrLen       = input.int(14,  "ATR Length",        minval=7, maxval=30, group="Trade Mgmt") // sweep: 10-20 step 2

//--- indicator calculations

// EMA
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// RSI
rsiVal = ta.rsi(close, rsiLen)

// ADX (trend strength)
[dmPlus, dmMinus, adxVal] = ta.dmi(adxLen, adxLen)

// ATR for TP/SL
atrVal = ta.atr(atrLen)

//--- entry logic (LONG only)
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThreshold and adxVal > adxThreshold

// Entry — LONG
if longCondition and strategy.position_size == 0
    stopLoss   = close - atrVal * slATRMult
    takeProfit = close + atrVal * tpRatio
    strategy.entry("LONG", strategy.long)
    strategy.exit("XLONG", "LONG", loss=math.round(close - stopLoss), profit=math.round(takeProfit - close))
    // Comment: entered LONG on EMA crossover with RSI>50 and ADX>25 trending

//--- exit management (emergency exit on crossunder — no cascade close on every bar)
exitCondition = ta.crossunder(emaFast, emaSlow) and strategy.position_size > 0
if exitCondition
    strategy.close("LONG", comment="EMA_CROSSUNDER_EXIT")
