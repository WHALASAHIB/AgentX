//@version=6
strategy(title="EMA2/5 Long-Only ATR Trail — GBPUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fastLen = input.int(2, "Fast EMA Length", minval=1, maxval=20)
slowLen = input.int(5, "Slow EMA Length", minval=3, maxval=50)

// ATR trailing stop parameters
atrLen  = input.int(14, "ATR Length", minval=5, maxval=50)
atrMult = input.float(3.0, "ATR Multiplier", minval=0.5, maxval=6.0, step=0.5)

//--- indicator calculations
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
atr     = ta.atr(atrLen)

//--- entry logic
longCondition = ta.crossover(emaFast, emaSlow)

if longCondition
    strategy.entry("Long", strategy.long)

//--- trailing stop management
longStopPrice = 0.0
if strategy.position_size > 0
    // ATR trail: stop trails below highest close since entry minus ATR mult
    longStopPrice := math.max(longStopPrice[1], close - atr * atrMult)
    strategy.exit("ATR Trail", "Long", stop=longStopPrice)

//--- exit on EMA crossover (bearish)
if strategy.position_size > 0 and ta.crossunder(emaFast, emaSlow)
    strategy.close("Long")
