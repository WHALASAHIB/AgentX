//@version=6
strategy(title="BTC 30m — EMA3/8 ATR Trail", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods — sweep: 3-8 step 1
fastLen = input.int(3, "Fast EMA", minval=1, maxval=20)
slowLen = input.int(8, "Slow EMA", minval=5, maxval=50)

// ATR trailing stop — sweep: 1.5-3.0 step 0.25
atrPeriod = input.int(14, "ATR Period", minval=5, maxval=50)
trailMult = input.float(2.0, "Trail Multiplier", minval=0.5, maxval=5.0, step=0.1)

//--- indicators
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)
atrVal = ta.atr(atrPeriod)

//--- trailing stop state (persistent across bars)
var float trailStop = na

//--- entry logic — EMA crossover
longEntry = ta.crossover(fastMA, slowMA)
shortEntry = ta.crossunder(fastMA, slowMA)

flat = strategy.position_size == 0

//--- entry — only when flat, set initial trail stop
if (flat)
    if (longEntry)
        trailStop := close - (atrVal * trailMult)
        strategy.entry("Long", strategy.long)
    if (shortEntry)
        trailStop := close + (atrVal * trailMult)
        strategy.entry("Short", strategy.short)

//--- ratchet trail stop while in position
if (strategy.position_size > 0)
    trailStop := math.max(trailStop, close - (atrVal * trailMult))
    strategy.exit("Long Exit", "Long", stop=trailStop)

if (strategy.position_size < 0)
    trailStop := math.min(trailStop, close + (atrVal * trailMult))
    strategy.exit("Short Exit", "Short", stop=trailStop)

//--- reset trail when flat (no position)
if (flat)
    trailStop := na

//--- visual
plot(fastMA, "Fast EMA", color=color.blue, linewidth=2)
plot(slowMA, "Slow EMA", color=color.red, linewidth=2)

// Plot trailing stop
plot(strategy.position_size != 0 ? trailStop : na, "Trail Stop", color=color.green, style=plot.style_linebr)
