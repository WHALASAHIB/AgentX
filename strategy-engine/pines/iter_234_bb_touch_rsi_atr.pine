//@version=5
strategy(title="BB Touch RSI ATR XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_len = input.int(20, "BB Length", minval=5, maxval=50)       // sweep: 10-30 step 5
bb_mult = input.float(2.0, "BB StdDev", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)      // sweep: 7-21 step 7
rsi_ob = input.int(70, "RSI Overbought", minval=60, maxval=90)  // sweep: 65-80 step 5
rsi_os = input.int(30, "RSI Oversold", minval=10, maxval=40)    // sweep: 15-35 step 5
atr_len = input.int(14, "ATR Length", minval=7, maxval=30)      // sweep: 10-20 step 5
sl_atr = input.float(1.0, "SL Multiplier (ATR)", minval=0.5, maxval=3.0, step=0.5)   // sweep: 0.5-2.0 step 0.5
tp_atr = input.float(1.5, "TP Multiplier (ATR)", minval=0.5, maxval=5.0, step=0.5)   // sweep: 1.0-3.0 step 0.5

//--- indicators
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_len, bb_mult)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(atr_len)

//--- entry conditions
long_condition = close > bb_upper and rsi_val > 50
short_condition = close < bb_lower and rsi_val < 50

//--- entry logic
if long_condition
    strategy.entry("Long", strategy.long)

if short_condition
    strategy.entry("Short", strategy.short)

//--- exit management
// Use ATR-based fixed SL/TP
long_sl = close - (atr_val * sl_atr)
long_tp = close + (atr_val * tp_atr)
short_sl = close + (atr_val * sl_atr)
short_tp = close - (atr_val * tp_atr)

// Convert to ticks for strategy.exit
sl_dist_ticks_long = (close - long_sl) / syminfo.mintick
tp_dist_ticks_long = (long_tp - close) / syminfo.mintick
sl_dist_ticks_short = (short_sl - close) / syminfo.mintick
tp_dist_ticks_short = (close - short_tp) / syminfo.mintick

if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=int(sl_dist_ticks_long), profit=int(tp_dist_ticks_long))

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=int(sl_dist_ticks_short), profit=int(tp_dist_ticks_short))
