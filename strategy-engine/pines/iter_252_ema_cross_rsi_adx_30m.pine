//@version=5
strategy(title="EMA5_13_RSI50_ADX25_ATR151_30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFast = input.int(5, "Fast EMA Length", minval=2, maxval=50)      // sweep: 3-20 step 2
emaSlow = input.int(13, "Slow EMA Length", minval=5, maxval=100)     // sweep: 8-50 step 5

// RSI parameters
rsiLen = input.int(14, "RSI Length", minval=7, maxval=21)            // sweep: 7-21 step 2

// ADX parameters
adxLen = input.int(14, "ADX Length", minval=7, maxval=21)            // sweep: 7-21 step 2
adxThreshold = input.int(25, "ADX Threshold", minval=10, maxval=40)  // sweep: 15-35 step 5

// ATR TP/SL parameters
atrLen = input.int(14, "ATR Length", minval=7, maxval=21)            // sweep: 7-21 step 2
tpMultiplier = input.float(1.0, "Take Profit (ATR multiple)", minval=0.5, maxval=5.0)  // sweep: 0.5-3.0 step 0.5
slMultiplier = input.float(1.5, "Stop Loss (ATR multiple)", minval=0.5, maxval=5.0)    // sweep: 0.5-3.0 step 0.5

//--- indicator calculations
fastMA = ta.ema(close, emaFast)
slowMA = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLen)
adxVal = ta.adx(high, low, close, adxLen)
atrVal = ta.atr(atrLen)

//--- entry logic
// Long condition: EMA12 crosses above EMA26, RSI > 50, ADX > 25
longCondition = ta.crossover(fastMA, slowMA) and rsiVal > 50 and adxVal > adxThreshold
// Short condition: EMA12 crosses below EMA26, RSI < 50, ADX > 25
shortCondition = ta.crossunder(fastMA, slowMA) and rsiVal < 50 and adxVal > adxThreshold

// Calculate ATR-based TP/SL levels in ticks
slTicks = int(atrVal * slMultiplier / syminfo.mintick)
tpTicks = int(atrVal * tpMultiplier / syminfo.mintick)

// Enter long
if longCondition
    strategy.entry("Long", strategy.long)

// Enter short
if shortCondition
    strategy.entry("Short", strategy.short)

//--- exit management
// Exit long positions with ATR-based TP/SL
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)

// Exit short positions with ATR-based TP/SL
if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=slTicks, profit=tpTicks)
