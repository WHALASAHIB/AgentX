//@version=6
strategy(title="iter_500_ema3_8_rsi_adx_tp15", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)        // sweep: 2-10 step 1
slow_len = input.int(8, "Slow EMA Length", minval=1, maxval=50)        // sweep: 5-20 step 1

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)             // sweep: 7-21 step 1
rsi_threshold = input.int(50, "RSI Threshold (Long)", minval=1, maxval=99) // sweep: 40-60 step 5

// ADX parameters
adx_len = input.int(14, "ADX Length", minval=2, maxval=50)             // sweep: 10-20 step 2
adx_threshold = input.int(25, "ADX Threshold", minval=1, maxval=99)    // sweep: 20-30 step 5

// TP/SL parameters (based on ATR)
atr_len = input.int(14, "ATR Length", minval=2, maxval=50)             // sweep: 10-20 step 2
sl_atr_mult = input.float(2.0, "SL ATR Multiplier", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
tp_atr_mult = input.float(1.5, "TP ATR Multiplier", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5

//--- indicator calculations
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX calculation (ta.adx not available on TV_ENGINE_JUL_26)
tr_ = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_ = high - high[1]
down_ = low[1] - low
plus_dm = up_ > down_ and up_ > 0 ? up_ : 0
minus_dm = down_ > up_ and down_ > 0 ? down_ : 0
atr_val = ta.rma(tr_, adx_len)
plus_di = 100 * ta.rma(plus_dm, adx_len) / atr_val
minus_di = 100 * ta.rma(minus_dm, adx_len) / atr_val
dx = math.abs(plus_di - minus_di) / (plus_di + minus_di) * 100
adx_val = ta.rma(dx, adx_len)

//--- entry logic: long-only
long_condition = ta.crossover(fast_ema, slow_ema) and rsi_val > rsi_threshold and adx_val > adx_threshold

if (long_condition)
    strategy.entry("Long", strategy.long)

//--- exit management: fixed TP/SL based on ATR
if (strategy.position_size > 0)
    entry_price = strategy.position_avg_price
    sl_price = entry_price - (atr_val * sl_atr_mult)
    tp_price = entry_price + (atr_val * tp_atr_mult)
    strategy.exit("Long Exit", "Long", loss=math.round((entry_price - sl_price) / syminfo.mintick), profit=math.round((tp_price - entry_price) / syminfo.mintick))

//--- plot indicators for visual reference
plot(fast_ema, "Fast EMA", color=color.blue, linewidth=1)
plot(slow_ema, "Slow EMA", color=color.red, linewidth=1)
hline(50, "RSI Ref", color=color.gray, linestyle=hline.style_dashed)
