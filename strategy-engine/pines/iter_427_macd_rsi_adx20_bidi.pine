//@version=5
strategy(title="MACD RSI ADX20 Bidirectional XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//====================================================================//
//--- inputs
//====================================================================//

// MACD parameters
macd_fast = input.int(5, "MACD Fast Length", minval=1)        // sweep: 3-12 step 1
macd_slow = input.int(13, "MACD Slow Length", minval=1)       // sweep: 10-26 step 2
macd_signal = input.int(5, "MACD Signal Smoothing", minval=1) // sweep: 3-9 step 1

// RSI filter
rsi_length = input.int(14, "RSI Length", minval=1)            // sweep: 7-21 step 1
rsi_long_threshold = input.int(50, "RSI Long Minimum", minval=1)  // sweep: 40-60 step 5
rsi_short_threshold = input.int(50, "RSI Short Maximum", minval=1) // sweep: 40-60 step 5

// ADX filter
adx_length = input.int(14, "ADX Length", minval=1)            // sweep: 7-21 step 1
adx_threshold = input.int(20, "ADX Minimum Threshold", minval=1) // sweep: 14-30 step 2

// TP/SL in points (converted from ticks)
tp_points = input.int(100, "Take Profit (points)", minval=10)   // sweep: 50-200 step 10
sl_points = input.int(150, "Stop Loss (points)", minval=10)     // sweep: 50-200 step 10

// Bidirectional toggle
trade_long = input.bool(true, "Allow Long Trades")
trade_short = input.bool(true, "Allow Short Trades")

//====================================================================//
//--- indicator calculations
//====================================================================//

// MACD
[macd_line, signal_line, _] = ta.macd(close, macd_fast, macd_slow, macd_signal)
macd_bullish = ta.crossover(macd_line, signal_line)
macd_bearish = ta.crossunder(macd_line, signal_line)

// RSI
rsi_val = ta.rsi(close, rsi_length)

// ADX (requires +DI and -DI from DMI)
[di_plus, di_minus, adx_val] = ta.dmi(high, low, close, adx_length)

//====================================================================//
//--- entry logic
//====================================================================//

// Long condition: MACD bullish crossover + RSI > threshold + ADX > threshold
long_condition = macd_bullish and rsi_val > rsi_long_threshold and adx_val > adx_threshold and trade_long

// Short condition: MACD bearish crossover + RSI < threshold + ADX > threshold
short_condition = macd_bearish and rsi_val < rsi_short_threshold and adx_val > adx_threshold and trade_short

// Entry positions
if long_condition
    strategy.entry("Long", strategy.long)
    
if short_condition
    strategy.entry("Short", strategy.short)

//====================================================================//
//--- exit management
//====================================================================//

// Exit long positions with TP and SL
if strategy.position_size > 0
    strategy.exit("XL", "Long", 
     loss=int(sl_points / syminfo.mintick), 
     profit=int(tp_points / syminfo.mintick))

// Exit short positions with TP and SL
if strategy.position_size < 0
    strategy.exit("XS", "Short", 
     loss=int(sl_points / syminfo.mintick), 
     profit=int(tp_points / syminfo.mintick))
