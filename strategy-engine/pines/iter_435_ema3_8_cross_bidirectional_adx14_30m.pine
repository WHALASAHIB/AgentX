//@version=5
strategy(title="EMA3/8 Crossover Bidirectional ADX14 30m XAUUSD", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA fast period
emaFastLen = input.int(3, "EMA Fast Period", minval=1, maxval=50)
// sweep: 2-10 step 1

// EMA slow period  
emaSlowLen = input.int(8, "EMA Slow Period", minval=2, maxval=50)
// sweep: 5-21 step 2

// RSI length
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)
// sweep: 7-21 step 2

// RSI overbought threshold (used for short entry)
rsiOB = input.int(50, "RSI Overbought (short if RSI > this)", minval=20, maxval=80)
// sweep: 40-70 step 5

// RSI oversold threshold (used for long entry)  
rsiOS = input.int(50, "RSI Oversold (long if RSI < this)", minval=20, maxval=80)
// sweep: 30-60 step 5

// ADX threshold
adxLen = input.int(14, "ADX Length", minval=2, maxval=50)
adxThresh = input.int(14, "ADX Minimum Threshold", minval=1, maxval=50)
// sweep: 10-30 step 2

// TP in points
tpPoints = input.int(125, "Take Profit (points)", minval=10, maxval=500)
// sweep: 50-200 step 25

// SL in points
slPoints = input.int(125, "Stop Loss (points)", minval=10, maxval=500)
// sweep: 50-200 step 25

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

//--- entry logic
// Long: EMA fast crosses above EMA slow AND RSI < oversold threshold AND ADX > threshold
longCondition = ta.crossover(emaFast, emaSlow) and rsi < rsiOS and adx > adxThresh

// Short: EMA fast crosses below EMA slow AND RSI > overbought threshold AND ADX > threshold
shortCondition = ta.crossunder(emaFast, emaSlow) and rsi > rsiOB and adx > adxThresh

//--- exit management
// Exit long on crossunder (EMA fast crosses below EMA slow)
longExit = ta.crossunder(emaFast, emaSlow)

// Exit short on crossover (EMA fast crosses above EMA slow)
shortExit = ta.crossover(emaFast, emaSlow)

//--- position management
if (longCondition)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=slPoints, profit=tpPoints)

if (shortCondition)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=slPoints, profit=tpPoints)

// Exit positions on EMA crossover reversal (close at market, no cascade)
if (longExit and strategy.position_size > 0)
    strategy.close("Long")

if (shortExit and strategy.position_size < 0)
    strategy.close("Short")

//--- plot EMAs for visual reference
plot(emaFast, "EMA Fast", color.blue)
plot(emaSlow, "EMA Slow", color.red)
