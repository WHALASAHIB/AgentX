//@version=6
strategy(title="BB Mean Reversion XAU30m - No RSI, Wide TP/SL, 3-bar Cooldown", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_length = input.int(20, "BB Length", minval=5, maxval=50)       // sweep: 10-30 step 5
bb_mult = input.float(2.0, "BB StdDev", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5
tp_ticks = input.int(1000, "Take Profit (ticks)", minval=100, maxval=3000, step=50)  // sweep: 500-2000 step 100
sl_ticks = input.int(500, "Stop Loss (ticks)", minval=100, maxval=2000, step=50)     // sweep: 300-1000 step 100
cooldown_bars = input.int(3, "Bars Since Exit Cooldown", minval=1, maxval=20)        // sweep: 1-10 step 2

//--- Bollinger Bands
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)

//--- Track entries and exits
var last_exit_bar = 0
var in_position = false
var exit_placed = false

// Detect exit
if (strategy.position_size == 0)
    if (in_position)
        in_position := false
        exit_placed := false
        last_exit_bar := bar_index

// Bars since last exit
bars_since_exit = bar_index - last_exit_bar

//--- entry logic
// Buy when close touches or crosses below lower BB
long_entry = (close <= bb_lower) and not in_position and (bars_since_exit >= cooldown_bars)

// Sell when close touches or crosses above upper BB
short_entry = (close >= bb_upper) and not in_position and (bars_since_exit >= cooldown_bars)

//--- execute entries
if (long_entry)
    strategy.entry("BB_Long", strategy.long)
    in_position := true
    exit_placed := false

if (short_entry)
    strategy.entry("BB_Short", strategy.short)
    in_position := true
    exit_placed := false

//--- exit management via fixed tick-based TP/SL
if (strategy.position_size != 0 and not exit_placed)
    strategy.exit("BB_Exit", from_entry="BB_Long", loss=sl_ticks, profit=tp_ticks)
    strategy.exit("BB_Exit", from_entry="BB_Short", loss=sl_ticks, profit=tp_ticks)
    exit_placed := true

//--- visual bands
plot(bb_mid, "BB Mid", color=color.blue)
plot(bb_upper, "BB Upper", color=color.gray)
plot(bb_lower, "BB Lower", color=color.gray)
