//@version=6
strategy(title="iter_587 — MACD(8,17,5) + RSI(14)>40 LONG-ONLY XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
macd_fast = input.int(8, "MACD Fast", minval=2, maxval=50, step=1)   // sweep: 5-15 step 2
macd_slow = input.int(17, "MACD Slow", minval=5, maxval=100, step=1)  // sweep: 12-30 step 3
macd_sig  = input.int(5, "MACD Signal", minval=2, maxval=20, step=1)  // sweep: 3-12 step 2
rsi_len   = input.int(14, "RSI Length", minval=5, maxval=30, step=1)   // sweep: 7-21 step 3
rsi_min   = input.int(40, "RSI Min (Long)", minval=20, maxval=60, step=5) // sweep: 30-50 step 5
sl_pct    = input.float(0.3, "Stop Loss %", minval=0.1, maxval=2.0, step=0.1)  // sweep: 0.2-1.0 step 0.1
tp_pct    = input.float(0.2, "Take Profit %", minval=0.1, maxval=2.0, step=0.1) // sweep: 0.1-0.5 step 0.05

//--- indicators
[macd_line, signal_line, _] = ta.macd(close, macd_fast, macd_slow, macd_sig)
rsi_val = ta.rsi(close, rsi_len)

//--- entry logic (LONG ONLY)
long_condition = ta.crossover(macd_line, signal_line) and rsi_val > rsi_min

if long_condition
    strategy.entry("LONG", strategy.long)

//--- exit management — percentage-based stops
entry_price = strategy.position_avg_price
if strategy.position_size > 0
    strategy.exit("LONG_EXIT", "LONG", loss=entry_price * sl_pct / syminfo.mintick, profit=entry_price * tp_pct / syminfo.mintick)

//--- plot
hline(0, "Zero", color=color.gray)
plot(macd_line, "MACD", color=color.blue)
plot(signal_line, "Signal", color=color.orange)
