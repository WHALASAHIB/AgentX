//@version=6
strategy(title="MACD12/26/9 RSI40 ManualADX28 EMA150Filter BarrierExit TP3000 SL4500 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

// iter 780: PIVOT to the second alternate indicator family per the iter-774 pivot plan.
// iter 779 re-confirmed the EMA3/8 ADX28 peak (24 trades, PF 1.66, Sharpe 1.78, WR 70.8%,
// DD 2.23%, net +$273.58 -- all rulebook gates met, entry-quality levers exhausted).
// ONE change: signal family EMA3/8 crossover -> MACD(12,26,9) crossover.
// Signal: long when MACD line crosses above signal line (bullish crossover), short when
// MACD crosses below (bearish crossover); keep the proven filter stack UNCHANGED (RSI40
// filter, ADX28 trending gate, EMA150 long-side regime filter, TP3000/SL4500 manual barriers,
// flat-only entry, 1-bar min hold, NO breakeven).
// Precedent: iter 708-713 MACD on XAUUSD H1 was weak (PF 0.35-0.50) but on the truncated
// POLYGON forex store WITHOUT this filter stack; BTC 30m store is fully testable (4609 bars,
// coverage 106.96%, no warnings). Risk: MACD crossover is a slower signal than EMA3/8 --
// trade count may drop toward the 20-trade floor; if MACD yields <20 trades, next lever:
// reduce MACD fast/slow lengths (12,26 -> 8,17) or relax ADX 28->25.

//--- inputs
macd_fast_len = input.int(12, "MACD Fast Length", minval=3, maxval=30, step=1)       // sweep: 8-16 step 2 (iter 780: 12 per classic default; next lever 8,17 if <20 trades)
macd_slow_len = input.int(26, "MACD Slow Length", minval=8, maxval=60, step=1)       // sweep: 17-34 step 3 (iter 780: 26 per classic default)
macd_signal_len = input.int(9, "MACD Signal Length", minval=3, maxval=30, step=1)    // sweep: 7-12 step 1 (iter 780: 9 per classic default)
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(40, "RSI Threshold (long above / short below)", minval=20, maxval=80)  // iter 780: RSI UNCHANGED at 40 (iter-769/770 peak). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(28, "ADX Threshold", minval=10, maxval=50)   // iter 780: ADX UNCHANGED at 28 (iter-772/774 peak; ADX dimension FULLY MAPPED: ADX22 < ADX25 < ADX28 PEAK > ADX30 invalid). sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 780: regime EMA 150 UNCHANGED (proven-best long-side from iter 745/747). sweep: 100-200 step 50
take_profit_tick = input.int(3000, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 780: TP UNCHANGED at 3000 (iter-765 peak, ~0.75x ATR). sweep: 2000-4000 step 500
stop_loss_tick = input.int(4500, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 780: SL UNCHANGED at 4500 (iter-765 peak, ~1x ATR). sweep: 3000-6000 step 500

//--- indicator calculations
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- MACD (built-in; returns [macd_line, signal_line, hist])
[macd_line, macd_signal, macd_hist] = ta.macd(close, macd_fast_len, macd_slow_len, macd_signal_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection (MACD line vs signal line)
cross_up = ta.crossover(macd_line, macd_signal)
cross_down = ta.crossunder(macd_line, macd_signal)

//--- entry conditions (both directions; filter stack UNCHANGED from iter-772/774 peak: RSI40 + ADX28 + EMA150 regime)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime
short_condition = cross_down and rsi_val < rsi_threshold and adx_val > adx_threshold and close < ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var float short_tp = na
var float short_sl = na
var int entry_bar = -1

//--- entry logic (flat only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    short_tp := close - take_profit_tick * syminfo.mintick
    short_sl := close + stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")

if strategy.position_size < 0 and bar_index > entry_bar
    if low <= short_tp
        strategy.close("Short", comment="TP")
    if high >= short_sl
        strategy.close("Short", comment="SL")
