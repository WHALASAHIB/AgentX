//@version=5
strategy(title="EMA3/8 + RSI50 - XAUUSD 30m", overlay=true, initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         commission_type=strategy.commission.percent, commission_value=0.04,
         process_orders_on_close=true)

//--- inputs
// EMA parameters
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)  // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)  // sweep: 5-21 step 2

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)          // sweep: 7-21 step 2
rsiThreshold = input.int(50, "RSI Threshold (long above)", minval=20, maxval=80) // sweep: 40-60 step 5

// TP/SL parameters (in points)
tpPoints = input.int(67, "Take Profit (points)", minval=10, maxval=500)   // sweep: 30-200 step 20
slPoints = input.int(100, "Stop Loss (points)", minval=10, maxval=500)   // sweep: 50-200 step 20

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)

//--- entry logic
// Long condition: EMA fast crosses above EMA slow AND RSI > threshold
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThreshold

// Exit logic: flat when EMA fast crosses below EMA slow
longExit = ta.crossunder(emaFast, emaSlow)

//--- strategy execution
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=slPoints * syminfo.mintick, profit=tpPoints * syminfo.mintick)

// Close remaining position if EMA crosses down
if strategy.position_size > 0 and longExit
    strategy.close("Long")
