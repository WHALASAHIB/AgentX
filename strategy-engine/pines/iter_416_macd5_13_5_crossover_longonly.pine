//@version=5
strategy(title="MACD(5,13,5) Crossover Long-Only XAUUSD 1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(5, "MACD Fast Length", minval=2, maxval=20, group="MACD")       // sweep: 3-12 step 2
slowLength = input.int(13, "MACD Slow Length", minval=5, maxval=30, group="MACD")      // sweep: 10-26 step 2
signalLength = input.int(5, "MACD Signal Smoothing", minval=2, maxval=12, group="MACD") // sweep: 3-9 step 2

// TP/SL parameters
tpPoints = input.int(150, "Take Profit (points)", minval=50, maxval=500, group="TP/SL")     // sweep: 50-300 step 25
slPoints = input.int(100, "Stop Loss (points)", minval=30, maxval=300, group="TP/SL")       // sweep: 30-200 step 25

//--- MACD calculation
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)

//--- entry logic
// Long entry: MACD line crosses above signal line
longCondition = ta.crossover(macdLine, signalLine)

if (longCondition)
    strategy.entry("Long", strategy.long)

//--- exit management
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=slPoints * syminfo.mintick, profit=tpPoints * syminfo.mintick)
