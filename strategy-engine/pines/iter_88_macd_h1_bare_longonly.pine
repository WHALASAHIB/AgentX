//@version=5
strategy(title="MACD H1 Bare LONG-only (iter 88)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLen = input.int(8, "MACD Fast Length", minval=2, maxval=50)       // sweep: 5-12 step 1
slowLen = input.int(17, "MACD Slow Length", minval=5, maxval=100)      // sweep: 13-26 step 1
sigLen  = input.int(7, "MACD Signal Length", minval=2, maxval=30)      // sweep: 5-9 step 1

// ATR-based TP/SL
atrPeriod = input.int(14, "ATR Period", minval=7, maxval=30)           // sweep: 7-21 step 2
slMulti  = input.float(1.5, "SL Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
tpMulti  = input.float(3.0, "TP Multiplier (×ATR)", minval=1.0, maxval=10.0, step=0.5) // sweep: 2.0-5.0 step 0.5 (2:1 ratio)

//--- MACD calculation
[macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, sigLen)

//--- ATR for dynamic stops
atrVal = ta.atr(atrPeriod)

//--- entry logic
longCondition = ta.crossover(macdLine, signalLine)

//--- entry
if (longCondition)
    strategy.entry("Long", strategy.long)

//--- exit management: ATR-based TP/SL for all open long positions
// Only manage exits when in a position
if (strategy.position_size > 0)
    // Calculate stop loss and take profit distances in ticks
    stopTicks = int(atrVal * slMulti / syminfo.mintick)
    profitTicks = int(atrVal * tpMulti / syminfo.mintick)
    
    // Exit all existing entries with one exit order
    strategy.exit("XL", "Long", loss=stopTicks, profit=profitTicks)
