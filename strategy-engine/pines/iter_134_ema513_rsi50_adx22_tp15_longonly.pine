//@version=5
// Strategy: EMA(5,13) Crossover + RSI(14)>50 + ADX(14)>22 + TP/SL 1.5:1 LONG ONLY XAUUSD 30m
// Iteration 134 — Reverting TP/SL from 1:1 to 1.5:1 while keeping ADX>22
// Iter 133 with ADX>22 and TP/SL 1:1: PF 1.27, Sharpe -0.57, 55% WR, 20 trades
// Iter 128 with ADX>14 and TP/SL 1.5:1: PF 1.47, Sharpe 0.71, 52% WR, 25 trades
// Combining ADX>22 (higher trend quality) with TP/SL 1.5:1 (better R:R) should push PF above 1.5

strategy(title="EMA513 RSI50 ADX22 TP15 LONG XAUUSD 30m", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA inputs
ema_fast_len = input.int(5, "EMA Fast Length", minval=2, maxval=50)      // sweep: 2-20 step 2
ema_slow_len = input.int(13, "EMA Slow Length", minval=5, maxval=100)     // sweep: 10-30 step 3

// RSI inputs
rsi_len = input.int(14, "RSI Length", minval=7, maxval=28)               // sweep: 7-21 step 3
rsi_threshold = input.int(50, "RSI Minimum (Long)", minval=30, maxval=70)// sweep: 40-60 step 5

// ADX inputs
adx_len = input.int(14, "ADX Length", minval=7, maxval=28)               // sweep: 7-21 step 3
adx_threshold = input.int(22, "ADX Minimum Threshold", minval=5, maxval=40)// sweep: 15-30 step 2

// TP/SL inputs
tp_sl_ratio = input.float(1.5, "TP:SL Ratio (1 = 1:1)", minval=0.5, maxval=5.0, step=0.1) // sweep: 1.0-3.0 step 0.5
sl_atr_mult = input.float(1.5, "SL Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.1) // sweep: 1.0-3.0 step 0.5
atr_len = input.int(14, "ATR Length", minval=7, maxval=28)               // sweep: 7-21 step 3

//--- indicators
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

rsi_val = ta.rsi(close, rsi_len)

// Correct v5 call: ta.dmi(diLength, adxSmoothing)
[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)

atr_val = ta.atr(atr_len)

//--- entry logic
long_condition = false

// LONG: EMA fast crosses above EMA slow, RSI > 50, ADX > threshold (22)
if ta.crossover(ema_fast, ema_slow)
    if rsi_val > rsi_threshold
        if adx_val > adx_threshold
            long_condition := true

//--- entry management
if long_condition
    strategy.entry("Long", strategy.long)

//--- exit management
// Calculate SL and TP distances based on ATR
sl_distance = sl_atr_mult * atr_val
tp_distance = sl_distance * tp_sl_ratio

// Convert to ticks
sl_ticks = int(sl_distance / syminfo.mintick)
tp_ticks = int(tp_distance / syminfo.mintick)

// Place exit orders on each bar where a long position is open
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)

//--- plot EMAs for visual reference
plot(ema_fast, "EMA Fast", color=color.blue, linewidth=1)
plot(ema_slow, "EMA Slow", color=color.red, linewidth=1)
