//@version=6
strategy(title="BB %B Mean Reversion XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands
bb_length = input.int(20, "BB Length", minval=5, maxval=50, step=1)        // sweep: 10-30 step 2
bb_mult   = input.float(2.0, "BB StdDev Multiplier", minval=1.0, maxval=4.0, step=0.1)  // sweep: 1.5-3.0 step 0.2

// %B entry thresholds
oversold  = input.float(0.2, "%B Oversold (long entry)", minval=0.0, maxval=0.5, step=0.05)   // sweep: 0.0-0.4 step 0.05
overbought = input.float(0.8, "%B Overbought (short entry)", minval=0.5, maxval=1.0, step=0.05) // sweep: 0.6-1.0 step 0.05

// RSI filter
rsi_length = input.int(14, "RSI Length", minval=7, maxval=21, step=1)  // sweep: 7-21 step 2
rsi_ob     = input.int(70, "RSI Overbought (short)", minval=60, maxval=90, step=5)   // sweep: 60-85 step 5
rsi_os     = input.int(30, "RSI Oversold (long)", minval=10, maxval=40, step=5)     // sweep: 10-40 step 5

//--- calculations
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
bb_pct = (close - bb_lower) / (bb_upper - bb_lower)  // %B
rsi_val = ta.rsi(close, rsi_length)

//--- entry logic
// Long: %B < oversold (undervalued) AND RSI < oversold threshold
long_condition = bb_pct < oversold and rsi_val < rsi_os

// Short: %B > overbought (overvalued) AND RSI > overbought threshold
short_condition = bb_pct > overbought and rsi_val > rsi_ob

// Entry only when flat
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

//--- exit management
// Fixed percentage-based SL/TP: 1% SL, 2% TP
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=close * 0.01 / syminfo.mintick, profit=close * 0.02 / syminfo.mintick)

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=close * 0.01 / syminfo.mintick, profit=close * 0.02 / syminfo.mintick)
