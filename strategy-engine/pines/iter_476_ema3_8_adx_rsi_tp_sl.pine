//@version=6
strategy(title="BTCUSDT 30m — EMA3/8 + ADX>25 + RSI>50 + Fixed TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen  = input.int(3,    "EMA Fast Length",  minval=1,  maxval=50,  step=1)    // sweep: 2-10 step 1
emaSlowLen  = input.int(8,    "EMA Slow Length",  minval=5,  maxval=50,  step=1)    // sweep: 5-20 step 1
dmiLen      = input.int(14,   "DMI Length",       minval=5,  maxval=30,  step=1)    // sweep: 10-20 step 2
adxThresh   = input.int(25,   "ADX Threshold",    minval=10, maxval=40,  step=5)    // sweep: 20-30 step 5
rsiLen      = input.int(14,   "RSI Length",       minval=5,  maxval=30,  step=1)    // sweep: 10-20 step 2
rsiThresh   = input.int(50,   "RSI Threshold",    minval=30, maxval=70,  step=5)    // sweep: 40-60 step 5
atrLen      = input.int(14,   "ATR Length",       minval=5,  maxval=30,  step=1)    // sweep: 10-20 step 2
tpMulti     = input.float(1.5, "TP Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-3.0 step 0.5
slMulti     = input.float(1.0, "SL Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-2.0 step 0.5

//--- indicator calculation
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
[diPlus, diMinus, adxVal] = ta.dmi(high, low, close, dmiLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)

//--- entry logic: EMA3 crosses above EMA8, ADX>25, RSI>50
longCondition = ta.crossover(emaFast, emaSlow) and adxVal > adxThresh and rsiVal > rsiThresh

if (longCondition)
    strategy.entry("Long", strategy.long)

//--- exit management: fixed TP/SL based on ATR
if (strategy.position_size > 0)
    longTP = strategy.position_avg_price + (tpMulti * atrVal)
    longSL = strategy.position_avg_price - (slMulti * atrVal)
    strategy.exit("Long Exit", "Long", limit=longTP, stop=longSL)
