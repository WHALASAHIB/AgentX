//@version=5
strategy(title="BB Mean Reversion XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands parameters
bb_length = input.int(20, "BB Length", minval=5, maxval=50)       // sweep: 10-30 step 5
bb_mult   = input.float(2.0, "BB Std Dev", minval=1.0, maxval=4.0) // sweep: 1.5-3.0 step 0.5

// ATR-based SL/TP
atr_length = input.int(14, "ATR Length", minval=7, maxval=30)       // sweep: 7-21 step 7
sl_atr     = input.float(1.0, "SL (ATR multiples)", minval=0.5, maxval=3.0)  // sweep: 0.5-2.0 step 0.5
tp_atr     = input.float(2.0, "TP (ATR multiples)", minval=0.5, maxval=5.0)  // sweep: 1.0-3.0 step 0.5

// Trade direction toggle
long_only  = input.bool(true, "Long Only", group="Direction")

//--- Bollinger Bands
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)

//--- ATR for SL/TP distance
atr_val = ta.atr(atr_length)

//--- Entry signals
// LONG: close crosses below lower band (oversold bounce potential)
long_entry_signal = ta.crossunder(close, bb_lower)

// SHORT: close crosses above upper band (overbought rejection potential)
short_entry_signal = ta.crossover(close, bb_upper)

//--- Position management
var bool in_long  = false
var bool in_short = false

//--- Entry logic
// LONG entry
if long_entry_signal and (long_only or not long_only)
    strategy.entry("BB_Long", strategy.long)
    in_long := true
    in_short := false

// SHORT entry
if short_entry_signal and not long_only
    strategy.entry("BB_Short", strategy.short)
    in_short := true
    in_long := false

//--- Exit management
// Exit LONG when price touches middle band (SMA)
if strategy.position_size > 0
    strategy.exit("BB_Long_Exit", "BB_Long", 
     loss=int(sl_atr * atr_val / syminfo.mintick), 
     profit=int(tp_atr * atr_val / syminfo.mintick))
    // Also exit if close crosses back above middle band (mean reversion target hit)
    if ta.crossover(close, bb_mid)
        strategy.close("BB_Long")

// Exit SHORT when price touches middle band (SMA)
if strategy.position_size < 0
    strategy.exit("BB_Short_Exit", "BB_Short",
     loss=int(sl_atr * atr_val / syminfo.mintick),
     profit=int(tp_atr * atr_val / syminfo.mintick))
    // Also exit if close crosses back below middle band (mean reversion target hit)
    if ta.crossunder(close, bb_mid)
        strategy.close("BB_Short")

//--- Visuals
plot(bb_mid, "BB Mid", color=color.blue)
plot(bb_upper, "BB Upper", color=color.gray)
plot(bb_lower, "BB Lower", color=color.gray)
fill(plot(bb_upper), plot(bb_lower), color=color.new(color.gray, 95))
