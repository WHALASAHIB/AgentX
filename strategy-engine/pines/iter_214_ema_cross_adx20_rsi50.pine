//@version=5
strategy(title="EMA(5,13) Cross + ADX(14)>20 + RSI(14)>50 — XAUUSD 30m", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- inputs
fast_len = input.int(5, "Fast EMA", minval=1, maxval=50)           // sweep: 3-15 step 1
slow_len = input.int(13, "Slow EMA", minval=1, maxval=100)          // sweep: 8-30 step 2
adx_len = input.int(14, "ADX Length", minval=1, maxval=50)          // sweep: 10-20 step 2
adx_threshold = input.int(20, "ADX Threshold", minval=1, maxval=50) // sweep: 14-25 step 2
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)          // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold (long >)", minval=30, maxval=70)  // sweep: 40-60 step 5
tp_ratio = input.float(2.0, "TP Ratio (ATR multiples)", minval=0.5, maxval=5.0)   // sweep: 1.0-3.0 step 0.5
sl_ratio = input.float(1.0, "SL Ratio (ATR multiples)", minval=0.5, maxval=5.0)   // sweep: 0.5-2.0 step 0.5
atr_period = input.int(14, "ATR Period", minval=5, maxval=50)      // sweep: 5-20 step 3
min_bars_hold = input.int(4, "Min Bars to Hold", minval=1, maxval=20)  // sweep: 1-10 step 1

//--- indicator calculations
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
[di_plus, di_minus, adx] = ta.dmi(adx_len, adx_len)
rsi_val = ta.rsi(close, rsi_len)
atr = ta.atr(atr_period)

//--- crossover / crossunder detection
cross_up = ta.crossover(fast_ema, slow_ema)
cross_down = ta.crossunder(fast_ema, slow_ema)

//--- entry state tracking
var int bars_since_entry = 0
var bool in_position = false

if (strategy.position_size > 0)
    in_position := true
    bars_since_entry := bars_since_entry + 1
else
    in_position := false
    bars_since_entry := 0

//--- Long entry: EMA crossover + ADX trending (>=20) + RSI > 50 (bullish momentum)
//    ADX threshold refined from 22 (iter 213: 47.1% WR, 17 trades) to 20 — midpoint
//    between ADX>18 (24 trades, 37.5% WR) and ADX>22 (17 trades, 47.1% WR).
//    Goal: ~21-22 trades with WR ~42-44%, crossing both 20-trade min and 40% WR targets.
long_entry = cross_up and adx >= adx_threshold and rsi_val > rsi_threshold

if (long_entry and strategy.position_size == 0)
    stop_loss = sl_ratio * atr
    take_profit = tp_ratio * atr
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=stop_loss / syminfo.mintick, profit=take_profit / syminfo.mintick)

//--- Exit on EMA crossunder (after min bars held)
//    Prevents trades from running indefinitely, keeping strategy responsive.
if (cross_down and strategy.position_size > 0 and bars_since_entry >= min_bars_hold)
    strategy.close("Long")
