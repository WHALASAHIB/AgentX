//@version=6
strategy(title="BB Breakout BTCUSDT 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands parameters
bb_length = input.int(20, "BB Length", minval=5, maxval=50)        // sweep: 10-30 step 5
bb_mult = input.float(2.0, "BB StdDev Mult", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5

// TP/SL in ticks (BTCUSDT uses tick-based profit/loss)
tp_ticks = input.int(200, "Take Profit (ticks)", minval=10, maxval=1000)   // sweep: 100-500 step 50
sl_ticks = input.int(100, "Stop Loss (ticks)", minval=10, maxval=500)     // sweep: 50-300 step 25

// Trade direction
trade_long = input.bool(true, "Enable Long Trades")
trade_short = input.bool(true, "Enable Short Trades")

//--- Bollinger Bands calculation
[sma_bb, upper_bb, lower_bb] = ta.bb(close, bb_length, bb_mult)

//--- entry logic
// Long signal: close crosses above upper band (breakout to upside)
long_signal = close > upper_bb and close[1] <= upper_bb[1]
// Short signal: close crosses below lower band (breakout to downside)
short_signal = close < lower_bb and close[1] >= lower_bb[1]

//--- entry conditions
if (long_signal and trade_long)
    strategy.entry("BBL", strategy.long)

if (short_signal and trade_short)
    strategy.entry("BBS", strategy.short)

//--- exit management
// Fixed TP/SL exits based on ticks
if (strategy.position_size > 0)
    strategy.exit("BBL_X", "BBL", profit=tp_ticks, loss=sl_ticks)

if (strategy.position_size < 0)
    strategy.exit("BBS_X", "BBS", profit=tp_ticks, loss=sl_ticks)
