//@version=5
strategy(title="BB Squeeze RSI50 SMA5 SMA50 LONG ONLY XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands parameters
bb_length = input.int(20, "BB Length", minval=5, maxval=100, step=1)        // sweep: 10-30 step 2
bb_mult = input.float(2.0, "BB StdDev Multiplier", minval=1.0, maxval=4.0, step=0.25)  // sweep: 1.5-3.0 step 0.25

// SMA parameters
sma5_len = input.int(5, "SMA Momentum Length", minval=2, maxval=20, step=1)  // sweep: 3-10 step 1
sma50_len = input.int(50, "SMA Trend Length", minval=20, maxval=200, step=5) // sweep: 30-100 step 10

// RSI filter
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30, step=1)           // sweep: 7-21 step 3
rsi_threshold = input.int(50, "RSI Entry Threshold (> this)", minval=30, maxval=70, step=5)  // sweep: 40-60 step 5

// TP/SL
tp_sl_ratio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.25)  // sweep: 1.0-3.0 step 0.5
atr_mult_sl = input.int(1, "ATR Multiplier for SL", minval=1, maxval=5, step=1)   // sweep: 1-3 step 1

//--- calculations
[bb_middle, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
sma5 = ta.sma(close, sma5_len)
sma50 = ta.sma(close, sma50_len)
rsi = ta.rsi(close, rsi_len)
atr = ta.atr(14)

// BB squeeze: close within upper and lower bands (no breakout yet)
bb_squeeze = close > bb_lower and close < bb_upper
// Momentum: close > 5-bar SMA
momentum_up = close > sma5
// Trend: close > 50-bar SMA (uptrend)
trend_up = close > sma50
// RSI bounce: RSI above threshold (not oversold, trending)
rsi_bounce = rsi > rsi_threshold

//--- entry logic
long_condition = bb_squeeze and momentum_up and trend_up and rsi_bounce

if long_condition
    strategy.entry("BB_LONG", strategy.long)

//--- exit management
if strategy.position_size > 0
    sl_dist = atr * atr_mult_sl
    tp_dist = sl_dist * tp_sl_ratio
    sl_ticks = math.round(sl_dist / syminfo.mintick)
    tp_ticks = math.round(tp_dist / syminfo.mintick)
    strategy.exit("BB_EXIT", "BB_LONG", loss=sl_ticks, profit=tp_ticks)
