//@version=6
strategy(title="BB MeanRev XAU30 RSI ATR Exits", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bbLength = input.int(20, "BB Length")        // sweep: 10-30 step 5
bbMult = input.float(2.0, "BB Mult")         // sweep: 1.5-2.5 step 0.5
rsiLen = input.int(14, "RSI Length")         // sweep: 7-21 step 7
rsiBuyThresh = input.int(50, "RSI Buy <")   // sweep: 40-60 step 10
rsiSellThresh = input.int(50, "RSI Sell >") // sweep: 40-60 step 10
atrLen = input.int(14, "ATR Length")         // sweep: 7-21 step 7
tpAtrMult = input.float(0.8, "TP xATR")      // sweep: 0.3-1.5 step 0.1
slAtrMult = input.float(1.5, "SL xATR")      // sweep: 1.0-2.5 step 0.5
coolBars = input.int(3, "Cooldown")          // sweep: 1-5 step 1

//--- indicators
[bbMid, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- state
var bool inPos = false
var float entryPx = na
var bool exitSet = false
var int barsSinceExit = 999

if not inPos
    barsSinceExit := barsSinceExit + 1

//--- entries
bool buySignal = close <= bbLower and rsiVal < rsiBuyThresh and not inPos and barsSinceExit >= coolBars
bool sellSignal = close >= bbUpper and rsiVal > (100 - rsiSellThresh) and not inPos and barsSinceExit >= coolBars

if buySignal
    strategy.entry("Long", strategy.long)
    inPos := true
    barsSinceExit := 0

if sellSignal
    strategy.entry("Short", strategy.short)
    inPos := true
    barsSinceExit := 0

//--- track entry
if strategy.position_size > 0 and na(entryPx)
    entryPx := close
    exitSet := false

if strategy.position_size < 0 and na(entryPx)
    entryPx := close
    exitSet := false

//--- ATR-based exits
if strategy.position_size > 0 and not exitSet
    strategy.exit("LX", "Long", limit=entryPx + atrVal * tpAtrMult, stop=entryPx - atrVal * slAtrMult)
    exitSet := true

if strategy.position_size < 0 and not exitSet
    strategy.exit("SX", "Short", limit=entryPx - atrVal * tpAtrMult, stop=entryPx + atrVal * slAtrMult)
    exitSet := true

//--- reset
if strategy.position_size == 0
    inPos := false
    entryPx := na
    exitSet := false
