//@version=5
strategy(title="MACD Crossover XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//====================================================================
//--- inputs
//====================================================================

// MACD parameters
macdFastLen  = input.int(12,  "MACD Fast Length",  minval=2, maxval=50, tooltip="Fast EMA length for MACD")        // sweep: 8-20 step 2
macdSlowLen  = input.int(26,  "MACD Slow Length",  minval=5, maxval=100, tooltip="Slow EMA length for MACD")      // sweep: 18-34 step 2
macdSignalLen = input.int(9,  "MACD Signal Length", minval=2, maxval=30, tooltip="Signal line smoothing")          // sweep: 5-15 step 2

// TP/SL parameters
tpSlRatio    = input.float(1.5, "TP:SL Ratio",      minval=0.5, maxval=5.0, step=0.1, tooltip="Take-profit to stop-loss ratio")   // sweep: 1.0-3.0 step 0.25
atrLen       = input.int(14,   "ATR Length for SL",  minval=5, maxval=50, tooltip="ATR period for dynamic stops")                 // sweep: 10-20 step 2
atrMult      = input.float(1.5, "ATR Multiplier",    minval=0.5, maxval=5.0, step=0.1, tooltip="ATR multiplier for stop distance") // sweep: 1.0-3.0 step 0.25

// Session filter
sessStart    = input.int(8,   "Session Start (UTC)", minval=0, maxval=23, tooltip="Trading session start hour UTC")             // sweep: 6-10 step 1
sessEnd      = input.int(16,  "Session End (UTC)",   minval=0, maxval=23, tooltip="Trading session end hour UTC")               // sweep: 14-20 step 1

// Display
showSignals  = input.bool(true, "Show Signal Labels", tooltip="Display buy/sell labels on chart")

//====================================================================
//--- calculations
//====================================================================

// MACD
[macdLine, signalLine, _hist] = ta.macd(close, macdFastLen, macdSlowLen, macdSignalLen)

// ATR for dynamic stop placement
atrVal = ta.atr(atrLen)

// Session filter: trade only during specified UTC hours
inSession = (hour >= sessStart) and (hour < sessEnd)

// MACD crossover conditions
macdCrossOver  = ta.crossover(macdLine, signalLine)
macdCrossUnder = ta.crossunder(macdLine, signalLine)

//====================================================================
//--- entry logic
//====================================================================

// Long entry: MACD line crosses above signal line during session
longCondition = macdCrossOver and inSession

// Short entry: MACD line crosses below signal line during session
shortCondition = macdCrossUnder and inSession

// Entries
if longCondition
    strategy.entry("Long", strategy.long)
    if showSignals
        label.new(bar_index, low, "BUY MACD", style=label.style_label_up, color=color.green, size=size.small, textcolor=color.white)

if shortCondition
    strategy.entry("Short", strategy.short)
    if showSignals
        label.new(bar_index, high, "SELL MACD", style=label.style_label_down, color=color.red, size=size.small, textcolor=color.white)

//====================================================================
//--- exit management
//====================================================================

// Dynamic stop-loss and take-profit distances based on ATR
stopDist   = atrVal * atrMult
profitDist = stopDist * tpSlRatio

// Convert to ticks
stopTicks   = int(stopDist / syminfo.mintick)
profitTicks = int(profitDist / syminfo.mintick)

// Exit orders — placed on every bar after entry to maintain stops
if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", loss=stopTicks, profit=profitTicks)

if strategy.position_size < 0
    strategy.exit("Short Exit", "Short", loss=stopTicks, profit=profitTicks)

//====================================================================
//--- end
//====================================================================
