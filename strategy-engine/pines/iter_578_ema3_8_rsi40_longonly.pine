//@version=6
strategy(title="EMA3/8 + RSI40 Long-Only XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 2-10 step 1
ema_slow = input.int(8, "Slow EMA", minval=2, maxval=100)       // sweep: 5-20 step 1
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)      // sweep: 7-21 step 1
rsi_threshold = input.int(40, "RSI Threshold (entry > X)", minval=20, maxval=70)  // sweep: 30-55 step 5
tp_ratio = input.float(1.5, "TP Ratio (profit = SL * X)", minval=0.5, maxval=5.0) // sweep: 1.0-3.0 step 0.5
sl_atr = input.int(14, "ATR Length for SL", minval=5, maxval=50)// sweep: 7-21 step 1
sl_mult = input.float(1.0, "ATR Multiplier for SL", minval=0.5, maxval=5.0) // sweep: 0.5-3.0 step 0.5

//--- indicators
ema_f = ta.ema(close, ema_fast)
ema_s = ta.ema(close, ema_slow)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(sl_atr)

//--- entry logic: EMA fast crosses above slow AND RSI > threshold
long_condition = ta.crossover(ema_f, ema_s) and rsi_val > rsi_threshold

//--- exit management: fixed ATR-based TP/SL
sl_price = close - (atr_val * sl_mult)
tp_price = close + (atr_val * sl_mult * tp_ratio)

//--- calculate SL/TP in ticks
sl_ticks = (close - sl_price) / syminfo.mintick
tp_ticks = (tp_price - close) / syminfo.mintick

//--- skip if invalid tick values
if sl_ticks > 0 and tp_ticks > 0
    strategy.entry("Long", strategy.long, when=long_condition)
    strategy.exit("XL", "Long", loss=math.floor(sl_ticks), profit=math.floor(tp_ticks))

//--- plot indicators for visual reference
plot(ema_f, "Fast EMA", color.blue, 1)
plot(ema_s, "Slow EMA", color.red, 1)
hline(rsi_threshold, "RSI Threshold", color.green, hline.style_dashed)
