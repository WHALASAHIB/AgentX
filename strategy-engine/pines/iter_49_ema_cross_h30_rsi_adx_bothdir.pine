//@version=5
strategy(title="EMA Cross H30 RSI Both Directions", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(5, "EMA Fast Length", minval=2, maxval=50)  // sweep: 3-10 step 1
emaSlowLen = input.int(13, "EMA Slow Length", minval=5, maxval=100) // sweep: 8-26 step 2
adxLen = input.int(14, "ADX Length", minval=7, maxval=30)           // sweep: 10-21 step 2
adxThresh = input.int(25, "ADX Threshold", minval=15, maxval=40)   // sweep: 20-30 step 2
rsiLen = input.int(14, "RSI Length", minval=7, maxval=21)           // sweep: 10-21 step 2
rsiLongThresh = input.int(50, "RSI Long Above", minval=30, maxval=70) // sweep: 40-60 step 5
rsiShortThresh = input.int(50, "RSI Short Below", minval=30, maxval=70) // sweep: 40-60 step 5
atrMultSL = input.float(1.0, "ATR Multiplier SL", minval=0.5, maxval=3.0, step=0.25) // sweep: 0.75-2.0 step 0.25
riskReward = input.float(2.0, "Risk/Reward Ratio", minval=1.0, maxval=4.0, step=0.5) // sweep: 1.5-3.0 step 0.5

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(14)

//--- Manual ADX calculation (ta.adx may not be available in all Pine engines)
// +DM and -DM
upMove = high - high[1]
downMove = low[1] - low
plusDM = upMove > downMove and upMove > 0 ? upMove : 0
minusDM = downMove > upMove and downMove > 0 ? downMove : 0
// ATR for smoothing (already have atr)
trueRange = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
atrCustom = ta.sma(trueRange, adxLen)
// Smoothed +DI and -DI
plusDI = 100 * ta.sma(plusDM, adxLen) / atrCustom
minusDI = 100 * ta.sma(minusDM, adxLen) / atrCustom
// DX and ADX
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.sma(dx, adxLen)

//--- entry logic
// Long: EMA fast crosses above EMA slow + trending (ADX > threshold) + momentum (RSI > threshold)
longCondition = ta.crossover(emaFast, emaSlow) and adx > adxThresh and rsi > rsiLongThresh

// Short: EMA fast crosses below EMA slow + trending (ADX > threshold) + momentum (RSI < threshold)
shortCondition = ta.crossunder(emaFast, emaSlow) and adx > adxThresh and rsi < rsiShortThresh

//--- entry execution
if (longCondition and strategy.position_size <= 0)
    strategy.entry("Long", strategy.long)

if (shortCondition and strategy.position_size >= 0)
    strategy.entry("Short", strategy.short)

//--- exit management (ATR-based fixed TP/SL via strategy.exit)
slPips = int(atr * atrMultSL / syminfo.mintick)
tpPips = int(slPips * riskReward)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=slPips, profit=tpPips)

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", loss=slPips, profit=tpPips)

//--- visual
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)
hline(rsiLongThresh, "RSI Long Thresh", color=color.green, linestyle=hline.style_dashed)
hline(rsiShortThresh, "RSI Short Thresh", color=color.red, linestyle=hline.style_dashed)
