//@version=6
strategy(title="BB Mean Reversion w/ ATR Stop (BTC 1h)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bbLength = input.int(20, "BB Length", minval=5, maxval=50, step=1)          // sweep: 10-30 step 5
bbStdDev = input.float(2.0, "BB StdDev", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5
rsiLength = input.int(14, "RSI Length", minval=5, maxval=21, step=1)        // sweep: 10-21 step 2
rsiThreshold = input.int(35, "RSI Oversold Threshold", minval=20, maxval=45, step=5)  // sweep: 25-45 step 5
atrLength = input.int(14, "ATR Length", minval=5, maxval=30, step=1)        // sweep: 10-21 step 2
atrMultiplier = input.float(1.5, "ATR Stop Multiplier", minval=1.0, maxval=3.0, step=0.5)  // sweep: 1.0-2.5 step 0.5

//--- indicators
[bbMiddle, bbUpper, bbLower] = ta.bb(close, bbLength, bbStdDev)
rsi = ta.rsi(close, rsiLength)
atrVal = ta.atr(atrLength)

//--- entry logic: long when close below lower band AND RSI oversold
longCondition = close < bbLower and rsi < rsiThreshold

if (longCondition)
    strategy.entry("BB Long", strategy.long)

//--- exit management: take profit at middle band, hard stop at ATR multiplier below entry
if (strategy.position_size > 0)
    // Take profit at middle Bollinger Band
    strategy.exit("BB Exit", "BB Long", limit=bbMiddle, stop=strategy.position_avg_price - atrVal * atrMultiplier)

//--- plot for debugging
plot(bbMiddle, "BB Mid", color=color.blue)
plot(bbUpper, "BB Upper", color=color.gray)
plot(bbLower, "BB Lower", color=color.gray)
