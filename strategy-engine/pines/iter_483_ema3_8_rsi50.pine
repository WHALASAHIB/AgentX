//@version=6
strategy(title="iter_483_ema3_8_rsi50", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50, step=1)       // sweep: 2-5 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50, step=1)        // sweep: 6-13 step 1
rsiLen     = input.int(14, "RSI Length", minval=5, maxval=21, step=1)             // sweep: 10-20 step 2
rsiThresh  = input.int(50, "RSI Threshold (long if above)", minval=20, maxval=80, step=5)  // sweep: 30-60 step 5
tpFactor   = input.float(1.5, "TP Factor (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
slFactor   = input.float(1.0, "SL Factor (×ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 0.5-2.0 step 0.5
atrLen     = input.int(14, "ATR Length", minval=5, maxval=50, step=1)              // sweep: 10-20 step 2

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)

//--- entry logic: EMA3/8 crossover + RSI(14)>50 filter (long only)
longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiThresh

if (longCondition)
    strategy.entry("L", strategy.long)

//--- exit management: fixed TP/SL based on ATR
if (strategy.position_size > 0)
    entryPrice = strategy.position_avg_price
    slPrice = entryPrice - (atr * slFactor)
    tpPrice = entryPrice + (atr * tpFactor)
    strategy.exit("X", "L", limit=tpPrice, stop=slPrice, comment="TP/SL")
