//@version=6
strategy(title="MACD(5,13,3) + RSI(14) Bidirectional", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// MACD parameters
macdFastLen = input.int(5, "MACD Fast Length", minval=1, maxval=50, tooltip="Fast EMA length for MACD")  // sweep: 3-10 step 1
macdSlowLen = input.int(13, "MACD Slow Length", minval=1, maxval=50, tooltip="Slow EMA length for MACD")  // sweep: 8-26 step 2
macdSigLen  = input.int(3, "MACD Signal Length", minval=1, maxval=20, tooltip="Signal line EMA length")    // sweep: 2-9 step 1

// RSI filter
rsiLen      = input.int(14, "RSI Length", minval=2, maxval=50, tooltip="RSI period")                        // sweep: 7-21 step 2
rsiUpper    = input.int(50, "RSI Long Threshold", minval=20, maxval=80, tooltip="RSI must be above this for long")  // sweep: 40-60 step 5
rsiLower    = input.int(50, "RSI Short Threshold", minval=20, maxval=80, tooltip="RSI must be below this for short") // sweep: 40-60 step 5

// TP/SL
tpPercent   = input.float(0.2, "Take Profit %", minval=0.05, maxval=5.0, step=0.05)                        // sweep: 0.1-1.0 step 0.1
slPercent   = input.float(0.3, "Stop Loss %", minval=0.05, maxval=5.0, step=0.05)                          // sweep: 0.15-0.5 step 0.05

//--- indicator calculation

[macdLine, signalLine, _] = ta.macd(close, macdFastLen, macdSlowLen, macdSigLen)
rsiVal = ta.rsi(close, rsiLen)

//--- entry logic

// Long condition: MACD line crosses above signal line AND RSI > threshold
longEntry = ta.crossover(macdLine, signalLine) and rsiVal > rsiUpper

// Short condition: MACD line crosses below signal line AND RSI < threshold
shortEntry = ta.crossunder(macdLine, signalLine) and rsiVal < rsiLower

// Calculate TP/SL in absolute price terms
stopPriceLong  = close * (1 - slPercent / 100)
targetPriceLong = close * (1 + tpPercent / 100)

stopPriceShort  = close * (1 + slPercent / 100)
targetPriceShort = close * (1 - tpPercent / 100)

//--- entry and exit management

if longEntry
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=close - stopPriceLong, profit=targetPriceLong - close, comment="LongExit")

if shortEntry
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", loss=stopPriceShort - close, profit=close - targetPriceShort, comment="ShortExit")

//--- visual signals
plotshape(longEntry, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="L")
plotshape(shortEntry, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="S")
