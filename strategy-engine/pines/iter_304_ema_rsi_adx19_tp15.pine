//@version=5
strategy(title="EMA5/13 + RSI(50) + ADX(19) + 1:1.5 TP/SL", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFast_len  = input.int(5,   "EMA Fast Length",  minval=2, maxval=50, step=1)   // sweep: 3-10 step 1
emaSlow_len  = input.int(13,  "EMA Slow Length",  minval=5, maxval=50, step=1)   // sweep: 8-26 step 2
rsi_len      = input.int(14,  "RSI Period",       minval=7, maxval=21, step=1)   // sweep: 7-21 step 2
rsi_threshold= input.int(50,  "RSI Threshold",    minval=30, maxval=70, step=5)  // sweep: 30-70 step 5
adx_len      = input.int(14,  "ADX Period",       minval=7, maxval=21, step=1)   // sweep: 7-21 step 2
adx_threshold= input.int(19,  "ADX Threshold",    minval=10, maxval=40, step=1)  // sweep: 10-30 step 2  ← single change: 16 → 19
tp_sl_ratio  = input.float(1.5, "TP:SL Ratio",    minval=0.5, maxval=5.0, step=0.25) // sweep: 0.5-3.0 step 0.25
sl_pct       = input.float(0.5, "SL % of Price",  minval=0.1, maxval=2.0, step=0.1)  // sweep: 0.2-1.5 step 0.1
use_trade_hours = input.bool(true, "Restrict to London/NY (8-16 UTC)", group="Filters")

//--- indicator calculations
emaFast  = ta.ema(close, emaFast_len)
emaSlow  = ta.ema(close, emaSlow_len)
rsiVal   = ta.rsi(close, rsi_len)
[diPlus, diMinus, adxVal] = ta.dmi(high, low, close, adx_len)

//--- trade hours (UTC-based)
in_trade_hours = not use_trade_hours or (hour >= 8 and hour < 16)

//--- entry logic
longCondition  = ta.crossover(emaFast, emaSlow) and rsiVal > rsi_threshold and adxVal > adx_threshold and in_trade_hours
shortCondition = ta.crossunder(emaFast, emaSlow) and rsiVal < (100 - rsi_threshold) and adxVal > adx_threshold and in_trade_hours

//--- entry management
if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

//--- exit management
slDist = close * sl_pct / 100 / syminfo.mintick
tpDist = math.round(slDist * tp_sl_ratio)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long",  loss=slDist, profit=tpDist)

if (strategy.position_size < 0)
    strategy.exit("XS", "Short", loss=slDist, profit=tpDist)
