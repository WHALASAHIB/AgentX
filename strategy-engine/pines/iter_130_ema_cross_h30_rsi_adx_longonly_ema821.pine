//@version=5
strategy(title="EMA(8,21) Cross + RSI(14) + ADX(14) Long Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
ema_fast_len = input.int(8, "Fast EMA Length", minval=1, maxval=50)       // sweep: 5-20 step 1
ema_slow_len = input.int(21, "Slow EMA Length", minval=1, maxval=100)      // sweep: 10-50 step 2

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=1, maxval=50)                 // sweep: 7-21 step 1
rsi_threshold = input.int(50, "RSI Long Threshold", minval=1, maxval=100)  // sweep: 40-60 step 5

// ADX parameters
adx_len = input.int(14, "ADX Length", minval=1, maxval=50)                 // sweep: 8-20 step 2
adx_threshold = input.float(14.0, "ADX Min Threshold", minval=1, maxval=50, step=1.0)  // sweep: 8-20 step 2

// TP/SL parameters
sl_atr_mult = input.float(1.5, "SL ATR Multiplier", minval=0.5, maxval=5.0, step=0.5)    // sweep: 1.0-3.0 step 0.5
tp_sl_ratio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.25)         // sweep: 1.0-3.0 step 0.25

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

//--- Manual ADX calculation using EMA smoothing (ta.adx not available on this engine)
// True Range
tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
// Directional Movement
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0.0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0.0
// Smoothed values using EMA (Wilder's smoothing approximated via EMA)
smoothed_tr = ta.ema(tr_val, adx_len)
smoothed_plus_dm = ta.ema(plus_dm, adx_len)
smoothed_minus_dm = ta.ema(minus_dm, adx_len)
// Directional Indicators
plus_di = 100.0 * smoothed_plus_dm / smoothed_tr
minus_di = 100.0 * smoothed_minus_dm / smoothed_tr
// DX and ADX
dx_val = 100.0 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.ema(dx_val, adx_len)

atr_val = ta.atr(14)

//--- entry logic
// Bullish crossover: fast EMA crosses above slow EMA
bullish_cross = ta.crossover(ema_fast, ema_slow)

// Conditions for long entry:
// 1. EMA crossover (bullish)
// 2. RSI > threshold (showing momentum)
// 3. ADX > threshold (trending market)
// 4. No existing position
long_condition = bullish_cross and rsi_val > rsi_threshold and adx_val > adx_threshold

// Enter long when all conditions met
if (long_condition)
    strategy.entry("Long", strategy.long)

//--- exit management
sl_distance = atr_val * sl_atr_mult
tp_distance = sl_distance * tp_sl_ratio

sl_ticks = math.floor(sl_distance / syminfo.mintick)
tp_ticks = math.floor(tp_distance / syminfo.mintick)

if (strategy.position_size > 0)
    strategy.exit("Exit Long", "Long", loss=sl_ticks, profit=tp_ticks)

//--- visual indicators
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=1)
