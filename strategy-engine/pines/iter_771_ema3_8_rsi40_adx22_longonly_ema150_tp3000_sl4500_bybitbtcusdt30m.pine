//@version=6
strategy(title="EMA3/8 RSI40 ManualADX22 LongOnly EMA150Filter BarrierExit TP3000 SL4500 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(40, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 771: RSI UNCHANGED at 40 (iter-769/770 peak; RSI30 saturates at iter 770 -- filter NOT binding below 40). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(22, "ADX Threshold", minval=10, maxval=50)   // iter 771: ADX 25->22 (ONLY CHANGE -- iter 770 proved RSI30 is saturated and RSI is NOT the binding entry constraint; trade set identical to RSI40, so ADX>25 and close>EMA150 gate the entries; loosening the BINDING trend filter one step to admit more trades toward the 40-50 target, WR hold >=60%, pushing PF from 1.239 past 1.3 toward 1.5). Risk: iter-691 XAU precedent ADX 25->18 collapsed PF to 0.85 (weak trends admitted) -- the modest 25->22 step plus the long-only EMA150 regime gate mitigates that. sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 771: regime EMA 150 (proven-best long-side from iter 745/747). sweep: 100-200 step 50
take_profit_tick = input.int(3000, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 771: TP UNCHANGED at 3000 (iter-765 peak, ~0.75x ATR). sweep: 2000-4000 step 500
stop_loss_tick = input.int(4500, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 771: SL UNCHANGED at 4500 (iter-765 peak, ~1x ATR). sweep: 3000-6000 step 500

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 771: KEEP the iter-769/770 peak config (EMA3/8 + RSI40 + ADX25 + EMA150 long-only, TP3000/SL4500 manual barriers, NO breakeven) with ONE change: adx_threshold 25->22. iter 770: RSI 40->30 SATURATED -- trade set IDENTICAL to iter 769 (34 trades, 22W/12L, WR 64.7%, PF 1.239, net +$180.36): RSI30 admitted ZERO new entries because every qualifying cross already had RSI>40 at entry; RSI is NOT the binding constraint (ADX>25 and close>EMA150 are). RSI dimension FULLY MAPPED and SATURATED: RSI60 < RSI50 < RSI40 == RSI30 (peak PF 1.24, net +$180.36). Next lever per rulebook (PF 1.24 < 1.5 -> add/filter-loose): loosen the BINDING ADX filter one step 25->22 to admit more crosses toward trade count 40-50, WR hold >=60%, pushing PF past 1.3 toward 1.5. Risk: weak trends admitted collapse WR (iter-691 XAU precedent ADX 25->18 -> PF 0.85); modest 25->22 step + EMA150 regime gate mitigates. One change: adx_threshold 25->22 (iter-769/770 config otherwise intact).)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
