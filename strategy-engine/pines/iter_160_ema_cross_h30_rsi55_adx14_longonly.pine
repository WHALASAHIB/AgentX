//@version=5
strategy(title="EMA5_13_RSI55_ADX14_LONG_ONLY_30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fast_len = input.int(5, "Fast EMA Length", minval=2, maxval=50)      // sweep: 3-15 step 2
slow_len = input.int(13, "Slow EMA Length", minval=5, maxval=100)    // sweep: 8-30 step 3
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)           // sweep: 7-21 step 2
rsi_threshold = input.int(55, "RSI Entry Threshold", minval=30, maxval=80)  // sweep: 50-60 step 5
adx_len = input.int(14, "ADX Length", minval=5, maxval=30)           // sweep: 7-21 step 2
adx_threshold = input.int(14, "ADX Minimum Threshold", minval=5, maxval=50) // sweep: 10-20 step 2
tp_ratio = input.float(1.0, "Take Profit (×ATR)", minval=0.5, maxval=5.0)  // sweep: 0.5-3.0 step 0.5
sl_ratio = input.float(1.0, "Stop Loss (×ATR)", minval=0.5, maxval=5.0)   // sweep: 0.5-3.0 step 0.5
atr_len = input.int(14, "ATR Length", minval=5, maxval=50)            // sweep: 7-21 step 2
use_ema_exit = input.bool(true, "Exit on EMA Crossunder")            // toggle

//--- indicator calculations
ema_fast = ta.ema(close, fast_len)
ema_slow = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)

//--- manual ADX calculation (ta.adx not available in this engine)
// True Range for ATR
tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))

// ATR for TP/SL exit
atr_exit = ta.sma(tr_val, atr_len)

// Directional Movement
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

// Smoothed DM (Wilder smoothing = SMA)
s_plus_dm = ta.sma(plus_dm, adx_len)
s_minus_dm = ta.sma(minus_dm, adx_len)

// ATR for ADX normalization
atr_adx = ta.sma(tr_val, adx_len)

// Directional Indicators
plus_di = 100 * s_plus_dm / atr_adx
minus_di = 100 * s_minus_dm / atr_adx

// DX (prevents division by zero)
di_sum = plus_di + minus_di
dx_val = di_sum > 0 ? 100 * math.abs(plus_di - minus_di) / di_sum : 0

// ADX = smoothed DX
adx_val = ta.sma(dx_val, adx_len)

//--- entry logic: EMA crossover + RSI > threshold + ADX > threshold
bullish_ema_cross = ta.crossover(ema_fast, ema_slow)
bullish_rsi = rsi_val > rsi_threshold
trending_market = adx_val > adx_threshold

long_entry = bullish_ema_cross and bullish_rsi and trending_market

//--- exit logic: EMA crossunder
ema_crossunder_exit = ta.crossunder(ema_fast, ema_slow)

//--- entry
if long_entry
    strategy.entry("Long", strategy.long)

//--- exit management: fixed TP/SL based on ATR
if strategy.position_size > 0
    strategy.exit("TP/SL", "Long", loss=int((atr_exit * sl_ratio) / syminfo.mintick), profit=int((atr_exit * tp_ratio) / syminfo.mintick))

//--- signal-based exit (recycles capital)
if use_ema_exit and strategy.position_size > 0 and ema_crossunder_exit
    strategy.close("Long", comment="ema_crossunder")
