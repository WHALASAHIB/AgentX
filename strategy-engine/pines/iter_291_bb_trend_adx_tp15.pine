//@version=5
strategy(title="BB Trend-Follow ADX TP1.5 Long-Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands parameters
bb_length = input.int(20, "BB Length", minval=5, maxval=100, step=1)      // sweep: 10-40 step 5
bb_mult   = input.float(2.0, "BB StdDev Mult", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-4.0 step 0.5

// ADX parameters (manual DMI calc)
adx_len   = input.int(14, "ADX Length", minval=5, maxval=30, step=1)       // sweep: 7-21 step 2
adx_threshold = input.int(25, "ADX Threshold", minval=10, maxval=50, step=5) // sweep: 15-30 step 5

// TP/SL parameters (CHANGED: tightened from 2:1 to 1:1.5)
atr_len   = input.int(14, "ATR Length", minval=5, maxval=30, step=1)       // sweep: 10-20 step 2
tp_atr_mult = input.float(1.0, "TP (ATR mult)", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-3.0 step 0.5
sl_atr_mult = input.float(1.5, "SL (ATR mult)", minval=0.5, maxval=5.0, step=0.5) // sweep: 0.5-3.0 step 0.5

//--- indicator calculations
// Bollinger Bands
[bb_middle, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)

// Manual ADX via DMI (compatible with Trader Dev's Pine runtime)
up = ta.change(high)
down = -ta.change(low)
plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
atr_sma = ta.sma(tr, adx_len)
plusDI = 100 * ta.sma(plusDM, adx_len) / atr_sma
minusDI = 100 * ta.sma(minusDM, adx_len) / atr_sma
dx = math.abs(plusDI - minusDI) / (plusDI + minusDI) * 100
adx_val = ta.sma(dx, adx_len)

// ATR for TP/SL sizing
atr_val = ta.sma(tr, atr_len)

//--- entry logic
// LONG only: price above BB middle band AND ADX > threshold (trending market)
price_above_middle = close > bb_middle
trending = adx_val > adx_threshold

if (price_above_middle and trending)
    strategy.entry("Long", strategy.long)

//--- exit management
// Calculate TP/SL in ticks based on ATR
if (strategy.position_size > 0)
    long_tp_ticks = int(tp_atr_mult * atr_val / syminfo.mintick)
    long_sl_ticks = int(sl_atr_mult * atr_val / syminfo.mintick)
    strategy.exit("TP/SL", "Long", loss=long_sl_ticks, profit=long_tp_ticks)

//--- visual
plot(bb_middle, "BB Middle", color=color.blue)
plot(bb_upper, "BB Upper", color=color.gray)
plot(bb_lower, "BB Lower", color=color.gray)
hline(adx_threshold, "ADX Threshold", color=color.purple, linestyle=hline.style_dashed)
