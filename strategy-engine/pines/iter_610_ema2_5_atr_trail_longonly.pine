//@version=6
strategy(title="iter_610 EMA2/5 ATR Trail Long Only", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(2, "EMA Fast Length", minval=1, maxval=20, tooltip="Fast EMA period")
emaSlowLen = input.int(5, "EMA Slow Length", minval=3, maxval=50, tooltip="Slow EMA period")
atrPeriod  = input.int(14, "ATR Period", minval=5, maxval=50, tooltip="ATR calculation period")
atrMult    = input.float(2.5, "ATR Multiplier", minval=0.5, maxval=5.0, step=0.5, tooltip="ATR trailing stop multiplier")
useTrail   = input.bool(true, "Use ATR Trailing Stop", tooltip="Enable trailing stop instead of fixed TP/SL")

//--- calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atr     = ta.atr(atrPeriod)

//--- crossover signal
longCondition = ta.crossover(emaFast, emaSlow)

//--- entry logic
if longCondition
    strategy.entry("Long", strategy.long)

//--- exit management
if useTrail
    // ATR-based trailing stop
    stopLevel = close - atr * atrMult
    strategy.exit("XL", "Long", stop=stopLevel)
else
    // Fixed 2:1 TP/SL (based on ATR distance)
    slDist = atr * 1.0
    tpDist = atr * 2.0
    strategy.exit("XL", "Long", loss=syminfo.mintick * math.floor(slDist / syminfo.mintick), profit=syminfo.mintick * math.floor(tpDist / syminfo.mintick))
