//@version=5
strategy(title="BB Squeeze + SMA(5) + SMA(50) + RSI(50) — No ADX — LONG ONLY XAUUSD 30m", 
         overlay=true, 
         initial_capital=10000, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=100, 
         commission_type=strategy.commission.percent, 
         commission_value=0.04, 
         process_orders_on_close=true)

//--- inputs
// Bollinger Bands length
bb_len = input.int(20, "BB Length", minval=5, maxval=50, group="Bollinger Bands")
// sweep: 10-30 step 5

bb_mult = input.float(2.0, "BB StdDev Multiplier", step=0.1, group="Bollinger Bands")
// sweep: 1.5-3.0 step 0.2

// BB squeeze threshold (bandwidth relative to SMA of bandwidth)
squeeze_threshold = input.float(0.15, "BB Squeeze Threshold (fraction)", step=0.05, group="Bollinger Bands")
// sweep: 0.10-0.30 step 0.05

// SMA(5) — momentum filter
sma5_len = input.int(5, "SMA Momentum Length", minval=3, maxval=20, group="SMA Filters")
// sweep: 3-10 step 1

// SMA(50) — trend filter
sma50_len = input.int(50, "SMA Trend Length", minval=20, maxval=100, group="SMA Filters")
// sweep: 20-100 step 10

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=7, maxval=21, group="RSI Filter")
// sweep: 7-21 step 2

rsi_threshold = input.int(50, "RSI Minimum (long)", minval=30, maxval=70, group="RSI Filter")
// sweep: 40-60 step 5

// TP/SL parameters
tp_sl_ratio = input.float(1.5, "TP:SL Ratio", step=0.1, group="TP/SL")
// sweep: 1.0-2.5 step 0.3

sl_atr_mult = input.float(1.5, "SL ATR Multiplier", step=0.1, group="TP/SL")
// sweep: 0.5-3.0 step 0.5

// ATR length for TP/SL
atr_len = input.int(14, "ATR Length", minval=7, maxval=28, group="TP/SL")
// sweep: 7-21 step 3

//--- calculate indicators
bb_basis = ta.sma(close, bb_len)
bb_dev = ta.stdev(close, bb_len) * bb_mult
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
bb_width = (bb_upper - bb_lower) / bb_basis  // bandwidth as fraction of price

// Smooth the bandwidth to detect squeeze relative to recent history
bb_width_sma = ta.sma(bb_width, bb_len)

// BB squeeze: bandwidth is below threshold * average bandwidth
bb_squeeze = bb_width < squeeze_threshold * bb_width_sma

// Close above SMA(5) — momentum
mom_ok = close > ta.sma(close, sma5_len)

// Close above SMA(50) — uptrend
trend_ok = close > ta.sma(close, sma50_len)

// RSI filter
rsi_val = ta.rsi(close, rsi_len)
rsi_ok = rsi_val > rsi_threshold

// Entry condition: BB squeeze breakout (close exits BB range UPWARD) + momentum + trend + RSI
// A squeeze is detected, then we enter when price breaks above the upper BB
long_condition = bb_squeeze and close > bb_upper and mom_ok and trend_ok and rsi_ok

// ATR for stop loss
atr_val = ta.atr(atr_len)
sl_dist = atr_val * sl_atr_mult
tp_dist = sl_dist * tp_sl_ratio

//--- entry logic
if long_condition
    strategy.entry("BBL", strategy.long)
    strategy.exit("BBL_X", "BBL", 
                  loss=int(sl_dist / syminfo.mintick), 
                  profit=int(tp_dist / syminfo.mintick))

//--- visual signals
plot(bb_basis, "BB Mid", color=color.blue)
plot(bb_upper, "BB Upper", color=color.gray)
plot(bb_lower, "BB Lower", color=color.gray)
plot(ta.sma(close, sma5_len), "SMA(5)", color=color.orange, linewidth=2)
plot(ta.sma(close, sma50_len), "SMA(50)", color=color.purple, linewidth=2)

bgcolor(long_condition ? color.new(color.green, 85) : na)
