//@version=5
strategy(title="EMA Cross RSI50 Long Only (iter 54)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fastLen = input.int(5, "Fast EMA Length", minval=1, maxval=50)          // sweep: 3-10 step 1
slowLen = input.int(13, "Slow EMA Length", minval=1, maxval=50)         // sweep: 8-21 step 1

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)              // sweep: 7-21 step 1
rsiThreshold = input.int(50, "RSI Threshold (long minimum)", minval=1, maxval=100) // sweep: 40-60 step 5

// ATR stop
atrLen = input.int(14, "ATR Length", minval=1, maxval=50)              // sweep: 7-21 step 1
atrMult = input.float(1.5, "ATR Multiplier (SL)", minval=0.1, maxval=5.0, step=0.1) // sweep: 1.0-3.0 step 0.2

//--- indicator calculations
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- entry logic
// Crossover condition: fast EMA crosses above slow EMA (golden cross on fast/slow)
longEntry = ta.crossover(emaFast, emaSlow)
// RSI filter: only enter if RSI is above threshold (shows momentum is not bearish)
rsiOk = rsiVal > rsiThreshold
// Combined: enter long when EMA5 crosses above EMA13 AND RSI > 50
enterLong = longEntry and rsiOk

//--- exit logic
// Crossover-based exit: fast EMA crosses below slow EMA
longExit = ta.crossunder(emaFast, emaSlow)

//--- entry management
if (enterLong)
    strategy.entry("Long", strategy.long)

//--- exit management
// Primary exit: crossover exit (EMA5 < EMA13)
// Emergency exit: ATR-based trailing stop-loss
if (strategy.position_size > 0)
    // Crossover-based exit (close position when EMA5 crosses below EMA13)
    if (longExit)
        strategy.close("Long")

// Emergency trailing SL: if price drops below entry_price - atrMult * atr, close
slPrice = strategy.position_avg_price - atrMult * atrVal
strategy.exit("SL", "Long", stop=slPrice, comment="ATR_SL")
