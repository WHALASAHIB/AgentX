//@version=5
strategy(title="EMA3/8 Crossover RSI50 Long Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)      // sweep: 1-10 step 1
ema_slow_len = input.int(8, "Slow EMA Length", minval=1, maxval=100)     // sweep: 5-20 step 1
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)               // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Minimum (Long Only)", minval=20, maxval=80)  // sweep: 45-60 step 5
tp_points = input.int(150, "Take Profit (points)", minval=10, maxval=500)        // sweep: 50-200 step 25
sl_points = input.int(100, "Stop Loss (points)", minval=10, maxval=500)          // sweep: 50-200 step 25

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

//--- entry logic
// Bullish condition: fast EMA crosses above slow EMA AND RSI above threshold (bullish momentum)
bullish_cross = ta.crossover(ema_fast, ema_slow)
long_condition = bullish_cross and rsi_val > rsi_threshold

// No short entries — long-only strategy for XAUUSD
short_condition = false

//--- entry execution
if long_condition
    strategy.entry("Long", strategy.long)

//--- exit management
// Fixed TP/SL using syminfo.mintick for precision
tp_ticks = math.round(tp_points / (syminfo.mintick * 10)) * 10   // round to clean tick multiple
sl_ticks = math.round(sl_points / (syminfo.mintick * 10)) * 10

if strategy.position_size > 0
    strategy.exit("XL", "Long", profit=tp_ticks, loss=sl_ticks)
