//@version=5
strategy(title="EMA3_8_RSI_DMI_Session_XAU30m_Iter378", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFast = input.int(3, "EMA Fast", minval=1, maxval=50)
emaSlow = input.int(8, "EMA Slow", minval=1, maxval=50)
rsiLen = input.int(14, "RSI Length", minval=1, maxval=50)
rsiThreshold = input.int(50, "RSI Threshold (long above)", minval=1, maxval=100)
dmiLen = input.int(14, "DMI/ADX Length", minval=1, maxval=50)
adxThreshold = input.int(14, "ADX Threshold", minval=1, maxval=100)
tpPoints = input.int(67, "Take Profit (points)", minval=1, maxval=500)
slPoints = input.int(67, "Stop Loss (points)", minval=1, maxval=500)
useSessionFilter = input.bool(true, "Use Session Filter")
sessionStart = input.int(6, "Session Start Hour (UTC)", minval=0, maxval=23)
sessionEnd = input.int(18, "Session End Hour (UTC)", minval=0, maxval=23)

//--- indicators
emaFastVal = ta.ema(close, emaFast)
emaSlowVal = ta.ema(close, emaSlow)
rsiVal = ta.rsi(close, rsiLen)
[diPlus, diMinus, adxVal] = ta.dmi(dmiLen, dmiLen)

//--- session filter
currentHour = hour(time)
inSession = not useSessionFilter or (currentHour >= sessionStart and currentHour < sessionEnd)

//--- entry logic
longCondition = inSession and ta.crossover(emaFastVal, emaSlowVal) and rsiVal > rsiThreshold and adxVal > adxThreshold

if (longCondition)
    strategy.entry("Long", strategy.long)

//--- exit management
strategy.exit("Long Exit", "Long", loss=slPoints * syminfo.mintick, profit=tpPoints * syminfo.mintick)
