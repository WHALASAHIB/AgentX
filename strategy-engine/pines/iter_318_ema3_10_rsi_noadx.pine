//@version=5
strategy(title="EMA3_10 RSI50 NoADX XAUUSD 1h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//------------------------------------------------------------------------------
//--- inputs
//------------------------------------------------------------------------------

// EMA parameters
fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50, step=1)  // sweep: 2-10 step 1
slow_len = input.int(10, "Slow EMA Length", minval=1, maxval=100, step=1) // sweep: 8-30 step 2

// RSI filter
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50, step=1)       // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold", minval=1, maxval=100, step=1) // sweep: 40-60 step 5

// Trade management
tp_ratio = input.float(1.5, "Take Profit (x ATR)", minval=0.5, maxval=10.0, step=0.1)  // sweep: 1.0-3.0 step 0.5
sl_ratio = input.float(1.0, "Stop Loss (x ATR)", minval=0.1, maxval=5.0, step=0.1)     // sweep: 0.5-2.0 step 0.5

// Session filter — London/NY overlap
session_start = input.int(8, "Session Start (UTC)", minval=0, maxval=23, step=1)  // sweep: 6-10 step 1
session_end = input.int(20, "Session End (UTC)", minval=0, maxval=23, step=1)     // sweep: 16-22 step 1

// ATR period for SL/TP calculation
atr_len = input.int(14, "ATR Length", minval=5, maxval=50, step=1)  // sweep: 10-20 step 2

//------------------------------------------------------------------------------
//--- calculations
//------------------------------------------------------------------------------

// EMAs
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)

// RSI
rsi_val = ta.rsi(close, rsi_len)

// ATR for dynamic stops
atr_val = ta.atr(atr_len)

// Session filter (UTC time)
current_hour = hour(time)
in_session = current_hour >= session_start and current_hour < session_end

// Crossover / crossunder detection
ema_cross_over = ta.crossover(fast_ema, slow_ema)
ema_cross_under = ta.crossunder(fast_ema, slow_ema)

//------------------------------------------------------------------------------
//--- entry logic
//------------------------------------------------------------------------------

// Long conditions: EMA3 crosses above EMA10, RSI > 50, in session
long_condition = ema_cross_over and rsi_val > rsi_threshold and in_session
// Short conditions: EMA3 crosses below EMA10, RSI < 50, in session
short_condition = ema_cross_under and rsi_val < rsi_threshold and in_session

// Exit all positions on inverse crossover (clean exits, no cascade-close)
// Use strategy.exit with explicit SL/TP instead of strategy.close

if (long_condition)
    // Entry price for SL/TP calculation
    entry_price = close
    sl_price = entry_price - (atr_val * sl_ratio)
    tp_price = entry_price + (atr_val * tp_ratio)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=int(math.round((entry_price - sl_price) / syminfo.mintick)), profit=int(math.round((tp_price - entry_price) / syminfo.mintick)))

if (short_condition)
    entry_price = close
    sl_price = entry_price + (atr_val * sl_ratio)
    tp_price = entry_price - (atr_val * tp_ratio)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=int(math.round((sl_price - entry_price) / syminfo.mintick)), profit=int(math.round((entry_price - tp_price) / syminfo.mintick)))

//------------------------------------------------------------------------------
//--- visual aids
//------------------------------------------------------------------------------

plot(fast_ema, "Fast EMA", color=color.blue, linewidth=1)
plot(slow_ema, "Slow EMA", color=color.red, linewidth=1)
hline(rsi_threshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed)

