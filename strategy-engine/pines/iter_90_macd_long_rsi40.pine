//@version=5
strategy(title="iter_90 — MACD(8,17,7) + RSI(40) LONG-only XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLen   = input.int(8,    "MACD Fast Length",   minval=2, maxval=50)   // sweep: 5-15 step 1
slowLen   = input.int(17,   "MACD Slow Length",   minval=5, maxval=50)   // sweep: 12-26 step 2
sigLen    = input.int(7,    "MACD Signal Length", minval=1, maxval=20)   // sweep: 3-12 step 1

rsiLen    = input.int(14,   "RSI Length",         minval=2, maxval=30)   // sweep: 7-21 step 2
rsiMin    = input.int(40,   "RSI Minimum (LONG)", minval=20, maxval=60)  // sweep: 30-50 step 5

atrPeriod = input.int(14,   "ATR Period",         minval=5, maxval=30)   // sweep: 10-21 step 2
slMulti   = input.float(1.5,"SL ATR Multiplier",  minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
tpMulti   = input.float(3.0,"TP ATR Multiplier",  minval=1.0, maxval=10.0, step=0.5) // sweep: 2.0-5.0 step 0.5

//--- indicator calculations
[macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, sigLen)
rsiVal   = ta.rsi(close, rsiLen)
atrVal   = ta.atr(atrPeriod)

//--- entry logic — LONG only
longCondition = macdLine > signalLine and rsiVal > rsiMin  // MACD bullish crossover + RSI above min

if longCondition and strategy.position_size <= 0
    stopLoss  = close - atrVal * slMulti
    takeProfit = close + atrVal * tpMulti
    strategy.entry("LONG", strategy.long, comment="MACD_RSI_LONG")
    strategy.exit("EXIT_LONG", from_entry="LONG", loss=close - stopLoss, profit=takeProfit - close, comment="TP_SL_LONG")

//--- plot indicators for visual reference
hline(0, "Zero", color.gray)
plot(macdLine, "MACD", color.blue)
plot(signalLine, "Signal", color.orange)
