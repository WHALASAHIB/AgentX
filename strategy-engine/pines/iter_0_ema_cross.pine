//@version=5
strategy(title="EMA Crossover Starter", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fastLen = input.int(12, "Fast EMA", minval=2, maxval=100)  // sweep: 5-20 step 2
slowLen = input.int(26, "Slow EMA", minval=5, maxval=200)  // sweep: 15-40 step 3
slPct = input.float(0.5, "Stop Loss %", minval=0.1, maxval=5.0, step=0.1)  // sweep: 0.3-2.0 step 0.2
tpRatio = input.float(2.0, "TP:SL Ratio", minval=1.0, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5

//--- indicators
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)

//--- entry logic
longCondition = ta.crossover(fastMA, slowMA)
shortCondition = ta.crossunder(fastMA, slowMA)

if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

//--- exit management
strategy.exit("TP/SL", "Long", loss=close * slPct / 100 / syminfo.mintick, profit=close * slPct * tpRatio / 100 / syminfo.mintick)
strategy.exit("TP/SL", "Short", loss=close * slPct / 100 / syminfo.mintick, profit=close * slPct * tpRatio / 100 / syminfo.mintick)
