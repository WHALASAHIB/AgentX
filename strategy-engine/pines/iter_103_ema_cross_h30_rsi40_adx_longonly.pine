//@version=5
strategy(title="EMA Crossover RSI40 ADX Long-Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMAs
ema_fast_len = input.int(5, "Fast EMA Length", minval=1, maxval=50)        // sweep: 3-20 step 2
ema_slow_len = input.int(13, "Slow EMA Length", minval=1, maxval=100)       // sweep: 8-30 step 3

// ADX filter
adx_len = input.int(14, "ADX Length", minval=5, maxval=50)                  // sweep: 10-21 step 2
adx_threshold = input.int(25, "ADX Threshold", minval=10, maxval=50)        // sweep: 20-35 step 5

// RSI filter
rsi_len = input.int(14, "RSI Length", minval=5, maxval=30)                  // sweep: 7-21 step 2
rsi_min = input.int(40, "RSI Minimum for Longs", minval=20, maxval=80)      // sweep: 30-55 step 5

// TP/SL
tp_ratio = input.float(1.0, "Take Profit (TP/SL ratio multiplier)", minval=0.5, maxval=5.0, step=0.1)  // sweep: 0.5-3.0 step 0.25
sl_ratio = input.float(1.5, "Stop Loss (SL as SL/ATR multiplier)", minval=0.5, maxval=5.0, step=0.1)   // sweep: 1.0-2.5 step 0.25

// Session filter
session_start = input.int(8, "Session Start Hour (UTC)", minval=0, maxval=23)    // sweep: 0-16 step 4
session_end = input.int(16, "Session End Hour (UTC)", minval=1, maxval=23)       // sweep: 8-20 step 4

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)

// Manual ADX calculation (Wilder's method) — ta.adx not supported by all engines
up = high - high[1]
down = low[1] - low
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
plus_dm = up > down and up > 0 ? up : 0
minus_dm = down > up and down > 0 ? down : 0
atr_wilder = ta.rma(tr, adx_len)
plus_di = 100 * ta.rma(plus_dm, adx_len) / atr_wilder
minus_di = 100 * ta.rma(minus_dm, adx_len) / atr_wilder
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_value = ta.rma(dx, adx_len)

rsi_value = ta.rsi(close, rsi_len)
atr = ta.atr(14)

//--- entry logic
current_hour = hour(time)
in_session = current_hour >= session_start and current_hour < session_end

// Long entry: EMA crossover + trending session + RSI above minimum
ema_cross_over = ta.crossover(ema_fast, ema_slow)
entry_condition = ema_cross_over and in_session and adx_value > adx_threshold and rsi_value > rsi_min

// Exit condition
ema_cross_under = ta.crossunder(ema_fast, ema_slow)

//--- entry management
if (entry_condition and strategy.position_size == 0)
    sl_distance = atr * sl_ratio
    tp_distance = sl_distance * tp_ratio
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=int(sl_distance / syminfo.mintick), profit=int(tp_distance / syminfo.mintick))

// Stop trading if trend weakens or outside session
if (strategy.position_size > 0 and (adx_value < adx_threshold or not in_session))
    strategy.close("Long")
