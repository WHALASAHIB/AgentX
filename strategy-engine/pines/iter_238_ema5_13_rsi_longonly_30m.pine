//@version=5
strategy(title="EMA5/13 Cross + RSI Long-Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(5, "EMA Fast Length", minval=2, maxval=30)       // sweep: 3-10 step 1
emaSlowLen = input.int(13, "EMA Slow Length", minval=5, maxval=50)      // sweep: 10-30 step 2
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30)               // sweep: 7-21 step 2
rsiThresholdLong = input.int(50, "RSI Threshold (Long)", minval=30, maxval=70)  // sweep: 40-60 step 5
atrLen = input.int(14, "ATR Length", minval=7, maxval=30)               // sweep: 10-21 step 2
atrMult = input.float(1.0, "ATR Multiplier for TP/SL", minval=0.5, maxval=3.0, step=0.5)  // sweep: 0.5-2.0 step 0.5
tpSlRatio = input.float(1.0, "TP:SL Ratio", minval=0.5, maxval=4.0, step=0.5)             // sweep: 1.0-2.0 step 0.5

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

//--- entry logic
// Long on EMA fast crossing ABOVE slow + RSI confirms uptrend
longEntry = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThresholdLong

// Exit when EMA fast crosses BELOW slow (trend reversal) OR on SL/TP hit
longExit = ta.crossunder(emaFast, emaSlow)

//--- entry/exit management
if (longEntry)
    slDist = atrVal * atrMult
    tpDist = slDist * tpSlRatio
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=int(slDist / syminfo.mintick), profit=int(tpDist / syminfo.mintick))

//--- safety: close on EMA crossunder if still in position
if (longExit and strategy.position_size > 0)
    strategy.close("Long", comment="EMA_CROSSUNDER")

//--- plot
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)
hline(rsiThresholdLong, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed)
