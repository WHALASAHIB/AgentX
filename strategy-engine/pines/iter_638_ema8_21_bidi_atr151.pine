//@version=6
strategy(title="EMA8/21 Bidi RSI ADX ATR151", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fastLen = input.int(8, "Fast EMA Length", minval=2, maxval=50, step=1)       // sweep: 5-14 step 1
slowLen = input.int(21, "Slow EMA Length", minval=5, maxval=100, step=1)      // sweep: 14-34 step 2

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=2, maxval=30, step=1)            // sweep: 7-21 step 2
rsiLong = input.int(50, "RSI Long Threshold", minval=30, maxval=70, step=5)  // sweep: 45-60 step 5
rsiShort = input.int(50, "RSI Short Threshold", minval=30, maxval=70, step=5) // sweep: 40-55 step 5

// ADX filter
adxLen = input.int(14, "ADX Length", minval=5, maxval=30, step=1)            // sweep: 10-20 step 2
adxThresh = input.int(20, "ADX Threshold", minval=10, maxval=40, step=5)     // sweep: 15-30 step 5

// ATR-based TP/SL
atrLen = input.int(14, "ATR Length", minval=5, maxval=30, step=1)            // sweep: 7-21 step 2
tpMult = input.float(1.0, "TP Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.1)   // sweep: 0.5-2.0 step 0.1
slMult = input.float(1.5, "SL Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.1)   // sweep: 1.0-2.5 step 0.1

//--- indicators
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)

// RSI
rsi = ta.rsi(close, rsiLen)

// Manual ADX calculation (engine-compatible)
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
up = high - high[1]
down = low[1] - low
plusDM = up > down and up > 0 ? up : 0
minusDM = down > up and down > 0 ? down : 0
atr = ta.rma(tr, adxLen)
diPlus = 100 * ta.rma(plusDM, adxLen) / atr
diMinus = 100 * ta.rma(minusDM, adxLen) / atr
dx = 100 * math.abs(diPlus - diMinus) / (diPlus + diMinus)
adx = ta.rma(dx, adxLen)

// ATR for TP/SL
stopATR = ta.atr(atrLen)

//--- crossover detection
emaCrossOver = ta.crossover(fastEMA, slowEMA)
emaCrossUnder = ta.crossunder(fastEMA, slowEMA)

//--- entry conditions
longEntry = emaCrossOver and rsi > rsiLong and adx > adxThresh
shortEntry = emaCrossUnder and rsi < rsiShort and adx > adxThresh

//--- exit management
tpPriceLong = strategy.position_avg_price + (stopATR * tpMult / syminfo.mintick) * syminfo.mintick
slPriceLong = strategy.position_avg_price - (stopATR * slMult / syminfo.mintick) * syminfo.mintick
tpPriceShort = strategy.position_avg_price - (stopATR * tpMult / syminfo.mintick) * syminfo.mintick
slPriceShort = strategy.position_avg_price + (stopATR * slMult / syminfo.mintick) * syminfo.mintick

//--- execution
// Close any existing position before entering a reversal signal (fixes cascade ratio)
if longEntry
    strategy.close("Short", comment="CloseShort")
    strategy.entry("Long", strategy.long, comment="LongEntry")

if shortEntry
    strategy.close("Long", comment="CloseLong")
    strategy.entry("Short", strategy.short, comment="ShortEntry")

// Fixed take-profit and stop-loss exits
if strategy.position_size > 0
    strategy.exit("LongExit", "Long", limit=tpPriceLong, stop=slPriceLong)

if strategy.position_size < 0
    strategy.exit("ShortExit", "Short", limit=tpPriceShort, stop=slPriceShort)
