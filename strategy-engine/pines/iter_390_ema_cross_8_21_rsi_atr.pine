//@version=5
strategy(title="EMA8_21_RSI_ATR_XAUUSD_30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs

// EMA parameters
emaFastLen = input.int(8, "EMA Fast Length", minval=1, maxval=50)       // sweep: 5-15 step 2
emaSlowLen = input.int(21, "EMA Slow Length", minval=1, maxval=100)      // sweep: 15-30 step 3

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=1, maxval=50)                // sweep: 7-21 step 2
rsiThreshold = input.int(50, "RSI Threshold (Min for Long)", minval=1, maxval=100) // sweep: 40-60 step 5

// ATR-based TP/SL
atrLen = input.int(14, "ATR Length", minval=1, maxval=50)                // sweep: 7-21 step 2
tpMultiplier = input.float(2.0, "TP Multiplier (x ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-3.0 step 0.5
slMultiplier = input.float(1.0, "SL Multiplier (x ATR)", minval=0.5, maxval=5.0, step=0.5)  // sweep: 0.5-2.0 step 0.5

//--- indicator calculations

// EMAs
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

// RSI
rsi = ta.rsi(close, rsiLen)

// ATR for dynamic TP/SL
atr = ta.atr(atrLen)

//--- entry logic

// Entry condition: EMA fast crosses above EMA slow (bullish crossover) AND RSI > threshold
bullishCrossover = ta.crossover(emaFast, emaSlow)
entryCondition = bullishCrossover and rsi > rsiThreshold

// Calculate ATR-based stop and target distances in points
atrPoints = atr / syminfo.mintick
tpDistance = int(atrPoints * tpMultiplier)
slDistance = int(atrPoints * slMultiplier)

// Enter long position
if entryCondition
    strategy.entry("EL", strategy.long)

//--- exit management

// Exit long: ATR-based TP and SL
if strategy.position_size > 0
    strategy.exit("XL", "EL", loss=slDistance, profit=tpDistance)

//--- plot indicators for visual reference
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)
hline(rsiThreshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dashed)
