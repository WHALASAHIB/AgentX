//@version=6
strategy(title="EMA3/8 RSI50 XAU30m TP400 SL800", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 1-10 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=2, maxval=50)       // sweep: 5-20 step 1
rsi_len = input.int(14, "RSI Length", minval=7, maxval=28)         // sweep: 7-28 step 2
rsi_threshold = input.int(50, "RSI Threshold", minval=30, maxval=70) // sweep: 30-70 step 10
tp_ticks = input.int(400, "Take Profit (ticks)", minval=100, maxval=2000)  // sweep: 200-1000 step 100
sl_ticks = input.int(800, "Stop Loss (ticks)", minval=200, maxval=3000)   // sweep: 400-2000 step 100
cooldown_bars = input.int(3, "Cooldown (bars)", minval=1, maxval=20)      // sweep: 1-10 step 1

//--- indicators
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

//--- signals
bullish_cross = ta.crossover(ema_fast, ema_slow)
bearish_cross = ta.crossunder(ema_fast, ema_slow)

//--- conditions
rsi_ok_long = rsi_val > rsi_threshold
rsi_ok_short = rsi_val < rsi_threshold

long_condition = bullish_cross and rsi_ok_long
short_condition = bearish_cross and rsi_ok_short

//--- cooldown tracking
var bars_since_last_trade = 999
if strategy.position_size == 0 and nz(strategy.position_size[1]) != 0
    bars_since_last_trade := 0
else
    bars_since_last_trade := bars_since_last_trade + 1

cooldown_ok = bars_since_last_trade >= cooldown_bars

//--- entry logic
if (long_condition and cooldown_ok)
    strategy.entry("Long", strategy.long)
    
if (short_condition and cooldown_ok)
    strategy.entry("Short", strategy.short)

//--- exit management (via strategy.exit with loss/profit ticks)
if (strategy.position_size > 0)
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)
if (strategy.position_size < 0)
    strategy.exit("XS", "Short", loss=sl_ticks, profit=tp_ticks)

//--- plot EMAs for visual reference
plot(ema_fast, "Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow, "Slow EMA", color=color.red, linewidth=1)
