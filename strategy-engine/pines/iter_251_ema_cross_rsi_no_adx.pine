//@version=5
strategy(title="XAUUSD 30m EMA Cross + RSI + No ADX", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
ema_fast = input.int(5, "Fast EMA Length", minval=2, maxval=50)       // sweep: 3-20 step 1
ema_slow = input.int(13, "Slow EMA Length", minval=5, maxval=100)      // sweep: 8-50 step 2

// RSI filter
rsi_length = input.int(14, "RSI Length", minval=5, maxval=30)          // sweep: 7-21 step 2
rsi_short_threshold = input.int(50, "RSI Short Upper Threshold (< this)", minval=30, maxval=70)  // sweep: 40-60 step 5
rsi_long_threshold = input.int(50, "RSI Long Lower Threshold (> this)", minval=30, maxval=70)   // sweep: 40-60 step 5

// ATR-based TP/SL
atr_length = input.int(14, "ATR Length", minval=5, maxval=50)          // sweep: 7-21 step 2
tp_atr_mult = input.float(1.0, "TP Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.25)  // sweep: 0.5-3.0 step 0.5
sl_atr_mult = input.float(1.5, "SL Multiplier (×ATR)", minval=0.5, maxval=5.0, step=0.25)  // sweep: 0.5-3.0 step 0.5

//--- indicator calculations
ema_fast_val = ta.ema(close, ema_fast)
ema_slow_val = ta.ema(close, ema_slow)
rsi_val = ta.rsi(close, rsi_length)
atr_val = ta.atr(atr_length)

//--- entry logic
// Long: EMA fast > EMA slow AND RSI > threshold
long_condition = ta.crossover(ema_fast_val, ema_slow_val) and rsi_val > rsi_long_threshold
// Short: EMA fast < EMA slow AND RSI < threshold
short_condition = ta.crossunder(ema_fast_val, ema_slow_val) and rsi_val < rsi_short_threshold

//--- exit management
// Calculate ATR-based SL and TP in ticks
sl_ticks = int(sl_atr_mult * atr_val / syminfo.mintick)
tp_ticks = int(tp_atr_mult * atr_val / syminfo.mintick)

// Entry
if long_condition
    strategy.entry("Long", strategy.long)

if short_condition
    strategy.entry("Short", strategy.short)

// Exit with ATR-based TP/SL
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=sl_ticks, profit=tp_ticks)

//--- plot indicators for visual reference
plot(ema_fast_val, "Fast EMA", color=color.blue, linewidth=2)
plot(ema_slow_val, "Slow EMA", color=color.red, linewidth=2)
hline(rsi_long_threshold, "RSI Long Threshold", color=color.green, linestyle=hline.style_dashed)
hline(rsi_short_threshold, "RSI Short Threshold", color=color.red, linestyle=hline.style_dashed)
