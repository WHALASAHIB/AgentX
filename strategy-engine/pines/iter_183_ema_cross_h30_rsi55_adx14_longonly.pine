//@version=5
strategy(title="EMA5_10_RSI55_ADX14_LONGONLY_XAUUSD_30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA Parameters
fast_len = input.int(5, title="Fast EMA Length", minval=1, maxval=50)      // sweep: 3-10 step 1
slow_len = input.int(10, title="Slow EMA Length", minval=1, maxval=50)     // sweep: 8-20 step 1

// RSI Parameters
rsi_len = input.int(14, title="RSI Length", minval=5, maxval=30)           // sweep: 10-20 step 2
rsi_threshold = input.int(55, title="RSI Threshold (long only above)", minval=30, maxval=70)  // sweep: 40-60 step 5

// ADX Parameters
adx_len = input.int(14, title="ADX Length", minval=7, maxval=30)           // sweep: 10-20 step 2
adx_threshold = input.float(14.0, title="ADX Threshold (enter above)", minval=5, maxval=50)  // sweep: 12-25 step 2

// Risk Management
min_hold_bars = input.int(5, title="Minimum Hold Bars", minval=1, maxval=20)  // sweep: 3-8 step 1
tp_sl_ratio = input.float(2.0, title="TP:SL Ratio", minval=0.5, maxval=5.0)  // sweep: 1.0-3.0 step 0.5
atr_period = input.int(14, title="ATR Period for SL", minval=5, maxval=30)   // sweep: 10-20 step 2
atr_multiplier_sl = input.float(1.0, title="ATR Multiplier for SL", minval=0.5, maxval=5.0)  // sweep: 0.5-3.0 step 0.5

//--- indicator calculations
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)

// True ADX via DMI
[di_plus, di_minus, adx_real] = ta.dmi(adx_len, adx_len)

// ATR for stop loss calculation
atr_val = ta.atr(atr_period)

// Long condition: EMA crossover + RSI > 55 threshold + ADX > 14
long_condition = ta.crossover(fast_ema, slow_ema) and rsi_val > rsi_threshold and adx_real > adx_threshold

// Exit condition: EMA crossunder (after min hold)
exit_condition = ta.crossunder(fast_ema, slow_ema)

//--- entry logic
if (long_condition)
    // Calculate stop loss and take profit distances
    sl_distance = atr_val * atr_multiplier_sl
    tp_distance = sl_distance * tp_sl_ratio
    
    // Convert to ticks
    sl_ticks = int(sl_distance / syminfo.mintick)
    tp_ticks = int(tp_distance / syminfo.mintick)
    
    strategy.entry("Long", strategy.long)
    
    // Exit order with SL and TP
    strategy.exit("Long Exit", from_entry="Long", loss=sl_ticks, profit=tp_ticks)

//--- exit management — EMA crossunder after minimum hold period
if (barstate.isconfirmed and strategy.position_size > 0 and strategy.opentrades > 0)
    bars_since_entry = ta.barssince(strategy.position_size[1] == 0 and strategy.position_size != 0)
    if (exit_condition and bars_since_entry >= min_hold_bars)
        strategy.close("Long", comment="EMA_Xunder")

//--- visual overlays
plot(fast_ema, color=color.blue, linewidth=1, title="Fast EMA")
plot(slow_ema, color=color.red, linewidth=1, title="Slow EMA")

// Buy signal markers
plotshape(long_condition, title="Buy Signal", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
