//@version=6
strategy(title="EMA3/8 RSI30 ManualADX28 LongOnly EMA150Filter BarrierExit TP2500 SL5000 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

// iter 815: CHAMPION RSI SWEEP LOWER CELL per the iter-814 outcome-neutral result
// (result 01KZ85FXZ61XDFDHM1QD57TVGA -- RSI(14) threshold 40->35 produced a
// BYTE-IDENTICAL champion repro: PF 2.06 / Sharpe 2.22 / WR 77.3% / DD 1.55% /
// 22 trades / +$313.74, proving the RSI gate is NON-BINDING in (35,40] at
// TP2500/SL5000; the 22-trade sample is gate-stack-bound (cross_up + ADX28 +
// EMA150 + flat-only), not RSI-bound. 8/8 indicator families mapped; fresh-symbol
// (ETH/SOL/XRP) and timeframe (1h) transfers already failed; store locked at
// iter-796 champion (EMA3/8 + RSI40 + ADX28 + EMA150 + TP2500/SL5000 manual
// barriers, PF 2.06 / Sharpe 2.21 / WR 77.3% / 22 trades / +$313.74).
// ONE change: RSI(14) threshold 35 -> 30 (next untested lower cell at the
// TP2500/SL5000 barrier pair; iter-770 tested RSI30 only at TP3000/SL4500/ADX25,
// NOT on this exact champion stack). ALL else UNCHANGED: BYBIT:BTCUSDT.P 30m,
// EMA3/8 crossover, manual ADX28, EMA150 long-only regime, flat-only,
// TP2500/SL5000 manual tick barriers, 1-bar min hold, NO breakeven.
// Decision rule: if RSI30 is outcome-neutral again (metrics identical to
// iter-814/805), the RSI map at TP2500/SL5000 is COMPLETE (non-binding across
// 30-40) -> sample-expansion thesis CLOSED -> iter-796 declared the FINAL terminal
// answer, store permanently locked; if RSI30 produces NEW trades with PF >= 1.5
// and trades >= 20 -> candidate store peak (sweep RSI/barriers from there);
// PF 1.3-1.5 -> incremental; below PF 1.3 with >= 20 trades -> champion stands,
// store locked.

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // iter 815: UNCHANGED at 3 (peak). sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // iter 815: UNCHANGED at 8 (peak). sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(30, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 815: RSI 35 -> 30 (SWEEP LOWER CELL, untested at TP2500/SL5000). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(28, "ADX Threshold", minval=10, maxval=50)   // iter 815: ADX UNCHANGED at 28 (peak; ADX22 < ADX25 < ADX28 PEAK > ADX30 invalid). sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 815: regime EMA 150 (proven-best long-side). sweep: 100-200 step 50
take_profit_tick = input.int(2500, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 815: TP UNCHANGED at 2500 (PF peak, iter 792). sweep: 2000-4000 step 500
stop_loss_tick = input.int(5000, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 815: SL UNCHANGED at 5000 (loose-side peak, iter 796). sweep: 3000-6000 step 500

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 815: champion stack EXACT, RSI threshold
// 35 -> 30 only. EMA3/8 + RSI30 + ADX28 + EMA150 long-only regime + TP2500/SL5000
// manual barriers, flat-only, 1-bar min hold, NO breakeven.)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
