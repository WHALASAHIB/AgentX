//@version=5
strategy(title="EMA3_10_Cross_RSI_ADX15_XAUUSD_H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fast_len = input.int(3, "Fast EMA Length", minval=1, maxval=50)       // sweep: 2-10 step 1
slow_len = input.int(10, "Slow EMA Length", minval=1, maxval=100)     // sweep: 8-30 step 2

// RSI parameters
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)            // sweep: 7-21 step 2
rsi_threshold = input.int(50, "RSI Threshold", minval=20, maxval=80)  // sweep: 40-60 step 5

// ADX parameters — manual calculation
adx_len = input.int(14, "ADX Length", minval=2, maxval=50)            // sweep: 7-21 step 2
adx_threshold = input.int(15, "ADX Threshold", minval=5, maxval=50)   // sweep: 10-30 step 5

// Risk management
sl_pct = input.float(0.3, "Stop Loss %", minval=0.05, maxval=5.0)     // sweep: 0.1-1.0 step 0.1
tp_sl_ratio = input.float(1.5, "TP/SL Ratio", minval=0.5, maxval=5.0)// sweep: 1.0-3.0 step 0.5

// Session filter
session_start = input.int(8, "Session Start Hour (UTC)", minval=0, maxval=23)   // sweep: 0-12 step 2
session_end = input.int(20, "Session End Hour (UTC)", minval=0, maxval=23)      // sweep: 12-23 step 2

//--- indicator calculations
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)

// Manual ADX calculation (Wilder's smoothing)
up = high - high[1]
down = low[1] - low
plus_dm = up > down and up > 0 ? up : 0
minus_dm = down > up and down > 0 ? down : 0
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
plus_di = 100 * ta.rma(plus_dm, adx_len) / ta.rma(tr, adx_len)
minus_di = 100 * ta.rma(minus_dm, adx_len) / ta.rma(tr, adx_len)
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx_val = ta.rma(dx, adx_len)

//--- entry logic
is_trending = adx_val > adx_threshold
is_bullish = rsi_val > rsi_threshold
is_bearish = rsi_val < rsi_threshold

// Session check
current_hour = hour(time)
in_session = current_hour >= session_start and current_hour < session_end

// Crossover signals
bullish_cross = ta.crossover(fast_ema, slow_ema) and is_trending and is_bullish and in_session
bearish_cross = ta.crossunder(fast_ema, slow_ema) and is_trending and is_bearish and in_session

// Entry
if bullish_cross and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if bearish_cross and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

//--- exit management
sl_ticks = int((sl_pct / 100.0) * close / syminfo.mintick)
tp_ticks = int(sl_ticks * tp_sl_ratio)

if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", loss=sl_ticks, profit=tp_ticks)

if strategy.position_size < 0
    strategy.exit("Short Exit", "Short", loss=sl_ticks, profit=tp_ticks)
