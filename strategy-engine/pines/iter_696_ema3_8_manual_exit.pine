//@version=6
strategy(title="EMA3_8_ManualExit_XAU30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=0)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50, step=1)      // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50, step=1)       // sweep: 5-21 step 2
rsiLen     = input.int(14, "RSI Length", minval=2, maxval=50, step=1)           // sweep: 7-21 step 2
rsiThresh  = input.float(50, "RSI Threshold", minval=10, maxval=90, step=5)    // sweep: 40-60 step 5
adxPeriod  = input.int(14, "ADX Period", minval=5, maxval=30, step=1)          // sweep: 10-20 step 2
adxThresh  = input.float(25, "ADX Threshold", minval=10, maxval=50, step=5)    // sweep: 14-30 step 2
tpTicks    = input.int(500, "Take Profit (ticks)", minval=50, maxval=2000, step=50)  // sweep: 200-1000 step 100
slTicks    = input.int(750, "Stop Loss (ticks)", minval=50, maxval=2000, step=50)    // sweep: 300-1500 step 100

//--- manual ADX calculation
// True Range
trVal = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))

// Directional movement
upMove = high - high[1]
downMove = low[1] - low
plusDM = upMove > downMove and upMove > 0 ? upMove : 0
minusDM = downMove > upMove and downMove > 0 ? downMove : 0

// Smoothed ATR, +DI, -DI using rma (Wilder smoothing)
atr = ta.rma(trVal, adxPeriod)
plusDI = 100 * ta.rma(plusDM, adxPeriod) / atr
minusDI = 100 * ta.rma(minusDM, adxPeriod) / atr

// DX = |+DI - -DI| / (+DI + -DI)
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
// ADX = RMA of DX
adxVal = ta.rma(dx, adxPeriod)

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)

//--- entry logic
var float entryPrice   = na
var bool   oneShotExit = false

// LONG condition: EMA fast > slow, RSI > threshold, ADX > threshold
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThresh and adxVal > adxThresh
// SHORT condition: EMA fast < slow, RSI < (100-threshold), ADX > threshold
shortCondition = ta.crossunder(emaFast, emaSlow) and rsiVal < (100 - rsiThresh) and adxVal > adxThresh

// Entry
if longCondition and strategy.position_size == 0
    strategy.entry("EL", strategy.long)
    entryPrice := close
    oneShotExit := false

if shortCondition and strategy.position_size == 0
    strategy.entry("ES", strategy.short)
    entryPrice := close
    oneShotExit := false

//--- manual exit management (price-tracked, no strategy.exit, no OCO cascade)
// LONG exit: TP or SL hit
if strategy.position_size > 0 and not oneShotExit
    // TP: price >= entry + tpTicks * tick
    if close >= entryPrice + (tpTicks * syminfo.mintick)
        strategy.close("EL", comment="TP")
        oneShotExit := true
    // SL: price <= entry - slTicks * tick
    if close <= entryPrice - (slTicks * syminfo.mintick)
        strategy.close("EL", comment="SL")
        oneShotExit := true

// SHORT exit: TP or SL hit (inverse logic)
if strategy.position_size < 0 and not oneShotExit
    // TP: price <= entry - tpTicks * tick
    if close <= entryPrice - (tpTicks * syminfo.mintick)
        strategy.close("ES", comment="TP")
        oneShotExit := true
    // SL: price >= entry + slTicks * tick
    if close >= entryPrice + (slTicks * syminfo.mintick)
        strategy.close("ES", comment="SL")
        oneShotExit := true

// Reset oneShotExit on flat (next entry will need fresh guard)
if strategy.position_size == 0 and oneShotExit
    oneShotExit := false
    entryPrice := na

//--- plot indicators
plot(emaFast, "EMA Fast", color.blue)
plot(emaSlow, "EMA Slow", color.red)
hline(adxThresh, "ADX Threshold", color.gray, hline.style_dashed)
