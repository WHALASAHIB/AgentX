//@version=5
strategy(title="BB_ADX_RSI_LongOnly_30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands
bb_len = input.int(20, "BB Length", minval=5, maxval=50)       // sweep: 10-30 step 5
bb_mult = input.float(2.0, "BB StdDev", minval=1.0, maxval=4.0, step=0.5)  // sweep: 1.5-3.0 step 0.5

// ADX
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)     // sweep: 10-20 step 2
adx_threshold = input.int(25, "ADX Threshold", minval=15, maxval=40) // sweep: 20-30 step 5

// RSI
rsi_len = input.int(14, "RSI Length", minval=5, maxval=21)      // sweep: 10-20 step 2
rsi_threshold = input.int(50, "RSI Threshold (above = long)", minval=30, maxval=70) // sweep: 40-60 step 5

// Risk management
sl_atr_mult = input.float(1.5, "SL (ATR multiplier)", minval=0.5, maxval=3.0, step=0.5) // sweep: 1.0-2.0 step 0.5
tp_atr_mult = input.float(1.0, "TP (ATR multiplier)", minval=0.5, maxval=4.0, step=0.5) // sweep: 0.5-2.0 step 0.5
atr_len = input.int(14, "ATR Length", minval=7, maxval=21)      // sweep: 10-20 step 2

//--- indicator calculations
[bb_middle, bb_upper, bb_lower] = ta.bb(close, bb_len, bb_mult)
atr_val = ta.atr(atr_len)
[adx_val, di_plus, di_minus] = ta.dmi(high, low, close, adx_len)
rsi_val = ta.rsi(close, rsi_len)

//--- entry logic
// Long when: price above BB middle (uptrend) AND ADX > threshold (trending) AND RSI > threshold (momentum up)
long_entry = close > bb_middle and adx_val > adx_threshold and rsi_val > rsi_threshold

// No short entries for this version
short_entry = false

//--- exit management
// Enter only if we're flat (no open position)
if long_entry and strategy.position_size == 0
    strategy.entry("BB_LONG", strategy.long)

// Set fixed SL and TP using ATR
if strategy.position_size > 0 and strategy.position_size[1] == 0
    // On first bar of position, set SL and TP
    strategy.exit("BB_EXIT", "BB_LONG", loss=int(atr_val * sl_atr_mult / syminfo.mintick), profit=int(atr_val * tp_atr_mult / syminfo.mintick))

//--- plot indicators for visual reference
plot(bb_middle, "BB Middle", color=color.blue)
plot(bb_upper, "BB Upper", color=color.gray)
plot(bb_lower, "BB Lower", color=color.gray)
hline(adx_threshold, "ADX Threshold", color=color.purple, linestyle=hline.style_dashed)
