//@version=5
strategy(title="EMA Crossover RSI ADX18 TP1.5 LONG ONLY XAUUSD 30m", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fastLen = input.int(12, "Fast EMA Length", minval=2, maxval=50)      // sweep: 5-20 step 1
slowLen = input.int(26, "Slow EMA Length", minval=5, maxval=100)     // sweep: 13-50 step 2

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=2, maxval=30)            // sweep: 7-21 step 2
rsiThreshold = input.int(50, "RSI Threshold (long > this)", minval=20, maxval=80)  // sweep: 30-60 step 5

// ADX trend filter — lowered from 25 to 18 to capture moderate trends in lower-volatility regime
adxLen = input.int(14, "ADX Length", minval=5, maxval=30)            // sweep: 7-21 step 2
adxThreshold = input.int(18, "ADX Threshold (min)", minval=10, maxval=40)  // sweep: 10-30 step 5

// ATR-based stop loss
atrLen = input.int(14, "ATR Length for SL", minval=5, maxval=30)     // sweep: 7-21 step 2
atrMult = input.float(1.5, "ATR Multiplier for SL", minval=0.5, maxval=3.0, step=0.25)  // sweep: 0.5-3.0 step 0.25

// TP/SL ratio
tpSlRatio = input.float(1.5, "TP:SL Ratio", minval=0.5, maxval=5.0, step=0.25)  // sweep: 0.5-3.0 step 0.25

//--- indicator calculations
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
rsiVal = ta.rsi(close, rsiLen)
[_, _, adxVal] = ta.dmi(high, low, close, adxLen)
atrVal = ta.atr(atrLen)

//--- entry logic
// Long condition: EMA12 crosses above EMA26, RSI > 50, ADX > 18 (relaxed from 25 for lower-volatility regime)
longEntry = ta.crossover(fastEma, slowEma) and rsiVal > rsiThreshold and adxVal > adxThreshold

// Exit condition: trend reversal (fast EMA crosses below slow EMA) is handled by strategy.exit below
// We DON'T use strategy.close on every bar — only exits via ATR-based TP/SL

//--- entry management
if longEntry
    stopLoss = atrVal * atrMult
    takeProfit = stopLoss * tpSlRatio
    strategy.entry("Long", strategy.long)

//--- exit management
// Exit with ATR-based TP/SL using syminfo.mintick for precise conversion
if strategy.position_size > 0
    slTicks = math.floor((atrVal * atrMult) / syminfo.mintick)
    tpTicks = math.floor((atrVal * atrMult * tpSlRatio) / syminfo.mintick)
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)
