//@version=6
strategy(title="EMA3/8 RSI50 TP1:1 BTCUSDT 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50)          // sweep: 2-10 step 1
emaSlowLen = input.int(8, "Slow EMA Length", minval=1, maxval=50)          // sweep: 5-21 step 1
rsiLen     = input.int(14, "RSI Length", minval=2, maxval=50)              // sweep: 7-21 step 1
rsiThresh  = input.int(50, "RSI Threshold (long above)", minval=20, maxval=80) // sweep: 30-60 step 5
atrLen     = input.int(14, "ATR Length", minval=5, maxval=50)              // sweep: 10-21 step 2
atrMult    = input.float(2.0, "ATR Multiplier (TP=SL)", minval=0.5, maxval=5.0) // sweep: 1.0-3.0 step 0.5

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)

//--- entry logic
longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > rsiThresh

if longCondition
    strategy.entry("Long", strategy.long)

//--- exit management — fixed TP/SL at 1:1 (both at atrMult × ATR)
longTP = strategy.position_avg_price + (atrMult * atrVal * syminfo.mintick)
longSL = strategy.position_avg_price - (atrMult * atrVal * syminfo.mintick)

if strategy.position_size > 0
    strategy.exit("XL", "Long", limit=longTP, stop=longSL)

//--- visual
plot(emaFast, "Fast EMA", color.blue, 1)
plot(emaSlow, "Slow EMA", color.red, 1)
hline(rsiThresh, "RSI Threshold", color.gray, hline.style_dashed)
