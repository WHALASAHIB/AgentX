//@version=6
strategy(title="EMA3_8_TP_SL_1_1_BTCUSDT_30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)   // sweep: 1-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)   // sweep: 5-20 step 1
atrLen     = input.int(14, "ATR Length", minval=1, maxval=50)       // sweep: 7-21 step 7
atrMult    = input.float(2.0, "ATR Multiplier for SL/TP", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-3.0 step 0.5

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)

//--- plots
plot(emaFast, "EMA Fast", color=color.blue, linewidth=2)
plot(emaSlow, "EMA Slow", color=color.red, linewidth=2)

//--- entry logic: EMA3 crosses above EMA8 = long
longCondition = ta.crossover(emaFast, emaSlow)

if (longCondition)
    strategy.entry("Long", strategy.long)

//--- exit management: fixed TP/SL at 1:1 (both at 2×ATR)
if (strategy.position_size > 0)
    slPrice = close - (atrVal * atrMult)
    tpPrice = close + (atrVal * atrMult)
    strategy.exit("XL", "Long", loss=math.round((close - slPrice) / syminfo.mintick), profit=math.round((tpPrice - close) / syminfo.mintick))
