//@version=6
strategy(title="SuperTrend Flip-Change XAUUSD 15m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
st_factor = input.float(3.0, "Supertrend Factor", minval=1.0, maxval=10.0, step=0.5)   // sweep: 1.0–5.0 step 0.5
st_period = input.int(7, "Supertrend Period", minval=3, maxval=21, step=1)               // sweep: 3–21 step 2

//--- Supertrend calculation
[supertrend, direction] = ta.supertrend(st_factor, st_period)

//--- flip-change detection (only enter on direction CHANGE, not every bar)
long_signal = ta.crossover(direction, 0)
short_signal = ta.crossunder(direction, 0)

//--- entry logic
if (long_signal)
    strategy.entry("Long", strategy.long)

if (short_signal)
    strategy.entry("Short", strategy.short)

//--- exit management
// No explicit exits — opposite-direction entry auto-closes the prior position
// strategy.exit() is intentionally omitted to avoid OCO cascade fills
