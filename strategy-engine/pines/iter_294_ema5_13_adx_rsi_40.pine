//@version=5
strategy(title="iter_294_EMA5_13_ADX_RSI_40_XAUUSD_30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(5, "EMA Fast Length", minval=1, maxval=50)       // sweep: 3-10 step 1
emaSlowLen = input.int(13, "EMA Slow Length", minval=1, maxval=100)      // sweep: 10-30 step 2
adxLen = input.int(14, "ADX Length", minval=1, maxval=50)                // sweep: 7-21 step 2
adxThreshold = input.int(25, "ADX Threshold", minval=1, maxval=100)      // sweep: 20-30 step 2
rsiLen = input.int(14, "RSI Length", minval=1, maxval=50)                // sweep: 7-21 step 2
rsiMin = input.int(40, "RSI Minimum (Long)", minval=1, maxval=100)       // sweep: 30-50 step 5
tpRatio = input.float(2.0, "Take Profit (x ATR)", minval=0.1, step=0.1)  // sweep: 1.0-3.0 step 0.5
slRatio = input.float(1.0, "Stop Loss (x ATR)", minval=0.1, step=0.1)    // sweep: 0.5-2.0 step 0.5
useAdxFilter = input.bool(true, "Use ADX Trend Filter")
useRsiFilter = input.bool(true, "Use RSI Momentum Filter")

//--- indicator calculations
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(14)

//--- Manual ADX / DMI calculation (ta.adx not available on this platform)
up = high - high[1]
down = low[1] - low
plusDM = up > down and up > 0 ? up : 0
minusDM = down > up and down > 0 ? down : 0
atr14 = ta.atr(adxLen)
plusDI = 100 * ta.ema(plusDM, adxLen) / atr14
minusDI = 100 * ta.ema(minusDM, adxLen) / atr14
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.ema(dx, adxLen)

//--- entry signals
bullSignal = emaFast > emaSlow
bearSignal = emaFast < emaSlow

// Apply filters
entryLong = bullSignal
entryShort = bearSignal

if useAdxFilter
    entryLong := entryLong and adx > adxThreshold
    entryShort := entryShort and adx > adxThreshold

if useRsiFilter
    entryLong := entryLong and rsi > rsiMin
    entryShort := entryShort and rsi < (100 - rsiMin)

//--- entry logic
if entryLong and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if entryShort and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)

//--- exit management
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=int(slRatio * atr / syminfo.mintick), profit=int(tpRatio * atr / syminfo.mintick))

if strategy.position_size < 0
    strategy.exit("XS", "Short", loss=int(slRatio * atr / syminfo.mintick), profit=int(tpRatio * atr / syminfo.mintick))
