//@version=6
strategy(title="BB Squeeze ADX18 RSI50 BTCUSDT 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Bollinger Bands
bb_length = input.int(20, "BB Length", minval=5, maxval=50)       // sweep: 10-30 step 5
bb_std    = input.float(2.0, "BB StdDev", minval=1.0, maxval=3.0) // sweep: 1.5-2.5 step 0.5

// ADX filter — lowering threshold to 18 from 25 to allow trades while still filtering chop
adx_len   = input.int(14, "ADX Length", minval=7, maxval=21)      // sweep: 10-20 step 2
adx_thresh = input.int(18, "ADX Threshold", minval=10, maxval=30) // sweep: 14-25 step 3

// RSI filter
rsi_len   = input.int(14, "RSI Length", minval=7, maxval=21)      // sweep: 7-21 step 7
rsi_upper = input.int(50, "RSI Upper (long entry >)", minval=30, maxval=70) // sweep: 40-60 step 5
rsi_lower = input.int(50, "RSI Lower (short entry <)", minval=30, maxval=70) // sweep: 40-60 step 5

// ATR trailing stop
atr_len   = input.int(14, "ATR Length", minval=7, maxval=21)       // sweep: 10-20 step 2
atr_mult  = input.float(2.0, "ATR Trail Multiplier", minval=1.0, maxval=4.0) // sweep: 1.5-3.0 step 0.5

//--- indicator calculations
// Bollinger Bands
basis = ta.sma(close, bb_length)
dev   = ta.stdev(close, bb_length) * bb_std
upper_bb = basis + dev
lower_bb = basis - dev

// BB width (normalized)
bb_width = (upper_bb - lower_bb) / basis
bb_width_sma = ta.sma(bb_width, 20)
bb_expanding = bb_width > bb_width_sma

// ADX (Average Directional Index — confirms trending market)
[di_plus, di_minus, adx] = ta.dmi(adx_len, adx_len)
adx_trending = adx > adx_thresh

// RSI (Relative Strength Index — prevents counter-trend entries)
rsi_val = ta.rsi(close, rsi_len)

// ATR for trailing stop
atr_val = ta.atr(atr_len)
trail_stop_price = 0.0
if (strategy.position_size > 0)
    trail_stop_price := close - (atr_val * atr_mult)
if (strategy.position_size < 0)
    trail_stop_price := close + (atr_val * atr_mult)

//--- entry logic
// Long entry: price above upper BB + BB expanding + RSI > 50 + ADX > 18
long_entry = close > upper_bb and bb_expanding and rsi_val > rsi_upper and adx_trending

// Short entry: price below lower BB + BB expanding + RSI < 50 + ADX > 18
short_entry = close < lower_bb and bb_expanding and rsi_val < rsi_lower and adx_trending

if (long_entry and strategy.position_size == 0)
    strategy.entry("BB_LONG", strategy.long)

if (short_entry and strategy.position_size == 0)
    strategy.entry("BB_SHORT", strategy.short)

//--- exit management — ATR trailing stop
if (strategy.position_size > 0)
    strategy.exit("BB_LONG_EXIT", "BB_LONG", stop=trail_stop_price)

if (strategy.position_size < 0)
    strategy.exit("BB_SHORT_EXIT", "BB_SHORT", stop=trail_stop_price)
