//@version=5
strategy(title="MACD + ADX18 Trend Filter XAUUSD H1 (24h)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//====================================================================
//--- inputs
//====================================================================

// MACD parameters
macdFastLen   = input.int(12,  "MACD Fast Length",  minval=2, maxval=50, tooltip="Fast EMA length for MACD")        // sweep: 8-20 step 2
macdSlowLen   = input.int(26,  "MACD Slow Length",  minval=5, maxval=100, tooltip="Slow EMA length for MACD")      // sweep: 18-34 step 2
macdSignalLen = input.int(9,   "MACD Signal Length", minval=2, maxval=30, tooltip="Signal line smoothing")          // sweep: 5-15 step 2

// ADX parameters — computed manually from DMI components
adxLen        = input.int(14,  "ADX Length",         minval=7, maxval=28, tooltip="ADX lookback period")             // sweep: 7-21 step 2
adxThreshold  = input.int(18,  "ADX Threshold",      minval=10, maxval=50, tooltip="Minimum ADX value for trending")  // sweep: 10-25 step 2

// TP/SL parameters
tpSlRatio     = input.float(1.5, "TP:SL Ratio",      minval=0.5, maxval=5.0, step=0.1, tooltip="Take-profit to stop-loss ratio")   // sweep: 1.0-3.0 step 0.25
atrLen        = input.int(14,   "ATR Length for SL",  minval=5, maxval=50, tooltip="ATR period for dynamic stops")                 // sweep: 10-20 step 2
atrMult       = input.float(1.5, "ATR Multiplier",    minval=0.5, maxval=5.0, step=0.1, tooltip="ATR multiplier for stop distance") // sweep: 1.0-3.0 step 0.25

// Display
showSignals   = input.bool(true, "Show Signal Labels", tooltip="Display buy/sell labels on chart")

//====================================================================
//--- calculations
//====================================================================

// MACD
[macdLine, signalLine, _hist] = ta.macd(close, macdFastLen, macdSlowLen, macdSignalLen)

// --- Manual ADX calculation ---

// True Range
trVal = ta.tr(true)

// Directional Movement
upMove  = high - high[1]
downMove = low[1] - low

posDM = upMove > downMove and upMove > 0 ? upMove : 0
negDM = downMove > upMove and downMove > 0 ? downMove : 0

// Smoothed TR, +DM, -DM using RMA (Wilder smoothing)
smoothedTR    = ta.rma(trVal, adxLen)
smoothedPosDM = ta.rma(posDM, adxLen)
smoothedNegDM = ta.rma(negDM, adxLen)

// +DI and -DI
plusDI  = 100 * smoothedPosDM / smoothedTR
minusDI = 100 * smoothedNegDM / smoothedTR

// DX = absolute difference / sum * 100
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)

// ADX = RMA of DX
adxVal = ta.rma(dx, adxLen)

isTrending = adxVal > adxThreshold

// --- End manual ADX ---

// ATR for dynamic stop placement
atrVal = ta.atr(atrLen)

// MACD crossover conditions
macdCrossOver  = ta.crossover(macdLine, signalLine)
macdCrossUnder = ta.crossunder(macdLine, signalLine)

//====================================================================
//--- entry logic — NO session filter (24h trading)
//====================================================================

// Long entry: MACD crosses above signal line AND market is trending (ADX > threshold)
// Session filter REMOVED in iter 12 — trade 24h to increase trade count
longCondition = macdCrossOver and isTrending

// Short entry: MACD crosses below signal line AND market is trending (ADX > threshold)
// Session filter REMOVED in iter 12 — trade 24h to increase trade count
shortCondition = macdCrossUnder and isTrending

// Entries
if longCondition
    strategy.entry("Long", strategy.long)
    if showSignals
        label.new(bar_index, low, "BUY MACD+ADX", style=label.style_label_up, color=color.green, size=size.small, textcolor=color.white)

if shortCondition
    strategy.entry("Short", strategy.short)
    if showSignals
        label.new(bar_index, high, "SELL MACD+ADX", style=label.style_label_down, color=color.red, size=size.small, textcolor=color.white)

//====================================================================
//--- exit management
//====================================================================

// Dynamic stop-loss and take-profit distances based on ATR
stopDist   = atrVal * atrMult
profitDist = stopDist * tpSlRatio

// Convert to ticks
stopTicks   = int(stopDist / syminfo.mintick)
profitTicks = int(profitDist / syminfo.mintick)

// Exit orders — placed on every bar after entry to maintain stops
if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", loss=stopTicks, profit=profitTicks)

if strategy.position_size < 0
    strategy.exit("Short Exit", "Short", loss=stopTicks, profit=profitTicks)

//====================================================================
//--- end
//====================================================================
