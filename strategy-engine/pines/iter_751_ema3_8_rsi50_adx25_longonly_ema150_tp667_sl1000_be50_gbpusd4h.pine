//@version=6
strategy(title="EMA3/8 RSI50 ManualADX25 LongOnly EMA150Filter BarrierExit TP667 SL1000 BE50 GBPUSD4h", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(50, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 751: RSI>50 unchanged; sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(25, "ADX Threshold", minval=10, maxval=50)   // iter 751: ADX unchanged at 25; sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 751: regime EMA 150 (proven-best from iter 745/747). sweep: 100-200 step 50
take_profit_tick = input.int(667, "Take Profit (ticks)", minval=100, maxval=20000, step=50)  // iter 751: TP REVERTED 1000->667 (iter 749 peak: WR 65.5%, PF 1.01, net +$9; iter 750 TP1000 disproven -- WR fell to 51.7% below the ~56.8% breakeven at 0.76x payoff; TP667 is the confirmed peak). sweep: 500-1500 step 250
stop_loss_tick = input.int(1000, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 751: SL unchanged at 1000; sweep: 500-2500 step 250
be_enabled = input.bool(true, "Breakeven Stop Enabled", group="Breakeven")  // iter 751: NEW -- once price advances 50% of TP distance, SL moves from entry-1000 to entry
be_trigger_pct = input.float(0.5, "Breakeven Trigger (% of TP distance)", minval=0.1, maxval=0.9, step=0.1, group="Breakeven")  // iter 751: 0.5 -> 333 ticks of TP667; sweep: 0.3-0.7 step 0.1

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY GBPUSD 4h: iter 749 symbol pivot produced the family's HIGHEST WR -- 65.5% (19W/10L) -- but PF only 1.01 because realized payoff is 0.53x (avg win $46.32 vs avg loss $87.10; SL overruns on 4h gaps). iter 750: widening TP 667->1000 FAILED -- WR fell 65.5->51.7% below the ~56.8% breakeven at 0.76x payoff. TP667 is the confirmed peak. The structural loss-maker is the avg-loss side: SL overruns on 4h gaps make avg loss ($87.10-87.59) run ~2x avg win at TP667 ($46.32). A 50% breakeven stop converts post-favorable-move retracements from full -$87 SL hits to $0, directly attacking the 0.53x payoff asymmetry without touching the entry edge. One change: add breakeven stop at 50% of TP distance (TP reverts to proven 667).)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var float entry_price = na
var bool be_armed = false
var int entry_bar = -1

//--- breakeven trigger distance (ticks): 50% of TP distance, floored (667*0.5 = 333.5 -> 333)
be_trigger_ticks = math.floor(take_profit_tick * be_trigger_pct)

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_price := close
    be_armed := false
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    // TP check first
    if high >= long_tp
        strategy.close("Long", comment="TP")
    else
        // NEW iter 751: arm breakeven stop once price advances be_trigger_ticks toward TP
        if be_enabled and not be_armed and high >= entry_price + be_trigger_ticks * syminfo.mintick
            be_armed := true
            long_sl := entry_price
        // SL check (original SL before arming, breakeven SL after)
        if low <= long_sl
            strategy.close("Long", comment=be_armed ? "BE" : "SL")
