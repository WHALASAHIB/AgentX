//@version=5
strategy(title="EMA(5,21) Cross + RSI(50) + ADX(25) + TP 1.5:1 Long Only XAUUSD 30m",
         overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         commission_type=strategy.commission.percent,
         commission_value=0.04,
         process_orders_on_close=true)

//--- inputs
// EMA fast period — sweep: 3-10 step 2
ema_fast = input.int(5, "EMA Fast Period")
// EMA slow period — sweep: 10-30 step 5
ema_slow = input.int(21, "EMA Slow Period")
// RSI period — sweep: 10-20 step 2
rsi_period = input.int(14, "RSI Period")
// RSI minimum threshold — sweep: 40-60 step 5
rsi_min = input.int(50, "RSI Minimum (Long Only)")
// DMI/ADX period — sweep: 10-20 step 2
adx_period = input.int(14, "ADX Period")
// ADX threshold — sweep: 20-30 step 2
adx_threshold = input.int(25, "ADX Minimum Threshold")
// TP/SL ratio — sweep: 1.0-2.5 step 0.5
tp_sl_ratio = input.float(1.5, "TP/SL Ratio")
// SL in ATR multiples — sweep: 1.0-3.0 step 0.5
sl_atr_mult = input.float(1.5, "Stop Loss (ATR multiples)")
// ATR period
atr_period = input.int(14, "ATR Period")

//--- calculations using ta.dmi instead of ta.adx
ema_fast_val = ta.ema(close, ema_fast)
ema_slow_val = ta.ema(close, ema_slow)
rsi_val = ta.rsi(close, rsi_period)
// ta.dmi returns [adx, plus_di, minus_di]
[adx_val, plus_di, minus_di] = ta.dmi(high, low, close, adx_period)
atr_val = ta.atr(atr_period)

// Trend direction: fast EMA above slow EMA = uptrend
ema_trend_bullish = ema_fast_val > ema_slow_val

// Crossover detection: fast EMA crosses above slow EMA (fresh long signal)
ema_cross_over = ta.crossover(ema_fast_val, ema_slow_val)
// Crossunder = exit signal
ema_cross_under = ta.crossunder(ema_fast_val, ema_slow_val)

//--- entry logic
long_condition = ema_cross_over and rsi_val > rsi_min and adx_val > adx_threshold

//--- exit management
// SL in ticks: ATR value converted to ticks
sl_ticks = math.round(atr_val * sl_atr_mult / syminfo.mintick)
tp_ticks = math.round(sl_ticks * tp_sl_ratio)

// Entry: long only on EMA crossover with RSI and ADX filters
if long_condition
    strategy.entry("Long", strategy.long, comment="EMA_Cross_Long")

// Exit: SL/TP managed via strategy.exit
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)

// Also exit on EMA crossunder (trend reversal)
if ema_cross_under and strategy.position_size > 0
    strategy.close("Long", comment="EMA_Cross_Under_Exit")
