//@version=5
// Strategy: MACD(8,17,7) + RSI(14)>50 LONG-only XAUUSD H1
// Iteration 81: Add RSI(14)>50 momentum filter on top of iter 79's MACD(8,17,7) crossover
// Previous iter 80: ADX(DMI)>25 filter made PF worse (0.707 vs 1.23)
// Now trying RSI>50 filter — ensures entries during positive momentum only

strategy(title="MACD(8,17,7)+RSI(14)>50 LONG-only XAUUSD H1", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
macd_fast = input.int(8, "MACD Fast Length", minval=2, maxval=50)
macd_slow = input.int(17, "MACD Slow Length", minval=5, maxval=100)
macd_signal = input.int(7, "MACD Signal Length", minval=2, maxval=30)

// RSI filter
rsi_length = input.int(14, "RSI Length", minval=2, maxval=50)   // sweep: 10-20 step 2
rsi_threshold = input.int(50, "RSI Threshold (long above)", minval=30, maxval=70) // sweep: 40-60 step 5

// ATR-based exit management
atr_length = input.int(14, "ATR Length", minval=5, maxval=50)
sl_mult = input.float(1.0, "Stop Loss (ATR multiplier)", minval=0.5, maxval=3.0, step=0.1)      // sweep: 0.5-2.0 step 0.25
tp_mult = input.float(2.0, "Take Profit (ATR multiplier)", minval=0.5, maxval=5.0, step=0.1)    // sweep: 1.0-3.0 step 0.5

//--- calculations
[macd_line, signal_line, _] = ta.macd(close, macd_fast, macd_slow, macd_signal)
rsi_val = ta.rsi(close, rsi_length)
atr = ta.atr(atr_length)

//--- entry logic
// LONG: MACD line crosses above Signal line AND RSI(14) > 50
long_entry = ta.crossover(macd_line, signal_line) and rsi_val > rsi_threshold

//--- exit management
// Calculate SL and TP levels based on ATR
long_sl_price = close * (1.0 - (sl_mult * atr / close))
long_tp_price = close * (1.0 + (tp_mult * atr / close))

// Convert to ticks for strategy.exit()
sl_ticks = int((close - long_sl_price) / syminfo.mintick)
tp_ticks = int((long_tp_price - close) / syminfo.mintick)

// Entry
if long_entry and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=sl_ticks, profit=tp_ticks)
