//@version=5
strategy(title="EMA(5,13) Cross + ADX(14)>14 TP 1.5:1 NoCrossunderExit — XAUUSD 30m", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity,
         default_qty_value=100, commission_type=strategy.commission.percent,
         commission_value=0.04, process_orders_on_close=true)

//--- inputs
fast_len = input.int(5, "Fast EMA", minval=1, maxval=50)      // sweep: 3-15 step 1
slow_len = input.int(13, "Slow EMA", minval=1, maxval=100)     // sweep: 8-30 step 2
adx_len = input.int(14, "ADX Length", minval=1, maxval=50)     // sweep: 10-20 step 2
adx_threshold = input.int(14, "ADX Threshold", minval=1, maxval=50)  // sweep: 10-25 step 2
tp_ratio = input.float(1.5, "TP Ratio (ATR multiples)", minval=0.5, maxval=5.0)   // sweep: 1.0-3.0 step 0.5
sl_ratio = input.float(1.0, "SL Ratio (ATR multiples)", minval=0.5, maxval=5.0)   // sweep: 0.5-2.0 step 0.5
atr_period = input.int(14, "ATR Period", minval=5, maxval=50)  // sweep: 5-20 step 3

//--- indicator calculations
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
[di_plus, di_minus, adx] = ta.dmi(adx_len, adx_len)
atr = ta.atr(atr_period)

//--- crossover detection
cross_up = ta.crossover(fast_ema, slow_ema)
cross_down = ta.crossunder(fast_ema, slow_ema)

//--- entry logic (long only)
//--- Long entry: EMA crossover + ADX trending >= threshold
long_entry = cross_up and adx >= adx_threshold

if (long_entry and strategy.position_size == 0)
    stop_loss = sl_ratio * atr
    take_profit = tp_ratio * atr
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=stop_loss / syminfo.mintick, profit=take_profit / syminfo.mintick)

//--- NO crossunder exit — let all trades run to ATR-based TP/SL targets only
//--- This allows the TP ratio to actually function (iter 208 proved crossunder exit dominates)
//--- A new entry in opposite direction will auto-close any open position via strategy.entry
