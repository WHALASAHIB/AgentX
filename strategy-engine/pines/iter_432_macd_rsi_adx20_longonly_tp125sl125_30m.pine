//@version=5
strategy(title="MACD RSI ADX20 Long-Only 1:1 XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLength = input.int(5, title="MACD Fast Length", minval=1)      // sweep: 3-12 step 1
slowLength = input.int(13, title="MACD Slow Length", minval=1)     // sweep: 10-26 step 2
signalLength = input.int(5, title="MACD Signal Length", minval=1)  // sweep: 3-9 step 1

// RSI filter
rsiLength = input.int(14, title="RSI Length", minval=1)            // sweep: 7-21 step 2
rsiThreshold = input.int(50, title="RSI Long Minimum", minval=30, maxval=70)  // sweep: 40-60 step 5

// ADX filter
adxLength = input.int(14, title="ADX Length", minval=1)           // sweep: 7-21 step 2
adxThreshold = input.int(20, title="ADX Minimum", minval=1)       // sweep: 14-25 step 2

// TP/SL settings
tpPips = input.int(125, title="Take Profit (points)", minval=1)   // sweep: 50-200 step 25
slPips = input.int(125, title="Stop Loss (points)", minval=1)     // sweep: 50-200 step 25

//--- indicator calculations
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
rsi = ta.rsi(close, rsiLength)
[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)

//--- entry conditions (LONG-ONLY)
// Long: MACD line crosses above signal line, RSI > threshold, ADX > minimum (trending)
// No short trades — eliminates bidirectional whipsaw on sideways markets
longCondition = ta.crossover(macdLine, signalLine) and rsi > rsiThreshold and adx > adxThreshold

//--- entry management
// Enter long only
if longCondition
    strategy.entry("Long", strategy.long, comment="L")

//--- exit management via fixed TP/SL in points
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=slPips, profit=tpPips)
