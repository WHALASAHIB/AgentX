//@version=5
strategy(title="EMA5_13 Cross + ADX20 + RSI30 LONG only (XAUUSD 30m)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA fast period — shorter EMA for entry signal
emaFast   = input.int(5,   "EMA Fast",  minval=2, maxval=30)      // sweep: 3-10 step 1
// EMA slow period — longer EMA for trend reference
emaSlow   = input.int(13,  "EMA Slow",  minval=5, maxval=50)      // sweep: 10-30 step 2
// ADX threshold — minimum trend strength
adxThresh = input.int(20,  "ADX Threshold", minval=10, maxval=40)  // sweep: 15-30 step 2
// RSI minimum — bullish momentum filter
rsiMin    = input.int(30,  "RSI Minimum (Long)", minval=20, maxval=60) // sweep: 25-50 step 5
// ADX length
adxLen    = input.int(14,  "ADX Length", minval=7, maxval=28)     // sweep: 7-21 step 7
// Risk-to-reward ratio (profit target = risk * rrRatio)
rrRatio   = input.float(1.5, "Risk:Reward Ratio", minval=1.0, maxval=4.0, step=0.1) // sweep: 1.0-3.0 step 0.5

//--- manual ADX calculation (ta.adx not available on some platforms)
// True Range
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
// Directional Movement
upDM = high - high[1]
downDM = low[1] - low
plusDM = upDM > downDM and upDM > 0 ? upDM : 0
minusDM = downDM > upDM and downDM > 0 ? downDM : 0
// Smoothed values using RMA (Wilder's moving average)
atr_smooth = ta.rma(tr, adxLen)
plusDI = 100 * ta.rma(plusDM, adxLen) / atr_smooth
minusDI = 100 * ta.rma(minusDM, adxLen) / atr_smooth
// DX and ADX
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx_val = ta.rma(dx, adxLen)

//--- indicators
ema_fast = ta.ema(close, emaFast)
ema_slow = ta.ema(close, emaSlow)
rsi_val  = ta.rsi(close, 14)

//--- entry logic (LONG only)
// Conditions for long entry:
// 1. EMA fast crosses above EMA slow (bullish crossover)
// 2. ADX > threshold (trending market)
// 3. RSI > minimum (not oversold, bullish momentum)
longCondition = ta.crossover(ema_fast, ema_slow) and adx_val > adxThresh and rsi_val > rsiMin

// Plot signals for visual reference
plot(ema_fast, "EMA Fast", color.blue, 1)
plot(ema_slow, "EMA Slow", color.orange, 1)
hline(adxThresh, "ADX Threshold", color.gray, hline.style_dashed)
plotchar(longCondition, "Entry Signal", "▲", location.belowbar, color.green, size=size.tiny)

//--- entry management
// Declare ATR outside if block to ensure it's visible
atr_val = ta.atr(14)
if (longCondition)
    // Calculate ATR-based stop loss distance (2× ATR for volatility-adjusted SL)
    sl_distance = 2.0 * atr_val
    // Stop loss price = entry - sl_distance (for long)
    sl_price = close - sl_distance
    // Take profit price = entry + (sl_distance * rrRatio)
    tp_price = close + (sl_distance * rrRatio)
    // Convert to ticks for strategy.exit
    sl_ticks = int(sl_distance / syminfo.mintick)
    tp_ticks = int(sl_distance * rrRatio / syminfo.mintick)
    
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=sl_ticks, profit=tp_ticks, comment="TP/SL 1.5:1")

//--- trailing stop (exit only — no strategy.close to avoid cascade-close)
plot(atr_val, "ATR(14)", color.purple, 0, display=display.none)
