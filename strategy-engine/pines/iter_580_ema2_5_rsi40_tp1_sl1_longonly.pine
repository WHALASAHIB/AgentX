//@version=6
strategy(title="Iter 580 — EMA2/5 Long-Only + RSI40 + 1:1 TP/SL (XAUUSD H1)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
fast_len = input(2, "Fast EMA Length")        // sweep: 1-10 step 1
slow_len = input(5, "Slow EMA Length")        // sweep: 3-15 step 2
rsi_len = input(14, "RSI Length")             // sweep: 7-21 step 7
rsi_threshold = input(40, "RSI Minimum (Long)") // sweep: 30-60 step 10
tp_ratio = input(1.0, "TP/SL Ratio")          // sweep: 0.5-2.0 step 0.3
sl_pips = input(100, "Stop Loss (mintick units)") // sweep: 50-200 step 25

//--- indicators
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
rsi_val = ta.rsi(close, rsi_len)

//--- entry logic: long only
long_entry = ta.crossover(fast_ema, slow_ema) and rsi_val > rsi_threshold

//--- exit management: fixed TP/SL
if (long_entry)
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=sl_pips, profit=math.round(sl_pips * tp_ratio))

//--- plot EMAs for visual reference
plot(fast_ema, "Fast EMA", color.blue, linewidth=1)
plot(slow_ema, "Slow EMA", color.red, linewidth=1)
hline(rsi_threshold, "RSI Threshold", color.gray, hline.style_dashed)
