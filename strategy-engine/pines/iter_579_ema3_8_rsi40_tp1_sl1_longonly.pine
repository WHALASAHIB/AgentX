//@version=6
strategy(title="EMA3/8 + RSI(40) + 1:1 TP/SL XAUUSD H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen = input.int(3, "EMA Fast Length", minval=1, maxval=50)  // sweep: 2-10 step 1
emaSlowLen = input.int(8, "EMA Slow Length", minval=1, maxval=50)  // sweep: 5-21 step 2
rsiLen = input.int(14, "RSI Length", minval=2, maxval=50)          // sweep: 7-21 step 2
rsiThreshold = input.int(40, "RSI Threshold (long above)", minval=10, maxval=80) // sweep: 30-50 step 5
tpRatio = input.float(1.0, "Take Profit (ratio of SL)", minval=0.5, maxval=5.0)  // sweep: 0.5-3.0 step 0.5, TESTING 1:1
slRatio = input.float(1.0, "Stop Loss (ratio of TP)", minval=0.5, maxval=5.0)   // sweep: 0.5-3.0 step 0.5

//--- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)

//--- entry logic: EMA3 crosses above EMA8 AND RSI(14) > 40
longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiThreshold

//--- exit management using fixed tick SL/TP based on 0.2% of current price
if (longCondition)
    // Calculate SL distance as 0.2% of close price in ticks
    baseDist = close * 0.002
    slTicks = math.round((baseDist * slRatio) / syminfo.mintick)
    tpTicks = math.round((baseDist * tpRatio) / syminfo.mintick)
    
    // Ensure minimum distance: at least 10 ticks
    slTicks := math.max(slTicks, 10)
    tpTicks := math.max(tpTicks, 10)
    
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=slTicks, profit=tpTicks)
