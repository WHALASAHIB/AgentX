//@version=5
strategy(title="EMA5/13 + RSI(50) + ADX(15) + halved SL — XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
emaFastLen  = input.int(5,   "EMA Fast Length",   minval=1, maxval=50, step=1)   // sweep: 3-10 step 1
emaSlowLen  = input.int(13,  "EMA Slow Length",   minval=5, maxval=50, step=1)   // sweep: 10-26 step 2
rsiLen      = input.int(14,  "RSI Length",        minval=5, maxval=30, step=1)   // sweep: 7-21 step 2
rsiThresh   = input.int(50,  "RSI Threshold",     minval=20, maxval=80, step=5)  // sweep: 40-60 step 5
adxLen      = input.int(14,  "ADX Length",        minval=7, maxval=30, step=1)   // sweep: 10-20 step 2
adxThresh   = input.int(15,  "ADX Threshold",     minval=5, maxval=40, step=1)   // sweep: 10-20 step 2
tpRatio     = input.float(2.0, "Take Profit (x SL)", minval=0.5, maxval=5.0, step=0.5) // sweep: 1.0-3.0 step 0.5
slPct       = input.float(0.15, "Stop Loss %",     minval=0.05, maxval=1.0, step=0.05) // sweep: 0.1-0.5 step 0.05

//--- indicator calculation
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal  = ta.rsi(close, rsiLen)

//--- manual ADX calculation (ta.adx not supported by Trader Dev engine)
up = high - high[1]
down = low[1] - low

plusDM = up > down and up > 0 ? up : 0
minusDM = down > up and down > 0 ? down : 0

tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))

// Smooth with SMA
atr = ta.sma(tr, adxLen)
smoothPlusDM = ta.sma(plusDM, adxLen)
smoothMinusDM = ta.sma(minusDM, adxLen)

diPlus = 100 * smoothPlusDM / atr
diMinus = 100 * smoothMinusDM / atr
dx = 100 * math.abs(diPlus - diMinus) / (diPlus + diMinus)
adxVal = ta.sma(dx, adxLen)

//--- entry logic
bullishCross = ta.crossover(emaFast, emaSlow)
bearishCross = ta.crossunder(emaFast, emaSlow)

longCondition  = bullishCross and rsiVal > rsiThresh and adxVal > adxThresh
shortCondition = bearishCross and rsiVal < rsiThresh and adxVal > adxThresh

//--- entry execution
if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (shortCondition and strategy.position_size == 0)
    strategy.entry("Short", strategy.short)

//--- exit management
slPips = close * slPct / 100 / syminfo.mintick
tpPips = slPips * tpRatio

if (strategy.position_size != 0)
    strategy.exit("XL", "Long",  loss=slPips, profit=tpPips)
    strategy.exit("XS", "Short", loss=slPips, profit=tpPips)
