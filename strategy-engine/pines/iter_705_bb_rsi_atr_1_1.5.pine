//@version=6
strategy(title="BB RSI ATR 1:1.5 XAU30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_len     = input.int(20, "BB Length", minval=5, maxval=100)        // sweep: 10-40 step 5
bb_mult    = input.float(2.0, "BB Multiplier", step=0.25)             // sweep: 1.5-3.0 step 0.25
rsi_len    = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
atr_len    = input.int(14, "ATR Length", minval=5, maxval=50)         // sweep: 7-21 step 7
tp_atr     = input.float(1.0, "TP (ATR multiple)", step=0.1)          // sweep: 0.6-1.4 step 0.2
sl_atr     = input.float(1.5, "SL (ATR multiple)", step=0.1)          // sweep: 1.2-2.0 step 0.2
cooldown   = input.int(3, "Cooldown bars", minval=0, maxval=10)       // sweep: 1-6 step 1

//--- Bollinger Bands
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_len, bb_mult)

//--- RSI
rsi_val = ta.rsi(close, rsi_len)

//--- ATR
atr_val = ta.atr(atr_len)

//--- state tracking
var int bars_since_exit = 0
var bool in_position = false
var float entry_price = 0.0
var int entry_bar = 0
var bool exit_placed = false
var float tp_price = 0.0
var float sl_price = 0.0

//--- update cooldown
if not in_position
    bars_since_exit := bars_since_exit + 1

//--- entry conditions
buy_signal = ta.crossunder(close, bb_lower) and rsi_val < 50
sell_signal = ta.crossover(close, bb_upper) and rsi_val > 50

//--- entry logic
if not in_position and bars_since_exit >= cooldown
    if buy_signal
        entry_price := close
        entry_bar := bar_index
        strategy.entry("BB_Long", strategy.long)
        in_position := true
        exit_placed := false
        bars_since_exit := 0
        
    if sell_signal
        entry_price := close
        entry_bar := bar_index
        strategy.entry("BB_Short", strategy.short)
        in_position := true
        exit_placed := false
        bars_since_exit := 0

//--- exit management (once per entry)
if in_position and not exit_placed
    tp_price := entry_price + (tp_atr * atr_val * (strategy.position_size > 0 ? 1 : -1))
    sl_price := entry_price - (sl_atr * atr_val * (strategy.position_size > 0 ? 1 : -1))
    if strategy.position_size > 0
        strategy.exit("BB_Long_Exit", "BB_Long", limit=tp_price, stop=sl_price)
    else
        strategy.exit("BB_Short_Exit", "BB_Short", limit=tp_price, stop=sl_price)
    exit_placed := true

//--- reset when flat
if strategy.position_size == 0 and in_position
    in_position := false
    exit_placed := false
    entry_price := 0.0
    tp_price := 0.0
    sl_price := 0.0
