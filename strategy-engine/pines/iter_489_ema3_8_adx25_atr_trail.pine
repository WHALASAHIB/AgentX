//@version=6
strategy(title="iter_489_ema3_8_adx25_atr_trail", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA periods
fastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50)
slowLen = input.int(8, "Slow EMA Length", minval=1, maxval=50)

// ADX filter
adxLen = input.int(14, "ADX Length", minval=1, maxval=50)

// ATR trailing stop
atrLen = input.int(14, "ATR Length", minval=1, maxval=50)
trailMult = input.float(2.0, "ATR Trail Multiplier", minval=0.5, maxval=5.0, step=0.5)

// Trade direction
tradeLong = input.bool(true, "Enable Long Trades")
tradeShort = input.bool(false, "Enable Short Trades")

//--- indicator calculations
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
atrVal = ta.atr(atrLen)

// Manual ADX calculation
upChange = high - high[1]
downChange = low[1] - low
plusDM = upChange > downChange and upChange > 0 ? upChange : 0
minusDM = downChange > upChange and downChange > 0 ? downChange : 0
tr = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
atrSm = ta.rma(tr, adxLen)
plusDI = 100 * ta.rma(plusDM, adxLen) / atrSm
minusDI = 100 * ta.rma(minusDM, adxLen) / atrSm
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adxVal = ta.rma(dx, adxLen)

//--- entry logic
bullishCross = ta.crossover(fastEma, slowEma)
bearishCross = ta.crossunder(fastEma, slowEma)
trending = adxVal >= 25

// Long entry: fast EMA crosses above slow EMA, ADX > 25, trending up
if bullishCross and trending and tradeLong
    strategy.entry("Long", strategy.long)

// Short entry: fast EMA crosses below slow EMA, ADX > 25, trending down
if bearishCross and trending and tradeShort
    strategy.entry("Short", strategy.short)

//--- exit management: ATR trailing stop
if strategy.position_size > 0
    stopLevel = close - (atrVal * trailMult)
    strategy.exit("XL", "Long", stop=stopLevel)

if strategy.position_size < 0
    stopLevel = close + (atrVal * trailMult)
    strategy.exit("XS", "Short", stop=stopLevel)
