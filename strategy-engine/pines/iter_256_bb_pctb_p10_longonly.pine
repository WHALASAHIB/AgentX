//@version=5
strategy(title="BB %B Short Period Long Only (iter_256)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
bb_length = input.int(10, "BB Length", minval=5, maxval=50)        // sweep: 5-50 step 5
bb_stddev = input.float(2.0, "BB StdDev", minval=1.0, maxval=4.0)   // sweep: 1.0-3.0 step 0.5
atr_length = input.int(14, "ATR Length", minval=7, maxval=28)       // sweep: 7-28 step 7
atr_mult_sl = input.float(1.5, "ATR SL Multiplier", minval=1.0, maxval=3.0) // sweep: 1.0-3.0 step 0.5
use_tp_exit = input.bool(true, "Enable %B TP Exit")                 // true = exit when %B<1

//--- Bollinger Bands
basis = ta.sma(close, bb_length)
dev = bb_stddev * ta.stdev(close, bb_length)
upper_band = basis + dev
lower_band = basis - dev

//--- %B calculation
pct_b = (close - lower_band) / (upper_band - lower_band)
pct_b_prev = (close[1] - lower_band[1]) / (upper_band[1] - lower_band[1])

//--- ATR for stop loss
atr_val = ta.atr(atr_length)
stop_loss_price = atr_mult_sl * atr_val / syminfo.mintick

//--- entry conditions
enter_long = ta.cross(pct_b, 0)  // %B crosses above 0 = close crosses above lower band

//--- exit conditions
exit_tp = use_tp_exit and ta.cross(pct_b, 1)  // %B crosses below 1 = close crosses below upper band

//--- entry
if enter_long
    strategy.entry("Long", strategy.long)

//--- exit management
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=stop_loss_price, profit=use_tp_exit ? 0 : stop_loss_price)
    if exit_tp
        strategy.close("Long")
