//@version=5
strategy(title="EMA2/5 Long-Only DMI10 RSI50 TP83 SL125", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// Fast EMA period
fastLen = input.int(2, "Fast EMA Length", minval=1, maxval=20)     // sweep: 1-10 step 1
// Slow EMA period
slowLen = input.int(5, "Slow EMA Length", minval=3, maxval=50)     // sweep: 3-21 step 1
// ADX threshold (from DMI)
adxThresh = input.int(10, "ADX Threshold", minval=5, maxval=40)    // sweep: 5-25 step 5
// RSI threshold (long only above this)
rsiThresh = input.int(50, "RSI Threshold (Long > this)", minval=20, maxval=80) // sweep: 30-60 step 5
// Take profit in points
tpPoints = input.int(83, "Take Profit (points)", minval=10, maxval=500) // sweep: 50-200 step 25
// Stop loss in points
slPoints = input.int(125, "Stop Loss (points)", minval=10, maxval=500) // sweep: 50-200 step 25
// DMI period
dmiLen = input.int(14, "DMI Period", minval=5, maxval=30)          // sweep: 7-21 step 7

//--- indicators
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
[plusDi, minusDi, dmiAdx] = ta.dmi(high, low, close, dmiLen)
rsiVal = ta.rsi(close, 14)

//--- entry logic
longCondition = ta.crossover(fastEma, slowEma) and dmiAdx > adxThresh and rsiVal > rsiThresh

if longCondition
    strategy.entry("Long", strategy.long)

//--- exit management
if strategy.position_size > 0
    strategy.exit("XL", "Long", loss=slPoints, profit=tpPoints)
