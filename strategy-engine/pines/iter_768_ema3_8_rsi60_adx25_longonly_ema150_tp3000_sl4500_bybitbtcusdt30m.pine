//@version=6
strategy(title="EMA3/8 RSI60 ManualADX25 LongOnly EMA150Filter BarrierExit TP3000 SL4500 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(60, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 768: RSI 50->60 (ONLY CHANGE -- stronger momentum filter, targeting WR >63% to clear the ~62.9% breakeven WR at iter-765 payoff 0.59x). sweep: 50-70 step 5
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(25, "ADX Threshold", minval=10, maxval=50)   // iter 768: ADX UNCHANGED at 25; sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 768: regime EMA 150 (proven-best long-side from iter 745/747). sweep: 100-200 step 50
take_profit_tick = input.int(3000, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 768: TP UNCHANGED at 3000 (iter-765 peak value). 3000 ticks = $300 ~ 0.3% ~ 0.75x ATR. sweep: 2000-4000 step 500
stop_loss_tick = input.int(4500, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 768: SL UNCHANGED at 4500 (iter-765 peak value; iter 767 SL 4500->3000 DISPROVEN: WR 62.1->60.0%, net -$22.18->-$40.10). 4500 ticks = $450 ~ 0.45% ~ 1x ATR. sweep: 3000-6000 step 500

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 768: REVERT to the iter-765 PEAK config on BYBIT:BTCUSDT.P 30m (EMA3/8 + RSI50 + ADX25 + EMA150 long-only, TP3000/SL4500 manual barriers, NO breakeven) with ONE change: rsi_threshold 50->60. iter 767: SL tightening 4500->3000 DISPROVEN -- on the SAME 4615-bar window, WR 62.1->60.0% (18W/12L, -2.1pp), avg loss shrank -$60.87->-$54.97 (-9.7%) but avg win also slipped -$35.97->-$34.42 (-4.3%), realized payoff only rose 0.591->0.626, breakeven-WR gap WIDENED -0.8pp -> -1.5pp: net -$22.18->-$40.10. SL dimension FULLY MAPPED (SL3000 < SL4500 peak). Exit geometry EXHAUSTED on BTC 30m (TP: 667/2000/3000/4000 mapped, peak TP3000; SL: 3000/4500 mapped, peak SL4500; ATR trail worst). iter-765 (TP3000/SL4500) is the family peak with the SOLE deficit WR 62.1% sitting 0.8pp BELOW the ~62.9% breakeven WR (payoff 0.59x). Next lever: ENTRY QUALITY -- rsi_threshold 50->60 (only strongest momentum crosses enter, targeting WR >63% to clear breakeven). Risk: trade count drops below 20 (30 -> ~20-25) or WR does not rise enough -- that is the experiment.)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
