//@version=6
strategy(title="EMA3/8 RSI40 ManualADX28 LongOnly EMA150Filter BarrierExit TP3000 SL4500 BYBITBTCUSDT30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true, pyramiding=1)

//--- inputs
ema_fast_len = input.int(3, "Fast EMA", minval=1, maxval=50)       // sweep: 2-8 step 1
ema_slow_len = input.int(8, "Slow EMA", minval=1, maxval=50)       // sweep: 5-21 step 2
rsi_len = input.int(14, "RSI Length", minval=2, maxval=50)         // sweep: 7-21 step 7
rsi_threshold = input.int(40, "RSI Threshold (long above)", minval=20, maxval=80)  // iter 779: RSI UNCHANGED at 40 (iter-769/770 peak, RSI dimension mapped: RSI60 < RSI50 < RSI40 == RSI30). sweep: 30-60 step 10
adx_len = input.int(14, "ADX Length", minval=7, maxval=30)         // sweep: 7-21 step 7
adx_threshold = input.int(28, "ADX Threshold", minval=10, maxval=50)   // iter 779: REVERT to ADX28 (ONLY CHANGE from iter 778 -- signal family Supertrend flip -> EMA3/8 crossover). iter 778: Supertrend(3,7) family conclusively ENTRY-STARVED after full relaxation sequence (ADX 28->22: +1 trade; EMA 150->100: SATURATED; RSI 40->30: +3 trades; cumulative 4->8) despite excellent quality (WR 87.5%, PF 3.57, net +$168.16 on 8 trades) -- never reached the 20-trade floor. Reverting to EMA3/8 crossover restores the confirmed family best (iter 772/774: 24 trades, PF 1.66, WR 70.8%, net +$273.58). sweep: 15-35 step 5
ema_regime_len = input.int(150, "Regime EMA Length", minval=50, maxval=300)   // iter 779: regime EMA 150 (proven-best long-side from iter 745/747). sweep: 100-200 step 50
take_profit_tick = input.int(3000, "Take Profit (ticks)", minval=100, maxval=20000, step=100)  // iter 779: TP UNCHANGED at 3000 (iter-765 peak, ~0.75x ATR). sweep: 2000-4000 step 500
stop_loss_tick = input.int(4500, "Stop Loss (ticks)", minval=100, maxval=20000, step=100)     // iter 779: SL UNCHANGED at 4500 (iter-765 peak, ~1x ATR). sweep: 3000-6000 step 500

//--- indicator calculations
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)
ema_regime = ta.ema(close, ema_regime_len)

//--- manual Wilder ADX calculation (built-in ta.adx not supported by engine)
wilder_alpha = 1.0 / adx_len

tr_val = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

var float smoothed_tr = na
var float smoothed_plus_dm = na
var float smoothed_minus_dm = na
var float adx_val = na

if na(smoothed_tr)
    smoothed_tr := ta.sma(tr_val, adx_len)
    smoothed_plus_dm := ta.sma(plus_dm, adx_len)
    smoothed_minus_dm := ta.sma(minus_dm, adx_len)
else
    smoothed_tr := smoothed_tr + wilder_alpha * (tr_val - smoothed_tr)
    smoothed_plus_dm := smoothed_plus_dm + wilder_alpha * (plus_dm - smoothed_plus_dm)
    smoothed_minus_dm := smoothed_minus_dm + wilder_alpha * (minus_dm - smoothed_minus_dm)

plus_di = 100 * smoothed_plus_dm / smoothed_tr
minus_di = 100 * smoothed_minus_dm / smoothed_tr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)

if na(adx_val)
    adx_val := ta.sma(dx, adx_len)
else
    adx_val := adx_val + wilder_alpha * (dx - adx_val)

//--- crossover detection
cross_up = ta.crossover(ema_fast, ema_slow)

//--- entry conditions (LONG-ONLY. iter 779: REVERT to the iter-774 PEAK config on BYBIT:BTCUSDT.P 30m (EMA3/8 + RSI40 + ADX28 + EMA150 long-only regime + TP3000/SL4500 manual barriers, flat-only, 1-bar min hold, NO breakeven) per the iter-778 conclusion: the Supertrend(3,7) family pivot is conclusively ENTRY-STARVED -- the full relaxation sequence (ADX 28->22: +1 trade; EMA 150->100: SATURATED; RSI 40->30: +3 trades; cumulative 4->8) never reached the 20-trade floor despite excellent quality (iter 778: WR 87.5%, PF 3.57, net +$168.16 on 8 trades). ONE change: signal family Supertrend flip -> EMA3/8 crossover (revert). This restores the confirmed family best (24 trades, PF 1.66, WR 70.8%, net +$273.58). After the peak re-confirms, the alternate pivot candidate is MACD(12,26,9) crossover with the same proven filter stack (the second candidate named in the iter-774 pivot plan).)
long_condition = cross_up and rsi_val > rsi_threshold and adx_val > adx_threshold and close > ema_regime

//--- manual price-barrier tracking (no strategy.exit OCO -> no cascade)
var float long_tp = na
var float long_sl = na
var int entry_bar = -1

//--- entry logic (flat only, long side only)
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    long_tp := close + take_profit_tick * syminfo.mintick
    long_sl := close - stop_loss_tick * syminfo.mintick
    entry_bar := bar_index

//--- exit management (manual barriers, min 1-bar hold to prevent same-bar cascade)
if strategy.position_size > 0 and bar_index > entry_bar
    if high >= long_tp
        strategy.close("Long", comment="TP")
    if low <= long_sl
        strategy.close("Long", comment="SL")
