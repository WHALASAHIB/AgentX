//@version=5
strategy(title="MACD ADX14 RSI30 Long-Only XAUUSD 30m", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// MACD parameters
fastLen = input.int(12, "MACD Fast Length", minval=5, maxval=50, group="MACD")      // sweep: 5-20 step 1
slowLen = input.int(26, "MACD Slow Length", minval=10, maxval=100, group="MACD")     // sweep: 15-50 step 1
sigLen  = input.int(9, "MACD Signal Length", minval=3, maxval=30, group="MACD")      // sweep: 5-20 step 1

// ADX filter
adxLen   = input.int(14, "ADX Length", minval=5, maxval=50, group="ADX")              // sweep: 10-30 step 2
adxLevel = input.int(14, "ADX Minimum Level", minval=5, maxval=50, group="ADX")       // sweep: 10-25 step 2

// RSI filter
rsiLen    = input.int(14, "RSI Length", minval=7, maxval=28, group="RSI")             // sweep: 7-21 step 2
rsiMin    = input.int(30, "RSI Minimum (long only)", minval=10, maxval=60, group="RSI") // sweep: 20-50 step 5

// TP/SL
tpPoints = input.int(104, "Take Profit (points)", minval=20, maxval=500, group="TP/SL")    // sweep: 50-200 step 10
slPoints = input.int(104, "Stop Loss (points)", minval=20, maxval=500, group="TP/SL")      // sweep: 50-200 step 10

//--- manual DMI/ADX calculation
// True Range
hiLo = high - low
hiCl = math.abs(high - close[1])
loCl = math.abs(low - close[1])
tr = math.max(hiLo, hiCl, loCl)
atr = ta.sma(tr, adxLen)

// Directional Movements
upMove = high - high[1]
downMove = low[1] - low

plusDM = upMove > downMove and upMove > 0 ? upMove : 0
minusDM = downMove > upMove and downMove > 0 ? downMove : 0

// Smoothed DMs
smoothPlusDM = ta.sma(plusDM, adxLen)
smoothMinusDM = ta.sma(minusDM, adxLen)

// Directional Indicators
plusDI = 100 * smoothPlusDM / atr
minusDI = 100 * smoothMinusDM / atr

// DMI difference and sum
dmiDiff = math.abs(plusDI - minusDI)
dmiSum = plusDI + minusDI

// ADX = smoothed average of DMI diff / sum
adxVal = 100 * ta.sma(dmiDiff / (dmiSum == 0 ? 1 : dmiSum), adxLen)

//--- indicator calculations
[macdLine, signalLine, histLine] = ta.macd(close, fastLen, slowLen, sigLen)
rsiVal  = ta.rsi(close, rsiLen)

//--- entry logic
// MACD crossover = bullish signal (line crosses above signal)
macdBuySignal  = ta.crossover(macdLine, signalLine)
// ADX > threshold = trending market (avoid ranging chop)
trendingOk     = adxVal > adxLevel
// RSI > minimum = not oversold/bearish extreme (gentle filter)
rsiOk          = rsiVal > rsiMin

// Long entry condition: MACD crossover + trending + not oversold
longCondition  = macdBuySignal and trendingOk and rsiOk

//--- exit management
if (longCondition)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=slPoints, profit=tpPoints)

//--- plot indicators for visual reference
hline(adxLevel, "ADX Level", color=color.gray, linestyle=hline.style_dashed)
plot(adxVal, "ADX", color=color.purple, linewidth=1)
hline(50, "RSI 50", color=color.gray, linestyle=hline.style_dashed)
plot(rsiVal, "RSI", color=color.orange, linewidth=1)
plot(histLine, "MACD Histogram", color=color.blue, style=plot.style_histogram, display=display.none)
