//@version=6
strategy(title="EMA3/8 ATR Trail RSI40 Long Only XAU H1", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04, process_orders_on_close=true)

//--- inputs
// EMA parameters
fastLen = input.int(3, "Fast EMA Length", minval=1, maxval=50, step=1)       // sweep: 1-10 step 1
slowLen = input.int(8, "Slow EMA Length", minval=1, maxval=50, step=1)        // sweep: 5-21 step 2

// RSI filter
rsiLen = input.int(14, "RSI Length", minval=5, maxval=28, step=1)             // sweep: 5-28 step 3
rsiThreshold = input.int(40, "RSI Threshold (long only above)", minval=20, maxval=60, step=5)  // sweep: 30-60 step 5

// ATR trailing stop
atrLen = input.int(14, "ATR Length", minval=5, maxval=30, step=1)            // sweep: 5-30 step 5
atrMult = input.float(2.5, "ATR Multiplier", minval=0.5, maxval=5.0, step=0.5)  // sweep: 1.0-4.0 step 0.5

//--- indicator calculations
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

//--- entry logic
// Bullish crossover condition
bullishCross = ta.crossover(fastEMA, slowEMA)
// RSI filter — long only if RSI > threshold
rsiFilter = rsi > rsiThreshold
// Combined entry signal
longSignal = bullishCross and rsiFilter

//--- trailing stop management
// Ratchet a trail series and call strategy.exit each bar
var float trailStop = na
if (strategy.position_size > 0)
    // Update trail stop to highest close - atrMult*atr, never lower the stop
    trailStop := math.max(na(trailStop) ? close - atrMult * atr : trailStop, close - atrMult * atr)
    // Apply the trailing stop via strategy.exit each bar
    strategy.exit("XL", from_entry="Long", stop=trailStop)
else
    trailStop := na

//--- execution
if (longSignal and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    trailStop := close - atrMult * atr

//--- plot indicators for visual reference
plot(fastEMA, "Fast EMA", color=color.blue, linewidth=1)
plot(slowEMA, "Slow EMA", color=color.red, linewidth=1)
hline(rsiThreshold, "RSI Threshold", color=color.gray, linestyle=hline.style_dotted)
