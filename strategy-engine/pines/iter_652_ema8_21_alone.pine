//@version=6
strategy(title="iter_652 — EMA8/21 cross alone", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.04)

fastLen = 8
slowLen = 21

fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)

bullCross = ta.crossover(fastEMA, slowEMA)

if (bullCross and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (strategy.position_size > 0)
    strategy.exit("XL", "Long", limit=close * 1.02, stop=close * 0.98)
